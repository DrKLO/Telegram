#!/usr/bin/env python3
"""Small local workflow for the Features Lab Android fork (Python 3, macOS)."""
import argparse
import datetime
import getpass
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent
LOCAL = ROOT / 'local.properties'
PACKAGE = 'org.telegram.features.beta'
OFFLINE_PACKAGE = 'org.telegram.features.offline.beta'
AVD = 'Features_Lab_API_36'
NDK = '27.2.12479018'


def run(args, capture=False, check=True, env=None):
    return subprocess.run([str(x) for x in args], cwd=ROOT, env=env,
                          text=True, capture_output=capture, check=check)


def properties():
    values = {}
    if LOCAL.exists():
        for line in LOCAL.read_text().splitlines():
            if line.strip() and not line.lstrip().startswith(('#', '!')) and '=' in line:
                k, v = line.split('=', 1)
                values[k.strip()] = v.strip().replace('\\ ', ' ').replace('\\:', ':').replace('\\\\', '\\')
    return values


def save_properties(updates):
    lines = LOCAL.read_text().splitlines() if LOCAL.exists() else ['# Local machine settings and credentials. Never commit this file.']
    keys = set(updates)
    lines = [line for line in lines if line.split('=', 1)[0].strip() not in keys]
    for key, value in updates.items():
        escaped = str(value).replace('\\', '\\\\').replace(' ', '\\ ').replace(':', '\\:')
        lines.append(f'{key}={escaped}')
    temporary = LOCAL.with_suffix('.properties.tmp')
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write('\n'.join(lines) + '\n')
    temporary.replace(LOCAL)
    LOCAL.chmod(0o600)


def sdk_path():
    return Path(properties().get('sdk.dir') or os.environ.get('ANDROID_HOME') or Path.home() / 'Library/Android/sdk')


def java_home():
    candidates = [Path('/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home')]
    if os.environ.get('JAVA_HOME'):
        candidates.append(Path(os.environ['JAVA_HOME']))
    for path in candidates:
        if (path / 'bin/java').exists():
            result = run([path / 'bin/java', '-version'], capture=True)
            if re.search(r'version "17[.\"]', result.stderr + result.stdout):
                return path
    raise SystemExit('Java 17 is missing. Install openjdk@17, or set JAVA_HOME to a Java 17 installation.')


def environment():
    env = os.environ.copy()
    env.update(JAVA_HOME=str(java_home()), ANDROID_HOME=str(sdk_path()),
               ANDROID_SDK_ROOT=str(sdk_path()), CMAKE_BUILD_PARALLEL_LEVEL='2', LC_ALL='en_US.UTF-8')
    env['PATH'] = str(java_home() / 'bin') + os.pathsep + str(sdk_path() / 'platform-tools') + os.pathsep + env.get('PATH', '')
    return env


def bootstrap():
    sdk = sdk_path()
    if not (sdk / 'platform-tools/adb').exists():
        raise SystemExit(f'Android platform-tools missing from {sdk}')
    java = java_home()
    save_properties({'sdk.dir': str(sdk)})
    gradle = ROOT / '.gradle'
    gradle.mkdir(exist_ok=True)
    (gradle / 'config.properties').write_text(f'java.home={java}\n')
    idea = ROOT / '.idea'
    idea.mkdir(exist_ok=True)
    config = idea / 'gradle.xml'
    if not config.exists():
        config.write_text('''<?xml version="1.0" encoding="UTF-8"?>
<project version="4">
  <component name="GradleSettings">
    <option name="linkedExternalProjectsSettings"><GradleProjectSettings>
      <option name="externalProjectPath" value="$PROJECT_DIR$" />
      <option name="gradleJvm" value="#GRADLE_LOCAL_JAVA_HOME" />
      <option name="modules"><set><option value="$PROJECT_DIR$" /></set></option>
    </GradleProjectSettings></option>
  </component>
</project>
''')


def credentials_valid():
    props = properties()
    app_id, app_hash = props.get('telegram.apiId', ''), props.get('telegram.apiHash', '')
    return bool(re.fullmatch(r'[1-9][0-9]{0,9}', app_id)
                and int(app_id) <= 2147483647
                and re.fullmatch(r'[a-fA-F0-9]{32}', app_hash))


def adb(*args, serial=None, capture=False, check=True):
    command = [sdk_path() / 'platform-tools/adb']
    if serial:
        command += ['-s', serial]
    return run(command + list(args), capture=capture, check=check)


def device(required=False):
    result = adb('devices', capture=True)
    rows = [line.split() for line in result.stdout.splitlines()[1:] if line.strip()]
    serial = os.environ.get('ANDROID_SERIAL')
    if serial:
        if [serial, 'device'] not in rows:
            raise SystemExit('ANDROID_SERIAL is not connected and authorized. Check ./dev devices.')
        return serial
    ready = [row[0] for row in rows if len(row) >= 2 and row[1] == 'device']
    if len(ready) > 1:
        raise SystemExit('Multiple devices connected. Set ANDROID_SERIAL to the intended phone.')
    if ready:
        return ready[0]
    if required:
        raise SystemExit('No authorized device. Run ./dev emulator, or connect a phone with USB debugging. Run ./dev devices.')
    return None


def phone_abi(serial):
    api = adb('shell', 'getprop', 'ro.build.version.sdk', serial=serial, capture=True).stdout.strip()
    if not api.isdigit() or int(api) < 23:
        raise SystemExit('This Telegram baseline requires Android 6.0 / API 23 or later.')
    abis = adb('shell', 'getprop', 'ro.product.cpu.abilist', serial=serial, capture=True).stdout.strip().split(',')
    for abi in ('arm64-v8a', 'armeabi-v7a'):
        if abi in abis:
            return abi
    raise SystemExit('The connected device does not support an ARM ABI supported by this setup.')


def build(compile_only=False, offline=False):
    bootstrap()
    if not compile_only and not offline and not credentials_valid():
        raise SystemExit('Run ./dev configure first. Credentials stay in ignored local.properties. For compilation without login, use ./dev compile-check.')
    serial = device()
    abi = phone_abi(serial) if serial else properties().get('featuresLab.abi', 'arm64-v8a')
    save_properties({'featuresLab.abi': abi})
    print(f'Building Features Lab for {abi}' + (' (compile check: no login credentials)' if compile_only else ''), flush=True)
    run([ROOT / 'gradlew', ':TMessagesProj_App:assembleAfatDebug',
         '-PfeaturesLab=true', f'-PfeaturesLabAbi={abi}',
         f'-PfeaturesLabOffline={str(offline).lower()}',
         f'-PfeaturesLabCompileOnly={str(compile_only).lower()}', '--console=plain'], env=environment())
    apk = ROOT / 'TMessagesProj_App/build/outputs/apk/afat/debug/app.apk'
    if not apk.exists():
        raise SystemExit('Gradle completed but the expected APK was not found.')
    print(f'APK: {apk}')
    if compile_only:
        print('Compile-check APK only: do not use this artifact for account login or distribution.')
    return apk


def emulator():
    """Start only our dedicated AVD; preserve its data and avoid snapshot disk usage."""
    bootstrap()
    binary = sdk_path() / 'emulator/emulator'
    if not binary.exists():
        raise SystemExit('Install Android Emulator and create Features_Lab_API_36; see docs/OFFLINE.md.')
    available = run([binary, '-list-avds'], capture=True).stdout.splitlines()
    if AVD not in available:
        raise SystemExit('Features_Lab_API_36 is missing. Follow docs/OFFLINE.md to create it.')
    for row in adb('devices', capture=True).stdout.splitlines()[1:]:
        fields = row.split()
        if len(fields) >= 2 and fields[0].startswith('emulator-') and fields[1] == 'device':
            name = adb('emu', 'avd', 'name', serial=fields[0], capture=True, check=False).stdout.splitlines()
            if name and name[0] == AVD:
                print(f'{AVD} is already running ({fields[0]}).')
                return fields[0]
    if shutil.disk_usage(ROOT).free < 5e9:
        raise SystemExit('The emulator needs at least 5 GB of free working space.')
    logs = ROOT / 'artifacts'
    logs.mkdir(exist_ok=True)
    # Choose an unused emulator console/ADB port pair.
    import socket
    port = None
    for candidate in range(5554, 5585, 2):
        try:
            with socket.socket() as console, socket.socket() as bridge:
                console.bind(('127.0.0.1', candidate))
                bridge.bind(('127.0.0.1', candidate + 1))
                port = candidate
                break
        except OSError:
            continue
    if port is None:
        raise SystemExit('No free emulator port pair.')
    with (logs / 'emulator.log').open('a') as log:
        subprocess.Popen([str(binary), '-avd', AVD, '-port', str(port), '-memory', '2560',
                          '-cores', '2', '-no-snapshot', '-no-boot-anim', '-camera-back', 'none',
                          '-camera-front', 'none'], stdout=log, stderr=log, stdin=subprocess.DEVNULL,
                         start_new_session=True, env=environment())
    serial = f'emulator-{port}'
    print(f'Booting {AVD}; log: {logs / "emulator.log"}', flush=True)
    deadline = time.monotonic() + 180
    while time.monotonic() < deadline:
        ready = adb('shell', 'getprop', 'sys.boot_completed', serial=serial, capture=True, check=False)
        if ready.stdout.strip() == '1':
            print(f'Emulator ready: {serial}', flush=True)
            return serial
        time.sleep(2)
    raise SystemExit('Emulator did not boot within 3 minutes; inspect artifacts/emulator.log.')


def install(offline=False):
    serial = device(required=True)
    phone_abi(serial)
    apk = build(offline=offline)
    package = OFFLINE_PACKAGE if offline else PACKAGE
    activity = 'org.telegram.features.FeaturesLabActivity' if offline else 'org.telegram.ui.LaunchActivity'
    # Never uninstall or clear user data to work around a signing conflict.
    adb('install', '-r', apk, serial=serial)
    adb('shell', 'am', 'start', '-n', f'{package}/{activity}', serial=serial)


def smoke_test(privacy=False):
    source_commit = run(['git', 'rev-parse', 'HEAD'], capture=True).stdout.strip()
    dirty_at_start = bool(run(['git', 'status', '--porcelain'], capture=True).stdout.strip())
    serial = device(required=True)
    install(offline=True)
    run([ROOT / 'gradlew', ':TMessagesProj_App:assembleAfatDebugAndroidTest',
         '-PfeaturesLab=true', '-PfeaturesLabOffline=true', '--console=plain'], env=environment())
    test_apk = ROOT / 'TMessagesProj_App/build/outputs/apk/androidTest/afat/debug/TMessagesProj_App-afat-debug-androidTest.apk'
    adb('install', '-r', test_apk, serial=serial)
    artifacts = ROOT / 'artifacts'
    artifacts.mkdir(exist_ok=True)
    results = []
    suite = 'StarsPrivacyTest' if privacy else 'OfflineSmokeTest'
    methods = [
        'deadlineAndMockContract', 'retroactiveReactionPrivacy', 'liveRetroactivePrivacy',
        'purchasePrivacyNotice', 'privacyChangeCancelsPendingPublicSends', 'openReceiptRespondsToPrivacy',
        'channelHighlightExpiresInOpenSheet', 'productionPendingReactionCancelsSafely',
        'nativePrivacyScreensAndRecycledRows', 'privateTransactionAmounts', 'anonymousChoiceAfterOptOut',
        'twentySecondUndoAndLiveMock', 'nativeSettingsPolish', 'compactRtlAndLargeText', 'historyPrivacyControl',
        # The last two scenarios deliberately share persisted fixtures across fresh processes.
        'channelPolicyAndIrreversibleHistory', 'privacySurvivesProcessRestart',
    ] if privacy else ['offlinePlaygroundRendersWithoutAccount', 'themeSurvivesProcessRestart']
    folder = 'stars-privacy' if privacy else 'smoke'
    if privacy:
        (artifacts / 'stars-privacy-qa.json').unlink(missing_ok=True)
    for method in methods:
        adb('shell', 'am', 'force-stop', OFFLINE_PACKAGE, serial=serial)
        result = adb('shell', 'am', 'instrument', '-w', '-r', '-e', 'class',
                     'org.telegram.features.' + suite + '#' + method,
                     OFFLINE_PACKAGE + '.test/androidx.test.runner.AndroidJUnitRunner', serial=serial, capture=True)
        print(result.stdout, flush=True)
        results.append(result.stdout + result.stderr)
        (artifacts / ('stars-privacy-test.txt' if privacy else 'offline-smoke-test.txt')).write_text('\n'.join(results))
        if adb('shell', 'test', '-d', f'/sdcard/Android/data/{OFFLINE_PACKAGE}/files/{folder}', serial=serial, capture=True, check=False).returncode == 0:
            adb('pull', f'/sdcard/Android/data/{OFFLINE_PACKAGE}/files/{folder}', artifacts, serial=serial, check=False)
        if not re.search(r'OK \(\d+ tests?\)', result.stdout):
            raise SystemExit('Android test failed; inspect artifacts/' + ('stars-privacy-test.txt' if privacy else 'offline-smoke-test.txt'))
    if privacy:
        from Tools.prepare_stars_submission import SCREENSHOTS
        metadata = {
            'source_commit': source_commit,
            'working_tree_dirty': dirty_at_start or bool(run(['git', 'status', '--porcelain'], capture=True).stdout.strip())
                or source_commit != run(['git', 'rev-parse', 'HEAD'], capture=True).stdout.strip(),
            'scenario_passed': True,
            'scenarios': methods,
            'screenshots': {name: hashlib.sha256((artifacts / folder / name).read_bytes()).hexdigest() for name in SCREENSHOTS},
        }
        (artifacts / 'stars-privacy-qa.json').write_text(json.dumps(metadata, indent=2) + '\n')
    adb('shell', 'am', 'start', '-n', OFFLINE_PACKAGE + '/org.telegram.features.FeaturesLabActivity', serial=serial)


def native_test():
    """Exercise the production navigation with the offline data provider."""
    source_commit = run(['git', 'rev-parse', 'HEAD'], capture=True).stdout.strip()
    dirty_at_start = bool(run(['git', 'status', '--porcelain'], capture=True).stdout.strip())
    (ROOT / 'artifacts/native-ui-qa.json').unlink(missing_ok=True)
    serial = device(required=True)
    install(offline=True)
    run([ROOT / 'gradlew', ':TMessagesProj_App:assembleAfatDebugAndroidTest',
         '-PfeaturesLab=true', '-PfeaturesLabOffline=true', '--console=plain'], env=environment())
    adb('install', '-r', ROOT / 'TMessagesProj_App/build/outputs/apk/androidTest/afat/debug/TMessagesProj_App-afat-debug-androidTest.apk', serial=serial)
    methods = ['settingsToHistory', 'channelReactionAndAdmin', 'liveStoryStars', 'darkSettings']
    outputs = []
    for method in methods:
        adb('shell', 'am', 'force-stop', OFFLINE_PACKAGE, serial=serial)
        result = adb('shell', 'am', 'instrument', '-w', '-r', '-e', 'class',
                     'org.telegram.features.NativeStarsFlowTest#' + method,
                     OFFLINE_PACKAGE + '.test/androidx.test.runner.AndroidJUnitRunner',
                     serial=serial, capture=True)
        outputs.append(result.stdout + result.stderr)
        print(outputs[-1], flush=True)
        (ROOT / 'artifacts/native-ui-test.txt').write_text('\n'.join(outputs))
        if 'OK (1 test)' not in outputs[-1]:
            raise SystemExit('Native navigation test failed: ' + method)
    adb('pull', '/sdcard/Android/data/' + OFFLINE_PACKAGE + '/files/native-ui', ROOT / 'artifacts', serial=serial)
    evidence = {
        'source_commit': source_commit,
        'working_tree_dirty': dirty_at_start or bool(run(['git', 'status', '--porcelain'], capture=True).stdout.strip())
            or source_commit != run(['git', 'rev-parse', 'HEAD'], capture=True).stdout.strip(),
        'scenario_passed': True,
        'scenarios': methods,
        'screenshots': {p.name: hashlib.sha256(p.read_bytes()).hexdigest()
                        for p in sorted((ROOT / 'artifacts/native-ui').glob('[0-9]*.png'))},
    }
    (ROOT / 'artifacts/native-ui-qa.json').write_text(json.dumps(evidence, indent=2) + '\n')


def doctor():
    bootstrap()
    print(f'Java 17: {java_home()}\nAndroid SDK: {sdk_path()}')
    print(f'Free disk: {shutil.disk_usage(ROOT).free / 1e9:.1f} GB')
    errors = []
    for rel in ['platforms/android-36/android.jar', 'build-tools/36.0.0/aapt2',
                f'ndk/{NDK}/source.properties', 'cmake/3.22.1/bin/cmake']:
        ok = (sdk_path() / rel).exists()
        print(f'{"OK" if ok else "MISSING"}: {rel}')
        if not ok:
            errors.append(rel)
    modules = run(['git', 'submodule', 'status', '--recursive'], capture=True)
    bad = [line for line in modules.stdout.splitlines() if line and line[0] in '-+U']
    print('Submodules: ' + ('need initialization / pinned checkout' if bad else 'at pinned commits'))
    errors.extend(bad)
    print('API credentials: ' + ('configured (values hidden)' if credentials_valid() else 'not configured; not needed for ./dev demo'))
    serial = device()
    if serial:
        abi = phone_abi(serial)
        save_properties({'featuresLab.abi': abi})
        version = adb('shell', 'getprop', 'ro.build.version.release', serial=serial, capture=True).stdout.strip()
        print(f'Device: Android {version}; saved build ABI: {abi}')
    else:
        print('Device: none connected; run ./dev demo for the account-free emulator')
    if errors:
        raise SystemExit(1)


def configure():
    bootstrap()
    if not sys.stdin.isatty():
        raise SystemExit('Run ./dev configure interactively in Terminal; do not send API credentials through chat.')
    print('Create an application at https://my.telegram.org/apps. Values are saved locally and not printed.')
    app_id = input('Telegram api_id: ').strip()
    app_hash = getpass.getpass('Telegram api_hash (hidden): ').strip()
    if not re.fullmatch(r'[1-9][0-9]{0,9}', app_id) or int(app_id) > 2147483647 or not re.fullmatch(r'[a-fA-F0-9]{32}', app_hash):
        raise SystemExit('Expected a positive numeric api_id and a 32-character hexadecimal api_hash. No credentials were saved.')
    save_properties({'telegram.apiId': app_id, 'telegram.apiHash': app_hash})
    print('Credentials saved locally. Next: ./dev install')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['doctor', 'configure', 'devices', 'build', 'compile-check', 'install', 'logs', 'record', 'studio', 'emulator', 'demo', 'offline-build', 'offline-install', 'smoke-test', 'privacy-test', 'native-test'])
    parser.add_argument('seconds', nargs='?', type=int, default=30, help='record duration, 1–180 seconds')
    args = parser.parse_args()
    if args.command == 'doctor':
        doctor()
    elif args.command == 'configure':
        configure()
    elif args.command == 'devices':
        adb('devices', '-l')
    elif args.command in ('build', 'compile-check', 'offline-build'):
        build(args.command == 'compile-check', args.command == 'offline-build')
    elif args.command in ('install', 'offline-install'):
        install(offline=args.command == 'offline-install')
    elif args.command == 'emulator':
        emulator()
    elif args.command == 'demo':
        os.environ['ANDROID_SERIAL'] = emulator()
        install(offline=True)
    elif args.command == 'native-test':
        native_test()
    elif args.command in ('smoke-test', 'privacy-test'):
        smoke_test(privacy=args.command == 'privacy-test')
    elif args.command == 'logs':
        serial = device(required=True)
        pid = adb('shell', 'pidof', OFFLINE_PACKAGE, serial=serial, capture=True, check=False).stdout.strip().split()
        if not pid:
            pid = adb('shell', 'pidof', PACKAGE, serial=serial, capture=True, check=False).stdout.strip().split()
        if not pid:
            raise SystemExit('Features Lab is not running. Open it on the emulator or phone first.')
        adb('logcat', '--pid=' + pid[0], serial=serial)
    elif args.command == 'record':
        if not 1 <= args.seconds <= 180:
            raise SystemExit('Recording duration must be between 1 and 180 seconds.')
        serial = device(required=True)
        name = 'features-lab-' + datetime.datetime.now().strftime('%Y%m%d-%H%M%S') + '.mp4'
        out = ROOT / 'artifacts' / name
        out.parent.mkdir(exist_ok=True)
        remote = '/sdcard/' + name
        print(f'Recording for {args.seconds}s. Demonstrate the flow on the selected emulator or phone.', flush=True)
        adb('shell', 'screenrecord', '--time-limit', str(args.seconds), remote, serial=serial)
        adb('pull', remote, out, serial=serial)
        adb('shell', 'rm', remote, serial=serial)
        print(f'Recording: {out}')
    elif args.command == 'studio':
        bootstrap()
        studio = Path('/Applications/Android Studio Features Lab.app')
        if not studio.exists():
            studio = Path('/Applications/Android Studio.app')
        run(['open', '-a', studio, ROOT])


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        raise SystemExit(130)
    except subprocess.CalledProcessError as exc:
        raise SystemExit(exc.returncode)
