{
  "name": "widget-sandbox",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "corepack pnpm -C apps/web dev",
    "build": "corepack pnpm -C apps/web build",
    "typecheck": "corepack pnpm -r typecheck && tsc --noEmit",
    "canary": "tsx tests/canary-server.ts",
    "test:attacks": "playwright test tests/attacks.spec.ts",
    "test:compat": "playwright test tests/compat.spec.ts",
    "test:generated": "playwright test tests/generated.spec.ts",
    "test:htmlbubbles": "CORPUS_GROUP=htmlbubbles-ported playwright test tests/generated.spec.ts",
    "test:common": "CORPUS_GROUP=common playwright test tests/generated.spec.ts",
    "test:showcase": "CORPUS_GROUP=showcase playwright test tests/generated.spec.ts",
    "test:defaults": "CORPUS_GROUP=defaults playwright test tests/generated.spec.ts",
    "test:gesture-corpus": "CORPUS_GROUP=gestures playwright test tests/generated.spec.ts",
    "test:resize-corpus": "CORPUS_GROUP=resize playwright test tests/generated.spec.ts",
    "test:safe-area-corpus": "CORPUS_GROUP=safe-area playwright test tests/generated.spec.ts",
    "test:lifecycle": "playwright test tests/lifecycle.spec.ts",
    "test:activation": "playwright test tests/activation.spec.ts",
    "test:sdk": "playwright test tests/sdk.spec.ts",
    "test:gestures": "playwright test tests/gestures.spec.ts",
    "test:unit": "corepack pnpm -r test:unit",
    "generate-corpus": "tsx scripts/generate-corpus.ts",
    "build:ios": "corepack pnpm -C packages/core build:native ios && corepack pnpm exec tsx scripts/sync-demo-corpus.ts ios",
    "build:macos": "corepack pnpm -C packages/core build:native macos && corepack pnpm exec tsx scripts/sync-demo-corpus.ts macos",
    "build:android": "corepack pnpm -C packages/core build:native android && corepack pnpm exec tsx scripts/sync-demo-corpus.ts android",
    "build:desktop": "corepack pnpm -C packages/core build:native desktop && corepack pnpm exec tsx scripts/sync-demo-corpus.ts desktop",
    "build:blitz-web": "tsx scripts/build-blitz-web.ts",
    "build:litehtml-web": "tsx scripts/build-litehtml-web.ts"
  },
  "devDependencies": {
    "@telegram/widget-sandbox": "workspace:*",
    "@anthropic-ai/sdk": "^0.131.0",
    "@playwright/test": "^1.63.0",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.2",
    "css-tree": "^3.2.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ws": "^8.22.0"
  }
}
