        { "start": ["c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "c9", "c10", "c11", "c12", "c13", "c14", "c15", "c16", "c17", "c18", "c19", "c20"], "animation": "a:sparkle", "keyframes": [{ "offset": 0, "boxShadow": "rgba(255, 255, 255, 0) 0px 0px 0px 9px inset" }, { "offset": 0.5, "boxShadow": "rgba(255, 255, 255, 0.5) 0px 0px 0px 9px inset" }, { "offset": 1, "boxShadow": "rgba(255, 255, 255, 0) 0px 0px 0px 9px inset" }] },
        { "check": { "heavy": 0, "backdrop": 0, "stop": null } },
        { "start": ["c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "c9", "c10", "c11", "c12", "c13", "c14", "c15", "c16", "c17"], "animation": "a:glow", "keyframes": [{ "offset": 0, "boxShadow": "rgba(255, 255, 255, 0) 0px 0px 0px 0px" }, { "offset": 1, "boxShadow": "rgba(255, 255, 255, 0.8) 0px 0px 10px 0px" }] },
        { "check": { "heavy": 17, "backdrop": 0, "stop": { "code": "paint-limit", "count": 17 } } }
      ]
    },
    {
      "name": "an animation that ends gives its box back; static and animated boxes add up",
      "steps": [
        { "set": ["s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "s9", "s10"], "style": { "display": "block", "opacity": "0.7" } },
        { "set": ["m1", "m2", "m3", "m4", "m5", "m6", "m7"], "style": { "display": "block" } },
        { "start": ["m1", "m2", "m3", "m4", "m5", "m6"], "animation": "t:box-shadow", "keyframes": [{ "offset": 0, "box-shadow": "rgba(0, 0, 0, 0) 0px 0px 0px 0px" }, { "offset": 1, "box-shadow": "rgba(0, 0, 0, 0.4) 0px 4px 12px 0px" }] },
        { "check": { "heavy": 16, "backdrop": 0, "stop": null } },
        { "end": ["m1", "m2", "m3", "m4", "m5", "m6"], "animation": "t:box-shadow" },
        { "check": { "heavy": 10, "backdrop": 0, "stop": null } },
        { "start": "s1", "animation": "t:opacity", "keyframes": [{ "offset": 0, "opacity": "0.2" }, { "offset": 1, "opacity": "1" }] },
        { "check": { "heavy": 10, "backdrop": 0, "stop": null } },
        { "start": ["m1", "m2", "m3", "m4", "m5", "m6", "m7"], "animation": "w:1", "keyframes": [{ "offset": 0, "filter": "blur(0px)" }, { "offset": 1, "filter": "blur(2px)" }] },
        { "check": { "heavy": 17, "backdrop": 0, "stop": { "code": "paint-limit", "count": 17 } } }
      ]
    },
    {
      "name": "a Web Animation counts while it runs: a paused one gives its box back",
      "steps": [
        { "set": ["c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "c9", "c10", "c11", "c12", "c13", "c14", "c15", "c16", "c17"], "style": { "display": "block" } },
        { "start": ["c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "c9", "c10", "c11", "c12", "c13", "c14", "c15", "c16", "c17"], "animation": "w:7", "keyframes": [{ "offset": 0, "opacity": "0.2", "transform": "none" }, { "offset": 1, "opacity": "1", "transform": "rotate(1turn)" }] },
        { "end": "c17", "animation": "w:7" },
        { "check": { "heavy": 16, "backdrop": 0, "stop": null } },
        { "start": "c17", "animation": "w:7", "keyframes": [{ "offset": 0, "opacity": "0.2", "transform": "none" }, { "offset": 1, "opacity": "1", "transform": "rotate(1turn)" }] },
        { "check": { "heavy": 17, "backdrop": 0, "stop": { "code": "paint-limit", "count": 17 } } }
      ]
    },
    {
      "name": "a ::before is a box of its own: 16 heavy elements and one heavy ::before stop the widget; a ::before without content does not count",
      "steps": [
        { "set": ["c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "c9", "c10", "c11", "c12", "c13", "c14", "c15", "c16"], "style": { "display": "block", "opacity": "0.8" } },
        { "set": ["c1::before", "c2::before", "c3::before"], "pseudo": true, "style": { "display": "block", "content": "none", "opacity": "0.5" } },
        { "check": { "heavy": 16, "backdrop": 0, "stop": null } },
        { "set": "c1::before", "pseudo": true, "style": { "display": "block", "content": "\"\"", "opacity": "0.5" } },
        { "check": { "heavy": 17, "backdrop": 0, "stop": { "code": "paint-limit", "count": 17 } } }
      ]
    },
    {
      "name": "two boxes with backdrop-filter run; a third stops the widget with backdrop-limit",
      "steps": [
        { "set": ["p1", "p2"], "style": { "display": "block", "backdropFilter": "blur(10px)" } },
        { "check": { "heavy": 2, "backdrop": 2, "stop": null } },
        { "set": "p3", "style": { "display": "block", "backdropFilter": "blur(10px) saturate(1.5)" } },
        { "check": { "heavy": 3, "backdrop": 3, "stop": { "code": "backdrop-limit", "count": 3 } } }
      ]
    },
    {
      "name": "an animation of backdrop-filter counts towards the backdrop limit while it runs",
      "steps": [
        { "set": ["p1", "p2"], "style": { "display": "block", "backdropFilter": "blur(10px)" } },
        { "set": "p3", "style": { "display": "block", "backdropFilter": "none" } },
        { "check": { "heavy": 2, "backdrop": 2, "stop": null } },
        { "start": "p3", "animation": "t:backdrop-filter", "keyframes": [{ "offset": 0, "backdrop-filter": "blur(0px)" }, { "offset": 1, "backdrop-filter": "blur(8px)" }] },
        { "check": { "heavy": 3, "backdrop": 3, "stop": { "code": "backdrop-limit", "count": 3 } } }
      ]
    },
    {
      "name": "past both limits at once: paint-limit, with the heavy count",
      "steps": [
        { "set": ["p1", "p2", "p3"], "style": { "display": "block", "backdropFilter": "blur(4px)" } },
        { "set": ["c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "c9", "c10", "c11", "c12", "c13", "c14"], "style": { "display": "block", "opacity": "0.9" } },
        { "check": { "heavy": 17, "backdrop": 3, "stop": { "code": "paint-limit", "count": 17 } } }
      ]
    },
    {
      "name": "the first verdict sticks: boxes that go away after it do not undo the stop",
      "steps": [
        { "set": ["c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "c9", "c10", "c11", "c12", "c13", "c14", "c15", "c16", "c17"], "style": { "display": "block", "opacity": "0.5" } },
        { "check": { "heavy": 17, "backdrop": 0, "stop": { "code": "paint-limit", "count": 17 } } },
        { "remove": ["c1", "c2", "c3"] },
        { "check": { "heavy": 14, "backdrop": 0, "stop": { "code": "paint-limit", "count": 17 } } }
      ]
    },
    {
      "name": "a theme change recomputes every box: opacity from a theme variable can make the 17th heavy",
      "steps": [
        { "set": ["c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "c9", "c10", "c11", "c12", "c13", "c14", "c15", "c16", "c17"], "style": { "display": "block", "opacity": "1" } },
        { "check": { "heavy": 0, "backdrop": 0, "stop": null } },
        { "set": ["c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "c9", "c10", "c11", "c12", "c13", "c14", "c15", "c16", "c17"], "style": { "display": "block", "opacity": "0.85" } },
        { "check": { "heavy": 17, "backdrop": 0, "stop": { "code": "paint-limit", "count": 17 } } }
      ]
    },
    {
      "name": "animation events: an end without a start changes nothing, two animations under one id need two ends",
      "steps": [
        { "set": "c1", "style": { "display": "block" } },
        { "end": "c1", "animation": "a:fade" },
        { "check": { "heavy": 0, "backdrop": 0, "stop": null } },
        { "start": "c1", "animation": "a:fade", "keyframes": [{ "offset": 0, "opacity": "0.2" }, { "offset": 1, "opacity": "1" }] },
        { "start": "c1", "animation": "a:fade", "keyframes": [{ "offset": 0, "opacity": "0.2" }, { "offset": 1, "opacity": "1" }] },
        { "end": "c1", "animation": "a:fade" },
        { "check": { "heavy": 1, "backdrop": 0, "stop": null } },
        { "end": "c1", "animation": "a:fade" },
        { "check": { "heavy": 0, "backdrop": 0, "stop": null } }
      ]
    },
    {
      "name": "a box hidden by display: none loses its CSS animations (they are cancelled); shown again it is plain until one starts",
      "steps": [
        { "set": "c1", "style": { "display": "block" } },
        { "start": "c1", "animation": "a:glow", "keyframes": [{ "offset": 0, "filter": "blur(0px)" }, { "offset": 1, "filter": "blur(2px)" }] },
        { "check": { "heavy": 1, "backdrop": 0, "stop": null } },
        { "remove": "c1" },
        { "check": { "heavy": 0, "backdrop": 0, "stop": null } },
        { "set": "c1", "style": { "display": "block" } },
        { "check": { "heavy": 0, "backdrop": 0, "stop": null } }
      ]
    },
    {
      "name": "an animation on display: contents runs but adds nothing until the element builds a box",
      "steps": [
        { "set": "c1", "style": { "display": "contents" } },
        { "start": "c1", "animation": "a:fade", "keyframes": [{ "offset": 0, "opacity": "0.2" }, { "offset": 1, "opacity": "1" }] },
        { "check": { "heavy": 0, "backdrop": 0, "stop": null } },
        { "set": "c1", "style": { "display": "block" } },
        { "check": { "heavy": 1, "backdrop": 0, "stop": null } }
      ]
    }
  ]
}
