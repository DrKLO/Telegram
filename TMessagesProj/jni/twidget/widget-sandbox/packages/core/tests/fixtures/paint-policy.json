  "cases": [
    {
      "name": "16 heavy boxes run; a 17th stops the widget (at load)",
      "steps": [
        { "set": ["html", "body"], "style": { "display": "block" } },
        { "set": ["c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "c9", "c10", "c11", "c12", "c13", "c14", "c15", "c16"], "style": { "display": "block", "boxShadow": "rgba(0, 0, 0, 0.2) 0px 2px 8px 0px" } },
        { "check": { "heavy": 16, "backdrop": 0, "stop": null } },
        { "set": "c17", "style": { "display": "block", "opacity": "0.6" } },
        { "check": { "heavy": 17, "backdrop": 0, "stop": { "code": "paint-limit", "count": 17 } } }
      ]
    },
    {
      "name": "the count is taken after the whole batch: a batch that removes two heavy boxes and adds two never holds 18",
      "steps": [
        { "set": ["c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "c9", "c10", "c11", "c12", "c13", "c14", "c15", "c16"], "style": { "display": "block", "filter": "blur(2px)" } },
        { "check": { "heavy": 16, "backdrop": 0, "stop": null } },
        { "remove": ["c1", "c2"] },
        { "set": ["n1", "n2"], "style": { "display": "block", "filter": "blur(2px)" } },
        { "check": { "heavy": 16, "backdrop": 0, "stop": null } }
      ]
    },
    {
