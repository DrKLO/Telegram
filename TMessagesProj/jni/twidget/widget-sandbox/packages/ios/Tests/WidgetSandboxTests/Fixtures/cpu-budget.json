{
  "_": "Shared fixture for src/host/cpu-budget.ts, ios CpuBudget.swift, android CpuBudget.kt and desktop cpu_budget.cpp (copies made by scripts/build-native-bundles.ts). Steps run in order on one budget: decide {kind} → expect, record {kind, cpuMs}, kill → expect boolean, used → the JS time charged at that moment (the window plus the debt; compare within 1e-9), queries [count, ms] → expect \"count\" | \"time\" | null (the layout-query limit of a task: past 128 queries the host answered, or past 1000 ms of their time in all, whatever the slice; the count first), opsCost [ops, canvasCommands] → expect ms (the modelled main-thread cost: 0.025 ms per op, 0.002 ms per canvas command; compare within 1e-9). Times in ms.",
  "cases": [
    {
      "name": "fresh window: every task gets cpuLimitMs",
      "config": {
        "cpuLimitMs": 500,
        "cpuQuotaMs": 300,
        "cpuQuotaWindowMs": 1000,
        "cpuKillAfterMs": 0
      },
      "steps": [
        {
          "at": 0,
          "decide": "timer",
          "expect": {
            "run": true,
            "sliceMs": 500
          }
        },
        {
          "at": 0,
          "decide": "frame",
          "expect": {
            "run": true,
            "sliceMs": 500
          }
        },
        {
          "at": 0,
          "decide": "event",
          "expect": {
            "run": true,
            "sliceMs": 500
          }
        },
        {
          "at": 0,
          "used": 0
        },
        {
          "at": 0,
          "kill": false
        }
      ]
    },
    {
