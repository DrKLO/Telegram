        { "up": [800, 100, 90], "expect": { "owner": "bubble", "gesture": "hold", "cancel": false, "action": "menu" } },
        { "down": [2000, 100, 50], "claim": "none", "expect": { "owner": "pending", "gesture": "press", "cancel": false } },
        { "up": [2650, 100, 50], "expect": { "owner": "widget", "gesture": "hold", "cancel": false, "event": "contextmenu" } }
      ]
    },
    {
