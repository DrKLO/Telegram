{
  "_": "Shared fixture for src/shared/gesture-policy.ts, ios GesturePolicy.swift, android GesturePolicy.kt and desktop gesture_policy.cpp (copies made by scripts/build-native-bundles.ts). constants: the thresholds every copy exports. claims: claimOf(touchActions, prevented) -> claim (touchActions: the target first, up to the widget's <html>). cases: steps on one GestureArbiter, in order: down [t, x, y] with claim = claimOf([claim]) (default \"auto\"), or the claim object `claimed` {x, y, hold} as given (what a client may build by hand), pointer (default \"touch\"), button (default 0); move / up [t, x, y]; tick t; cancel (no expectation); holdDeadline -> number or null. expect is the verdict (owner, gesture, cancel always; action, event, edge only when set) or null. x from the widget's leading edge, CSS px; t in ms.",
  "constants": {
    "TOUCH_SLOP_PX": 10,
    "HOLD_MS": 500,
    "DOUBLE_TAP_MS": 300,
    "DOUBLE_TAP_SLOP_PX": 40,
    "EDGE_STRIP_PX": 20
  },
  "claims": [
    { "touchActions": [], "prevented": false, "expect": { "x": false, "y": false, "hold": false } },
    { "touchActions": ["auto", "auto"], "prevented": false, "expect": { "x": false, "y": false, "hold": false } },
    { "touchActions": ["manipulation"], "prevented": false, "expect": { "x": false, "y": false, "hold": false } },
    { "touchActions": ["none"], "prevented": false, "expect": { "x": true, "y": false, "hold": true } },
    { "touchActions": ["auto", "none", "auto"], "prevented": false, "expect": { "x": true, "y": false, "hold": true } },
    { "touchActions": ["auto", "auto", "none"], "prevented": false, "expect": { "x": true, "y": false, "hold": true } },
    { "touchActions": ["pan-y"], "prevented": false, "expect": { "x": true, "y": false, "hold": false } },
    { "touchActions": ["pan-x"], "prevented": false, "expect": { "x": false, "y": false, "hold": false } },
    { "touchActions": ["pan-up"], "prevented": false, "expect": { "x": true, "y": false, "hold": false } },
    { "touchActions": ["pan-right"], "prevented": false, "expect": { "x": false, "y": false, "hold": false } },
    { "touchActions": ["pan-y pinch-zoom"], "prevented": false, "expect": { "x": true, "y": false, "hold": false } },
    { "touchActions": ["pan-left pan-down"], "prevented": false, "expect": { "x": false, "y": false, "hold": false } },
    { "touchActions": ["pan-x pan-y"], "prevented": false, "expect": { "x": false, "y": false, "hold": false } },
    { "touchActions": ["pinch-zoom"], "prevented": false, "expect": { "x": true, "y": false, "hold": false } },
    { "touchActions": ["pan-x", "pan-y"], "prevented": false, "expect": { "x": true, "y": false, "hold": false } },
    { "touchActions": ["pan-y", "pan-x"], "prevented": false, "expect": { "x": true, "y": false, "hold": false } },
    { "touchActions": ["pan-x", "auto"], "prevented": false, "expect": { "x": false, "y": false, "hold": false } },
    { "touchActions": [" PAN-Y "], "prevented": false, "expect": { "x": true, "y": false, "hold": false } },
    { "touchActions": ["auto"], "prevented": true, "expect": { "x": true, "y": false, "hold": false } },
    { "touchActions": ["pan-x"], "prevented": true, "expect": { "x": true, "y": false, "hold": false } },
    { "touchActions": ["none"], "prevented": true, "expect": { "x": true, "y": false, "hold": true } }
  ],
  "cases": [
    {
      "name": "a tap on auto is the widget's",
      "steps": [
        { "down": [0, 100, 50], "expect": { "owner": "pending", "gesture": "press", "cancel": false } },
        { "holdDeadline": 500 },
        { "move": [40, 104, 53], "expect": { "owner": "pending", "gesture": "press", "cancel": false } },
        { "up": [80, 104, 53], "expect": { "owner": "widget", "gesture": "tap", "cancel": false } },
        { "holdDeadline": null }
      ]
    },
    {
      "name": "a hold on auto is the bubble's menu: the widget is cancelled once",
      "steps": [
        { "down": [1000, 100, 50], "expect": { "owner": "pending", "gesture": "press", "cancel": false } },
        { "tick": 1499, "expect": { "owner": "pending", "gesture": "press", "cancel": false } },
        { "tick": 1500, "expect": { "owner": "bubble", "gesture": "hold", "cancel": true, "action": "menu" } },
        { "holdDeadline": null },
        { "tick": 1600, "expect": { "owner": "bubble", "gesture": "hold", "cancel": false, "action": "menu" } },
        { "move": [1700, 140, 50], "expect": { "owner": "bubble", "gesture": "hold", "cancel": false, "action": "menu" } },
        { "up": [1900, 140, 50], "expect": { "owner": "bubble", "gesture": "hold", "cancel": false, "action": "menu" } },
        { "move": [1950, 140, 50], "expect": null },
        { "tick": 2000, "expect": null }
      ]
    },
    {
