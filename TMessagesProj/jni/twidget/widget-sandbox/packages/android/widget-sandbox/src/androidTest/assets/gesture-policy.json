        { "down": [2000, 100, 50], "claim": "pan-x", "expect": { "owner": "pending", "gesture": "press", "cancel": false } },
        { "tick": 2500, "expect": { "owner": "bubble", "gesture": "hold", "cancel": true, "action": "menu" } }
