      "steps": [
        { "down": [0, 100, 50], "claim": "none", "expect": { "owner": "pending", "gesture": "press", "cancel": false } },
        { "up": [60, 100, 50], "expect": { "owner": "widget", "gesture": "tap", "cancel": false } },
        { "down": [200, 100, 50], "claim": "none", "expect": { "owner": "pending", "gesture": "press", "cancel": false } },
        { "up": [260, 100, 50], "expect": { "owner": "widget", "gesture": "double-tap", "cancel": false, "event": "dblclick" } }
      ]
