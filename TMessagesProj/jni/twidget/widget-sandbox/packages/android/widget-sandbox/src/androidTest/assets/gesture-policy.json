        { "move": [5020, 100, 90], "expect": { "owner": "widget", "gesture": "drag-y", "cancel": false } }
      ]
    },
    {
      "name": "mouse: a right click is the menu on auto, contextmenu on none",
      "steps": [
        { "down": [0, 100, 50], "pointer": "mouse", "button": 2, "expect": { "owner": "bubble", "gesture": "menu-click", "cancel": true, "action": "menu" } },
        { "move": [20, 100, 80], "expect": { "owner": "bubble", "gesture": "menu-click", "cancel": false, "action": "menu" } },
        { "up": [80, 100, 80], "expect": { "owner": "bubble", "gesture": "menu-click", "cancel": false, "action": "menu" } },
        { "down": [1000, 100, 50], "claim": "none", "pointer": "mouse", "button": 2, "expect": { "owner": "widget", "gesture": "menu-click", "cancel": false, "event": "contextmenu" } },
        { "up": [1080, 100, 50], "expect": { "owner": "widget", "gesture": "menu-click", "cancel": false } },
        { "down": [1100, 100, 50], "claim": "none", "pointer": "mouse", "expect": { "owner": "pending", "gesture": "press", "cancel": false } },
        { "up": [1150, 100, 50], "expect": { "owner": "widget", "gesture": "tap", "cancel": false } }
      ]
    },
    {
      "name": "mouse: a double click is the widget's dblclick on any element, also at the leading edge",
      "steps": [
        { "down": [0, 100, 50], "pointer": "mouse", "expect": { "owner": "pending", "gesture": "press", "cancel": false } },
        { "up": [50, 100, 50], "expect": { "owner": "widget", "gesture": "tap", "cancel": false } },
        { "down": [150, 100, 50], "pointer": "mouse", "expect": { "owner": "pending", "gesture": "press", "cancel": false } },
        { "up": [200, 100, 50], "expect": { "owner": "widget", "gesture": "double-tap", "cancel": false, "event": "dblclick" } },
        { "down": [1000, 5, 50], "claim": "none", "pointer": "mouse", "expect": { "owner": "pending", "gesture": "press", "cancel": false } },
        { "up": [1050, 5, 50], "expect": { "owner": "widget", "gesture": "tap", "cancel": false } },
        { "down": [1150, 5, 50], "claim": "none", "pointer": "mouse", "expect": { "owner": "pending", "gesture": "press", "cancel": false } },
        { "up": [1200, 5, 50], "expect": { "owner": "widget", "gesture": "double-tap", "cancel": false, "event": "dblclick" } }
      ]
    },
    {
      "name": "a new pointerdown replaces a press still open",
      "steps": [
        { "down": [0, 100, 50], "expect": { "owner": "pending", "gesture": "press", "cancel": false } },
        { "down": [100, 200, 50], "claim": "none", "expect": { "owner": "pending", "gesture": "press", "cancel": false } },
        { "holdDeadline": 600 },
        { "tick": 599, "expect": { "owner": "pending", "gesture": "press", "cancel": false } },
        { "tick": 600, "expect": { "owner": "widget", "gesture": "hold", "cancel": false, "event": "contextmenu" } }
      ]
    },
    {
      "name": "nothing open: move, up and tick answer null",
      "steps": [
        { "move": [0, 10, 10], "expect": null },
        { "up": [0, 10, 10], "expect": null },
        { "tick": 1000, "expect": null },
        { "holdDeadline": null }
      ]
    }
  ]
