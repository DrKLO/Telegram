<div class="card pad co"><b>Weekly retention by signup cohort</b><div class="small muted">Week-1 retention holds at about 55% across the last nine cohorts (Aug 4 – Sep 29).</div></div>
<script>
const MODES = [
  { label: 'Weekly', head: 'W', cohorts: [
    ['Aug 4', 1840, [100, 55, 48, 40, 35, 30, 25, 22, 17]],
    ['Aug 11', 1922, [100, 56, 50, 42, 36, 30, 28, 24]],
    ['Aug 18', 2015, [100, 54, 46, 41, 36, 33, 29]],
    ['Aug 25', 1876, [100, 58, 51, 47, 43, 38]],
    ['Sep 1', 2240, [100, 57, 50, 46, 41]],
    ['Sep 8', 2391, [100, 58, 52, 46]],
    ['Sep 15', 2410, [100, 56, 49]],
    ['Sep 22', 2532, [100, 58]],
    ['Sep 29', 2688, [100]],
  ] },
  { label: 'Monthly', head: 'M', cohorts: [
    ['Apr', 7410, [100, 41, 33, 29, 26, 24]],
    ['May', 7980, [100, 42, 34, 30, 27]],
    ['Jun', 8240, [100, 40, 33, 29]],
    ['Jul', 8610, [100, 43, 35]],
    ['Aug', 7653, [100, 44]],
    ['Sep', 12261, [100]],
  ] },
];
MODES.forEach(M => {
  M.cols = M.cohorts[0][2].length;
  M.avg = Array.from({ length: M.cols }, (_, c) => {
    let w = 0, s = 0;
    for (const [, n, v] of M.cohorts) if (c < v.length) { w += n; s += n * v[c]; }
    return s / w;
  });
});
const group = n => String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
const fmtN = v => v >= 10000 ? (v / 1000).toFixed(1) + 'k' : group(v);

let mode = 0, users = false, row = -1, intro = 0, introRun = 0;
const view = { dim: 0, draw: 1 };
const cellP = (r, c) => ease.outCubic(clamp((intro * 900 - (r + c) * 35) / 330, 0, 1));

function play() {
  const me = ++introRun;
  animate(900, (_, t) => { if (me === introRun) intro = t; }, ease.linear);
}
setTimeout(play, 250);

function onAction(name, value) {
  if (name === 'mode') {
    const k = Number(value);
    if (k === mode) return;
    transition('fade');
    mode = k;
    row = -1;
    view.dim = 0;
    play();
  } else if (name === 'units') {
    transition('fade');
    users = !users;
  } else if (name === 'row') {
    const r = Number(value);
    if (!(r >= 0 && r < MODES[mode].cohorts.length)) return;
    transition('fade');
    if (r === row) { row = -1; tween(view, { dim: 0 }, 300); return; }
    row = r;
    tween(view, { dim: 1 }, 350);
    view.draw = 0;
    tween(view, { draw: 1 }, 700, ease.inOutCubic);
  } else if (name === 'close' && row >= 0) {
    transition('fade');
    row = -1;
    tween(view, { dim: 0 }, 300);
  }
}

function curve(M, v) {
  const w = 150, h = 56, X = c => 5 + c / (M.cols - 1) * (w - 10), Y = p => 5 + (1 - p / 100) * (h - 10);
  const avg = M.avg.map((p, c) => `${X(c).toFixed(1)},${Y(p).toFixed(1)}`).join(' ');
  const n = (v.length - 1) * view.draw, whole = Math.floor(n);
  const pts = [];
  for (let c = 0; c <= whole; c++) pts.push([X(c), Y(v[c])]);
  if (n > whole) pts.push([X(n), Y(lerp(v[whole], v[whole + 1], n - whole))]);
  const line = pts.map(p => p[0].toFixed(1) + ',' + p[1].toFixed(1)).join(' ');
  let body = `<polyline fill='none' stroke='#8e8e93' stroke-width='1.5' stroke-dasharray='3 3' points='${avg}'/>`;
  if (pts.length > 1) body += `<polyline fill='none' stroke='#5856d6' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round' points='${line}'/>`;
  body += pts.map(([x, y]) => `<circle cx='${x.toFixed(1)}' cy='${y.toFixed(1)}' r='2.5' fill='#5856d6'/>`).join('');
  return 'data:image/svg+xml;utf8,' + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='${w}' height='${h}'>${body}</svg>`);
}

function detail(M) {
  const [name, n, v] = M.cohorts[row], last = v.length - 1;
  const lines = [];
  if (last === 0) lines.push('Signed up this ' + (mode ? 'month' : 'week') + '.', 'First retention reading next ' + (mode ? 'month' : 'week') + '.');
  else {
    const d1 = v[1] - M.avg[1], dl = v[last] - M.avg[last];
    const vs = d => `<span class="${d >= 0 ? 't-green' : 't-red'}">${d >= 0 ? '+' : '−'}${Math.abs(d).toFixed(1)} pp</span>`;
    lines.push(`${M.head}1 <b>${v[1]}%</b> · ${vs(d1)} vs average`);
    lines.push(`${M.head}${last} <b>${v[last]}%</b> · ${vs(dl)} vs average`);
    lines.push(`<b>${group(n * v[last] / 100)}</b> of ${group(n)} still active`);
  }
  return `<div class="det">
    <div class="row"><b class="grow">${name} cohort</b><span class="small muted">${group(n)} sign-ups</span><span class="x" data-action="close">×</span></div>
    <div class="row" style="margin-top: 6px; align-items: flex-start"><img src="${curve(M, v)}" width="150" height="56">
      <div class="small grow" style="margin-left: 10px; line-height: 1.55">${lines.join('<br>')}</div></div>
    <div class="tiny muted" style="margin-top: 2px">━ this cohort · ┄ average of all cohorts</div>
  </div>`;
}

function render() {
  const M = MODES[mode];
  const head = `<tr><th style="text-align: left; padding-left: 4px">Cohort</th>${M.avg.map((_, c) => `<th>${M.head}${c}</th>`).join('')}</tr>`;
  const rows = M.cohorts.map(([name, n, v], r) => {
    const on = row < 0 || row === r, fade = on ? 1 : 1 - 0.65 * view.dim;
    const cells = M.avg.map((_, c) => {
      if (c >= v.length) return '<td class="na">&nbsp;</td>';
      const p = cellP(r, c), a = (0.06 + 0.87 * v[c] / 100) * p * fade;
      const white = v[c] >= 45 && p > 0.6 && fade > 0.7;
      return `<td style="background-color: rgba(88,86,214,${a.toFixed(3)});${white ? ' color: #ffffff;' : ''}">${users ? fmtN(n * v[c] / 100 * p) : Math.round(v[c] * p) + '%'}</td>`;
    }).join('');
    return `<tr class="r${row === r ? ' on' : ''}${on ? '' : ' dm'}" data-action="row" data-value="${r}"><td class="cn">${row === r ? '▸ ' : ''}${name}</td>${cells}</tr>`;
  }).join('');
  const avg = `<tr class="avg"><td class="cn">Avg</td>${M.avg.map((a, c) => `<td>${Math.round(a * cellP(M.cohorts.length - 1, c))}%</td>`).join('')}</tr>`;
  const tabs = MODES.map((m, k) => `<span class="${k === mode ? 'on' : ''}" data-action="mode" data-value="${k}">${m.label}</span>`).join('');
  return `<div class="card pad co">
    <div class="row"><b class="grow" style="font-size: 16px">Retention by cohort</b><span class="badge purple">${M.head}1 ≈ ${Math.round(M.avg[1])}%</span></div>
    <div class="row between" style="margin-top: 6px"><span class="seg">${tabs}</span><span class="tog" data-action="units">${users ? 'Show %' : 'Show users'}</span></div>
    <table>${head}${rows}${avg}</table>
    ${row >= 0 ? detail(M) : `<div class="tiny muted" style="margin-top: 4px">${users ? 'Users still active from each cohort' : 'Share of each cohort still active'} · click a cohort to highlight it</div>`}
  </div>`;
}
</script>

