<div class="card pad fn"><b>Conversion funnel</b><div class="small muted">182,400 visits → 69,312 sign-ups → 38,304 first messages → 13,498 subscribers → 9,302 still active after 90 days (5.1%)</div></div>
<script>
const STEPS = ['Visited site', 'Signed up', 'Sent first message', 'Subscribed', 'Still active after 90 days'];
const COLORS = ['#5856d6', '#6a5ae0', '#7d5ce8', '#af52de', '#ff2d55'];
const DATA = {
  all: [[182400, 69312, 38304, 13498, 9302], [182400, 84816, 45800, 15960, 10940]],
  desktop: [[78400, 36064, 21280, 8190, 5700], [78400, 39200, 23100, 8790, 6120]],
  mobile: [[104000, 33248, 17024, 5308, 3602], [104000, 45616, 22700, 7170, 4820]],
};
const DEVICES = [['all', 'All devices'], ['desktop', 'Desktop'], ['mobile', 'Mobile']];
const VARIANTS = ['Variant A · current sign-up form', 'Variant B · one-tap sign-in'];
const WHY = [
  ['Where visitors come from', [['Search', 46, '#5856d6'], ['Social', 31, '#ff9500'], ['Direct', 23, '#30b0c7']]],
  ['Why they didn’t sign up', [['Bounced on the landing page', 48, '#ff3b30'], ['Left the sign-up form', 34, '#ff9500'], ['Chose “maybe later”', 18, '#8e8e93']]],
  ['Why no first message', [['Never opened the app again', 41, '#ff3b30'], ['No contacts on LiteChat yet', 37, '#ff9500'], ['Skipped onboarding', 22, '#8e8e93']]],
  ['Why they didn’t subscribe', [['The free plan is enough', 58, '#ff3b30'], ['Price', 27, '#ff9500'], ['Trial ended unnoticed', 15, '#8e8e93']]],
  ['Why they left within 90 days', [['Cancelled', 46, '#ff3b30'], ['Payment failed', 31, '#ff9500'], ['Went inactive', 23, '#8e8e93']]],
];
const group = n => String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
const width = s => 10 * Math.min(1, s * 20) + 90 * s;

let device = 'all', variant = 0, open = -1, run = 0;
let N = Array(5).fill(0), S = Array(5).fill(0);
const view = { det: 0, ghost: 0 };

function morph(ms, stagger) {
  const d = DATA[device][variant], fromN = N.slice(), fromS = S.slice(), me = ++run, total = ms + stagger * 4;
  return animate(total, (_, t) => {
    if (me !== run) return;
    for (let i = 0; i < 5; i++) {
      const p = ease.outCubic(clamp((t * total - i * stagger) / ms, 0, 1));
      N[i] = lerp(fromN[i], d[i], p);
      S[i] = lerp(fromS[i], d[i] / d[0], p);
    }
  }, ease.linear);
}
setTimeout(() => morph(620, 70), 250);
setTimeout(() => tween(view, { ghost: 1 }, 500), 1150);

function onAction(name, value) {
  if (name === 'variant') {
    const v = Number(value);
    if (v !== variant) { variant = v; morph(560, 45); }
  } else if (name === 'device') {
    if (value !== device && DATA[value]) { device = value; morph(560, 45); }
  } else if (name === 'step') {
    const i = Number(value);
    transition('fade');
    if (open === i) { open = -1; return; }
    open = i;
    view.det = 0;
    tween(view, { det: 1 }, 550);
  } else if (name === 'close' && open >= 0) {
    transition('fade');
    open = -1;
  }
}

function detail(i) {
  const [title, items] = WHY[i], d = DATA[device];
  const lost = i ? N[i - 1] - N[i] : N[0];
  const rate = v => (d[v][i] / d[v][i - 1] * 100).toFixed(1) + '%';
  return `<div class="det">
    <div class="row"><b class="grow">${title}</b><span class="tiny muted">${i ? `${group(lost)} people lost` : `${group(N[0])} visitors`}</span><span class="x" data-action="close">×</span></div>
    <div class="stk">${items.map(([, p, c]) => `<div style="width: ${(p * view.det).toFixed(2)}%; background-color: ${c}"></div>`).join('')}</div>
    <div class="rs">${items.map(([n, p, c]) => `<div><i style="background-color: ${c}"></i><span class="grow">${n}</span><b>${i ? group(lost * p / 100 * view.det) : Math.round(p * view.det) + '%'}</b></div>`).join('')}</div>
    ${i ? `<div class="tiny muted" style="margin-top: 5px">Step conversion · A <b class="fg">${rate(0)}</b> · B <b class="fg">${rate(1)}</b></div>` : ''}
  </div>`;
}

function stepView(i) {
  const d = DATA[device], cur = d[variant], other = d[1 - variant];
  const ow = width(other[i] / other[0]) * view.ghost;
  const a = ((100 - ow) / 2).toFixed(2), b = ((100 + ow) / 2).toFixed(2);
  const ghost = ow > 0.5 ? `background: linear-gradient(90deg, rgba(127,127,127,0) ${a}%, rgba(127,127,127,0.22) ${a}%, rgba(127,127,127,0.22) ${b}%, rgba(127,127,127,0) ${b}%)` : '';
  const delta = i && variant === 1 ? (cur[i] / cur[0] - other[i] / other[0]) * 100 : null;
  const drop = i && N[i - 1] > 0 ? (1 - N[i] / N[i - 1]) * 100 : 0;
  return `${i ? `<div class="drop">▼ ${Math.round(drop)}% drop-off</div>` : ''}
    <div class="stp${open === i ? ' on' : ''}" data-action="step" data-value="${i}">
      <div class="fl"><b class="grow">${STEPS[i]}</b>${delta === null ? '' : `<span class="tiny ${delta < 0 ? 't-red' : 't-green'}" style="margin-right: 6px">${delta < 0 ? '−' : '+'}${Math.abs(delta).toFixed(1)} pp vs A</span>`}<span class="muted">${group(N[i])}</span></div>
      <div class="trk" style="${ghost}"><div class="fs" style="width: ${width(S[i]).toFixed(2)}%; background-color: ${COLORS[i]}">${(S[i] * 100).toFixed(S[i] < 0.1 ? 1 : 0)}%</div></div>
    </div>${open === i ? detail(i) : ''}`;
}

function render() {
  const d = DATA[device], overall = N[0] ? N[4] / N[0] * 100 : 0;
  const lift = (d[1][4] / d[1][0] - d[0][4] / d[0][0]) * 100;
  return `<div class="card pad fn">
    <div class="row between"><b style="font-size: 16px">Conversion funnel</b><span class="seg">${['A · Control', 'B · One-tap'].map((v, k) =>
      `<span class="${k === variant ? 'on' : ''}" data-action="variant" data-value="${k}">${v}</span>`).join('')}</span></div>
    <div class="tiny muted" style="margin: 2px 0 8px 0">${VARIANTS[variant]} · click a step for details</div>
    <div class="chips" style="margin-bottom: 6px">${DEVICES.map(([k, l]) => `<span class="${k === device ? 'on' : ''}" data-action="device" data-value="${k}">${l}</span>`).join('')}</div>
    ${STEPS.map((_, i) => stepView(i)).join('')}
    <div class="sum"><div class="grow"><div class="caps">Visit → active after 90 days</div><b style="font-size: 22px">${overall.toFixed(2)}%</b></div>
      <div class="right"><span class="badge green">B lifts it by ${lift.toFixed(1)} pp</span><div class="tiny muted" style="margin-top: 3px">Grey band: variant ${variant ? 'A' : 'B'}</div></div></div>
  </div>`;
}
</script>

