<div class="card pad lb"><b>🏆 Sales leaderboard · October</b><div class="small muted">1. Ava Chen 9,800 · 2. Liam Haddad 9,699 · 3. Mia Nielsen 9,477 · 4. Noah Okafor 9,352 · 5. Zoe Larsen 9,274</div></div>
<script>
const REPS = [
  ['Ava Chen', '#ff2d55', 9800], ['Liam Haddad', '#ff9500', 9699], ['Mia Nielsen', '#34c759', 9477], ['Noah Okafor', '#007aff', 9352],
  ['Zoe Larsen', '#5856d6', 9274], ['Ethan Ivanova', '#af52de', 9195], ['Ivy Novak', '#30b0c7', 9051], ['Lucas Tanaka', '#a2845e', 8996],
  ['Nora Costa', '#ff3b30', 8759], ['Omar Silva', '#32ade6', 8622], ['Priya Dubois', '#ff2d55', 8506], ['Kenji Weber', '#ff9500', 8275],
  ['Lena Kim', '#34c759', 8179], ['Mateo Kowalski', '#007aff', 8132], ['Sara Singh', '#5856d6', 7919], ['Theo Müller', '#af52de', 7847],
  ['Yara Ahmed', '#30b0c7', 7656], ['Hugo Moreau', '#a2845e', 7452], ['Aisha Rossi', '#ff3b30', 7366], ['Felix Garcia', '#32ade6', 7243],
  ['Chloe Chen', '#ff2d55', 7117], ['Diego Haddad', '#ff9500', 7013], ['Elif Nielsen', '#34c759', 6782], ['Finn Okafor', '#007aff', 6685],
].map(([name, color, pts]) => ({ name, color, pts, init: name.split(' ').map(s => s[0]).join('') }));
let seed = 40;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const group = n => String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
const METRICS = [
  { label: 'Points', color: '#5856d6', fmt: v => group(v) },
  { label: 'Deals', color: '#34c759', fmt: v => String(Math.round(v)) },
  { label: 'Revenue', color: '#ff9500', fmt: v => '€' + (v / 1000).toFixed(v >= 100000 ? 0 : 1) + 'k' },
];
const PERIODS = [
  { label: 'Week', badge: 'Week 40', k: 0.24 },
  { label: 'Month', badge: 'October', k: 1 },
  { label: 'Quarter', badge: 'Q3 2026', k: 2.85 },
];
REPS.forEach(r => {
  const skill = r.pts / 9800;
  r.vals = PERIODS.map((P, p) => {
    const pts = p === 1 ? r.pts : r.pts * P.k * (0.86 + 0.28 * rnd());
    const deals = Math.max(1, Math.round(44 * P.k * skill * (0.75 + 0.5 * rnd())));
    return [pts, deals, deals * (3200 + 2200 * rnd())];
  });
  r.prev = r.vals.map(v => v.map(x => x * (0.85 + 0.3 * rnd())));
  r.win = 22 + Math.round(rnd() * 18);
  r.hist = Array.from({ length: 8 }, () => 0.45 + 0.55 * rnd());
});

const ROW = 38, EXP = 46;
let metric = 0, period = 1, limit = 10, open = -1, order = [], trend = [], run = 0;
const S = REPS.map(() => 0), V = REPS.map(() => 0), B = REPS.map(() => 0), EX = REPS.map(() => ({ e: 0 }));
const view = { lim: 10 };

const rankBy = key => REPS.map((_, i) => i).sort((a, b) => REPS[b][key][period][metric] - REPS[a][key][period][metric]);
function rerank() {
  order = rankBy('vals');
  const prev = rankBy('prev');
  trend = REPS.map((_, i) => prev.indexOf(i) - order.indexOf(i));
}
rerank();
order.forEach((i, pos) => { S[i] = pos + 10; });

function relayout(ms, stagger, fresh, easing) {
  rerank();
  const lead = REPS[order[0]].vals[period][metric];
  const fromS = S.slice(), fromV = fresh ? REPS.map(() => 0) : V.slice(), fromB = B.slice();
  const toS = [], toV = REPS.map(r => r.vals[period][metric]), toB = toV.map(v => v / lead);
  order.forEach((i, pos) => { toS[i] = pos; });
  const me = ++run, total = ms + stagger * 12;
  animate(total, (_, t) => {
    if (me !== run) return;
    for (let i = 0; i < REPS.length; i++) {
      const p = easing(clamp((t * total - Math.min(toS[i], 12) * stagger) / ms, 0, 1));
      S[i] = lerp(fromS[i], toS[i], p);
      V[i] = lerp(fromV[i], toV[i], p);
      B[i] = lerp(fromB[i], toB[i], p);
    }
  }, ease.linear);
}
setTimeout(() => relayout(560, 26, true, ease.outCubic), 250);

function onAction(name, value) {
  if (name === 'metric' || name === 'period') {
    const v = Number(value);
    if (v === (name === 'metric' ? metric : period)) return;
    if (name === 'metric') metric = v; else period = v;
    relayout(600, 22, name === 'metric', ease.inOutCubic);
  } else if (name === 'open') {
    const i = Number(value);
    if (!(i >= 0 && i < REPS.length)) return;
    if (open >= 0) tween(EX[open], { e: 0 }, 300, ease.inOutCubic);
    open = open === i ? -1 : i;
    if (open >= 0) tween(EX[open], { e: 1 }, 380, ease.outCubic);
  } else if (name === 'more') {
    limit = limit === 10 ? 20 : 10;
    tween(view, { lim: limit }, 520, ease.inOutCubic);
  }
}

function yOf(i) {
  let y = S[i] * ROW;
  for (let k = 0; k < REPS.length; k++) if (k !== i && EX[k].e > 0) y += EXP * EX[k].e * clamp(S[i] - S[k], 0, 1);
  return y;
}

function spark(vals, color) {
  const pts = vals.map((v, i) => `${(2 + i * 60 / (vals.length - 1)).toFixed(1)},${(26 - v * 22).toFixed(1)}`).join(' ');
  return 'data:image/svg+xml;utf8,' + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='64' height='28'><polyline fill='none' stroke='${color}' stroke-width='2' stroke-linejoin='round' stroke-linecap='round' points='${pts}'/></svg>`);
}

function stats(i) {
  const r = REPS[i], [pts, deals, rev] = r.vals[period];
  const box = (k, v) => `<div><div class="tiny muted">${k}</div><b>${v}</b></div>`;
  return `<div class="more">${box('Deals', deals)}${box('Avg deal', '€' + (rev / deals / 1000).toFixed(1) + 'k')}${box('Win rate', r.win + '%')}${box('Quota', Math.round(pts / (PERIODS[period].k * 9000) * 100) + '%')}
    <img src="${spark(r.hist, r.color)}" width="64" height="28"></div>`;
}

function rowHTML(i, y) {
  const r = REPS[i], M = METRICS[metric], pos = order.indexOf(i), e = EX[i].e, t = trend[i];
  const tr = t > 0 ? `<span class="t-green">▲${t}</span>` : t < 0 ? `<span class="t-red">▼${-t}</span>` : '<span class="muted">–</span>';
  return `<div class="rw${i === open ? ' open' : ''}" data-action="open" data-value="${i}" style="top: ${y.toFixed(1)}px; height: ${(ROW + EXP * e).toFixed(1)}px">
    <div class="mn"><span class="rk">${pos < 3 ? ['🥇', '🥈', '🥉'][pos] : pos + 1}</span><span class="nm"><span class="av" style="background-color: ${r.color}; margin-right: 8px">${r.init}</span>${esc(r.name)}</span>
      <div class="mini"><div style="width: ${(B[i] * 100).toFixed(1)}%; background-color: ${M.color}"></div></div><span class="pts">${M.fmt(V[i])}</span><span class="tr">${tr}</span></div>
    ${e > 0.02 ? stats(i) : ''}
  </div>`;
}

function render() {
  const M = METRICS[metric], P = PERIODS[period];
  let extra = 0;
  for (let k = 0; k < REPS.length; k++) if (EX[k].e > 0) extra += EXP * EX[k].e * clamp(view.lim - S[k], 0, 1);
  const height = view.lim * ROW + extra;
  let rows = '';
  for (let i = 0; i < REPS.length; i++) { const y = yOf(i); if (y < height) rows += rowHTML(i, y); }
  const tabs = (list, cur, action) => `<span class="seg">${list.map((x, k) =>
    `<span class="${k === cur ? 'on' : ''}" data-action="${action}" data-value="${k}">${x.label}</span>`).join('')}</span>`;
  return `<div class="card lb">
    <div class="hd"><div class="row"><b class="grow" style="font-size: 16px">🏆 Sales leaderboard</b><span class="badge purple">${P.badge}</span></div>
      <div class="row between" style="margin-top: 8px">${tabs(METRICS, metric, 'metric')}${tabs(PERIODS, period, 'period')}</div></div>
    <div class="th"><span style="width: 30px; text-align: center">#</span><span class="grow">Rep · click for stats</span><span style="width: 100px">vs leader</span><span style="width: 64px; text-align: right">${M.label}</span><span style="width: 38px">&nbsp;</span></div>
    <div class="list" style="height: ${height.toFixed(1)}px">${rows}</div>
    <a class="sh t-purple" href="#" data-action="more">${limit === 10 ? 'Show top 20 ▾' : 'Show top 10 ▴'}</a>
  </div>`;
}
</script>

