<p>📊 <b>Weekly report</b> for <b>LiteChat</b> · 29 Sep – 5 Oct 2026. Everything below is plain HTML and CSS — no images except four tiny inline SVG sparklines.</p>

--- bot 09:00 bare
<style>
  .kp { width: 390px; max-width: 100%; }
  .kp .seg { display: inline-block; padding: 2px; border-radius: 9px; background-color: rgba(127,127,127,0.14); }
  .kp .seg span { display: inline-block; padding: 3px 10px; border-radius: 7px; font-size: 12px; font-weight: 700; }
  .kp .seg span:hover { background-color: rgba(127,127,127,0.22); }
  .kp .seg span.on { background-color: #5856d6; color: #ffffff; }
  .kp .tiles { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 10px; }
  .kp .kt { width: 168px; padding: 9px 11px 7px 11px; margin-bottom: 8px; border-radius: 12px; border: 1px solid rgba(127,127,127,0.2); background-color: rgba(127,127,127,0.04); }
  .kp .kt:hover { background-color: rgba(127,127,127,0.11); border-color: rgba(127,127,127,0.42); }
  .kp .dot { display: inline-block; width: 7px; height: 7px; border-radius: 4px; margin-right: 5px; }
  .kp .big { font-size: 22px; font-weight: 800; }
  .kp .hero { font-size: 34px; font-weight: 800; line-height: 40px; }
  .kp .back { font-size: 13px; font-weight: 600; }
  .kp .nav { display: inline-block; width: 24px; padding: 2px 0; text-align: center; border-radius: 7px; font-weight: 700; }
  .kp .nav:hover { background-color: rgba(127,127,127,0.2); }
  .kp .st { display: flex; margin-top: 8px; }
  .kp .st > div { flex-grow: 1; flex-basis: 0; padding: 6px 9px; margin-right: 6px; border-radius: 9px; background-color: rgba(127,127,127,0.09); }
  .kp .st > div:last-child { margin-right: 0; }
  .kp .note { margin-top: 8px; padding: 7px 10px; border-radius: 9px; }
</style>
<div class="card pad kp"><b>Key numbers · week 40</b><div class="small muted">Active users 48,213 (+12.4%) · Revenue €182.4k (+8.1%) · Conversion 3.42% (−0.3 pp) · NPS 61 (+4)</div></div>
<script>
const PERIODS = [
  { label: 'Day', vs: 'vs yesterday', from: '24 h ago', to: 'now' },
  { label: 'Week', vs: 'vs previous week', from: '14 days ago', to: 'today' },
  { label: 'Month', vs: 'vs previous month', from: '14 weeks ago', to: 'this week' },
];
const group = n => String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
const KPIS = [
  { name: 'Active users', color: '#007aff', kind: 'pct', fmt: v => group(v), data: [[9874, 3.1], [48213, 12.4], [61540, 18.7]],
    note: 'Eighth week of growth in a row. Germany and the US bring in over a third of all usage.' },
  { name: 'Revenue', color: '#34c759', kind: 'pct', fmt: v => '€' + (v / 1000).toFixed(1) + 'k', data: [[27900, 5.6], [182400, 8.1], [702300, 11.3]],
    note: 'On track: 72% of the Q4 goal with 12 weeks to go.' },
  { name: 'Conversion', color: '#ff9500', kind: 'pp', fmt: v => v.toFixed(2) + '%', data: [[3.51, 0.1], [3.42, -0.3], [3.38, -0.5]],
    note: 'The dip is on mobile: social traffic is 41% of visits there and converts at half the desktop rate.' },
  { name: 'NPS', color: '#af52de', kind: 'abs', fmt: v => String(Math.round(v)), data: [[63, 2], [61, 4], [58, 6]],
    note: 'Up since the onboarding changes. Detractors still mention sign-in friction.' },
];

function makeSeries(k, p) {
  const [v, d] = KPIS[k].data[p];
  const start = KPIS[k].kind === 'pct' ? v / (1 + d / 100) : v - d;
  const amp = Math.abs(v - start) * 0.5 + Math.abs(v) * 0.015;
  const ph = k * 1.9 + p * 2.7;
  return Array.from({ length: 14 }, (_, i) => {
    const t = i / 13;
    const wiggle = Math.sin(t * 8.3 + ph) * 0.65 + Math.sin(t * 19.1 + ph * 1.6) * 0.35;
    return lerp(start, v, ease.inOutSine(t)) + amp * wiggle * Math.sin(Math.PI * t);
  });
}
const SERIES = KPIS.map((_, k) => PERIODS.map((_, p) => makeSeries(k, p)));

let period = 1, focus = -1, intro = 0, reveal = 1, morphRun = 0, revealRun = 0;
const cur = KPIS.map((K, k) => ({ v: K.data[1][0], s: SERIES[k][1].slice() }));
const tileP = k => ease.outCubic(clamp((intro * 900 - k * 80) / 660, 0, 1));

function deltaText(k) {
  const d = KPIS[k].data[period][1], a = Math.abs(d);
  return (d < 0 ? '−' : '+') + (KPIS[k].kind === 'pct' ? a.toFixed(1) + '%' : KPIS[k].kind === 'pp' ? a.toFixed(1) + ' pp' : a);
}

function chart(vals, color, w, h, shown, big) {
  const lo = Math.min(...vals), hi = Math.max(...vals), span = hi - lo || 1, n = vals.length - 1;
  const X = i => 3 + i / n * (w - 6), Y = v => h - (big ? 8 : 4) - (v - lo) / span * (h - (big ? 18 : 9));
  const last = clamp(shown, 0, 1) * n, whole = Math.floor(last);
  const pts = [];
  for (let i = 0; i <= whole; i++) pts.push([X(i), Y(vals[i])]);
  if (last > whole) pts.push([X(last), Y(lerp(vals[whole], vals[whole + 1], last - whole))]);
  const line = pts.map(p => p[0].toFixed(1) + ',' + p[1].toFixed(1)).join(' ');
  const [ex, ey] = pts[pts.length - 1];
  let body = '';
  if (big) {
    const avg = vals.reduce((a, b) => a + b, 0) / vals.length;
    for (const f of [0.33, 0.66]) body += `<line x1='0' x2='${w}' y1='${(h * f).toFixed(1)}' y2='${(h * f).toFixed(1)}' stroke='#8e8e93' stroke-opacity='0.2'/>`;
    body += `<line x1='0' x2='${w}' y1='${Y(avg).toFixed(1)}' y2='${Y(avg).toFixed(1)}' stroke='#8e8e93' stroke-opacity='0.75' stroke-dasharray='4 4'/>`;
  }
  if (pts.length > 1) {
    body += `<polygon fill='${color}' fill-opacity='0.15' points='${X(0).toFixed(1)},${h} ${line} ${ex.toFixed(1)},${h}'/>`;
    body += `<polyline fill='none' stroke='${color}' stroke-width='${big ? 2.5 : 2}' stroke-linejoin='round' stroke-linecap='round' points='${line}'/>`;
  }
  if (big) for (const i of [vals.indexOf(hi), vals.indexOf(lo)]) if (i <= last)
    body += `<circle cx='${X(i).toFixed(1)}' cy='${Y(vals[i]).toFixed(1)}' r='4' fill='none' stroke='${color}' stroke-width='1.5'/>`;
  body += `<circle cx='${ex.toFixed(1)}' cy='${ey.toFixed(1)}' r='${big ? 4.5 : 3}' fill='${color}'/>`;
  return 'data:image/svg+xml;utf8,' + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='${w}' height='${h}'>${body}</svg>`);
}

function setPeriod(p) {
  if (p === period) return;
  period = p;
  const from = cur.map(c => ({ v: c.v, s: c.s.slice() }));
  const me = ++morphRun;
  animate(650, e => {
    if (me !== morphRun) return;
    cur.forEach((c, k) => {
      c.v = lerp(from[k].v, KPIS[k].data[p][0], e);
      c.s = from[k].s.map((x, i) => lerp(x, SERIES[k][p][i], e));
    });
  }, ease.inOutCubic);
}

function replay() {
  const me = ++revealRun;
  animate(750, e => { if (me === revealRun) reveal = e; }, ease.outCubic);
}

function onAction(name, value) {
  if (name === 'period') return setPeriod(Number(value));
  if (name === 'back' && focus >= 0) { transition('slide-right'); focus = -1; return; }
  if (name === 'focus' && focus < 0) { transition('slide-left'); focus = clamp(Number(value) || 0, 0, KPIS.length - 1); replay(); return; }
  if (name === 'step' && focus >= 0) {
    const dir = Number(value);
    transition(dir > 0 ? 'slide-left' : 'slide-right');
    focus = (focus + dir + KPIS.length) % KPIS.length;
    replay();
  }
}
setTimeout(() => animate(900, (_, t) => { intro = t; }, ease.linear), 250);

const seg = () => `<span class="seg">${PERIODS.map((p, i) =>
  `<span class="${i === period ? 'on' : ''}" data-action="period" data-value="${i}">${p.label}</span>`).join('')}</span>`;
const badge = k => `<span class="badge ${KPIS[k].data[period][1] < 0 ? 'red' : 'green'}">${deltaText(k)}</span>`;

function tile(k) {
  const K = KPIS[k], e = tileP(k);
  return `<div class="kt" data-action="focus" data-value="${k}">
    <div class="caps"><span class="dot" style="background-color: ${K.color}"></span>${K.name}</div>
    <div class="row"><span class="big grow">${K.fmt(cur[k].v * e)}</span>${badge(k)}</div>
    <img src="${chart(cur[k].s, K.color, 168, 34, e, false)}" width="168" height="34" style="margin-top: 6px">
    <div class="tiny muted">${PERIODS[period].vs}</div>
  </div>`;
}

function detail() {
  const k = focus, K = KPIS[k], P = PERIODS[period], s = cur[k].s;
  const stat = (label, v) => `<div><div class="caps">${label}</div><b>${K.fmt(v)}</b></div>`;
  return `<div class="row between"><a class="back" href="#" data-action="back">‹ All numbers</a>${seg()}</div>
    <div class="row" style="margin-top: 12px"><span class="caps grow"><span class="dot" style="background-color: ${K.color}"></span>${K.name}</span>
      <span class="nav" data-action="step" data-value="-1">‹</span><span class="tiny muted">${k + 1} of ${KPIS.length}</span><span class="nav" data-action="step" data-value="1">›</span></div>
    <div class="row"><span class="hero">${K.fmt(cur[k].v * reveal)}</span><span style="margin-left: 10px">${badge(k)}</span><span class="tiny muted" style="margin-left: 6px">${P.vs}</span></div>
    <img src="${chart(s, K.color, 390, 104, reveal, true)}" width="390" height="104" style="margin-top: 6px">
    <div class="row between tiny muted"><span>${P.from}</span><span>┄ average</span><span>${P.to}</span></div>
    <div class="st">${stat('High', Math.max(...s))}${stat('Low', Math.min(...s))}${stat('Average', s.reduce((a, b) => a + b, 0) / s.length)}</div>
    <div class="note small" style="background-color: ${alpha(K.color, 0.1)}">💡 ${K.note}</div>`;
}

function render() {
  if (focus >= 0) return `<div class="card pad kp">${detail()}</div>`;
  return `<div class="card pad kp">
    <div class="row between"><span><b style="font-size: 16px">Key numbers</b> <span class="small muted">LiteChat</span></span>${seg()}</div>
    <div class="tiles">${KPIS.map((_, k) => tile(k)).join('')}</div>
    <div class="tiny muted center">Click a number to focus it</div>
  </div>`;
}
</script>

--- bot 09:01 bare
<style>
  .rv { width: 390px; max-width: 100%; }
  .rv .seg { display: inline-block; padding: 2px; border-radius: 9px; background-color: rgba(127,127,127,0.14); }
  .rv .seg span { display: inline-block; padding: 3px 10px; border-radius: 7px; font-size: 12px; font-weight: 700; }
  .rv .seg span:hover { background-color: rgba(127,127,127,0.22); }
  .rv .seg span.on { color: #ffffff; }
  .rv .tog { display: inline-block; padding: 2px 9px; border-radius: 11px; font-size: 11px; font-weight: 700; border: 1px solid rgba(127,127,127,0.35); }
  .rv .tog:hover { background-color: rgba(127,127,127,0.12); }
  .rv .tog.on { border-color: #ff9500; color: #ff9500; background-color: rgba(255,149,0,0.12); }
  .rv .plot { position: relative; height: 150px; margin: 12px 0 0 34px; border-bottom: 1px solid rgba(127,127,127,0.35); }
  .rv .gl { position: absolute; left: 0; width: 356px; height: 0; border-top: 1px dashed rgba(127,127,127,0.25); }
  .rv .gl span { position: absolute; left: -34px; top: -7px; width: 30px; text-align: right; font-size: 9px; color: #8e8e93; }
  .rv .cols { display: flex; position: relative; height: 150px; }
  .rv .col { flex-grow: 1; flex-basis: 0; height: 150px; overflow: hidden; text-align: center; border-radius: 6px 6px 0 0; }
  .rv .col:hover { background-color: rgba(127,127,127,0.08); }
  .rv .val { height: 11px; line-height: 11px; margin-bottom: 2px; font-size: 9px; font-weight: 700; white-space: nowrap; visibility: hidden; }
  .rv .col:hover .val, .rv .val.show { visibility: visible; }
  .rv .bars { display: flex; justify-content: center; align-items: flex-end; }
  .rv .b { border-radius: 4px 4px 0 0; }
  .rv .col:hover .b.cur { background-color: #ff9500 !important; }
  .rv .mo { display: flex; margin-left: 34px; font-size: 9.5px; color: #8e8e93; }
  .rv .mo span { flex-grow: 1; flex-basis: 0; text-align: center; padding-top: 3px; }
  .rv .mo span.on { color: #ff9500; font-weight: 700; }
  .rv .foot { margin-top: 10px; padding: 8px 10px; border-radius: 10px; background-color: rgba(127,127,127,0.08); }
  .rv .sm { display: flex; }
  .rv .sm > div { flex-grow: 1; flex-basis: 0; }
  .rv .stk { display: flex; height: 10px; border-radius: 5px; overflow: hidden; margin: 8px 0 6px 0; background-color: rgba(127,127,127,0.15); }
  .rv .stk div { height: 10px; }
  .rv .parts { display: flex; font-size: 11px; }
  .rv .parts > div { flex-grow: 1; flex-basis: 0; }
  .rv .parts i { display: inline-block; width: 8px; height: 8px; border-radius: 3px; margin-right: 4px; }
  .rv .x { display: inline-block; width: 22px; text-align: center; border-radius: 7px; font-weight: 700; }
  .rv .x:hover { background-color: rgba(127,127,127,0.2); }
</style>
<div class="card pad rv"><b>Last 12 months</b><div class="small muted">Revenue grew from €96k in November to €182k in October · 12-month total €1.53M</div></div>
<script>
const MONTHS = ['Nov', 'Dec', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct'];
const LONG = ['November 2025', 'December 2025', 'January 2026', 'February 2026', 'March 2026', 'April 2026', 'May 2026', 'June 2026', 'July 2026', 'August 2026', 'September 2026', 'October 2026'];
const sum = a => a.reduce((x, y) => x + y, 0);
const SERIES = [
  { label: 'Revenue', color: '#5856d6', top: 200, unit: v => '€' + Math.round(v) + 'k',
    now: [96, 121, 88, 92, 110, 118, 131, 127, 140, 152, 168, 182], prev: [61, 83, 58, 60, 72, 77, 85, 83, 91, 99, 109, 117],
    total: ['12-month total', a => sum(a), v => '€' + (Math.round(v / 10) / 100).toFixed(2) + 'M'],
    parts: [['Subscriptions', '#5856d6'], ['Marketplace', '#30b0c7'], ['Ads', '#ff9500']],
    split: i => { const s = 0.56 + i * 0.007, m = 0.25 + 0.03 * Math.sin(i * 1.7); return [s, m, 1 - s - m]; } },
  { label: 'Users', color: '#30b0c7', top: 60, unit: v => Math.round(v) + 'k',
    now: [21, 24, 22, 25, 28, 30, 33, 35, 39, 42, 45, 48], prev: [12, 14, 13, 14, 16, 17, 19, 20, 22, 24, 26, 28],
    total: ['Average MAU', a => sum(a) / a.length, v => v.toFixed(1) + 'k'],
    parts: [['Returning', '#30b0c7'], ['New', '#34c759'], ['Reactivated', '#af52de']],
    split: i => { const n = 0.27 + 0.04 * Math.sin(i * 1.3 + 1), r = 0.08 + 0.02 * Math.cos(i * 0.9); return [1 - n - r, n, r]; } },
];
const PLOT = 128;
const pct = x => (x < 0 ? '▼ ' : '▲ ') + Math.abs(x).toFixed(1) + '%';

let series = 0, compare = false, sel = -1, run = 0, pickRun = 0;
let H = Array(12).fill(0), G = Array(12).fill(0), shares = [0, 0, 0];
const view = { sw: 0, cmp: 0, sum: 0, selV: 0, dim: 0 };
const heights = (s, key) => SERIES[s][key].map(v => v / SERIES[s].top * PLOT);

function morph(ms, stagger) {
  const fromH = H.slice(), fromG = G.slice(), toH = heights(series, 'now'), toG = heights(series, 'prev');
  const me = ++run, total = ms + stagger * 11;
  animate(total, (_, t) => {
    if (me !== run) return;
    for (let i = 0; i < 12; i++) {
      const p = ease.outCubic(clamp((t * total - i * stagger) / ms, 0, 1));
      H[i] = lerp(fromH[i], toH[i], p);
      G[i] = lerp(fromG[i], toG[i], p);
    }
  }, ease.linear);
}

function pick(i) {
  const S = SERIES[series], from = shares.slice(), to = S.split(i), me = ++pickRun;
  sel = i;
  animate(480, e => { if (me === pickRun) shares = from.map((f, k) => lerp(f, to[k], e)); }, ease.outCubic);
  tween(view, { selV: S.now[i] }, 480);
}

function close() {
  transition('fade');
  sel = -1;
  tween(view, { dim: 0 }, 300);
}

function onAction(name, value) {
  if (name === 'series') {
    const s = Number(value);
    if (s === series) return;
    series = s;
    morph(520, 20);
    tween(view, { sw: s }, 500, ease.inOutCubic);
    tween(view, { sum: SERIES[s].total[1](SERIES[s].now) }, 600);
    if (sel >= 0) pick(sel);
  } else if (name === 'compare') {
    compare = !compare;
    tween(view, { cmp: compare ? 1 : 0 }, 450, ease.inOutCubic);
  } else if (name === 'pick') {
    const i = Number(value);
    if (i === sel) return close();
    if (sel < 0) {
      transition('fade');
      shares = [0, 0, 0];
      view.selV = 0;
      tween(view, { dim: 1 }, 350);
    }
    pick(i);
  } else if (name === 'step' && sel >= 0) {
    pick((sel + Number(value) + 12) % 12);
  } else if (name === 'close' && sel >= 0) {
    close();
  }
}
setTimeout(() => { morph(560, 30); tween(view, { sum: SERIES[0].total[1](SERIES[0].now) }, 900); }, 250);

function summary(S) {
  const [label, , fmt] = S.total;
  const best = S.now.indexOf(Math.max(...S.now));
  const yoy = (sum(S.now) / sum(S.prev) - 1) * 100;
  return `<div class="foot"><div class="sm">
    <div><div class="caps">${label}</div><b style="font-size: 17px">${fmt(view.sum)}</b></div>
    <div><div class="caps">Best month</div><b style="font-size: 17px">${MONTHS[best]}</b> <span class="small muted">${S.unit(S.now[best])}</span></div>
    <div><div class="caps">vs last year</div><b class="t-green" style="font-size: 17px">${pct(yoy)}</b></div>
  </div></div>`;
}

function breakdown(S) {
  const i = sel, v = S.now[i];
  const mom = i ? (v / S.now[i - 1] - 1) * 100 : null, yoy = (v / S.prev[i] - 1) * 100;
  return `<div class="foot">
    <div class="row"><b class="grow">${LONG[i]}</b><span class="x" data-action="step" data-value="-1">‹</span><span class="x" data-action="step" data-value="1">›</span><span class="x" data-action="close">×</span></div>
    <div class="row" style="margin-top: 2px"><b style="font-size: 20px; margin-right: 8px">${S.unit(view.selV)}</b>
      ${mom === null ? '' : `<span class="badge ${mom < 0 ? 'red' : 'green'}" style="margin-right: 4px">${pct(mom)} MoM</span>`}<span class="badge purple">${pct(yoy)} YoY</span></div>
    <div class="stk">${shares.map((s, k) => `<div style="width: ${(s * 100).toFixed(2)}%; background-color: ${S.parts[k][1]}"></div>`).join('')}</div>
    <div class="parts">${S.parts.map(([n, c], k) => `<div><i style="background-color: ${c}"></i>${n}<br><b>${S.unit(v * shares[k])}</b> <span class="muted">${Math.round(shares[k] * 100)}%</span></div>`).join('')}</div>
  </div>`;
}

function render() {
  const S = SERIES[series], color = mix(SERIES[0].color, SERIES[1].color, view.sw);
  const tabs = SERIES.map((s, i) => i === series
    ? `<span class="on" style="background-color: ${s.color}" data-action="series" data-value="${i}">${s.label}</span>`
    : `<span data-action="series" data-value="${i}">${s.label}</span>`).join('');
  const grid = [0.25, 0.5, 0.75, 1].map(f => `<div class="gl" style="top: ${Math.round(150 - PLOT * f)}px"><span>${S.unit(S.top * f)}</span></div>`).join('');
  const mainW = lerp(20, 11, view.cmp), ghostW = 11 * view.cmp;
  const cols = MONTHS.map((m, i) => {
    const c = i === sel ? '#ff9500' : alpha(color, 1 - 0.5 * view.dim);
    const g = G[i] * view.cmp;
    const ghost = view.cmp > 0.02 ? `<div class="b" style="width: ${ghostW.toFixed(1)}px; height: ${g.toFixed(1)}px; margin-right: ${(2 * view.cmp).toFixed(1)}px; background-color: ${alpha(color, 0.32 - 0.14 * view.dim)}"></div>` : '';
    return `<div class="col" data-action="pick" data-value="${i}"><div style="height: ${(137 - Math.max(H[i], g)).toFixed(1)}px"></div>
      <div class="val${i === sel || (sel < 0 && i === 11) ? ' show' : ''}">${S.unit(S.now[i])}</div>
      <div class="bars">${ghost}<div class="b cur" style="width: ${mainW.toFixed(1)}px; height: ${H[i].toFixed(1)}px; background-color: ${c}"></div></div></div>`;
  }).join('');
  const months = MONTHS.map((m, i) => `<span class="${i === sel ? 'on' : ''}">${m}</span>`).join('');
  return `<div class="card pad rv">
    <div class="row between"><b style="font-size: 16px">Last 12 months</b><span class="seg">${tabs}</span></div>
    <div class="row between" style="margin-top: 4px"><span class="tiny muted">${compare ? 'Faded columns: the same month a year earlier' : 'Hover a column for its value, click it for the breakdown'}</span>
      <span class="tog${compare ? ' on' : ''}" data-action="compare">${compare ? '✓ ' : ''}vs last year</span></div>
    <div class="plot">${grid}<div class="cols">${cols}</div></div>
    <div class="mo">${months}</div>
    ${sel >= 0 ? breakdown(S) : summary(S)}
  </div>`;
}
</script>

