</style>
<div class="card pad hm"><b>Deploys per day</b><div class="small muted">1,284 deploys in 6 months, with a clear dip in August.</div></div>
<script>
const ENC = '55kcb005kef932af06j0eg9ib847albki706g0f53ahcehad9ada9c04bkaf675lblad330ghhb045ekb9623d74e07a6578302e43b0380c620098362005006800893930090475002350420ceeb0004409700273622452859024deb000';
const DEPLOYS = [...ENC].map(c => parseInt(c, 36));
let seed = 20261004;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const INCIDENTS = DEPLOYS.map(d => { const r = rnd(); return d ? Math.max(0, Math.round(d * 0.12 + r * 1.8 - 1.1)) : r < 0.05 ? 1 : 0; });
const PRS = DEPLOYS.map((d, i) => Math.round(d * 1.5 + rnd() * (i % 7 >= 5 ? 2 : 7)));
const METRICS = [
  { label: 'Deploys', one: 'deploy', many: 'deploys', badge: 'green', pal: ['#9be9a8', '#40c463', '#30a14e', '#216e39'], data: DEPLOYS },
  { label: 'Incidents', one: 'incident', many: 'incidents', badge: 'red', pal: ['#ffc078', '#ff922b', '#f03e3e', '#a61e1e'], data: INCIDENTS },
  { label: 'PRs merged', one: 'PR', many: 'PRs', badge: 'purple', pal: ['#d0bfff', '#9775fa', '#7048e8', '#4c2fb0'], data: PRS },
];
const START = Date.UTC(2026, 3, 6), N = 182;
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const DOW = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const SERVICES = ['api-gateway', 'web', 'billing', 'search', 'notifications', 'auth', 'media'];
const EMPTY = 'rgba(127,127,127,0.15)';
const date = i => new Date(START + i * 86400000);
const dayLabel = i => `${DOW[i % 7]} ${date(i).getUTCDate()} ${MON[date(i).getUTCMonth()]}`;
const group = n => String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');

METRICS.forEach(m => {
  const nz = m.data.filter(v => v > 0).sort((a, b) => a - b);
  m.cuts = [0.25, 0.5, 0.75].map(f => nz[Math.floor(f * (nz.length - 1))]);
  m.total = m.data.reduce((a, b) => a + b, 0);
  m.max = Math.max(...m.data);
  const month = k => m.data.reduce((s, v, i) => s + (date(i).getUTCMonth() === k ? v : 0), 0);
  m.jul = month(6);
  m.aug = month(7);
  m.colors = m.data.map(v => v <= 0 ? EMPTY : m.pal[v <= m.cuts[0] ? 0 : v <= m.cuts[1] ? 1 : v <= m.cuts[2] ? 2 : 3]);
  const parsed = {};
  m.rgba = m.colors.map(c => parsed[c] || (parsed[c] = mix(c, c, 0).slice(5, -1).split(',').map(Number)));
});
const LABELS = [];
for (let i = 0; i < N; i++) if (i === 0 || date(i).getUTCDate() === 1) LABELS.push([Math.floor(i / 7), MON[date(i).getUTCMonth()]]);

let metric = 0, prevMetric = 0, sel = -1, wave = 0, waveMs = 870, waveKind = 'intro', waveRun = 0, wkRun = 0;
let fromC = METRICS[0].rgba.map(([r, g, b]) => [r, g, b, 0]), toC = METRICS[0].rgba, WK = Array(7).fill(0);
const view = { total: 0 };

function cellP(i) {
  if (wave >= 1) return 1;
  const c = Math.floor(i / 7), r = i % 7, intro = waveKind === 'intro';
  const delay = intro ? c * 18 + r * 20 : c * 13 + r * 9;
  return ease.outCubic(clamp((wave * waveMs - delay) / (intro ? 300 : 260), 0, 1));
}
function cellRGBA(i) {
  const p = cellP(i), a = fromC[i], b = toC[i];
  return p >= 1 ? b : p <= 0 ? a : [a[0] + (b[0] - a[0]) * p, a[1] + (b[1] - a[1]) * p, a[2] + (b[2] - a[2]) * p, a[3] + (b[3] - a[3]) * p];
}
const cellColor = i => {
  if (wave >= 1) return METRICS[metric].colors[i];
  const v = cellRGBA(i);
  return `rgba(${Math.round(v[0])},${Math.round(v[1])},${Math.round(v[2])},${v[3].toFixed(2)})`;
};

function runWave(kind, from) {
  waveKind = kind;
  fromC = from;
  toC = METRICS[metric].rgba;
  waveMs = kind === 'intro' ? 870 : 640;
  wave = 0;
  const me = ++waveRun;
  animate(waveMs, (_, t) => { if (me === waveRun) wave = t; }, ease.linear);
}

function syncWeek(fromZero) {
  const m = METRICS[metric], c = Math.floor(sel / 7);
  const to = m.data.slice(c * 7, c * 7 + 7).map(v => v / m.max * 34);
  const from = fromZero ? Array(7).fill(0) : WK.slice(), me = ++wkRun;
  animate(450, e => { if (me === wkRun) WK = from.map((f, r) => lerp(f, to[r], e)); }, ease.outCubic);
}

function close() {
  transition('fade');
  sel = -1;
}

function onAction(name, value) {
  if (name === 'metric') {
    const k = Number(value);
    if (k === metric) return;
    const shown = Array.from({ length: N }, (_, i) => cellRGBA(i));
    prevMetric = metric;
    metric = k;
    runWave('switch', shown);
    tween(view, { total: METRICS[k].total }, 600);
    if (sel >= 0) syncWeek(false);
  } else if (name === 'day') {
    const i = Number(value);
    if (i === sel) return close();
    const opening = sel < 0, sameWeek = !opening && Math.floor(i / 7) === Math.floor(sel / 7);
    if (opening) transition('fade');
    sel = i;
    if (!sameWeek) syncWeek(opening);
  } else if (name === 'week' && sel >= 0) {
    const i = sel + 7 * Number(value);
    if (i < 0 || i >= N) return;
    sel = i;
    syncWeek(false);
  } else if (name === 'close' && sel >= 0) {
    close();
  }
}
setTimeout(() => { runWave('intro', fromC); tween(view, { total: METRICS[metric].total }, 900); }, 250);

function detail() {
  const m = METRICS[metric], i = sel, c = Math.floor(i / 7), r0 = i % 7, start = c * 7;
  const week = m.data.slice(start, start + 7), wsum = week.reduce((a, b) => a + b, 0);
  const counts = METRICS.map((M, k) => `<span class="${k === metric ? 'fg' : 'muted'}"><b>${M.data[i]}</b> ${M.data[i] === 1 ? M.one : M.many}</span>`).join('');
  const bars = WK.map((h, r) => `<div data-action="day" data-value="${start + r}"><div class="tiny ${r === r0 ? 'fg' : 'muted'}">${week[r]}</div>
    <div class="bb" style="height: ${Math.max(2, h).toFixed(1)}px; background-color: ${r === r0 ? m.pal[3] : alpha(m.pal[1], 0.85)}"></div></div>`).join('');
  return `<div class="det">
    <div class="row"><b class="grow">${dayLabel(i)}</b>
      <span class="x${c > 0 ? '' : ' muted'}" data-action="week" data-value="-1">‹ week</span><span class="x${c < 25 ? '' : ' muted'}" data-action="week" data-value="1">week ›</span><span class="x" data-action="close">×</span></div>
    <div class="small mx" style="margin-top: 2px">${counts}</div>
    <div class="wk">${bars}</div>
    <div class="wkl">${DOW.map((d, r) => `<span class="${r === r0 ? 'fg' : ''}">${d}</span>`).join('')}</div>
    <div class="tiny muted" style="margin-top: 6px">Week of ${date(start).getUTCDate()} ${MON[date(start).getUTCMonth()]}: <b class="fg">${wsum}</b> ${wsum === 1 ? m.one : m.many}${m.data[i] ? ` · top service that day: <b class="fg">${SERVICES[(i * 5 + metric) % SERVICES.length]}</b>` : ' · a quiet day'}</div>
  </div>`;
}

function render() {
  const m = METRICS[metric];
  let cols = '';
  for (let c = 0; c < 26; c++) {
    let h = '';
    for (let r = 0; r < 7; r++) {
      const i = c * 7 + r;
      h += `<div class="hc${i === sel ? ' sel' : ''}" data-action="day" data-value="${i}" style="background-color: ${cellColor(i)}"></div>`;
    }
    cols += `<div class="hw">${h}</div>`;
  }
  const tabs = METRICS.map((M, k) => k === metric
    ? `<span class="on" style="background-color: ${M.pal[2]}" data-action="metric" data-value="${k}">${M.label}</span>`
    : `<span data-action="metric" data-value="${k}">${M.label}</span>`).join('');
  const months = LABELS.map(([c, name]) => `<span style="left: ${28 + c * 14}px">${name}</span>`).join('');
  const lp = waveKind === 'intro' ? 1 : ease.outCubic(wave);
  const legend = [-1, 0, 1, 2, 3].map(k => `<div style="background-color: ${k < 0 ? EMPTY : mix(METRICS[prevMetric].pal[k], m.pal[k], lp)}"></div>`).join('');
  const change = m.jul ? Math.round((m.aug / m.jul - 1) * 100) : 0;
  return `<div class="card pad hm">
    <div class="row"><b class="grow" style="font-size: 16px">${m.label} per day</b><span class="badge ${m.badge}">${group(view.total)} in 6 months</span></div>
    <div class="row between" style="margin-top: 6px"><span class="seg">${tabs}</span><span class="tiny muted">click any day</span></div>
    <div class="ml">${months}</div>
    <div class="row" style="align-items: flex-start">
      <div class="dl"><div>Mon</div><div>&nbsp;</div><div>Wed</div><div>&nbsp;</div><div>Fri</div><div>&nbsp;</div><div>Sun</div></div>
      <div class="grid7">${cols}</div>
    </div>
    <div class="leg"><span class="grow">August vs July: <b class="fg">${change > 0 ? '+' : change < 0 ? '−' : ''}${Math.abs(change)}%</b>${change <= -30 ? ' 🏖️' : ''}</span>Less${legend}<span style="margin-left: 4px">More</span></div>
    ${sel >= 0 ? detail() : ''}
  </div>`;
}
</script>

