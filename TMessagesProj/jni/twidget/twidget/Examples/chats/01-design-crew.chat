</style>
<div class="card spr"><div class="hd"><div class="kick">Sprint 42 · day 6 of 10</div><div class="ttl">Chat Redesign</div></div><div class="bd small muted">Story points burned 34 / 50</div></div>
<script>
const STATUS = [
  { label: 'TODO', c: '#8e8e93' },
  { label: 'IN PROGRESS', c: '#2f7cf6' },
  { label: 'IN REVIEW', c: '#e08a00' },
  { label: 'DONE', c: '#25a244' },
];
const PEOPLE = { M: '#ff2d55', L: '#34c759', P: '#af52de' };
const TASKS = [
  { id: 'rnd', icon: '🫧', name: 'Bubble renderer', pts: 13, who: 'M', s: 3 },
  { id: 'kit', icon: '🧩', name: 'Kit classes', pts: 8, who: 'L', s: 3 },
  { id: 'lay', icon: '📐', name: 'Layout cache', pts: 13, who: 'M', s: 3 },
  { id: 'drk', icon: '🌙', name: 'Dark mode', pts: 5, who: 'L', s: 2 },
  { id: 'crd', icon: '🃏', name: 'Card components', pts: 8, who: 'P', s: 1 },
  { id: 'a11y', icon: '♿️', name: 'Accessibility audit', pts: 3, who: 'P', s: 0 },
];
const TOTAL = 50, TODAY = 6, DAYS = 10, HIST = [50, 48, 44, 41, 33, 24];
const START = TASKS.map(t => t.s);
const FILTERS = [['all', 'All'], ['open', 'Open'], ['done', 'Done']];
TASKS.forEach(t => { t.from = t.s; t.k = 1; t.flash = 0; });
let filter = 'all', day = TODAY, intro = 0, sweep = 0;
const sticky = new Set(), meter = { v: 0 }, cur = { d: TODAY };

const burned = () => TASKS.reduce((s, t) => s + (t.s === 3 ? t.pts : 0), 0);
const match = t => filter === 'all' || (filter === 'done') === (t.s === 3);
const velocity = left => (TOTAL - left) / TODAY;
const finish = left => left <= 0 ? TODAY : velocity(left) > 0 ? TODAY + left / velocity(left) : Infinity;

function remaining(d) {
  const left = TOTAL - meter.v;
  if (d <= TODAY) {
    const pts = HIST.concat([left]);
    const i = Math.min(TODAY - 1, Math.floor(d));
    return lerp(pts[i], pts[i + 1], d - i);
  }
  return Math.max(0, left - velocity(left) * (d - TODAY));
}

setTimeout(() => {
  animate(900, (_, t) => { intro = t; }, ease.linear);
  tween(meter, { v: burned() }, 900, ease.outCubic);
}, 250);

const X = d => 6 + d * 32, Y = r => 6 + (1 - r / TOTAL) * 54;
function chart() {
  const upto = Math.max(0.01, intro * TODAY);
  const pts = [];
  for (let d = 0; d < upto; d++) pts.push(`${X(d).toFixed(1)},${Y(remaining(d)).toFixed(1)}`);
  pts.push(`${X(upto).toFixed(1)},${Y(remaining(upto)).toFixed(1)}`);
  const line = pts.join(' ');
  let ticks = '', extra = '';
  for (let d = 0; d <= DAYS; d++) ticks += `<line x1='${X(d)}' y1='60' x2='${X(d)}' y2='${d === TODAY ? 65 : 63}' stroke='#8e8e93' stroke-opacity='0.6'/>`;
  if (intro >= 1) {
    const left = TOTAL - meter.v, end = Math.min(DAYS, finish(left));
    if (end > TODAY + 0.01)
      extra += `<line x1='${X(TODAY)}' y1='${Y(left).toFixed(1)}' x2='${X(end).toFixed(1)}' y2='${Y(remaining(end)).toFixed(1)}' stroke='#2cb67d' stroke-width='2' stroke-dasharray='4 3'/>`;
    const cx = X(cur.d).toFixed(1), cy = Y(remaining(cur.d)).toFixed(1);
    extra += `<line x1='${cx}' y1='2' x2='${cx}' y2='60' stroke='#8e8e93' stroke-opacity='0.5'/><circle cx='${cx}' cy='${cy}' r='4.5' fill='#7f5af0' stroke='#ffffff' stroke-width='2'/>`;
  }
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' width='332' height='66' viewBox='0 0 332 66'>` +
    `<line x1='0' y1='60.5' x2='332' y2='60.5' stroke='#8e8e93' stroke-opacity='0.35'/>${ticks}` +
    `<line x1='${X(0)}' y1='${Y(TOTAL)}' x2='${X(DAYS)}' y2='${Y(0)}' stroke='#8e8e93' stroke-opacity='0.55' stroke-width='1.5' stroke-dasharray='3 3'/>` +
    `<polygon points='${X(0)},60 ${line} ${X(upto).toFixed(1)},60' fill='#7f5af0' fill-opacity='0.16'/>` +
    `<polyline points='${line}' fill='none' stroke='#7f5af0' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round'/>${extra}</svg>`;
  return 'data:image/svg+xml;utf8,' + encodeURIComponent(svg);
}

function row(t, i) {
  const e = ease.outCubic(clamp((intro * 900 - i * 90) / 450, 0, 1));
  const a = STATUS[t.from].c, b = STATUS[t.s].c;
  const flash = t.flash > 0.01 ? ` background-color: ${alpha(b, 0.22 * t.flash)};` : '';
  return `<div class="task" data-action="cycle" data-value="${t.id}" style="left: ${Math.round((1 - e) * 380)}px;${flash}">
    <span class="nm ${t.s === 3 ? 'muted' : ''}">${t.icon} ${esc(t.name)}</span>
    <span class="pt">${t.pts} pt</span><span class="who" style="background-color: ${PEOPLE[t.who]}">${t.who}</span>
    <span class="pill" style="background-color: ${mix(alpha(a, 0.16), alpha(b, 0.16), t.k)}; color: ${mix(a, b, t.k)}">${STATUS[t.s].label}</span></div>`;
}

function render() {
  const done = burned();
  const pct = meter.v / TOTAL * 100;
  const fin = finish(TOTAL - done);
  const state = done === TOTAL ? 'Goal met 🎉' : fin <= DAYS + 0.01 ? `On track · day ${Math.ceil(fin - 0.01)}` : 'At risk ⚠︎';
  const counts = { all: TASKS.length, open: TASKS.filter(t => t.s !== 3).length, done: TASKS.filter(t => t.s === 3).length };
  const chips = FILTERS.map(([id, label]) => `<span class="fl ${filter === id ? 'on' : ''}" data-action="filter" data-value="${id}">${label} ${counts[id]}</span>`).join('');
  const shown = TASKS.filter(t => sticky.has(t.id) || match(t));
  const rows = shown.length ? shown.map(row).join('') : '<div class="task muted">Nothing here yet</div>';
  const changed = TASKS.some((t, i) => t.s !== START[i]);
  const note = day === TODAY ? 'today' : day > TODAY ? 'forecast' : day === 0 ? 'start' : 'history';
  return `<div class="card spr">
    <div class="hd"><div class="row between"><span class="kick">Sprint 42 · day ${TODAY} of ${DAYS}</span><span class="state">${state}</span></div>
      <div class="ttl">Chat Redesign</div></div>
    <div class="bd">
      <div class="row between"><span>${chips}</span>${changed ? '<a class="reset" href="#" data-action="reset">↺ Reset</a>' : ''}</div>
      <div class="list">${rows}</div>
      ${done === TOTAL ? `<div class="goal"><b class="t-green">🎉 Sprint goal met</b> <span class="muted">· all ${TOTAL} points burned</span></div>` : ''}
      <div class="row between small" style="margin-top: 10px"><span class="muted">Story points burned <b class="fg">${Math.round(meter.v)} / ${TOTAL}</b></span><span class="muted">${Math.round(pct)}%</span></div>
      <div class="meter"><div style="width: ${pct.toFixed(1)}%"></div></div>
      <div class="row between small" style="margin-top: 10px"><span class="muted">Burn-down · <b class="fg">${Math.round(remaining(cur.d))}</b> pts left</span>
        <span><span class="step" data-action="day" data-value="-1">‹</span><span class="day"><b>Day ${day}</b> <span class="muted">${note}</span></span><span class="step" data-action="day" data-value="1">›</span></span></div>
      <img src="${chart()}" width="332" height="66" style="margin-top: 4px">
      <div class="tiny muted">Click a task to move it along · grey dashes are the ideal pace</div>
    </div>
  </div>`;
}

function onAction(name, value) {
  if (name === 'filter') {
    if (value === filter) return;
    const order = FILTERS.map(f => f[0]);
    transition(order.indexOf(value) > order.indexOf(filter) ? 'slide-left' : 'slide-right');
    filter = value;
    sticky.clear(); clearTimeout(sweep);
  } else if (name === 'cycle') {
    const t = TASKS.find(x => x.id === value);
    if (!t) return;
    const was = burned() === TOTAL;
    t.from = t.s; t.s = (t.s + 1) % STATUS.length; t.k = 0; t.flash = 1;
    tween(t, { k: 1 }, 450, ease.outCubic);
    tween(t, { flash: 0 }, 800, ease.outQuad);
    tween(meter, { v: burned() }, 700, ease.outCubic);
    const now = burned() === TOTAL;
    if (now !== was) transition(now ? 'pop' : 'fade');
    if (!match(t)) {
      sticky.add(t.id);
      clearTimeout(sweep);
      sweep = setTimeout(() => {
        if (TASKS.some(x => sticky.has(x.id) && !match(x))) transition('slide-up');
        sticky.clear();
      }, 900);
    }
  } else if (name === 'day') {
    day = clamp(day + Number(value), 0, DAYS);
    tween(cur, { d: day }, 450, ease.outCubic);
  } else if (name === 'reset') {
    transition('fade');
    TASKS.forEach((t, i) => {
      if (t.s === START[i]) return;
      t.from = t.s; t.s = START[i]; t.k = 0;
      tween(t, { k: 1 }, 450, ease.outCubic);
    });
    sticky.clear(); clearTimeout(sweep);
    tween(meter, { v: burned() }, 700, ease.outCubic);
    day = TODAY;
    tween(cur, { d: TODAY }, 450, ease.outCubic);
  }
}
</script>

