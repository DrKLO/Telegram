<style>
  .pl { width: 330px; max-width: 100%; }
  .pl .q { font-size: 16px; font-weight: 700; margin: 2px 0 8px 0; }
  .pl .opt { padding: 5px 8px 7px 8px; margin: 0 -8px 2px -8px; border-radius: 10px; }
  .pl .opt:hover { background-color: rgba(127,127,127,0.10); }
  .pl .res { padding: 5px 0 7px 0; }
  .pl .top { display: flex; align-items: center; height: 22px; font-size: 13px; }
  .pl .lbl { flex-grow: 1; }
  .pl .pc { width: 40px; text-align: right; font-weight: 700; }
  .pl .vt { display: inline-block; margin-left: 2px; border-radius: 10px; text-align: center; color: #ffffff; font-weight: 700; vertical-align: middle; }
  .pl .track { height: 6px; margin-top: 3px; border-radius: 3px; background-color: rgba(127,127,127,0.2); }
  .pl .track div { height: 6px; border-radius: 3px; }
  .pl .names { margin-top: 3px; font-size: 11px; color: #8e8e93; }
  .pl .foot { display: flex; align-items: center; justify-content: space-between; margin-top: 6px; }
  .pl .lnk { font-size: 12px; font-weight: 600; padding: 3px 8px; border-radius: 8px; }
  .pl .lnk:hover { background-color: rgba(127,127,127,0.14); }
  .pl .say { margin-top: 8px; padding: 6px 10px; border-radius: 10px; background-color: rgba(127,127,127,0.10); font-size: 12.5px; }
  .pl .say span { position: relative; }
  .pl .win { margin: 2px 0 8px 0; padding: 10px 12px; border-radius: 12px; color: #ffffff; }
  .pl .rank { width: 18px; font-weight: 800; color: #8e8e93; }
</style>
<div class="card pad pl"><div class="caps">📊 Poll · 3 votes</div><div class="q">Where should we go for the offsite?</div><div class="small muted">🇵🇹 Lisbon 67% · 🇯🇵 Kyoto 33% · 🇮🇸 Reykjavík 0%</div></div>
<script>
const PEOPLE = { maya: ['Maya', '#ff2d55'], leo: ['Leo', '#34c759'], priya: ['Priya', '#af52de'], me: ['You', '#007aff'] };
const OPTIONS = [
  { id: 'lis', label: '🇵🇹 Lisbon', color: '#007aff', voters: ['maya', 'leo'] },
  { id: 'kyo', label: '🇯🇵 Kyoto', color: '#ff2d55', voters: ['priya'] },
  { id: 'rey', label: '🇮🇸 Reykjavík', color: '#30b0c7', voters: [] },
];
const LINES = {
  lis: ['priya', 'Lisbon it is! 🎉 Pastéis de nata on me'],
  kyo: ['priya', "It's a tie! 🍣 vs 🐟 Tie-breaker at standup tomorrow"],
  rey: ['leo', "Northern lights or bust 🌌 I'm with you"],
};
let mine = null, closed = false, names = false, shown = [0, 0, 0], barRun = 0, say = null, sayRun = 0;
const count = { v: 0 }, you = { s: 1 }, reveal = { v: 1 };

const total = () => OPTIONS.reduce((s, o) => s + o.voters.length, 0);
const shares = () => { const t = total() || 1; return OPTIONS.map(o => o.voters.length / t); };

function moveBars(ms) {
  const from = shown.slice(), to = shares(), me = ++barRun;
  animate(ms, p => { if (me === barRun) shown = from.map((f, i) => lerp(f, to[i], p)); }, ease.outCubic);
}
setTimeout(() => { moveBars(850); tween(count, { v: total() }, 850, ease.outCubic); }, 250);

async function chime(id) {
  const me = ++sayRun;
  if (!id) { say = null; return; }
  say = { who: LINES[id][0], text: LINES[id][1], typing: true, k: 0 };
  await animate(1000, () => {}, ease.linear);
  if (me !== sayRun) return;
  say.typing = false;
  tween(say, { k: 1 }, 400, ease.outCubic);
}

function vote(id) {
  const o = OPTIONS.find(x => x.id === id);
  if (!o) return;
  const had = !!say;
  if (mine) { const m = OPTIONS.find(x => x.id === mine); m.voters = m.voters.filter(v => v !== 'me'); }
  if (mine === id) mine = null;
  else { mine = id; o.voters.push('me'); you.s = 0; tween(you, { s: 1 }, 450, ease.outBack); }
  if (had !== !!mine) transition('fade');
  chime(mine);
  moveBars(650);
  tween(count, { v: total() }, 450, ease.outCubic);
}

function onAction(name, value) {
  if (name === 'vote' && !closed) vote(value);
  else if (name === 'names') { transition(names ? 'slide-up' : 'slide-down'); names = !names; }
  else if (name === 'close' && !closed) {
    transition('pop');
    closed = true; sayRun++; say = null;
    reveal.v = 0;
    tween(reveal, { v: 1 }, 1000, ease.linear);
  } else if (name === 'reopen' && closed) { transition('slide-right'); closed = false; }
}

function avatar(v, s) {
  const d = Math.max(1, Math.round(18 * s));
  return `<span class="vt" style="width: ${d}px; height: ${d}px; line-height: ${d}px; font-size: ${Math.max(1, Math.round(9 * s))}px; background-color: ${PEOPLE[v][1]}">${PEOPLE[v][0][0]}</span>`;
}
const who = list => list.map(v => PEOPLE[v][0]).join(' · ');
const votes = n => `${n} vote${n === 1 ? '' : 's'}`;

function ballot() {
  const rows = OPTIONS.map((o, i) => {
    const pc = shown[i] * 100, me = mine === o.id;
    const avs = o.voters.map(v => avatar(v, v === 'me' ? you.s : 1)).join('');
    return `<div class="opt" data-action="vote" data-value="${o.id}"${me ? ` style="background-color: ${alpha(o.color, 0.10)}"` : ''}>
      <div class="top"><span class="lbl">${o.label}${me ? ` <b style="color: ${o.color}">✓</b>` : ''}</span>${avs}<span class="pc">${Math.round(pc)}%</span></div>
      <div class="track"><div style="width: ${pc.toFixed(1)}%; background-color: ${o.color}"></div></div>
      ${names ? `<div class="names">${o.voters.length ? who(o.voters) : 'No votes yet'}</div>` : ''}
    </div>`;
  }).join('');
  let chat = '';
  if (say) {
    const [n, c] = PEOPLE[say.who];
    chat = `<div class="say"><b style="color: ${c}">${n}</b> ${say.typing
      ? `<span class="muted">is typing ${'•'.repeat(1 + Math.floor(performance.now() / 250) % 3)}</span>`
      : `<span style="left: ${Math.round((1 - say.k) * 14)}px">${esc(say.text)}</span>`}</div>`;
  }
  return `<div class="card pad pl">
    <div class="row between"><span class="caps">📊 Poll · ${votes(Math.round(count.v))}</span>${mine ? '<span class="badge blue">voted</span>' : ''}</div>
    <div class="q">Where should we go for the offsite?</div>
    ${rows}${chat}
    <div class="foot" data-pin="bottom"><span class="tiny muted">${mine ? 'Click your choice again to retract' : 'Click an option to vote ↑'}</span>
      <span><span class="lnk t-blue" data-action="names">${names ? 'Hide voters' : '👥 Voters'}</span><span class="lnk t-red" data-action="close">Close poll</span></span></div>
  </div>`;
}

function results() {
  const t = total();
  const ranked = OPTIONS.map(o => ({ o, n: o.voters.length })).sort((a, b) => b.n - a.n);
  const top = ranked.filter(r => r.n === ranked[0].n);
  const tie = top.length > 1;
  const c = tie ? '#8e8e93' : top[0].o.color;
  const rows = ranked.map((r, k) => {
    const grow = ease.outCubic(clamp(reveal.v * 1.5 - k * 0.22, 0, 1));
    const pc = (t ? r.n / t : 0) * 100 * grow;
    return `<div class="res">
      <div class="top"><span class="rank">${k + 1}</span><span class="lbl">${r.o.label}</span><span class="small muted">${votes(r.n)}</span><span class="pc">${Math.round(pc)}%</span></div>
      <div class="track"><div style="width: ${pc.toFixed(1)}%; background-color: ${r.o.color}"></div></div>
      <div class="names">${r.n ? who(r.o.voters) : 'No votes'}</div></div>`;
  }).join('');
  return `<div class="card pad pl">
    <div class="row between"><span class="caps">📊 Poll closed · ${votes(t)}</span><span class="badge">final</span></div>
    <div class="q">Where should we go for the offsite?</div>
    <div class="win" style="background: linear-gradient(135deg, ${c}, ${mix(c, '#000000', 0.3)})">
      <b style="font-size: 16px">${tie ? "🤝 It's a tie" : `🏆 ${top[0].o.label} wins`}</b>
      <div class="small" style="color: rgba(255,255,255,0.85)">${tie ? top.map(r => r.o.label).join(' vs ') + ' · tie-breaker at standup' : `${votes(top[0].n)} of ${t} · ${Math.round(top[0].n / t * 100)}%`}</div>
    </div>
    ${rows}
    <div class="foot" data-pin="bottom"><span class="tiny muted">Closed by you</span><span class="lnk t-blue" data-action="reopen">↺ Reopen poll</span></div>
  </div>`;
}

function render() { return closed ? results() : ballot(); }
</script>

