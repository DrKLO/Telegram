<div class="card inv"><div class="top"><div class="cal"><div class="mon">OCT</div><div class="dnum">09</div></div><div class="grow"><div class="ti">Design review — Bubbles v2</div><div class="small muted">🕑 Thu 14:00 – 15:00</div><div class="small muted">📍 Room “Ada”, 4th floor</div></div></div></div>
<script>
const DAYS = [
  { name: 'Wed', long: 'Wednesday', date: 8, busy: { '11:30': 'Leo busy', '16:30': 'Priya busy' } },
  { name: 'Thu', long: 'Thursday', date: 9, busy: { '10:00': 'Maya busy' } },
  { name: 'Fri', long: 'Friday', date: 10, busy: { '14:00': 'Leo busy' } },
];
const TIMES = ['10:00', '11:30', '14:00', '16:30'];
const END = { '10:00': '11:00', '11:30': '12:30', '14:00': '15:00', '16:30': '17:30' };
const TEAM = [
  { name: 'Maya Chen', i: 'M', c: '#ff2d55', rsvp: 'yes', org: true },
  { name: 'Leo Park', i: 'L', c: '#34c759', rsvp: 'yes' },
  { name: 'Priya Nair', i: 'P', c: '#af52de', rsvp: 'maybe' },
];
const RSVP = {
  yes: { label: "✓ You're going", c: '#28a745', badge: 'green', word: 'Going' },
  maybe: { label: '? You might come', c: '#e08a00', badge: 'orange', word: 'Maybe' },
  no: { label: '✕ You declined', c: '#ff3b30', badge: 'red', word: 'Declined' },
};
const REPLY = {
  yes: d => `Great, see you ${d}! I'll bring 🍩`,
  maybe: () => 'No pressure, just let me know by tomorrow 🙏',
  no: () => "No worries, I'll share the notes afterwards 📝",
};
let when = { d: 1, t: '14:00' }, prevDate = '', rsvp = null, view = 'main', people = false, pickDay = 1, pick = null;
let proposal = null, reply = null, replyRun = 0, propRun = 0;
const flip = { p: 0 }, pin = { y: -40 }, faces = TEAM.map(() => ({ s: 0 })), me = { s: 0 }, sel = { k: 1 }, list = { k: 1 };

setTimeout(() => {
  tween(flip, { p: 1 }, 650, ease.outBack);
  tween(pin, { y: 44 }, 900, ease.outBounce);
  animate(900, (_, t) => faces.forEach((f, i) => { f.s = ease.outBack(clamp((t * 900 - 250 - i * 130) / 350, 0, 1)); }), ease.linear);
}, 250);

const two = n => String(n).padStart(2, '0');
const slotLabel = (d, t) => `${DAYS[d].name} ${DAYS[d].date} · ${t}`;
const dots = () => '•'.repeat(1 + Math.floor(performance.now() / 250) % 3);
function face(i, c, s) {
  const d = Math.max(1, Math.round(22 * s));
  return `<span class="face" style="width: ${d}px; height: ${d}px; line-height: ${d}px; font-size: ${Math.max(1, Math.round(10 * s))}px; background-color: ${c}">${i}</span>`;
}

async function typeReply(text) {
  const token = ++replyRun;
  reply = { text, typing: true, k: 0 };
  await animate(1100, () => {}, ease.linear);
  if (token !== replyRun) return;
  reply.typing = false;
  tween(reply, { k: 1 }, 380, ease.outCubic);
}

async function waitForMaya() {
  const token = ++propRun;
  await animate(1800, () => {}, ease.linear);
  if (token !== propRun || !proposal) return;
  prevDate = DAYS[when.d].date;
  when = { d: proposal.d, t: proposal.t };
  proposal.state = 'accepted';
  flip.p = 0;
  tween(flip, { p: 1 }, 650, ease.outBack);
}

function onAction(name, value) {
  if (name === 'rsvp' && RSVP[value] && !rsvp) {
    transition('pop');
    rsvp = value;
    if (value !== 'no') { me.s = 0; tween(me, { s: 1 }, 450, ease.outBack); }
    typeReply(REPLY[value](DAYS[when.d].long));
  } else if (name === 'undo') {
    transition('fade');
    rsvp = null; reply = null; replyRun++;
  } else if (name === 'people') {
    transition(people ? 'slide-up' : 'slide-down');
    people = !people;
    list.k = 0;
    tween(list, { k: 1 }, 600, ease.linear);
  } else if (name === 'propose') {
    transition('slide-left');
    view = 'slots'; pickDay = when.d; pick = null;
  } else if (name === 'back') {
    transition('slide-right');
    view = 'main';
  } else if (name === 'pday') {
    const i = Number(value);
    if (i === pickDay || !DAYS[i]) return;
    transition(i > pickDay ? 'slide-left' : 'slide-right');
    pickDay = i;
  } else if (name === 'slot') {
    pick = { d: pickDay, t: value };
    sel.k = 0;
    tween(sel, { k: 1 }, 320, ease.outCubic);
  } else if (name === 'send' && pick) {
    transition('slide-right');
    view = 'main';
    proposal = { d: pick.d, t: pick.t, state: 'pending' };
    waitForMaya();
  } else if (name === 'cancel' || name === 'dismiss') {
    transition('fade');
    proposal = null; propRun++;
  }
}

function attendees() {
  const rows = TEAM.map(p => [p.i, p.c, esc(p.name) + (p.org ? ' <span class="muted">· organizer</span>' : ''), p.rsvp]).concat([['Y', '#007aff', 'You', rsvp]]);
  return rows.map((r, k) => {
    const e = ease.outCubic(clamp(list.k * 1.6 - k * 0.18, 0, 1));
    const st = r[3] ? RSVP[r[3]] : null;
    return `<div class="who" style="left: ${Math.round((1 - e) * 40)}px">${face(r[0], r[1], 1)}<span class="grow">&nbsp;${r[2]}</span><span class="badge ${st ? st.badge : ''}">${st ? st.word : 'No reply'}</span></div>`;
  }).join('');
}

function mainView() {
  const D = DAYS[when.d];
  const all = TEAM.map(p => p.rsvp).concat(rsvp ? [rsvp] : []);
  const n = k => all.filter(r => r === k).length;
  const summary = [`${n('yes')} going`, n('maybe') ? `${n('maybe')} maybe` : '', n('no') ? `${n('no')} declined` : ''].filter(Boolean).join(' · ');
  const avs = TEAM.map((p, i) => face(p.i, p.c, faces[i].s)).join('') + (rsvp && rsvp !== 'no' ? face('Y', '#007aff', me.s) : '');
  let prop = '';
  if (proposal && proposal.state === 'pending')
    prop = `<div class="strip" style="background-color: rgba(0,122,255,0.10)"><span class="grow">⏳ Proposed <b>${slotLabel(proposal.d, proposal.t)}</b> · waiting for Maya ${dots()}</span><span class="mini" data-action="cancel">Cancel</span></div>`;
  else if (proposal)
    prop = `<div class="strip" style="background-color: rgba(52,199,89,0.12)"><span class="grow"><b class="t-green">✓ Maya moved it</b> to ${D.long} ${when.t}</span><span class="mini" data-action="dismiss">OK</span></div>`;
  let bottom;
  if (rsvp) {
    const R = RSVP[rsvp];
    const text = !reply ? '' : reply.typing ? `<span class="muted">is typing ${dots()}</span>` : `<span style="left: ${Math.round((1 - reply.k) * 14)}px">${esc(reply.text)}</span>`;
    bottom = `<div class="strip" style="background-color: ${alpha(R.c, 0.13)}"><b class="grow" style="color: ${R.c}">${R.label}</b><span class="mini" data-action="undo">Undo</span></div>
      ${reply ? `<div class="reply"><b style="color: #ff2d55">Maya</b> ${text}</div>` : ''}
      <div class="prop t-blue" data-action="propose">🗓 Propose new time ›</div>`;
  } else {
    bottom = `<div class="acts"><span class="act t-blue" data-action="rsvp" data-value="yes">Accept</span><span class="act bl t-orange" data-action="rsvp" data-value="maybe">Maybe</span><span class="act bl t-red" data-action="rsvp" data-value="no">Decline</span></div>
      <div class="prop t-blue" data-action="propose">🗓 Propose new time ›</div>`;
  }
  return `<div class="card inv">
    <div class="top">
      <div class="cal"><div class="mon">OCT</div><div class="dwin"><div class="dnum" style="margin-top: ${-Math.round(32 * flip.p)}px">${prevDate === '' ? '&nbsp;' : two(prevDate)}</div><div class="dnum">${two(D.date)}</div></div></div>
      <div class="grow"><div class="ti">Design review — Bubbles v2</div>
        <div class="small muted" style="margin-top: 2px">🕑 ${D.name} ${when.t} – ${END[when.t]}</div>
        <div class="small muted">📍 Room “Ada”, 4th floor</div></div>
    </div>
    <div class="map"><img src="data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27360%27%20height=%27150%27%20viewBox=%270%200%20360%20150%27%3E%3Crect%20width=%27360%27%20height=%27150%27%20fill=%27%23f2efe9%27/%3E%3Crect%20x=%2730%27%20y=%2720%27%20width=%2790%27%20height=%2760%27%20rx=%2718%27%20fill=%27%23c8e6c9%27/%3E%3Cpath%20d=%27M0%20120C120%2080%20240%20150%20360%20100%27%20fill=%27none%27%20stroke=%27%23aad3df%27%20stroke-width=%2714%27/%3E%3Cpath%20d=%27M0%2060L360%2050M200%200L230%20150M90%200L140%20150M0%20140L360%2030%27%20fill=%27none%27%20stroke=%27%23ffffff%27%20stroke-width=%276%27/%3E%3Ccircle%20cx=%27207%27%20cy=%2751%27%20r=%2711%27%20fill=%27%23ff3b30%27/%3E%3Cpath%20d=%27M199%2056L207%2072L215%2056Z%27%20fill=%27%23ff3b30%27/%3E%3Ccircle%20cx=%27207%27%20cy=%2751%27%20r=%274%27%20fill=%27%23ffffff%27/%3E%3C/svg%3E" style="width: 320px; height: 132px; display: block"><div class="pin" style="left: 146px; top: ${Math.round(pin.y)}px">📍</div></div>
    <div class="ppl" data-action="people"><span class="faces">${avs}</span><span class="small muted grow">${summary}</span><span class="small muted">${people ? 'Hide ▴' : 'Attendees ▾'}</span></div>
    ${people ? `<div style="padding-bottom: 6px">${attendees()}</div>` : ''}
    ${prop}${bottom}
  </div>`;
}

function slotsView() {
  const D = DAYS[pickDay];
  const days = DAYS.map((d, i) => `<div class="day ${i === pickDay ? 'on' : ''}" data-action="pday" data-value="${i}"><div class="tiny">${d.name}</div><b>${d.date}</b></div>`).join('');
  const slots = TIMES.map(t => {
    const current = pickDay === when.d && t === when.t, busy = D.busy[t];
    if (current || busy) return `<div class="slot off"><b class="grow">${t} – ${END[t]}</b><span class="small">${current ? 'current time' : busy}</span></div>`;
    const chosen = pick && pick.d === pickDay && pick.t === t;
    const st = chosen ? ` style="border-color: #007aff; background-color: ${alpha('#007aff', 0.16 * sel.k)}"` : '';
    return `<div class="slot free" data-action="slot" data-value="${t}"${st}><b class="grow">${t} – ${END[t]}</b><span class="small ${chosen ? 't-blue' : 't-green'}">${chosen ? '✓ selected' : 'everyone free'}</span></div>`;
  }).join('');
  return `<div class="card inv">
    <div class="row between" style="padding: 10px 12px"><span class="mini" data-action="back">‹ Back</span><b>Propose a new time</b><span style="width: 52px">&nbsp;</span></div>
    <div class="days">${days}</div>
    <div style="padding-bottom: 12px">${slots}</div>
    <div class="acts"><span class="act ${pick ? 't-blue' : 'muted dis'}"${pick ? ' data-action="send"' : ''}>${pick ? `Send proposal · ${slotLabel(pick.d, pick.t)}` : 'Pick a free slot'}</span></div>
  </div>`;
}

function render() { return view === 'slots' ? slotsView() : mainView(); }
</script>

