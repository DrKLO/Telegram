<style>
  .ar { width: 340px; max-width: 100%; background-color: #000000; border-color: #000000; color: #ffffff; }
  .ar .wrap { display: flex; align-items: center; margin-top: 10px; }
  .ar .ring { border-radius: 50%; }
  .ar .mask { background-color: #000000; }
  .ar .lbl { margin-left: 14px; }
  .ar .it { padding: 3px 8px; margin-bottom: 3px; border-radius: 8px; }
  .ar .it:hover { background-color: #1c1c1e; }
  .ar .k { font-size: 11px; font-weight: 700; }
  .ar .v { font-size: 20px; font-weight: 700; color: #ffffff; }
  .ar .u { font-size: 12px; color: #8e8e93; }
  .ar .week { display: flex; justify-content: space-between; margin-top: 12px; }
  .ar .day { width: 40px; padding: 4px 0 3px 0; border-radius: 8px; text-align: center; font-size: 10px; font-weight: 700; color: #8e8e93; }
  .ar .day:hover { background-color: #1c1c1e; }
  .ar .day.on { background-color: #2c2c2e; color: #ffffff; }
  .ar .hint { font-size: 11px; color: #8e8e93; margin-top: 6px; }
  .ar button { background-color: #2c2c2e; color: #ffffff; }
  .ar button:hover { background-color: #3a3a3c; }
  .ar .back { font-size: 12px; color: #8e8e93; }
  .ar .back:hover { color: #ffffff; text-decoration: none; }
  .ar .pct { text-align: center; font-weight: 800; }
  .ar .side { margin-left: 16px; }
  .ar .big { font-size: 26px; font-weight: 800; }
  .ar .hours { display: flex; align-items: flex-end; height: 64px; margin: 12px 0 3px 0; }
  .ar .hours div { width: 10px; margin-right: 3px; border-radius: 2px; }
  .ar .axis { display: flex; justify-content: space-between; font-size: 10px; color: #8e8e93; }
</style>
<div class="card pad ar"><b>Activity</b></div>
<script>
const RINGS = [
  { name: 'MOVE', unit: 'CAL', goal: 500, color: [250, 17, 79], hex: '#fa114f', step: 60, log: '+60 cal' },
  { name: 'EXERCISE', unit: 'MIN', goal: 30, color: [146, 232, 42], hex: '#92e82a', step: 5, log: '+5 min workout' },
  { name: 'STAND', unit: 'HRS', goal: 12, color: [30, 234, 239], hex: '#1eeaef', step: 1, log: '+1 hour stood' },
];
const DAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Today'], TODAY = 6, NOW = 15;
let seed = 11;
const rand = () => (seed = seed * 16807 % 2147483647) / 2147483647;
const HOURS = DAYS.map((_, d) => RINGS.map((r, i) => {
  const target = d === TODAY ? [0.72, 0.9, 0.58][i] : 0.35 + rand() * 0.85;
  const w = Array.from({ length: 24 }, (_, h) => h < 7 || h > 22 || (d === TODAY && h > NOW) ? 0 : 0.2 + rand() * (h % 6 === 0 ? 2.2 : 1));
  const sum = w.reduce((a, b) => a + b, 0);
  return w.map(x => x / sum * target * r.goal);
}));
const total = (d, i) => HOURS[d][i].reduce((a, b) => a + b, 0);
const frac = (d, i) => total(d, i) / RINGS[i].goal;
let day = TODAY, view = 'rings', focus = 0, minis = {};
const vals = { 0: 0, 1: 0, 2: 0 }, bars = { k: 0 }, flash = { a: 0 };

function show(ms) { tween(vals, { 0: frac(day, 0), 1: frac(day, 1), 2: frac(day, 2) }, ms, ease.outCubic); }
setTimeout(() => show(900), 250);

function onAction(name, value) {
  if (name === 'day') {
    day = Number(value);
    return show(700);
  }
  if (name === 'ring') {
    transition('slide-left');
    view = 'detail'; focus = Number(value);
    bars.k = 0;
    tween(bars, { k: 1 }, 700, ease.outCubic);
    return;
  }
  if (name === 'back') { transition('slide-right'); view = 'rings'; return; }
  if (name === 'log' && day === TODAY) {
    const r = RINGS[focus], before = frac(TODAY, focus);
    HOURS[TODAY][focus][NOW] += r.step;
    delete minis[TODAY];
    if (before < 1 && frac(TODAY, focus) >= 1) {
      transition('pop');
      flash.a = 1;
      tween(flash, { a: 0 }, 1200, ease.inQuad);
    }
    show(500);
  }
}

function ring(i, d, only) {
  const c = RINGS[i].color.join(','), f = Math.min(1, vals[i]), deg = f * 360;
  const head = flash.a > 0.01 && i === focus ? mix(`rgb(${c})`, '#ffffff', 0.6 * flash.a) : `rgb(${c})`;
  const fill = deg < 0.5 ? `background-color: rgba(${c},0.22)` : `background: conic-gradient(${head} ${deg.toFixed(1)}deg, rgba(${c},0.22) ${deg.toFixed(1)}deg)`;
  const inner = only !== undefined ? only : i + 1 < RINGS.length ? ring(i + 1, d - 36) : '';
  return `<div class="ring" ${only === undefined ? `data-action="ring" data-value="${i}"` : ''} style="width: ${d - 32}px; height: ${d - 32}px; padding: 16px; border-radius: ${d / 2}px; ${fill}">
    <div class="mask" style="width: ${d - 36}px; height: ${d - 36}px; padding: 2px; border-radius: ${(d - 32) / 2}px">${inner}</div></div>`;
}

function mini(d) {
  if (minis[d]) return minis[d];
  let body = '';
  [42, 29, 16].forEach((r, i) => {
    const len = 2 * Math.PI * r, f = Math.min(1, frac(d, i));
    body += `<circle cx='50' cy='50' r='${r}' fill='none' stroke='${RINGS[i].hex}' stroke-opacity='0.28' stroke-width='11'/>`;
    if (f > 0.01) body += `<circle cx='50' cy='50' r='${r}' fill='none' stroke='${RINGS[i].hex}' stroke-width='11' stroke-linecap='round' stroke-dasharray='${(len * f).toFixed(1)} ${len.toFixed(1)}' transform='rotate(-90 50 50)'/>`;
  });
  return minis[d] = 'data:image/svg+xml;utf8,' + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='26' height='26' viewBox='0 0 100 100'>${body}</svg>`);
}

function rings() {
  const labels = RINGS.map((r, i) => `<div class="it" data-action="ring" data-value="${i}"><div class="k" style="color: rgb(${r.color.join(',')})">${r.name} ›</div>
    <span class="v">${Math.round(vals[i] * r.goal)}</span><span class="u">/${r.goal} ${r.unit}</span></div>`).join('');
  const week = DAYS.map((n, d) => `<div class="day ${d === day ? 'on' : ''}" data-action="day" data-value="${d}"><img src="${mini(d)}" width="26" height="26"><div>${d === TODAY ? 'Today' : n.slice(0, 3)}</div></div>`).join('');
  return `<div class="wrap">${ring(0, 160)}<div class="lbl">${labels}</div></div>
    <div class="week">${week}</div><div class="hint">Tap a ring for details · tap a day to compare</div>`;
}

function detail() {
  const r = RINGS[focus], c = r.color.join(','), f = vals[focus], h = HOURS[day][focus], max = Math.max(...h, r.goal / 12);
  let streak = 0;
  for (let d = day; d >= 0 && frac(d, focus) >= 1; d--) streak++;
  const center = `<div class="pct" style="width: 70px; height: 70px; line-height: 70px; border-radius: 35px; font-size: 18px; color: rgb(${c})">${Math.round(f * 100)}%</div>`;
  const hours = h.map((v, k) => {
    const g = clamp(bars.k * 1.8 - k / 24, 0, 1);
    return `<div style="height: ${Math.max(2, 62 * v / max * ease.outCubic(g)).toFixed(1)}px; background-color: ${v ? `rgb(${c})` : 'rgba(255,255,255,0.12)'}"></div>`;
  }).join('');
  const action = day === TODAY ? `<button data-action="log">${r.log}</button>` : '<span class="u">Past days are read-only</span>';
  return `<div class="row between" style="margin-top: 4px"><a class="back" href="#" data-action="back">‹ Summary</a><span class="k" style="color: rgb(${c})">${r.name} · ${DAYS[day]}</span></div>
    <div class="wrap">${ring(focus, 110, center)}
      <div class="side"><div><span class="big">${Math.round(f * r.goal)}</span><span class="u"> / ${r.goal} ${r.unit}</span></div>
        <div class="u">${f >= 1 ? '<span style="color: #ffffff">Goal closed 🎉</span>' : `${Math.max(0, Math.round((1 - f) * r.goal))} ${r.unit.toLowerCase()} to go`}</div>
        <div class="u">${streak ? `${streak}-day streak 🔥` : 'No streak yet'}</div>
        <div style="margin-top: 8px">${action}</div></div></div>
    <div class="hours">${hours}</div>
    <div class="axis"><span>00</span><span>06</span><span>12</span><span>18</span><span>24</span></div>`;
}

function render() {
  return `<div class="card pad ar">
    <div class="row between"><b>Activity</b><span class="u">${DAYS[day]}</span></div>
    ${view === 'rings' ? rings() : detail()}
  </div>`;
}
</script>

