<div class="card pad lp"><b>Link preview</b></div>
<script>
const SLIDES = [['data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27200%27%20height=%27200%27%20viewBox=%270%200%20200%20200%27%3E%3Cdefs%3E%3ClinearGradient%20id=%27g%27%20x1=%270%27%20y1=%271%27%20x2=%270%27%20y2=%270%27%3E%3Cstop%20offset=%270%27%20stop-color=%27%2389f7fe%27/%3E%3Cstop%20offset=%270.5%27%20stop-color=%27%2366a6ff%27/%3E%3Cstop%20offset=%271%27%20stop-color=%27%232a5298%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width=%27200%27%20height=%27200%27%20fill=%27url%28%23g%29%27/%3E%3Cpath%20d=%27M0%2070C10%2062%2030%2078%2040%2070C50%2062%2070%2078%2080%2070C90%2062%20110%2078%20120%2070C130%2062%20150%2078%20160%2070C170%2062%20190%2078%20200%2070M0%2094C10%2086%2030%20102%2040%2094C50%2086%2070%20102%2080%2094C90%2086%20110%20102%20120%2094C130%2086%20150%20102%20160%2094C170%2086%20190%20102%20200%2094M0%20118C10%20110%2030%20126%2040%20118C50%20110%2070%20126%2080%20118C90%20110%20110%20126%20120%20118C130%20110%20150%20126%20160%20118C170%20110%20190%20126%20200%20118M0%20142C10%20134%2030%20150%2040%20142C50%20134%2070%20150%2080%20142C90%20134%20110%20150%20120%20142C130%20134%20150%20150%20160%20142C170%20134%20190%20150%20200%20142M0%20166C10%20158%2030%20174%2040%20166C50%20158%2070%20174%2080%20166C90%20158%20110%20174%20120%20166C130%20158%20150%20174%20160%20166C170%20158%20190%20174%20200%20166M0%20190C10%20182%2030%20198%2040%20190C50%20182%2070%20198%2080%20190C90%20182%20110%20198%20120%20190C130%20182%20150%20198%20160%20190C170%20182%20190%20198%20200%20190%27%20fill=%27none%27%20stroke=%27%23ffffff%27%20stroke-opacity=%270.35%27%20stroke-width=%272%27/%3E%3C/svg%3E', 'Belém at sunrise'], ['data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27360%27%20height=%27180%27%20viewBox=%270%200%20360%20180%27%3E%3Cdefs%3E%3ClinearGradient%20id=%27g%27%20x1=%270%27%20y1=%271%27%20x2=%270%27%20y2=%270%27%3E%3Cstop%20offset=%270%27%20stop-color=%27%232b1055%27/%3E%3Cstop%20offset=%270.33%27%20stop-color=%27%237597de%27/%3E%3Cstop%20offset=%270.67%27%20stop-color=%27%23ff9a8b%27/%3E%3Cstop%20offset=%271%27%20stop-color=%27%23ffd194%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width=%27360%27%20height=%27180%27%20fill=%27url%28%23g%29%27/%3E%3Ccircle%20cx=%27252%27%20cy=%27110%27%20r=%2732%27%20fill=%27%23fff3c4%27/%3E%3Cpolygon%20points=%270,180%200,130%200,112%2030,110%2060,107%2090,105%20120,102%20150,123%20180,97%20210,118%20240,92%20270,113%20300,110%20330,108%20360,105%20360,180%27%20fill=%27%236a3d7c%27%20fill-opacity=%270.9%27/%3E%3Cpolygon%20points=%270,180%200,150%200,132%2030,130%2060,127%2090,125%20120,122%20150,143%20180,117%20210,138%20240,112%20270,133%20300,130%20330,128%20360,125%20360,180%27%20fill=%27%233f2a5c%27/%3E%3C/svg%3E', 'Miradouro de Santa Catarina'], ['data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27360%27%20height=%27150%27%20viewBox=%270%200%20360%20150%27%3E%3Crect%20width=%27360%27%20height=%27150%27%20fill=%27%23f2efe9%27/%3E%3Crect%20x=%2730%27%20y=%2720%27%20width=%2790%27%20height=%2760%27%20rx=%2718%27%20fill=%27%23c8e6c9%27/%3E%3Cpath%20d=%27M0%20120C120%2080%20240%20150%20360%20100%27%20fill=%27none%27%20stroke=%27%23aad3df%27%20stroke-width=%2714%27/%3E%3Cpath%20d=%27M0%2060L360%2050M200%200L230%20150M90%200L140%20150M0%20140L360%2030%27%20fill=%27none%27%20stroke=%27%23ffffff%27%20stroke-width=%276%27/%3E%3Ccircle%20cx=%27207%27%20cy=%2751%27%20r=%2711%27%20fill=%27%23ff3b30%27/%3E%3Cpath%20d=%27M199%2056L207%2072L215%2056Z%27%20fill=%27%23ff3b30%27/%3E%3Ccircle%20cx=%27207%27%20cy=%2751%27%20r=%274%27%20fill=%27%23ffffff%27/%3E%3C/svg%3E', 'All 12 bakeries on one map']];
const RANKS = [['Manteigaria', 'Chiado', '€1.20'], ['Pastéis de Belém', 'Belém', '€1.40'], ['Aloma', 'Campo de Ourique', '€1.10'],
               ['Fábrica da Nata', 'Baixa', '€1.30'], ['Confeitaria Nacional', 'Rossio', '€1.50']];
const W = 312, TITLE = 'The 12 best pastéis de nata in Lisbon, ranked';
let phase = 'loading', shimmer = 0, run = 0, slide = 0, saved = false;
const reveal = { k: 0 }, strip = { x: 0 }, pop = { s: 1 }, rows = RANKS.map(() => ({ k: 1 }));

function load() {
  const me = ++run;
  phase = 'loading'; reveal.k = 0;
  const t0 = performance.now();
  const f = t => { if (me !== run) return; shimmer = ((t - t0) / 1100) % 1; if (phase === 'loading') requestAnimationFrame(f); };
  requestAnimationFrame(f);
  setTimeout(() => {
    if (me !== run) return;
    phase = 'card';
    tween(reveal, { k: 1 }, 650, ease.outCubic);
  }, 1700);
}
setTimeout(load, 250);

function go(i) {
  slide = (i + SLIDES.length) % SLIDES.length;
  tween(strip, { x: slide * W }, 480, ease.outCubic);
}

function onAction(name, value) {
  if (name === 'reload') { transition('fade'); return load(); }
  if (phase === 'loading') return;
  if (name === 'go') return go(Number(value));
  if (name === 'step') return go(slide + Number(value));
  if (name === 'save') { saved = !saved; pop.s = saved ? 1.6 : 0.7; tween(pop, { s: 1 }, 420, ease.outBack); return; }
  const to = { collapse: ['compact', 'slide-up'], expand: ['card', 'slide-down'], open: ['reader', 'slide-left'], back: ['card', 'slide-right'] }[name];
  if (!to || phase === to[0]) return;
  transition(to[1]);
  phase = to[0];
  if (phase === 'reader') rows.forEach((r, i) => { r.k = 0; setTimeout(() => tween(r, { k: 1 }, 380, ease.outCubic), 120 + i * 70); });
}

function sk(w, h) {
  const x = -30 + shimmer * 160;
  return `<div class="sk" style="width: ${w}; height: ${h}px; background: linear-gradient(90deg, rgba(127,127,127,0.16) ${x - 20}%, rgba(127,127,127,0.34) ${x}%, rgba(127,127,127,0.16) ${x + 20}%)"></div>`;
}
const saveBtn = () => `<button data-action="save" ${saved ? 'class="primary"' : ''}><span style="font-size: ${Math.round(13 * pop.s)}px">🔖</span> ${saved ? 'Saved' : 'Save'}</button>`;

function card() {
  const off = Math.round((1 - reveal.k) * 150), offT = Math.round((1 - reveal.k) * 74);
  const imgs = SLIDES.map(([src], i) => `<img class="slide" src="${src}" style="left: ${(i * W - strip.x).toFixed(1)}px; top: ${off}px">`).join('');
  const dots = SLIDES.map((_, i) => `<span data-action="go" data-value="${i}" style="background-color: ${alpha('#ffffff', 1 - 0.55 * clamp(Math.abs(strip.x / W - i), 0, 1))}"></span>`).join('');
  const arrows = (slide > 0 ? '<div class="arrow" data-action="step" data-value="-1" style="left: 8px">‹</div>' : '') +
                 (slide < SLIDES.length - 1 ? `<div class="arrow" data-action="step" data-value="1" style="left: ${W - 36}px">›</div>` : '');
  return `<div class="img">${imgs}<span class="cap">${SLIDES[slide][1]}</span>${arrows}<div class="dots">${dots}</div></div>
    <div class="txt"><div style="transform: translateY(${offT}px)"><b>${TITLE}</b>
      <div class="small muted" style="margin-top: 3px">We ate 61 custard tarts in four days so you don't have to. #1 is not where you think.</div></div></div>
    <div class="acts" data-pin="bottom"><span><button class="primary" data-action="open">Read article</button>${saveBtn()}</span><a class="lnk" href="#" data-action="collapse">▴ Collapse</a></div>`;
}
function compact() {
  return `<div class="mini" data-action="expand"><img src="${SLIDES[slide][0]}"><div class="grow"><b class="small">${TITLE}</b>
      <div class="tiny muted">4 min read · 12 bakeries${saved ? ' · 🔖 saved' : ''}</div></div><span class="muted">▾</span></div>`;
}
function reader() {
  const list = RANKS.map(([n, area, price], i) => `<div class="rank" style="margin-left: ${Math.round(18 * (1 - rows[i].k))}px">
      <span class="n">${i + 1}</span><span class="grow"><b>${n}</b> <span class="small muted">${area}</span></span><span class="small">${price}</span></div>`).join('');
  return `<div class="reader"><a class="lnk" href="#" data-action="back">‹ Back to preview</a>
    <div style="margin-top: 6px"><b>${TITLE}</b></div><div class="tiny muted">By Inês Duarte · 4 min read</div>
    <p>The perfect nata has a blistered, almost burnt top, a shell that shatters, and custard that is still a little warm. We rated each one on all three.</p>
    <div class="caps" style="margin-bottom: 2px">Top 5</div>${list}
    <div class="acts" data-pin="bottom">${saveBtn()}<span class="tiny muted">7 more in the full list</span></div></div>`;
}

function render() {
  const head = `<div class="row between" data-pin="top" style="margin-bottom: 8px"><span class="small muted">🔗 eatlisboa.example</span><span>
    ${phase === 'loading' ? '<span class="small muted">loading… </span>' : ''}<a class="lnk" href="#" data-action="reload">↻ Reload</a></span></div>`;
  if (phase === 'loading')
    return `<div class="card pad lp">${head}${sk('100%', 150)}<div style="margin-top: 10px">${sk('85%', 16)}${sk('100%', 12)}${sk('60%', 12)}</div></div>`;
  return `<div class="card pad lp">${head}${phase === 'card' ? card() : phase === 'compact' ? compact() : reader()}</div>`;
}
</script>

