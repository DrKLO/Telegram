<style>
  .ai-acts { margin-top: 2px; }
  .ai-acts span { display: inline-block; padding: 1px 8px; margin: 0 4px 2px 0; border-radius: 8px; font-size: 12px; font-weight: 600; background-color: rgba(127,127,127,0.12); }
  .ai-acts span:hover { background-color: rgba(127,127,127,0.24); }
  .ai-acts span.on { background-color: rgba(255,159,10,0.24); }
  .ai-acts span.off, .ai-acts span.off:hover, .ai-acts span.pg, .ai-acts span.pg:hover { background-color: rgba(127,127,127,0); color: #8e8e93; }
</style>
<p>Typing…</p>
<script>
const ANSWERS = [
  "Sure! This bubble re-renders itself every frame: <b>render()</b> returns a slightly longer string each time, and LiteChat lays out a fresh litehtml document. The bubble grows line by line, so the transcript re-flows around it, <i>just like a streamed reply</i>. ✨",
  "Yes. Nothing comes from a server here: a <code>requestAnimationFrame</code> loop reveals a few more characters on every frame, up to 60 times a second, and <b>render()</b> closes any tag that is cut in half. Press <b>Stop</b> and the loop simply ends.",
  "Short version: <b>state → render() → HTML</b>. The script keeps a cursor into the answer and moves it forward each frame, so the bubble's height follows the text. <i>Regenerate</i> starts another draft, and the arrows flip between drafts with a native slide. 🙂",
];
const tokenize = text => text.match(/<[^>]+>|&[a-z]+;|[\s\S]/gu);
let drafts = [], cur = 0, phase = 'idle', run = 0, think0 = 0;
const thumb = { s: 1 };

function stream() {
  const me = ++run, d = drafts[cur];
  phase = 'thinking';
  think0 = performance.now();
  const f = t => {
    if (me !== run) return;
    if (phase === 'thinking' && t - think0 > 650) { phase = 'typing'; d.t0 = t; }
    if (phase === 'typing') {
      d.shown = Math.min(d.chars, Math.floor((t - d.t0) / 20));
      if (d.shown >= d.chars) { phase = 'done'; return; }
    }
    requestAnimationFrame(f);
  };
  requestAnimationFrame(f);
}
function newDraft() {
  const idx = drafts.length ? (drafts[drafts.length - 1].idx + 1) % ANSWERS.length : 0;
  const tokens = tokenize(ANSWERS[idx]);
  drafts.push({ idx, tokens, chars: tokens.filter(t => t[0] !== '<').length, shown: 0, t0: 0, stopped: false, vote: null });
  if (drafts.length > 5) drafts.shift();
  cur = drafts.length - 1;
  stream();
}
setTimeout(newDraft, 250);

function onAction(name, value) {
  const busy = phase === 'thinking' || phase === 'typing';
  if (name === 'stop' && busy) { run++; drafts[cur].stopped = true; phase = 'done'; return; }
  if (busy) return;
  if (name === 'regen') { transition('fade'); return newDraft(); }
  if (name === 'page') {
    const next = clamp(cur + Number(value), 0, drafts.length - 1);
    if (next === cur) return;
    transition(next > cur ? 'slide-left' : 'slide-right');
    cur = next;
    return;
  }
  if (name === 'vote') {
    const d = drafts[cur];
    d.vote = d.vote === value ? null : value;
    thumb.s = 1.6;
    tween(thumb, { s: 1 }, 420, ease.outBack);
  }
}

function cut(d) {
  let n = 0, out = '';
  const open = [];
  for (const t of d.tokens) {
    if (t[0] === '<') {
      if (t[1] === '/') open.pop(); else open.push(t.slice(1).split(/[\s>]/)[0]);
      out += t;
      continue;
    }
    if (n >= d.shown) break;
    n++;
    out += t;
  }
  return out + open.reverse().map(tag => `</${tag}>`).join('');
}

function render() {
  if (!drafts.length) return '<p>Typing…</p>';
  const d = drafts[cur], now = performance.now();
  if (phase === 'thinking') {
    const dots = '.'.repeat(1 + Math.floor((now - think0) / 220) % 3);
    return `<p style="color: ${mix('#8e8e93', '#ff9f0a', 0.5 + 0.5 * Math.sin(now / 160))}">Thinking${dots}</p>
      <div class="ai-acts"><span data-action="stop">■ Stop</span></div>`;
  }
  const caret = phase === 'typing' && Math.floor(now / 400) % 2 === 0 ? '<span style="color: #ff9f0a">▍</span>' : '';
  const tail = d.stopped ? ' <span class="small muted">(stopped)</span>' : '';
  let acts = '<span data-action="stop">■ Stop</span>';
  if (phase === 'done') {
    const pager = drafts.length > 1 ? `<span class="${cur ? '' : 'off'}" ${cur ? 'data-action="page" data-value="-1"' : ''}>‹</span><span class="pg">${cur + 1} / ${drafts.length}</span><span class="${cur < drafts.length - 1 ? '' : 'off'}" ${cur < drafts.length - 1 ? 'data-action="page" data-value="1"' : ''}>›</span>` : '';
    const thumbBtn = (v, icon) => `<span class="${d.vote === v ? 'on' : ''}" data-action="vote" data-value="${v}"${d.vote === v ? ` style="font-size: ${Math.round(12 * thumb.s)}px"` : ''}>${icon}</span>`;
    acts = `<span data-action="regen">↻ Regenerate</span>${pager}${thumbBtn('up', '👍')}${thumbBtn('down', '👎')}`;
  }
  return `<p>${cut(d)}${caret}${tail}</p><div class="ai-acts">${acts}</div>`;
}
</script>

