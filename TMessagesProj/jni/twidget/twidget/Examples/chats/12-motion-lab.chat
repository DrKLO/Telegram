  .eg .n { width: 84px; padding-left: 6px; font-family: ui-monospace; font-size: 11px; color: #8e8e93; }
  .eg .track { position: relative; width: 204px; height: 2px; margin-left: 4px; background-color: rgba(127,127,127,0.25); }
