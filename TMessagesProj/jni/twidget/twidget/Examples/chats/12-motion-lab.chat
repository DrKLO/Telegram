<script>
const STEPS = [
  { name: 'Install dependencies', ms: 900, log: ['$ npm ci', 'resolving 1,284 packages', 'added 1,284 packages in 8.1 s'] },
  { name: 'Build (release)', ms: 1500, log: ['$ swift build -c release', 'compiling 312 files', 'linking LiteChat', 'build ok, 2.4 MB'] },
  { name: 'Run 214 tests', ms: 1300, log: ['$ swift test --parallel', 'running 214 tests on 8 workers', '214 passed, 0 failed'],
    fail: ['$ swift test --parallel', '✗ CheckoutTests.testTimeout (flaky)', '213 passed, 1 failed'] },
  { name: 'Upload bundle', ms: 1000, log: ['$ upload dist/litechat.zip', 'sha256 9f3c…e1a0', 'uploaded 2.4 MB'], fail: ['$ upload dist/litechat.zip', '✗ 503 from storage, connection reset'] },
  { name: 'Roll out to 3 regions', ms: 1400, log: ['eu-west 100% ✓', 'us-east 100% ✓', 'ap-south 100% ✓'], fail: ['eu-west 100% ✓', '✗ us-east health check timed out'] },
];
let steps, current = -1, status = 'queued', spin = 0, runs = 0, run = 0, failAt = -1, open = -1, retries = 0;
const banner = { k: 0 }, shake = { x: 0 };
const fresh = () => { steps = STEPS.map(() => ({ st: 'wait', p: 0, took: 0, pop: { s: 1 } })); current = -1; banner.k = 0; open = -1; retries = 0; };
fresh();

function spinner() { spin = (spin + 6) % 360; if (status === 'running') requestAnimationFrame(spinner); }

function runFrom(i, me) {
  if (status !== 'running') { status = 'running'; requestAnimationFrame(spinner); }
  if (i >= STEPS.length) {
    current = -1; status = 'live';
    transition('pop');
    banner.k = 0;
    tween(banner, { k: 1 }, 1000, ease.outCubic);
    return;
  }
  const s = steps[i], ms = STEPS[i].ms * (0.8 + Math.random() * 0.4), fails = i === failAt;
  current = i; s.st = 'run'; s.p = 0;
  animate(fails ? ms * 0.65 : ms, (p, raw) => {
    if (me !== run) return;
    s.p = fails ? p * 0.65 : p;
    if (raw < 1) return;
    if (fails) {
      failAt = -1; s.st = 'fail'; status = 'failed'; current = -1;
      transition('slide-down');
      open = i;
      animate(450, q => { shake.x = Math.sin(q * Math.PI * 6) * (1 - q) * 7; }, ease.linear);
      return;
    }
    s.st = 'done'; s.took = ms;
    s.pop.s = 0;
    tween(s.pop, { s: 1 }, 320, ease.outBack);
    runFrom(i + 1, me);
  }, ease.inOutSine);
}

function deploy() {
  const me = ++run;
  runs++; fresh();
  failAt = runs === 1 ? 2 : Math.random() < 0.4 ? 2 + Math.floor(Math.random() * 3) : -1;
  runFrom(0, me);
}
setTimeout(deploy, 250);

function onAction(name, value) {
  if (name === 'deploy') { if (status !== 'running') transition('fade'); return deploy(); }
  if (name === 'cancel' && status === 'running') {
    run++;
    transition('fade');
    steps[current].st = 'skip'; current = -1; status = 'cancelled';
    return;
  }
  if (name === 'retry' && status === 'failed') {
    const i = steps.findIndex(s => s.st === 'fail');
    transition('slide-up');
    open = -1; retries++;
    return runFrom(i, ++run);
  }
  if (name === 'log') {
    const i = Number(value);
    transition(open === i ? 'slide-up' : 'slide-down');
    open = open === i ? -1 : i;
  }
}

function render() {
  const rows = STEPS.map((s, i) => {
    const st = steps[i];
    const icon = st.st === 'done' ? `<div class="ok" style="font-size: ${Math.max(1, Math.round(12 * st.pop.s))}px">✓</div>`
      : st.st === 'fail' ? '<div class="ko">!</div>' : st.st === 'skip' ? '<div class="skip">–</div>'
      : st.st === 'run' ? `<div class="ring" style="background: conic-gradient(from ${spin}deg, rgba(10,132,255,0) 0deg, #0a84ff 300deg, rgba(10,132,255,0) 300deg)"><div class="hole"></div></div>`
      : '<div class="wait"></div>';
    const lines = st.st === 'fail' ? s.fail : st.st === 'skip' ? [s.log[0], '✗ cancelled'] : s.log;
    const live = st.st === 'run' ? `<div class="pbar"><div style="width: ${(st.p * 100).toFixed(1)}%; background-color: #0a84ff"></div></div>
        <div class="live muted">${esc(s.log[Math.min(s.log.length - 1, Math.floor(st.p * s.log.length))])}</div>` : '';
    const right = st.st === 'done' ? (st.took / 1000).toFixed(1) + ' s' : st.st === 'run' ? Math.round(st.p * 100) + '%'
                : st.st === 'fail' ? 'failed' : st.st === 'skip' ? 'cancelled' : '';
    const can = st.st === 'done' || st.st === 'fail' || st.st === 'skip';
    const log = open === i && can ? `<div class="log">${lines.map(l => `<div class="${l[0] === '✗' ? 't-red' : l[0] === '$' ? 'muted' : ''}">${esc(l)}</div>`).join('')}</div>` : '';
    return `<div class="st ${can ? 'can' : ''}" ${can ? `data-action="log" data-value="${i}"` : ''} ${st.st === 'fail' ? `style="margin-left: ${shake.x.toFixed(1)}px"` : ''}>
      <div class="ic">${icon}</div><div class="grow"><span class="${st.st === 'wait' ? 'muted' : st.st === 'fail' ? 't-red' : 'fg'}">${s.name}</span>${live}</div>
      <span class="small ${st.st === 'fail' ? 't-red' : 'muted'}">${right}${can ? (open === i ? ' ▴' : ' ▾') : ''}</span></div>${log}`;
  }).join('');
  const total = steps.reduce((t, s) => t + s.took, 0) / 1000;
  let foot = '';
  if (status === 'live') foot = `<div class="banner" style="background-color: rgba(52,199,89,0.14)"><b class="t-green">🚀 Live in production</b>${retries ? ` <span class="tiny muted">after ${retries} retr${retries > 1 ? 'ies' : 'y'}</span>` : ''}
      <div class="stats"><span><b>${(2.4 * banner.k).toFixed(1)}</b> MB</span><span><b>${(total * banner.k).toFixed(1)}</b> s total</span><span><b>${Math.round(214 * banner.k)}</b> tests ✓</span></div></div>`;
  if (status === 'failed') {
    const f = STEPS[steps.findIndex(s => s.st === 'fail')];
    foot = `<div class="banner" style="background-color: rgba(255,59,48,0.12)"><b class="t-red">✗ ${f.name} failed</b>
      <div class="small muted">${esc(f.fail[f.fail.length - 1])}. Retrying runs this step again and continues.</div>
      <div class="acts"><button class="primary" data-action="retry">↻ Retry step</button><button data-action="deploy">Start over</button></div></div>`;
  }
  if (status === 'cancelled') foot = `<div class="banner" style="background-color: rgba(127,127,127,0.12)"><b>Deploy cancelled</b><div class="small muted">Nothing was rolled out. Tap a step to read its log.</div></div>`;
  const badge = { queued: ['blue', 'queued'], running: ['blue', 'running'], failed: ['red', 'failed'], cancelled: ['', 'cancelled'], live: ['green', 'live'] }[status];
  const btn = status === 'running' ? '<button data-action="cancel">■ Cancel</button>'
            : status === 'failed' ? '' : `<button data-action="deploy">↻ ${status === 'live' ? 'Deploy again' : 'Restart'}</button>`;
  return `<div class="card pad dp">
    <div class="row between"><span><b>🛠 Deploy #${1040 + runs}</b> <span class="badge ${badge[0]}">${badge[1]}</span></span>${btn}</div>
    <div style="margin-top: 6px">${rows}</div>${foot}
  </div>`;
}
</script>

