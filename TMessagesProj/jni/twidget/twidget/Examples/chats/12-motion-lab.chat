  .eg .durs span.on { background-color: rgba(127,127,127,0.22); }
</style>
<div class="card pad eg"><b>Easing gallery</b></div>
<script>
const NAMES = ['linear', 'inQuad', 'outQuad', 'inOutQuad', 'outCubic', 'inOutCubic', 'outQuint', 'outExpo', 'inOutSine', 'outBack', 'inOutBack', 'outElastic', 'outBounce', 'spring'];
const COLORS = ['#8e8e93', '#ff9500', '#ffcc00', '#ff6b22', '#34c759', '#30b0c7', '#00c7be', '#32ade6', '#64d2ff', '#007aff', '#5e5ce6', '#af52de', '#ff2d55', '#ff6482'];
const NOTES = {
  linear: 'Constant speed. Robotic, but honest for progress bars.',
  inQuad: 'Starts slow, ends fast. For things leaving the screen.',
  outQuad: 'Fast start, gentle stop. A safe default for UI.',
  inOutQuad: 'Slow at both ends, symmetric.',
  outCubic: 'A softer landing than outQuad. The default of tween().',
  inOutCubic: 'A stronger symmetric ease. The default of animate().',
  outQuint: 'A very quick start and a long glide.',
  outExpo: 'Snappy: 90% of the way in the first third.',
  inOutSine: 'The gentlest symmetric curve. Great for loops.',
  outBack: 'Overshoots by about 10%, then settles.',
  inOutBack: 'Pulls back first, overshoots at the end.',
  outElastic: 'Wobbles past the target like a plucked string.',
  outBounce: 'Drops and bounces three times.',
  spring: 'A damped spring with one soft overshoot.',
};
const DURS = [[600, '0.6 s'], [1200, '1.2 s'], [2400, '2.4 s']];
const R = 190, LANE = 240, gx = t => 8 + t * 356, gy = v => 10 + (1.4 - v) / 1.6 * 160;
let tab = 'race', sel = 'outBack', prev = 'outBack', dur = 1200, raw = 0, forward = true, run = 0, morphRun = 0, graphKey = '', graphURI = '';
const morph = { k: 1 }, trace = { t: 1 };
const color = n => COLORS[NAMES.indexOf(n)];
const value = t => lerp(ease[prev](t), ease[sel](t), morph.k);

function play(rounds) {
  const me = ++run;
  animate(rounds * 2000, (_, t) => {
    if (me !== run) return;
    const at = t * rounds, round = Math.min(rounds - 1, Math.floor(at));
    forward = round % 2 === 0;
    raw = t >= 1 ? 0 : Math.min(1, (at - round) * 2000 / 1500);
    if (t >= 1) forward = true;
  }, ease.linear);
}
function traceIt() {
  const me = ++run;
  trace.t = 0;
  setTimeout(() => { if (me === run) animate(dur, (_, t) => { if (me === run) trace.t = t; }, ease.linear); }, 180);
}
setTimeout(() => play(4), 250);

function onAction(name, value) {
  if (name === 'tab') {
    if (value === tab) return;
    transition(value === 'curve' ? 'slide-left' : 'slide-right');
    tab = value;
    return tab === 'race' ? play(2) : traceIt();
  }
  if (name === 'play') return tab === 'race' ? play(2) : traceIt();
  if (name === 'dur') { dur = Number(value); return traceIt(); }
  if (name !== 'pick') return;
  if (tab === 'race') {
    transition('slide-left');
    tab = 'curve'; prev = sel = value; morph.k = 1; morphRun++;
    return traceIt();
  }
  if (value === sel) return traceIt();
  prev = sel; sel = value;
  const me = ++run, mm = ++morphRun;
  trace.t = 1;
  animate(450, (p, t) => { if (mm !== morphRun) return; morph.k = p; if (t >= 1 && me === run) traceIt(); }, ease.inOutCubic);
}

function graph() {
  const key = prev + sel + morph.k.toFixed(3);
  if (key === graphKey) return graphURI;
  let d = '';
  for (let i = 0; i <= 64; i++) d += `${i ? ' L' : 'M'}${gx(i / 64).toFixed(1)} ${gy(value(i / 64)).toFixed(1)}`;
  const grid = [0, 1].map(v => `<line x1='8' y1='${gy(v)}' x2='364' y2='${gy(v)}' stroke='#8e8e93' stroke-opacity='0.5' stroke-dasharray='3 4'/>`).join('');
  graphKey = key;
  graphURI = 'data:image/svg+xml;utf8,' + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='372' height='180' viewBox='0 0 372 180'>
    <rect x='0.5' y='0.5' width='371' height='179' rx='10' fill='#8e8e93' fill-opacity='0.07' stroke='#8e8e93' stroke-opacity='0.25'/>${grid}
    <line x1='${gx(0)}' y1='${gy(0)}' x2='${gx(1)}' y2='${gy(1)}' stroke='#8e8e93' stroke-opacity='0.55' stroke-width='1.5'/>
    <path d='${d}' fill='none' stroke='${color(sel)}' stroke-width='3' stroke-linejoin='round' stroke-linecap='round'/></svg>`);
  return graphURI;
}

function race() {
  return '<div style="margin-top: 8px">' + NAMES.map((n, i) => {
    const e = ease[n](raw), x = (forward ? e : 1 - e) * R, big = n === sel;
    const s = big ? 16 : 12;
    return `<div class="r ${big ? 'sel' : ''}" data-action="pick" data-value="${n}"><span class="n" ${big ? `style="color: ${color(n)}; font-weight: 700"` : ''}>${n}</span><div class="track">
      <div class="dot" style="left: ${(x + (16 - s) / 2).toFixed(1)}px; top: ${-s / 2 + 1}px; width: ${s}px; height: ${s}px; background-color: ${COLORS[i]}"></div></div></div>`;
  }).join('') + '<div class="tiny muted" style="margin-top: 6px">Tap a curve to plot it against linear</div></div>';
}

function curve() {
  const t = trace.t, v = value(t), c = color(sel);
  const chips = NAMES.map(n => `<span data-action="pick" data-value="${n}" ${n === sel ? `style="background-color: ${c}; color: #ffffff"` : ''}>${n}</span>`).join('');
  const durs = DURS.map(([ms, label]) => `<span class="${ms === dur ? 'on' : ''}" data-action="dur" data-value="${ms}">${label}</span>`).join('');
  return `<div class="graph"><img src="${graph()}" width="372" height="180">
      <div class="cursor" style="left: ${gx(t).toFixed(1)}px"></div>
      <div class="gdot" style="left: ${(gx(t) - 6).toFixed(1)}px; top: ${(gy(v) - 6).toFixed(1)}px; background-color: ${c}"></div></div>
    <div class="row between" style="margin-top: 6px"><span class="small"><b style="color: ${c}">${sel}</b> <span class="muted">${NOTES[sel]}</span></span></div>
    <div class="lane"><div class="box" style="left: ${(26 + v * LANE).toFixed(1)}px; background-color: ${c}"></div><span class="ln">${sel}</span></div>
    <div class="lane"><div class="box" style="left: ${(26 + t * LANE).toFixed(1)}px; background-color: #8e8e93"></div><span class="ln">linear</span></div>
    <div class="row between" style="margin-top: 6px"><span class="tiny muted" style="font-family: ui-monospace">t ${t.toFixed(2)} → ${v.toFixed(2)}</span><span class="durs">${durs}</span></div>
    <div class="chips">${chips}</div>`;
}

function render() {
  const tabs = [['race', 'Race'], ['curve', 'Curve']].map(([id, label]) => `<span class="tab ${tab === id ? 'on' : ''}" data-action="tab" data-value="${id}">${label}</span>`).join('');
  return `<div class="card pad eg">
    <div class="row between"><span><b>Easing gallery</b>${tabs}</span><button data-action="play">↻ Replay</button></div>
    ${tab === 'race' ? race() : curve()}
  </div>`;
}
</script>

