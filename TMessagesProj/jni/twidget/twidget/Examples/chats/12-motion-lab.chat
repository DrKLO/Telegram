<div class="card pad cf"><b>🚀 v2.0 shipped</b></div>
<script>
const PALETTE = [[255, 45, 85], [255, 204, 0], [52, 199, 89], [10, 132, 255], [191, 90, 242], [255, 159, 10], [100, 210, 255]];
const MODES = [['cannons', '🎊 Cannons'], ['rain', '🌧 Rain'], ['fireworks', '🎆 Fireworks']];
const NOTES = [['✨', 'Scripted bubbles now animate at 60 fps'], ['🧭', 'Native transitions between states'], ['🎨', 'tween(), mix() and alpha() helpers'], ['🐛', '42 fixes, 0 regressions']];
const MAX = 150;
let bits = [], last = 0, flying = false, bursts = 0, mode = 'cannons', rainUntil = 0, cheers = 0, open = false, rockets = [];
const title = { s: 1 }, cheer = { s: 1 }, rows = NOTES.map(() => ({ k: 1 }));
const rgb = () => PALETTE[Math.floor(Math.random() * PALETTE.length)];

function add(b) { bits.push(b); if (bits.length > MAX) bits.splice(0, bits.length - MAX); }
function conf(x, y, vx, vy, born, life) {
  add({ kind: 'conf', x, y, vx, vy, w: 6 + Math.random() * 5, h: 9 + Math.random() * 6, spin: Math.random() * 6,
        spinRate: 5 + Math.random() * 9, rgb: rgb(), born, life, emoji: Math.random() < 0.06 ? ['🎉', '✨', '⭐️'][bits.length % 3] : null });
}
function go() { if (!flying) { flying = true; last = performance.now(); requestAnimationFrame(step); } }

function burst() {
  bursts++;
  const now = performance.now();
  if (mode === 'cannons') for (let i = 0; i < 64; i++) {
    const left = i % 2 === 0, a = ((left ? -62 : -118) + (Math.random() - 0.5) * 40) * Math.PI / 180, v = 330 + Math.random() * 260;
    conf(left ? 8 : 344, 205, Math.cos(a) * v, Math.sin(a) * v, now, 2600 + Math.random() * 1200);
  }
  if (mode === 'rain') rainUntil = now + 1800;
  if (mode === 'fireworks') for (let k = 0; k < 3; k++)
    rockets.push({ x: 60 + Math.random() * 232, y: 205, vy: -(300 + Math.random() * 70), fuse: now + 650 + k * 380 + Math.random() * 150, launch: now + k * 380, rgb: rgb() });
  title.s = 0.2;
  tween(title, { s: 1 }, 1000, ease.outElastic);
  go();
}

function explode(r, now) {
  for (let i = 0; i < 34; i++) {
    const a = i / 34 * Math.PI * 2, v = 80 + Math.random() * 90;
    add({ kind: 'spark', x: r.x, y: r.y, vx: Math.cos(a) * v, vy: Math.sin(a) * v, rgb: r.rgb, born: now, life: 1100 + Math.random() * 500 });
  }
}

function step(t) {
  const dt = Math.min(0.05, (t - last) / 1000);
  last = t;
  if (t < rainUntil) for (let i = 0; i < 2; i++) conf(Math.random() * 352, -12, (Math.random() - 0.5) * 40, 60 + Math.random() * 80, t, 2600);
  rockets = rockets.filter(r => {
    if (t < r.launch) return true;
    if (t >= r.fuse) { explode(r, t); return false; }
    r.y += r.vy * dt; r.vy += 240 * dt;
    return true;
  });
  for (const b of bits) {
    if (b.kind === 'spark') { b.vx *= 1 - 1.8 * dt; b.vy = b.vy * (1 - 1.8 * dt) + 90 * dt; }
    else { b.vx *= 1 - 1.6 * dt; b.vy = Math.min(b.vy + 700 * dt, 95 + 45 * Math.sin(b.spin)); b.spin += b.spinRate * dt; }
    b.x += b.vx * dt; b.y += b.vy * dt;
  }
  bits = bits.filter(b => t - b.born < b.life && b.y < 215);
  if (bits.length || rockets.length || t < rainUntil) requestAnimationFrame(step); else flying = false;
}

setTimeout(burst, 250);

function onAction(name, value) {
  if (name === 'mode') { mode = value; return burst(); }
  if (name === 'burst') return burst();
  if (name === 'cheer') {
    cheers++;
    cheer.s = 1.5;
    tween(cheer, { s: 1 }, 420, ease.outBack);
    const now = performance.now();
    for (let i = 0; i < 14; i++) {
      const a = (-90 + (Math.random() - 0.5) * 70) * Math.PI / 180, v = 220 + Math.random() * 160;
      conf(176, 205, Math.cos(a) * v, Math.sin(a) * v, now, 1800 + Math.random() * 600);
    }
    return go();
  }
  if (name === 'notes') {
    transition(open ? 'slide-up' : 'slide-down');
    open = !open;
    if (open) rows.forEach((r, i) => { r.k = 0; setTimeout(() => tween(r, { k: 1 }, 420, ease.outCubic), 60 + i * 80); });
  }
}

function render() {
  const t = performance.now();
  const parts = bits.map(b => {
    const age = (t - b.born) / b.life, a = age > 0.7 ? Math.max(0, (1 - age) / 0.3) : 1;
    if (b.emoji) return `<div class="e" style="left: ${b.x.toFixed(0)}px; top: ${b.y.toFixed(0)}px">${b.emoji}</div>`;
    if (b.kind === 'spark') return `<div class="p" style="left: ${b.x.toFixed(0)}px; top: ${b.y.toFixed(0)}px; width: 4px; height: 4px; background-color: rgba(${b.rgb.join(',')},${a.toFixed(2)})"></div>`;
    const w = Math.max(1.5, b.w * Math.abs(Math.cos(b.spin)));
    return `<div class="p" style="left: ${(b.x - w / 2).toFixed(0)}px; top: ${b.y.toFixed(0)}px; width: ${w.toFixed(1)}px; height: ${b.h.toFixed(0)}px; background-color: rgba(${b.rgb.join(',')},${a.toFixed(2)})"></div>`;
  }).join('');
  const trails = rockets.filter(r => t >= r.launch).map(r => `<div class="p" style="left: ${r.x.toFixed(0)}px; top: ${r.y.toFixed(0)}px; width: 3px; height: 12px; background-color: rgba(255,230,160,0.9)"></div>`).join('');
  const modes = MODES.map(([id, label]) => `<span class="m ${mode === id ? 'on' : ''}" data-action="mode" data-value="${id}">${label}</span>`).join('');
  const notes = open ? '<div style="margin-top: 6px">' + NOTES.map(([ic, text], i) =>
    `<div class="note" style="margin-left: ${Math.round(24 * (1 - rows[i].k))}px"><span class="ic">${ic}</span><span class="${rows[i].k > 0.6 ? 'fg' : 'muted'}">${text}</span></div>`).join('') + '</div>' : '';
  return `<div class="card pad cf">
    <div class="row between" style="margin-bottom: 8px"><b>🚀 Release party</b>
      <span><button data-action="cheer"><span style="font-size: ${Math.round(14 * cheer.s)}px">🙌</span> ${cheers}</button> <button class="primary" data-action="burst">🎉 Again</button></span></div>
    <div class="stage">
      <div class="title" style="font-size: ${Math.max(1, Math.round(30 * title.s))}px">v2.0 shipped!</div>
      <div class="sub">${bursts > 1 ? `${bursts} rounds of confetti 🥳` : '42 PRs · 9 contributors · 0 regressions'}</div>
      ${trails}${parts}
    </div>
    <div class="modes"><span>${modes}</span><a class="lnk" href="#" data-action="notes">What's new ${open ? '▴' : '▾'}</a></div>
    ${notes}
  </div>`;
}
</script>

