<style>
  .sl { width: 330px; max-width: 100%; }
  .sl .wrap { position: relative; overflow: hidden; border-radius: 14px; }
  .sl .machine { padding: 10px 12px 12px 12px; border-radius: 14px; background: linear-gradient(180deg, #8e1d2c, #c0392b); }
  .sl .lights { display: flex; justify-content: space-between; margin: 0 4px 9px 4px; }
  .sl .lights div { width: 9px; height: 9px; border-radius: 5px; }
  .sl .reels { display: flex; justify-content: space-between; }
  .sl .reel { width: 88px; height: 76px; overflow: hidden; border-radius: 10px; background: linear-gradient(180deg, #d8d8d8, #ffffff 30%, #ffffff 70%, #d8d8d8); text-align: center; }
  .sl .reel div { font-size: 44px; line-height: 76px; height: 76px; }
  .sl .msg { text-align: center; margin-top: 10px; height: 24px; line-height: 24px; font-weight: 800; color: #ffffff; }
  .sl .coin { position: absolute; font-size: 18px; }
  .sl .foot { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }
  .sl .bet { display: flex; align-items: center; }
  .sl .bet button { width: 28px; padding: 3px 0; }
  .sl .bet b { width: 34px; text-align: center; }
  .sl .lnk { font-size: 12px; }
  .sl .lnk:hover { text-decoration: underline; }
  .sl .pay { margin-top: 8px; }
  .sl .pay div { display: flex; justify-content: space-between; padding: 3px 2px; font-size: 12.5px; border-top: 1px solid rgba(127,127,127,0.16); }
</style>
<div class="card pad sl"><b>🎰 Slots</b></div>
<script>
const SYM = ['🍒', '🍋', '🔔', '⭐️', '🍇', '7️⃣', '💎'];
const PAY = { '7️⃣': 50, '💎': 25, '⭐️': 15 }, BETS = [1, 2, 5, 10, 25], BULBS = 11;
let pos = [0, 2, 4], spinning = false, coins = 100, msg = 'Pull to play', bi = 2, spins = 0, bestWin = 0, paytable = false;
let rain = [], looping = false, last = 0, chase = 0, big = false;
const shown = { v: 100 }, betPop = { s: 1 }, flash = { a: 0 }, msgPop = { s: 1 };

function loop() { if (!looping) { looping = true; last = performance.now(); requestAnimationFrame(step); } }
function step(t) {
  const dt = Math.min(0.05, (t - last) / 1000);
  last = t;
  if (spinning) chase += dt * 14;
  for (const c of rain) { c.vy += 500 * dt; c.y += c.vy * dt; c.x += c.vx * dt; }
  rain = rain.filter(c => c.y < 190);
  if (spinning || rain.length || flash.a > 0.01) requestAnimationFrame(step); else looping = false;
}

function spin() {
  const bet = BETS[bi];
  if (spinning || coins < bet) return;
  spinning = true; spins++; big = false;
  coins -= bet; msg = '';
  tween(shown, { v: coins }, 300, ease.outCubic);
  let result = [0, 1, 2].map(() => Math.floor(Math.random() * SYM.length));
  if (Math.random() < 0.16) result = [result[0], result[0], result[0]];
  else if (Math.random() < 0.3) result[1] = result[0];
  const from = pos.slice();
  const goals = result.map((r, i) => Math.ceil(from[i] / SYM.length) * SYM.length + (3 + i) * SYM.length + r);
  let landed = 0;
  goals.forEach((g, i) => animate(1100 + i * 450, (p, raw) => {
    pos[i] = lerp(from[i], g, p);
    if (raw >= 1 && ++landed === 3) settle(result, goals);
  }, ease.outBack));
  loop();
}

function settle(result, goals) {
  pos = goals.map(g => g % SYM.length);
  spinning = false;
  const [a, b, c] = result, bet = BETS[bi];
  const mult = a === b && b === c ? PAY[SYM[a]] || 10 : a === b || b === c || a === c ? 2 : 0;
  if (mult) {
    const win = bet * mult;
    transition('pop');
    coins += win;
    bestWin = Math.max(bestWin, win);
    big = mult >= 10;
    msg = big ? `JACKPOT ${SYM[a]}${SYM[a]}${SYM[a]} +${win}` : `Pair! +${win}`;
    msgPop.s = 1.5;
    tween(msgPop, { s: 1 }, 500, ease.outBack);
    tween(shown, { v: coins }, big ? 1200 : 600, ease.outCubic);
    animate(big ? 1600 : 700, p => { flash.a = p >= 1 ? 0 : Math.abs(Math.sin(p * (big ? 6 : 2) * Math.PI)); }, ease.linear);
    if (big) for (let k = 0; k < 24; k++) rain.push({ x: 10 + Math.random() * 270, y: -20 - Math.random() * 120, vx: (Math.random() - 0.5) * 40, vy: 40 + Math.random() * 80 });
    loop();
  } else msg = ['So close…', 'Nothing this time', 'Try again'][spins % 3];
  if (coins < BETS[bi]) bi = Math.max(0, BETS.filter(x => x <= coins).length - 1);
}

function onAction(name, value) {
  if (name === 'spin') {
    if (coins < BETS[0] && !spinning) {
      transition('pop');
      coins = 100; msg = 'Refilled 🪙 Pull to play';
      tween(shown, { v: coins }, 700, ease.outCubic);
      return;
    }
    return spin();
  }
  if (name === 'bet' && !spinning) {
    const next = name === 'bet' && value === 'max' ? Math.max(0, BETS.filter(x => x <= coins).length - 1) : clamp(bi + Number(value), 0, BETS.length - 1);
    if (next === bi || BETS[next] > coins) return;
    bi = next;
    betPop.s = 1.5;
    tween(betPop, { s: 1 }, 380, ease.outBack);
    return;
  }
  if (name === 'pay') { transition(paytable ? 'slide-up' : 'slide-down'); paytable = !paytable; }
}
setTimeout(() => { msgPop.s = 0.3; tween(msgPop, { s: 1 }, 700, ease.outElastic); chase = 0; animate(800, p => { chase = p * 11; }, ease.outCubic); }, 250);

function reel(p) {
  const k = Math.floor(p), frac = p - k, n = SYM.length;
  return `<div class="reel"><div style="margin-top: ${(-frac * 76).toFixed(1)}px">${SYM[(k % n + n) % n]}</div><div>${SYM[((k + 1) % n + n) % n]}</div></div>`;
}

function render() {
  const f = flash.a;
  const glow = f > 0.01 ? `background: linear-gradient(180deg, ${mix('#8e1d2c', '#ffc72c', f)}, #c0392b)` : '';
  const bulbs = Array.from({ length: BULBS }, (_, i) => {
    const lit = f > 0.01 && !spinning ? (i % 2 === 0) === (f > 0.5) : (Math.floor(chase) - i) % 3 === 0;
    return `<div style="background-color: ${lit ? '#ffd60a' : f > 0.01 ? mix('#5a1a20', '#ffd60a', f * 0.5) : '#5a1a20'}"></div>`;
  }).join('');
  const coinsHTML = rain.map(c => `<div class="coin" style="left: ${c.x.toFixed(0)}px; top: ${c.y.toFixed(0)}px">🪙</div>`).join('');
  const bet = BETS[bi], broke = coins < BETS[0];
  const table = paytable ? `<div class="pay">
      <div><span>7️⃣ 7️⃣ 7️⃣</span><b>×50</b></div><div><span>💎 💎 💎</span><b>×25</b></div><div><span>⭐️ ⭐️ ⭐️</span><b>×15</b></div>
      <div><span>Any three of a kind</span><b>×10</b></div><div><span>Any pair</span><b>×2</b></div>
      <div class="muted"><span>${spins} spins · biggest win ${bestWin}</span><span>&nbsp;</span></div></div>` : '';
  return `<div class="card pad sl">
    <div class="wrap"><div class="machine" style="${glow}">
      <div class="lights">${bulbs}</div>
      <div class="reels">${pos.map(reel).join('')}</div>
      <div class="msg" style="font-size: ${Math.max(1, Math.round(15 * msgPop.s))}px">${msg}</div>
    </div>${coinsHTML}</div>
    <div class="foot"><span>🪙 <b>${Math.round(shown.v)}</b></span>
      <span class="bet"><span class="small muted">Bet&nbsp;</span><button data-action="bet" data-value="-1">−</button><b style="font-size: ${Math.round(14 * betPop.s)}px">${bet}</b><button data-action="bet" data-value="1">+</button>&nbsp;<a class="lnk" href="#" data-action="bet" data-value="max">max</a></span>
      <button class="primary" data-action="spin" style="background-color: ${spinning ? '#8e8e93' : broke ? '#34c759' : '#ff3b30'}">${spinning ? 'Spinning…' : broke ? '↻ Refill' : `SPIN · ${bet}`}</button></div>
    <div class="row between" style="margin-top: 6px"><span class="tiny muted">${big ? '🎉 Big win!' : 'Three of a kind pays ×10 or more'}</span><a class="lnk" href="#" data-action="pay">Paytable ${paytable ? '▴' : '▾'}</a></div>
    ${table}
  </div>`;
}
</script>

