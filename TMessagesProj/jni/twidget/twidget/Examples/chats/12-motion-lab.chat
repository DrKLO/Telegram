<style>
  .rx { width: 360px; max-width: 100%; }
  .rx .tab { display: inline-block; padding: 2px 10px; margin-left: 3px; border-radius: 7px; font-size: 12px; font-weight: 600; }
  .rx .tab:hover { background-color: rgba(127,127,127,0.16); }
  .rx .tab.on { background-color: rgba(255,45,85,0.14); color: #ff2d55; }
  .rx .stage { position: relative; height: 170px; overflow: hidden; margin-top: 8px; border-radius: 12px; background: linear-gradient(180deg, rgba(127,127,127,0.04), rgba(127,127,127,0.14)); }
  .rx .live { position: absolute; left: 10px; top: 10px; }
  .rx .combo { position: absolute; right: 12px; top: 6px; font-weight: 900; }
  .rx .fl { position: absolute; }
  .rx .btns { display: flex; justify-content: space-between; margin-top: 8px; }
  .rx .btns span.r { display: inline-block; width: 60px; text-align: center; padding: 5px 0; border-radius: 16px; background-color: rgba(127,127,127,0.14); font-size: 13px; font-weight: 700; }
  .rx .btns span.r:hover { background-color: rgba(127,127,127,0.26); }
  .rx .btns span.hype { width: 70px; background-color: rgba(255,45,85,0.14); color: #ff2d55; }
  .rx .btns span.hype:hover { background-color: rgba(255,45,85,0.26); }
  .rx .st { display: flex; align-items: center; height: 32px; }
  .rx .st .em { width: 30px; font-size: 18px; }
  .rx .st .tr { width: 214px; height: 16px; margin-left: 6px; border-radius: 6px; background-color: rgba(127,127,127,0.12); }
  .rx .st .fill { height: 16px; border-radius: 6px; }
  .rx .st .num { width: 82px; text-align: right; font-size: 12px; font-weight: 700; }
  .rx .sum { display: flex; justify-content: space-between; margin-top: 8px; font-size: 12px; }
</style>
<div class="card pad rx"><b>Live reactions</b></div>
<script>
const KINDS = ['❤️', '😂', '🔥', '👏'], TINT = ['#ff2d55', '#ffcc00', '#ff9500', '#5e5ce6'];
const counts = [128, 41, 77, 63];
let floats = [], pending = [], flying = false, tab = 'live', taps = 0, lastTap = -9999, streak = 0, bestStreak = 0, hypeUntil = 0, hypes = 0;
const pops = KINDS.map(() => ({ s: 1 })), bars = KINDS.map(() => ({ w: 0 })), watchers = { v: 1200 }, combo = { s: 1 };

function spawn(i, t) {
  floats.push({ i, x0: 40 + i * 84 + (Math.random() - 0.5) * 30, born: t, life: 1700 + Math.random() * 700,
                wobble: 14 + Math.random() * 14, phase: Math.random() * 6, size: 22 + Math.random() * 10 });
  if (floats.length > 60) floats.shift();
}
function fly(t) {
  pending = pending.filter(p => { if (p.at > t) return true; counts[p.i]++; spawn(p.i, t); return false; });
  if (t < hypeUntil && Math.random() < 0.35) { const k = Math.floor(Math.random() * 4); counts[k]++; spawn(k, t); }
  floats = floats.filter(f => t - f.born < f.life);
  if (floats.length || pending.length || t < hypeUntil) requestAnimationFrame(fly); else flying = false;
}
function wake() { if (!flying) { flying = true; requestAnimationFrame(fly); } }
function crowd(i, n) {
  let at = performance.now();
  for (let k = 0; k < n; k++) { at += 180 + Math.random() * 380; pending.push({ at, i: Math.random() < 0.6 ? i : Math.floor(Math.random() * 4) }); }
  if (pending.length > 24) pending.splice(0, pending.length - 24);
  wake();
}
setTimeout(() => crowd(0, 4), 250);

function grow() { bars.forEach((b, i) => { b.w = 0; setTimeout(() => tween(b, { w: 1 }, 600, ease.outCubic), 60 + i * 70); }); }

function onAction(name, value) {
  const now = performance.now();
  if (name === 'tab') {
    if (value === tab) return;
    transition(value === 'stats' ? 'slide-left' : 'slide-right');
    tab = value;
    if (tab === 'stats') grow();
    return;
  }
  if (name === 'hype') {
    hypes++;
    hypeUntil = now + 3500;
    tween(watchers, { v: 1300 + Math.random() * 700 }, 1400, ease.outCubic);
    return wake();
  }
  const i = Number(value);
  counts[i]++; taps++;
  streak = now - lastTap < 700 ? streak + 1 : 1;
  lastTap = now;
  bestStreak = Math.max(bestStreak, streak);
  if (streak >= 3) { combo.s = 1.7; tween(combo, { s: 1 }, 380, ease.outBack); }
  spawn(i, now);
  crowd(i, 2);
  pops[i].s = 1.45;
  tween(pops[i], { s: 1 }, 320, ease.outBack);
}

function live() {
  const t = performance.now();
  const parts = floats.map(f => {
    const a = (t - f.born) / f.life, y = 150 - a * 175;
    const x = f.x0 + Math.sin(a * 7 + f.phase) * f.wobble * a;
    const s = f.size * (a < 0.15 ? ease.outBack(a / 0.15) : a > 0.8 ? Math.max(0.05, (1 - a) / 0.2) : 1);
    return `<div class="fl" style="left: ${(x - s / 2).toFixed(0)}px; top: ${y.toFixed(0)}px; font-size: ${Math.max(1, s).toFixed(0)}px">${KINDS[f.i]}</div>`;
  }).join('');
  const fade = clamp(1 - (t - lastTap - 600) / 400, 0, 1);
  const badge = streak >= 3 && fade > 0 ? `<div class="combo" style="font-size: ${Math.round(20 * combo.s)}px; color: ${alpha('#ff2d55', fade)}">×${streak}</div>` : '';
  const hype = t < hypeUntil ? ' · 📣 hype!' : '';
  const btns = KINDS.map((k, i) => `<span class="r" data-action="react" data-value="${i}"><span style="font-size: ${Math.round(13 * pops[i].s)}px">${k}</span> ${counts[i]}</span>`).join('');
  return `<div class="stage"><span class="live badge red">● LIVE · ${(watchers.v / 1000).toFixed(1)}k watching${hype}</span>${badge}${parts}</div>
    <div class="btns">${btns}<span class="r hype" data-action="hype">📣 Hype</span></div>`;
}

function stats() {
  const total = counts.reduce((s, c) => s + c, 0), max = Math.max(...counts);
  const order = KINDS.map((_, i) => i).sort((a, b) => counts[b] - counts[a]);
  const rows = order.map((i, rank) => `<div class="st"><span class="em">${KINDS[i]}</span>
      <div class="tr"><div class="fill" style="width: ${(214 * counts[i] / max * bars[rank].w).toFixed(1)}px; background-color: ${alpha(TINT[i], 0.75)}"></div></div>
      <span class="num">${counts[i]} · ${Math.round(counts[i] / total * 100)}%${rank === 0 ? ' 👑' : ''}</span></div>`).join('');
  return `<div style="margin-top: 8px">${rows}</div>
    <div class="sum muted"><span>${total} reactions · ${hypes} hype${hypes === 1 ? '' : 's'}</span><span>You tapped ${taps}× · best streak ×${bestStreak}</span></div>`;
}

function render() {
  const tabs = [['live', 'Live'], ['stats', 'Stats']].map(([id, label]) => `<span class="tab ${tab === id ? 'on' : ''}" data-action="tab" data-value="${id}">${label}</span>`).join('');
  return `<div class="card pad rx">
    <div class="row between"><b>Live reactions</b><span>${tabs}</span></div>
    ${tab === 'live' ? live() : stats()}
  </div>`;
}
</script>

