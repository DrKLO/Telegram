               background: linear-gradient(160deg, #1d1b4b, #3b1d5e 55%, #6b2a63); }
  .cf .title { color: #ffffff; font-weight: 800; padding-top: 62px; height: 52px; line-height: 52px; }
  .cf .sub { color: rgba(255,255,255,0.75); font-size: 13px; }
