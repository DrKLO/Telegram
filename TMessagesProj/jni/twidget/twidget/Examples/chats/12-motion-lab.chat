%200-1.6M142.8%2076a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M195.8%20105a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M48.8%2024a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M101.8%2053a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M154.8%2082a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M7.8%201a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M60.8%2030a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M113.8%2059a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M166.8%2088a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M19.8%207a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M72.8%2036a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M125.8%2065a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M178.8%2094a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M31.8%2013a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M84.8%2042a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M137.8%2071a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M190.8%20100a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M43.8%2019a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M96.8%2048a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M149.8%2077a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M2.8%20106a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M55.8%2025a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M108.8%2054a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M161.8%2083a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M14.8%202a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M67.8%2031a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6%27%20fill=%27%23ffffff%27%20fill-opacity=%270.8%27/%3E%3Cpath%20d=%27M0%20200V165C70%20140%20130%20185%20200%20160V200Z%27%20fill=%27%23081322%27/%3E%3C/svg%3E', length: 187, bpm: 96, c: ['#30d158', '#64d2ff'] },
  { title: 'Reflow (Night Mix)', artist: 'Shrink-to-Fit', art: 'data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27200%27%20height=%27200%27%20viewBox=%270%200%20200%20200%27%3E%3Cdefs%3E%3ClinearGradient%20id=%27g%27%20x1=%270%27%20y1=%271%27%20x2=%270%27%20y2=%270%27%3E%3Cstop%20offset=%270%27%20stop-color=%27%2389f7fe%27/%3E%3Cstop%20offset=%270.5%27%20stop-color=%27%2366a6ff%27/%3E%3Cstop%20offset=%271%27%20stop-color=%27%232a5298%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width=%27200%27%20height=%27200%27%20fill=%27url%28%23g%29%27/%3E%3Cpath%20d=%27M0%2070C10%2062%2030%2078%2040%2070C50%2062%2070%2078%2080%2070C90%2062%20110%2078%20120%2070C130%2062%20150%2078%20160%2070C170%2062%20190%2078%20200%2070M0%2094C10%2086%2030%20102%2040%2094C50%2086%2070%20102%2080%2094C90%2086%20110%20102%20120%2094C130%2086%20150%20102%20160%2094C170%2086%20190%20102%20200%2094M0%20118C10%20110%2030%20126%2040%20118C50%20110%2070%20126%2080%20118C90%20110%20110%20126%20120%20118C130%20110%20150%20126%20160%20118C170%20110%20190%20126%20200%20118M0%20142C10%20134%2030%20150%2040%20142C50%20134%2070%20150%2080%20142C90%20134%20110%20150%20120%20142C130%20134%20150%20150%20160%20142C170%20134%20190%20150%20200%20142M0%20166C10%20158%2030%20174%2040%20166C50%20158%2070%20174%2080%20166C90%20158%20110%20174%20120%20166C130%20158%20150%20174%20160%20166C170%20158%20190%20174%20200%20166M0%20190C10%20182%2030%20198%2040%20190C50%20182%2070%20198%2080%20190C90%20182%20110%20198%20120%20190C130%20182%20150%20198%20160%20190C170%20182%20190%20198%20200%20190%27%20fill=%27none%27%20stroke=%27%23ffffff%27%20stroke-opacity=%270.35%27%20stroke-width=%272%27/%3E%3C/svg%3E', length: 236, bpm: 128, c: ['#0a84ff', '#bf5af2'] },
  { title: 'Overflow: Hidden', artist: 'Clip Path', art: 'data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27200%27%20height=%27200%27%20viewBox=%270%200%20200%20200%27%3E%3Cdefs%3E%3ClinearGradient%20id=%27g%27%20x1=%270%27%20y1=%271%27%20x2=%270%27%20y2=%270%27%3E%3Cstop%20offset=%270%27%20stop-color=%27%23ffe29f%27/%3E%3Cstop%20offset=%270.5%27%20stop-color=%27%23ffa99f%27/%3E%3Cstop%20offset=%271%27%20stop-color=%27%23ff719a%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width=%27200%27%20height=%27200%27%20fill=%27url%28%23g%29%27/%3E%3Cpath%20d=%27M0%20200V110C60%2070%20120%20140%20200%20100V200Z%27%20fill=%27%23f6a05c%27/%3E%3Cpath%20d=%27M0%20200V140C60%20100%20120%20170%20200%20138V200Z%27%20fill=%27%23e07b39%27/%3E%3Cpath%20d=%27M0%20200V170C60%20130%20120%20200%20200%20176V200Z%27%20fill=%27%23b85a26%27/%3E%3C/svg%3E', length: 212, bpm: 104, c: ['#ff9f0a', '#ffd60a'] },
  { title: 'Z-Index Blues', artist: 'Stacking Context', art: 'data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27200%27%20height=%27200%27%20viewBox=%270%200%20200%20200%27%3E%3Cdefs%3E%3ClinearGradient%20id=%27g%27%20x1=%270%27%20y1=%271%27%20x2=%270%27%20y2=%270%27%3E%3Cstop%20offset=%270%27%20stop-color=%27%23d4fc79%27/%3E%3Cstop%20offset=%270.5%27%20stop-color=%27%2396e6a1%27/%3E%3Cstop%20offset=%271%27%20stop-color=%27%233a7d44%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width=%27200%27%20height=%27200%27%20fill=%27url%28%23g%29%27/%3E%3Cpath%20d=%27M-10%20200L10%20130L30%20200Z%27%20fill=%27%232d6a4f%27/%3E%3Cpath%20d=%27M16%20200L36%2093L56%20200Z%27%20fill=%27%231e5631%27/%3E%3Cpath%20d=%27M42%20200L62%20106L82%20200Z%27%20fill=%27%232d6a4f%27/%3E%3Cpath%20d=%27M68%20200L88%20119L108%20200Z%27%20fill=%27%231e5631%27/%3E%3Cpath%20d=%27M94%20200L114%2082L134%20200Z%27%20fill=%27%232d6a4f%27/%3E%3Cpath%20d=%27M120%20200L140%2095L160%20200Z%27%20fill=%27%231e5631%27/%3E%3Cpath%20d=%27M146%20200L166%20108L186%20200Z%27%20fill=%27%232d6a4f%27/%3E%3Cpath%20d=%27M172%20200L192%20121L212%20200Z%27%20fill=%27%231e5631%27/%3E%3Cpath%20d=%27M198%20200L218%2084L238%20200Z%27%20fill=%27%232d6a4f%27/%3E%3C/svg%3E', length: 199, bpm: 88, c: ['#5e5ce6', '#64d2ff'] },
];
const N = 24, SEGS = 24, W = 332;
let track = 0, playing = false, running = false, lastT = 0, energy = 0, levels = Array(N).fill(0);
let shuffle = false, repeat = false, queue = false;
const pl = { pos: 41 }, heart = { s: 1 }, liked = new Set([2]);

function go(i, dir) {
  if (i === track) return;
  transition(dir);
  track = i; pl.pos = 0;
}
function nextIndex() { return shuffle ? (track + 1 + Math.floor(Math.random() * (TRACKS.length - 1))) % TRACKS.length : (track + 1) % TRACKS.length; }

function step(t) {
  const dt = Math.min(0.1, (t - lastT) / 1000);
  lastT = t;
  const tr = TRACKS[track];
  if (playing) {
    pl.pos += dt;
    if (pl.pos >= tr.length) {
      if (repeat) pl.pos = 0;
      else if (shuffle || track < TRACKS.length - 1) go(nextIndex(), 'slide-left');
      else { pl.pos = tr.length; playing = false; }
    }
  }
  energy += ((playing ? 1 : 0) - energy) * Math.min(1, dt * 5);
  const beat = Math.pow(Math.max(0, Math.sin(t / 1000 * Math.PI * tr.bpm / 60)), 8), s = t / 1000;
  levels = levels.map((l, i) => {
    const f = i / N;
    const target = energy * Math.min(1, 0.18 + 0.3 * Math.abs(Math.sin(s * (1.7 + i * 0.41) + i * 1.3))
                 + 0.55 * beat * (1 - f) + 0.2 * Math.random() * (0.4 + f));
    return l + (target - l) * (target > l ? 0.6 : 0.25);
  });
  if (playing || energy > 0.01) requestAnimationFrame(step); else running = false;
}
function wake() { if (!running) { running = true; lastT = performance.now(); requestAnimationFrame(step); } }

function onAction(name, value) {
  if (name === 'play') { playing = !playing; if (pl.pos >= TRACKS[track].length - 0.5) pl.pos = 0; }
  if (name === 'next') go(nextIndex(), 'slide-left');
  if (name === 'prev') { if (pl.pos > 3) tween(pl, { pos: 0 }, 300, ease.outCubic); else go((track + TRACKS.length - 1) % TRACKS.length, 'slide-right'); playing = true; }
  if (name === 'seek') tween(pl, { pos: (Number(value) + 0.5) / SEGS * TRACKS[track].length }, 350, ease.outCubic);
  if (name === 'pick') { const i = Number(value); go(i, i > track ? 'slide-left' : 'slide-right'); playing = true; }
  if (name === 'like') {
    if (liked.has(track)) liked.delete(track); else liked.add(track);
    heart.s = liked.has(track) ? 1.7 : 0.6;
    tween(heart, { s: 1 }, 450, ease.outBack);
  }
  if (name === 'shuffle') shuffle = !shuffle;
  if (name === 'repeat') repeat = !repeat;
  if (name === 'queue') { transition(queue ? 'slide-up' : 'slide-down'); queue = !queue; }
  wake();
}
setTimeout(() => onAction('play'), 250);

const mmss = s => Math.floor(s / 60) + ':' + String(Math.floor(s % 60)).padStart(2, '0');
function render() {
  const tr = TRACKS[track], frac = clamp(pl.pos / tr.length, 0, 1);
  const bars = levels.map((l, i) => `<div style="height: ${(3 + l * 69).toFixed(1)}px; background: linear-gradient(0deg, ${tr.c[0]}, ${mix(tr.c[0], tr.c[1], 0.3 + 0.7 * l)})"></div>`).join('');
  const hits = Array.from({ length: SEGS }, (_, k) => `<div class="hit" data-action="seek" data-value="${k}" style="left: ${(k * W / SEGS).toFixed(1)}px"></div>`).join('');
  const on = liked.has(track);
  const list = queue ? '<div style="margin-top: 8px">' + TRACKS.map((t, i) => `<div class="q ${i === track ? 'cur' : ''}" data-action="pick" data-value="${i}">
      <img src="${t.art}"><div class="grow"><div class="small"><b>${esc(t.title)}</b></div><div class="tiny muted">${esc(t.artist)}</div></div>
      <span class="tiny ${i === track ? 't-red' : 'muted'}">${i === track ? (playing ? '▶ playing' : 'paused') : mmss(t.length)}${liked.has(i) ? ' ♥' : ''}</span></div>`).join('') + '</div>' : '';
  return `<div class="card pad np">
    <div class="top"><img class="art" src="${tr.art}">
      <div class="grow"><b>${esc(tr.title)}</b><div class="small muted">${esc(tr.artist)}</div>
        <div style="margin-top: 3px"><span class="badge ${playing ? 'red' : ''}">${playing ? '● LIVE' : 'paused'}</span> <span class="tiny muted">${tr.bpm} BPM</span></div></div>
      <span class="like" data-action="like" style="font-size: ${Math.round(20 * heart.s)}px; color: ${on ? '#ff2d55' : '#8e8e93'}">${on ? '♥' : '♡'}</span></div>
    <div class="eq">${bars}</div>
    <div class="seek"><div class="prog"><div style="width: ${(frac * 100).toFixed(2)}%; background-color: ${tr.c[0]}"></div></div>
      <div class="knob" style="left: ${(frac * W - 5).toFixed(1)}px; background-color: ${tr.c[0]}"></div>${hits}</div>
    <div class="times"><span>${mmss(pl.pos)}</span><span>-${mmss(tr.length - pl.pos)}</span></div>
    <div class="ctl"><span class="tg ${shuffle ? 'on' : ''}" data-action="shuffle" role="button" aria-label="Shuffle" aria-pressed="${shuffle}">🔀</span>
      <span><span class="b" data-action="prev" role="button" aria-label="Previous track">⏮️</span><span class="b" data-action="play" role="button" aria-label="${playing ? 'Pause' : 'Play'}">${playing ? '⏸️' : '▶️'}</span><span class="b" data-action="next" role="button" aria-label="Next track">⏭️</span></span>
      <span class="tg ${repeat ? 'on' : ''}" data-action="repeat" role="button" aria-label="Repeat track" aria-pressed="${repeat}">🔂</span></div>
    <div class="row between" style="margin-top: 4px"><span class="tiny muted">${shuffle ? 'Shuffle on' : 'In order'}${repeat ? ' · repeat one' : ''}</span>
      <a class="lnk" href="#" data-action="queue">Up next ${queue ? '▴' : '▾'}</a></div>
    ${list}
  </div>`;
}
</script>

