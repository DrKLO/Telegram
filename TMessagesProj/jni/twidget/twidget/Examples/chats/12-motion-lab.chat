</style>
<div class="card pad ck"><b>🕰 Clock</b></div>
<script>
const CITIES = [['Local', null], ['Lisbon', 'Europe/Lisbon'], ['New York', 'America/New_York'], ['Tokyo', 'Asia/Tokyo'], ['Sydney', 'Australia/Sydney'], ['São Paulo', 'America/Sao_Paulo']];
const TABS = [['analog', 'Analog'], ['digital', 'Digital'], ['world', 'World']];
let now = new Date(), tab = 'analog', home = 0, h12 = false, digits = null, from = now.getSeconds() * 6, to = from;
const hand = { k: 1 }, intro = { k: 0 }, glow = { a: 0 }, fmts = new Map(), dates = new Map(), minis = new Map();

function parts(tz) {
  if (!tz) return [now.getHours(), now.getMinutes(), now.getSeconds()];
  let f = fmts.get(tz);
  if (!f) { f = new Intl.DateTimeFormat('en-GB', { timeZone: tz, hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' }); fmts.set(tz, f); }
  return f.format(now).split(':').map(Number).map((v, i) => i ? v : v % 24);
}
function dateOf(tz) {
  const key = tz || 'local';
  let f = dates.get(key);
  if (!f) { f = new Intl.DateTimeFormat('en-GB', tz ? { timeZone: tz, weekday: 'long', day: 'numeric', month: 'short' } : { weekday: 'long', day: 'numeric', month: 'short' }); dates.set(key, f); }
  return f.format(now);
}
const hhmm = (h, m, s) => {
  const hh = h12 ? (h + 11) % 12 + 1 : h;
  return String(hh).padStart(2, '0') + ':' + String(m).padStart(2, '0') + (s === undefined ? '' : ':' + String(s).padStart(2, '0')) + (h12 ? `<span class="tiny muted">${h < 12 ? ' am' : ' pm'}</span>` : '');
};

function syncDigits(roll) {
  const [h, m, s] = parts(CITIES[home][1]);
  const str = String(h12 ? (h + 11) % 12 + 1 : h).padStart(2, '0') + String(m).padStart(2, '0') + String(s).padStart(2, '0');
  if (!digits) digits = [...str].map(c => ({ from: c, to: c, k: 1 }));
  [...str].forEach((c, j) => {
    const d = digits[j];
    if (d.to === c) return;
    d.from = roll ? d.to : c; d.to = c; d.k = roll ? 0 : 1;
    if (roll) tween(d, { k: 1 }, 380, ease.outCubic);
  });
}

function springTo(extra, ms) {
  from = from + (to - from) * hand.k;
  let next = Math.floor(to / 360) * 360 + now.getSeconds() * 6 + extra;
  if (next < to) next += 360;
  to = next;
  hand.k = 0;
  tween(hand, { k: 1 }, ms, ease.outElastic);
}

function tick() {
  now = new Date();
  if (tab === 'analog') springTo(0, 450); else { from = to = Math.floor(to / 360) * 360 + now.getSeconds() * 6; hand.k = 1; }
  if (tab === 'digital') syncDigits(true);
  setTimeout(tick, 1000 - (Date.now() % 1000) + 5);
}
setTimeout(tick, 1000 - (Date.now() % 1000) + 5);
setTimeout(() => { intro.k = 0; tween(intro, { k: 1 }, 900, ease.outCubic); }, 250);

function onAction(name, value) {
  if (name === 'spin') return springTo(360, 1400);
  if (name === 'h12') { h12 = value === '12'; return syncDigits(true); }
  if (name === 'tab') {
    const a = TABS.findIndex(t => t[0] === tab), b = TABS.findIndex(t => t[0] === value);
    if (a === b) return;
    transition(b > a ? 'slide-left' : 'slide-right');
    tab = value;
    if (tab === 'digital') syncDigits(!!digits);
    return;
  }
  if (name === 'home') {
    home = Number(value);
    digits = null;
    glow.a = 1;
    tween(glow, { a: 0 }, 900, ease.inQuad);
  }
}

const polar = (deg, r) => [100 + r * Math.sin(deg * Math.PI / 180), 100 - r * Math.cos(deg * Math.PI / 180)];
const line = (deg, r0, r1, w, c) => { const [x0, y0] = polar(deg, r0), [x1, y1] = polar(deg, r1);
  return `<line x1='${x0.toFixed(1)}' y1='${y0.toFixed(1)}' x2='${x1.toFixed(1)}' y2='${y1.toFixed(1)}' stroke='${c}' stroke-width='${w}' stroke-linecap='round'/>`; };
const svgURI = (body, size = 150) => 'data:image/svg+xml;utf8,' + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='${size}' height='${size}' viewBox='0 0 200 200'>${body}</svg>`);

let ticks = '';
for (let i = 0; i < 60; i++) ticks += i % 5 ? line(i * 6, 84, 89, 1.5, '#8e8e93') : line(i * 6, 78, 89, 3.5, '#f2f2f7');
const FACE = svgURI(`<circle cx='100' cy='100' r='97' fill='#1c1c1e' stroke='#3a3a3c' stroke-width='4'/>${ticks}`);

function hands() {
  const [h, m, s] = parts(CITIES[home][1]), e = intro.k;
  const sec = (from + (to - from) * hand.k) * e;
  return svgURI(line((h % 12 * 30 + m * 0.5) * e, -10, 50, 7, '#f2f2f7') + line((m * 6 + s * 0.1) * e, -12, 72, 5, '#f2f2f7') +
                line(sec, -18, 80, 2, '#ff9f0a') + `<circle cx='100' cy='100' r='5' fill='#ff9f0a'/>`);
}
function mini(i) {
  const [h, m] = parts(CITIES[i][1]), key = i + ':' + h + ':' + m;
  if (!minis.has(key)) {
    if (minis.size > 40) minis.clear();
    const day = h >= 7 && h < 19, ink = day ? '#1c1c1e' : '#f2f2f7';
    minis.set(key, svgURI(`<circle cx='100' cy='100' r='94' fill='${day ? '#f2f2f7' : '#1c1c1e'}' stroke='#8e8e93' stroke-width='8'/>` +
      line(h % 12 * 30 + m * 0.5, 0, 48, 14, ink) + line(m * 6, 0, 72, 10, ink) + `<circle cx='100' cy='100' r='9' fill='#ff9f0a'/>`, 34));
  }
  return minis.get(key);
}

function analog() {
  const [h, m, s] = parts(CITIES[home][1]);
  const others = CITIES.filter((_, i) => i !== home).slice(0, 3).map(([n, tz]) => { const [a, b] = parts(tz); return `<div><span class="muted">${n}</span><b>${hhmm(a, b)}</b></div>`; }).join('');
  return `<div class="face"><div style="position: relative; width: 150px; height: 150px">
      <img src="${FACE}" width="150" height="150"><img src="${hands()}" width="150" height="150" style="position: absolute; left: 0; top: 0"></div>
    <div class="digital"><div class="big">${hhmm(h, m, s)}</div><div class="small muted">${dateOf(CITIES[home][1])}</div>
      <div class="zones" style="margin-top: 6px">${others}</div>
      <button data-action="spin" style="margin-top: 6px">🌀 Spin</button></div></div>`;
}
function digital() {
  const [h] = parts(CITIES[home][1]);
  const box = j => { const d = digits[j]; return `<div class="dg"><div style="margin-top: ${(-58 * ease.outCubic(d.k)).toFixed(1)}px">${d.from}</div><div>${d.to}</div></div>`; };
  const seg = [['24', '24h'], ['12', '12h']].map(([v, l]) => `<span class="${(v === '12') === h12 ? 'on' : ''}" data-action="h12" data-value="${v}">${l}</span>`).join('');
  return `<div class="roll">${box(0)}${box(1)}<span class="colon t-orange">:</span>${box(2)}${box(3)}<span class="colon t-orange">:</span>${box(4)}${box(5)}${h12 ? `<span class="ampm muted">${h < 12 ? 'AM' : 'PM'}</span>` : ''}</div>
    <div class="row between"><span class="small muted">${dateOf(CITIES[home][1])}</span><span class="seg">${seg}</span></div>`;
}
function world() {
  const [lh, lm] = parts(null);
  return '<div style="margin-top: 8px">' + CITIES.map(([n, tz], i) => {
    const [h, m] = parts(tz);
    let diff = (h * 60 + m) - (lh * 60 + lm);
    if (diff > 840) diff -= 1440; if (diff < -720) diff += 1440;
    const day = lh * 60 + lm + diff >= 1440 ? 'tomorrow' : lh * 60 + lm + diff < 0 ? 'yesterday' : 'today';
    const off = diff === 0 ? 'same time' : `${diff > 0 ? '+' : '−'}${Math.floor(Math.abs(diff) / 60)}${Math.abs(diff) % 60 ? ':' + String(Math.abs(diff) % 60).padStart(2, '0') : ''}h`;
    const bg = i === home ? ` style="background-color: ${alpha('#ff9f0a', 0.14 + 0.25 * glow.a)}"` : '';
    return `<div class="city" data-action="home" data-value="${i}"${bg}><img src="${mini(i)}" width="34" height="34">
      <div class="grow"><b>${n}</b>${i === home ? ' <span class="badge orange">home</span>' : ''}<div class="tiny muted">${off} · ${day}</div></div>
      <span class="t">${hhmm(h, m)}</span></div>`;
  }).join('') + '<div class="tiny muted" style="margin-top: 4px">Tap a city to show it on the analog and digital clocks</div></div>';
}

function render() {
  const tabs = TABS.map(([id, label]) => `<span class="tab ${tab === id ? 'on' : ''}" data-action="tab" data-value="${id}">${label}</span>`).join('');
  if (tab === 'digital' && !digits) syncDigits(false);
  return `<div class="card pad ck">
    <div class="row between"><span><b>🕰 Clock</b> <span class="small t-orange">${CITIES[home][0]}</span></span><span>${tabs}</span></div>
    ${tab === 'analog' ? analog() : tab === 'digital' ? digital() : world()}
  </div>`;
}
</script>

