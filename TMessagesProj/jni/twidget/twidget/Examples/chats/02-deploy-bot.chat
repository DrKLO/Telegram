  .bld .steps { margin-top: 8px; padding-top: 6px; border-top: 1px dashed rgba(127,127,127,0.35); }
  .bld .sr { display: flex; align-items: center; height: 21px; }
  .bld .ic { display: inline-block; width: 20px; height: 16px; }
  .bld .cap { margin-top: 8px; font-size: 11px; color: #8e8e93; }
