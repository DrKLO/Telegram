  .bld .prog { height: 8px; margin: 6px 0 8px 0; border-radius: 4px; background-color: rgba(127,127,127,0.22); }
  .bld .prog div { height: 8px; border-radius: 4px; }
  .bld .pods { display: flex; margin-bottom: 6px; }
