<script>
const ENVS = [
  { id: 'production', ver: '#1839', up: 99.98, st: 'ok', region: 'eu-west-1 · us-east-1', pods: 10, ready: 10, deploy: '2 days ago · Maya', err: '0.02%', p95: 182, bad: { 11: 1 } },
  { id: 'staging', ver: '#1842', up: 100, st: 'ok', region: 'eu-west-1', pods: 4, ready: 4, deploy: '18 min ago · Leo', err: '0.00%', p95: 141, bad: {} },
  { id: 'canary', ver: '#1842', up: 97.2, st: 'warn', region: 'us-east-1', pods: 2, ready: 2, deploy: '12 min ago · CI', err: '0.31%', p95: 238, bad: { 27: 1, 28: 1, 29: 1 }, note: 'pod-7 readiness probe slow (1.8s)' },
  { id: 'dev-eu', ver: '#1830', up: 91.4, st: 'down', region: 'eu-central-1', pods: 3, ready: 0, deploy: '6 days ago · Priya', err: '—', p95: null, bad: { 24: 1, 25: 1, 28: 2, 29: 2 }, note: 'Health check failed: connection refused' },
];
const COLOR = { ok: '#34c759', warn: '#ff9500', down: '#ff3b30' };
const FILTERS = [['all', 'All'], ['ok', 'Healthy'], ['warn', 'Degraded'], ['down', 'Down']];
const WEIGHTS = [0, 5, 10, 25, 50, 100];
ENVS.forEach(e => Object.assign(e, { shown: 0, pulse: 0, from: e.st, k: 1, checking: false, busy: null }));
let intro = 0, filter = 'all', open = null, checking = false, checked = '2 min ago', wi = 2;
const split = { w: 10 }, det = { k: 1 };

setTimeout(() => {
  animate(900, (_, t) => { intro = t; }, ease.linear);
  ENVS.forEach(e => tween(e, { shown: e.up }, 900, ease.outCubic));
}, 250);

const match = e => filter === 'all' || e.st === filter;
const byId = id => ENVS.find(e => e.id === id);
function pulse(e) { animate(700, (_, t) => { e.pulse = Math.sin(t * Math.PI); }, ease.linear); }

async function refresh() {
  if (checking) return;
  checking = true;
  const list = ENVS.filter(e => !e.busy && !e.checking);
  list.forEach(e => { e.checking = true; });
  const total = 450 + list.length * 320;
  await animate(total, (_, t) => {
    list.forEach((e, i) => {
      if (!e.checking || t * total < 450 + i * 320) return;
      e.checking = false;
      pulse(e);
      if (e.st === 'warn') { e.up = Math.round((e.up + (Math.random() - 0.4) * 0.1) * 100) / 100; tween(e, { shown: e.up }, 500, ease.outCubic); }
      if (e.p95) e.p95 = Math.max(90, Math.round(e.p95 + (Math.random() - 0.5) * 12));
    });
  }, ease.linear);
  list.forEach(e => { e.checking = false; });
  checking = false;
  checked = 'just now';
}

async function ping(e) {
  if (e.busy || e.checking) return;
  e.checking = true;
  await animate(650, () => {}, ease.linear);
  e.checking = false;
  pulse(e);
  if (e.p95) e.p95 = Math.max(90, Math.round(e.p95 + (Math.random() - 0.5) * 12));
}

async function restart(e) {
  if (e.busy || e.checking || e.st === 'ok') return;
  const down = e.st === 'down', n = down ? e.pods : 1;
  if (down) e.ready = 0;
  for (let i = 0; i < n; i++) {
    e.busy = `Restarting ${down ? `${i + 1}/${n}` : 'pod-7'}…`;
    await animate(600, () => {}, ease.linear);
    if (down) e.ready = i + 1;
  }
  e.busy = null;
  const wasShown = match(e);
  e.from = e.st; e.st = 'ok'; e.k = 0;
  tween(e, { k: 1 }, 700, ease.outCubic);
  e.note = null;
  e.err = down ? '0.04%' : '0.03%';
  e.p95 = down ? 205 : 191;
  e.bad[29] = 0;
  e.up = down ? 91.42 : 97.31;
  tween(e, { shown: e.up }, 600, ease.outCubic);
  pulse(e);
  if (wasShown && !match(e)) { transition('fade'); if (open === e.id) open = null; }
}

function onAction(name, value) {
  if (name === 'filter') {
    if (value === filter) return;
    const order = FILTERS.map(f => f[0]);
    transition(order.indexOf(value) > order.indexOf(filter) ? 'slide-left' : 'slide-right');
    filter = value;
    if (open && !match(byId(open))) open = null;
  } else if (name === 'row') {
    transition(open === value ? 'slide-up' : open ? 'fade' : 'slide-down');
    open = open === value ? null : value;
    det.k = 0;
    tween(det, { k: 1 }, 700, ease.linear);
  } else if (name === 'refresh') refresh();
  else if (name === 'ping' && byId(value)) ping(byId(value));
  else if (name === 'restart' && byId(value)) restart(byId(value));
  else if (name === 'w') {
    wi = clamp(wi + Number(value), 0, WEIGHTS.length - 1);
    tween(split, { w: WEIGHTS[wi] }, 650, ease.outCubic);
  }
}

function indicator(e) {
  if (e.checking || e.busy) {
    const a = Math.round(performance.now() * 0.6) % 360;
    return `<span class="ind" style="background: conic-gradient(from ${a}deg, rgba(88,86,214,0) 0deg, #5856d6 300deg, rgba(88,86,214,0) 300deg)"></span>`;
  }
  const c = mix(COLOR[e.from], COLOR[e.st], e.k);
  return `<span class="ind" style="background-color: ${alpha(c, 0.4 * e.pulse)}"><span class="dot" style="background-color: ${c}"></span></span>`;
}

function detail(e) {
  const bars = Array.from({ length: 30 }, (_, d) => {
    const b = e.bad[d] || 0;
    const g = ease.outCubic(clamp(det.k * 1.8 - d * 0.025, 0, 1));
    return `<div style="height: ${Math.max(1, Math.round((b === 2 ? 7 : b === 1 ? 13 : 22) * g))}px; background-color: ${b === 2 ? '#ff3b30' : b === 1 ? '#ff9500' : '#34c759'}"></div>`;
  }).join('');
  let act;
  if (e.busy) act = `<span class="mini off">${e.busy}</span>`;
  else if (e.checking) act = '<span class="mini off">Checking…</span>';
  else if (e.st === 'down') act = `<span class="mini t-red" data-action="restart" data-value="${e.id}">⟳ Restart pods</span>`;
  else if (e.st === 'warn') act = `<span class="mini t-orange" data-action="restart" data-value="${e.id}">⟳ Restart pod-7</span>`;
  else act = `<span class="mini" data-action="ping" data-value="${e.id}">Ping</span>`;
  const note = e.note ? `<div class="${e.st === 'down' ? 't-red' : 't-orange'}" style="margin-top: 4px">⚠︎ ${esc(e.note)}</div>` : '';
  return `<div class="det">
    <div class="row between"><span class="muted">Last 30 days</span><b>${e.up.toFixed(2)}% uptime</b></div>
    <div class="ub">${bars}</div>
    <div class="kv"><span class="muted">Region</span><span>${e.region}</span></div>
    <div class="kv"><span class="muted">Pods ready</span><span class="${e.ready < e.pods ? 't-red' : ''}">${e.ready}/${e.pods}</span></div>
    <div class="kv"><span class="muted">Last deploy</span><span>${e.ver} · ${e.deploy}</span></div>
    <div class="kv"><span class="muted">Errors · p95</span><span>${e.err} · ${e.p95 ? e.p95 + ' ms' : '—'}</span></div>
    ${note}<div style="margin-top: 7px">${act}</div>
  </div>`;
}

function row(e, i) {
  const s = ease.outCubic(clamp((intro * 900 - i * 90) / 450, 0, 1));
  const isOpen = open === e.id;
  const up = e.st === 'down' ? '<b class="t-red">down</b>' : `<span class="${e.st === 'warn' ? 't-orange' : ''}">${e.shown.toFixed(2)}%</span>`;
  return `<div class="r ${isOpen ? 'open' : ''}" data-action="row" data-value="${e.id}" style="left: ${Math.round((1 - s) * 400)}px">
    <span class="c1">${indicator(e)}${e.id}</span><span class="c2"><code>${e.ver}</code></span><span class="c3">${up}</span><span class="c4">${isOpen ? '▾' : '›'}</span></div>${isOpen ? detail(e) : ''}`;
}

function arc(a0, a1, color) {
  if (a1 - a0 < 0.3) return '';
  if (a1 - a0 > 359.7) return `<circle cx='32' cy='32' r='26' fill='none' stroke='${color}' stroke-width='10'/>`;
  const at = a => [32 + 26 * Math.sin(a * Math.PI / 180), 32 - 26 * Math.cos(a * Math.PI / 180)];
  const [x0, y0] = at(a0), [x1, y1] = at(a1);
  return `<path d='M${x0.toFixed(2)} ${y0.toFixed(2)} A26 26 0 ${a1 - a0 > 180 ? 1 : 0} 1 ${x1.toFixed(2)} ${y1.toFixed(2)}' fill='none' stroke='${color}' stroke-width='10'/>`;
}
function donut(w, sweep) {
  const a = 360 * (1 - w) * sweep, b = 360 * w * sweep;
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' width='64' height='64' viewBox='0 0 64 64'>` +
    `<circle cx='32' cy='32' r='26' fill='none' stroke='#8e8e93' stroke-opacity='0.2' stroke-width='10'/>${arc(0, a, '#5856d6')}${arc(a, a + b, '#ff9500')}</svg>`;
  return 'data:image/svg+xml;utf8,' + encodeURIComponent(svg);
}

function render() {
  const counts = {};
  FILTERS.forEach(([id]) => { counts[id] = ENVS.filter(e => id === 'all' || e.st === id).length; });
  const chips = FILTERS.map(([id, label]) => `<span class="fl ${filter === id ? 'on' : ''}" data-action="filter" data-value="${id}">${label} ${counts[id]}</span>`).join('');
  const shown = ENVS.filter(match);
  const rows = shown.length ? shown.map(row).join('') : '<div class="r muted">Nothing in this state 🎉</div>';
  const w = split.w, stable = Math.round(100 - w), can = Math.round(w);
  const err = Math.max(0.01, 0.02 + (w - 10) * 0.0029), p95 = Math.round(182 + (w - 10) * 0.6);
  return `<div class="card pad env">
    <div class="row between"><b>Environments</b><span><span class="small muted">${checking ? 'Checking…' : `Checked ${checked}`}</span> <button data-action="refresh">↻ Refresh</button></span></div>
    <div style="margin-top: 6px">${chips}</div>
    <div class="th"><span class="c1">ENVIRONMENT</span><span class="c2">VERSION</span><span class="c3">UPTIME (30D)</span><span class="c4">&nbsp;</span></div>
    <div class="rows">${rows}</div>
    <div class="split">
      <div class="donut"><img src="${donut(w / 100, ease.outCubic(intro))}" width="64" height="64"><div>${stable}/${can}</div></div>
      <div class="grow small" style="line-height: 1.6">
        <div><span style="color: #5856d6">●</span> Stable — ${stable}% of traffic</div>
        <div class="row"><span class="grow"><span style="color: #ff9500">●</span> Canary — ${can}% of traffic</span><span class="stp" data-action="w" data-value="-1">−</span><span class="stp" data-action="w" data-value="1">+</span></div>
        <div class="muted">Error rate <span class="${err > 0.1 ? 't-orange' : ''}">${err.toFixed(2)}%</span> · p95 latency ${p95} ms</div>
      </div>
    </div>
  </div>`;
}
</script>

