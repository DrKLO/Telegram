<style>
  .bld { width: 390px; max-width: 100%; }
  .bld .hd { display: flex; align-items: center; padding: 10px 14px; border-bottom: 1px solid rgba(127,127,127,0.2); }
  .bld .hd img { margin-right: 10px; }
  .bld .st { padding: 2px 8px; border-radius: 8px; font-size: 10px; font-weight: 700; }
  .bld .bd { padding: 8px 14px 0 14px; font-size: 13px; }
