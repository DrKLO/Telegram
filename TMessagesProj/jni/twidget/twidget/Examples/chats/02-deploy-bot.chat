<div class="card bld"><div class="hd"><img src="icon:seal-check-fill?size=29&color=34c759"><div class="grow"><b>Build #1842 passed</b><div class="small muted">litechat/main · 4m 12s · triggered by Leo</div></div><span class="st badge green">SUCCESS</span></div><div class="bd small muted" style="padding-bottom: 12px">412 tests passed · LiteChat.app (4.1 MB)</div></div>
<script>
const STEPS = [['Checkout', '2s'], ['Build (clang, -O2)', '1m 48s'], ['Unit tests', '1m 55s'], ['Package & notarize', '27s']];
const SPARK = [30, 26, 28, 18, 22, 12, 16, 20, 10, 14, 8, 12];
const LOG = [
  ['cmd', '$ cmake -S . -B build -DCMAKE_BUILD_TYPE=Release'],
  ['', '-- The C compiler identification is AppleClang 17.0'],
  ['', '-- Configuring done (0.4s)'],
  ['cmd', '$ cmake --build build -j10'],
  ['', '[ 12%] Building C object src/gumbo/CMakeFiles/gumbo.dir/parser.c.o'],
  ['', '[ 47%] Building CXX object CMakeFiles/litehtml.dir/src/render_flex.cpp.o'],
  ['', '[ 84%] Built target litehtml'],
  ['', '[ 89%] Building OBJCXX object CMakeFiles/lhmac.dir/src/LHContainer.mm.o'],
  ['', '[ 96%] Linking OBJCXX executable LiteChat.app/Contents/MacOS/LiteChat'],
  ['', '[100%] Built target LiteChat'],
  ['cmd', '$ ctest --output-on-failure'],
  ['ok', '100% tests passed, 0 tests failed out of 412'],
  ['warn', '3 skipped: test_bidi_*, test_print_media'],
];
const INK = { cmd: '#89b4fa', ok: '#a6e3a1', warn: '#f9e2af', err: '#f38ba8', info: '#cdd6f4' };
const COMMITS = [['a1b2c3d', 'Render bubbles with litehtml'], ['9f8e7d6', 'Dark mode stylesheet'], ['5c4b3a2', 'Card components']];
const POD = ['rgba(142,142,147,0.35)', '#5856d6', '#34c759', '#ff9500'];
const BADGE = {
  passed: ['SUCCESS', '#34c759', 'icon:seal-check-fill?size=29&color=34c759'],
  deploying: ['DEPLOYING', '#5856d6', 'icon:arrows-clockwise?size=29&color=5856d6'],
  live: ['LIVE', '#34c759', 'icon:seal-check-fill?size=29&color=34c759'],
  rolling: ['ROLLING BACK', '#ff9500', 'icon:arrow-circle-left-fill?size=29&color=ff9500'],
  rolledback: ['ROLLED BACK', '#ff3b30', 'icon:arrow-circle-left-fill?size=29&color=ff3b30'],
};

let intro = 0, state = 'passed', prod = '#1839', canary = '#1842', view = 'main', job = null, result = null, run = 0;
let logOpen = false, logShown = 0, logTimer = 0, extra = [], sparkKey = '', sparkURI = '';
const tests = { v: 0 }, stats = { v: 1 };

setTimeout(() => {
  animate(900, (_, t) => { intro = t; }, ease.linear);
  tween(tests, { v: 412 }, 900, ease.outCubic);
}, 250);

const rollTarget = () => prod === '#1842' ? 'production' : 'canary';
const canRoll = () => !job && (prod === '#1842' || canary === '#1842');
const clockText = () => {
  const s = 36720 + Math.floor(performance.now() / 1000);
  return [s / 3600, (s / 60) % 60, s % 60].map(v => String(Math.floor(v)).padStart(2, '0')).join(':');
};
function log(kind, text) {
  extra.push([kind, `${clockText()} ${text}`]);
  if (extra.length > 30) extra.shift();
}

function spark() {
  const key = intro.toFixed(3);
  if (key === sparkKey) return sparkURI;
  const n = SPARK.length - 1, upto = intro * n, X = i => 3 + i * 354 / n;
  const pts = [];
  for (let i = 0; i <= Math.floor(upto); i++) pts.push([X(i), SPARK[i]]);
  if (upto < n) { const i = Math.floor(upto), f = upto - i; pts.push([X(i + f), lerp(SPARK[i], SPARK[i + 1], f)]); }
  const line = pts.map(p => p[0].toFixed(1) + ',' + p[1].toFixed(1)).join(' ');
  const [lx, ly] = pts[pts.length - 1];
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' width='360' height='44'><defs><linearGradient id='g' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#5856d6' stop-opacity='0.35'/><stop offset='1' stop-color='#5856d6' stop-opacity='0'/></linearGradient></defs>` +
    `<polygon fill='url(#g)' points='3,44 ${line} ${lx.toFixed(1)},44'/><polyline fill='none' stroke='#5856d6' stroke-width='2' stroke-linejoin='round' points='${line}'/><circle cx='${lx.toFixed(1)}' cy='${ly.toFixed(1)}' r='3' fill='#5856d6'/></svg>`;
  sparkKey = key;
  sparkURI = 'data:image/svg+xml;utf8,' + encodeURIComponent(svg);
  return sparkURI;
}

async function runJob(kind) {
  const token = ++run, promote = kind === 'promote', target = promote ? 'production' : rollTarget();
  const alive = () => token === run;
  result = null;
  state = promote ? 'deploying' : 'rolling';
  job = {
    kind, target, p: 0, step: 0,
    title: promote ? 'Deploying #1842 → production' : `Rolling back ${target} → #1839`,
    sub: promote ? 'Rolling update · 10 pods' : 'Reverting 3 commits · 10 pods',
    steps: promote ? ['Drain canary', 'Rolling update', 'Health checks'] : ['Freeze traffic', 'Restore #1839', 'Verify health'],
    pods: Array(10).fill(promote ? 0 : 2),
  };
  log(promote ? 'info' : 'warn', promote ? 'INFO  promote #1842 → production' : `WARN  rollback ${target} → #1839`);
  await animate(700, p => { if (alive()) job.p = 0.12 * p; }, ease.inOutSine);
  if (!alive()) return;
  job.step = 1;
  log('info', promote ? 'INFO  canary drained' : 'INFO  traffic frozen');
  for (let i = 0; i < 10; i++) {
    job.pods[i] = 1;
    await animate(230, p => { if (alive()) job.p = 0.12 + 0.76 * (i + p) / 10; }, ease.linear);
    if (!alive()) return;
    job.pods[i] = promote ? 2 : 3;
    if (i % 3 === 2) log('info', `INFO  pod-${i} → litechat:${promote ? 1842 : 1839} (${i + 1}/10)`);
  }
  job.step = 2;
  await animate(800, p => { if (alive()) job.p = 0.88 + 0.12 * p; }, ease.inOutSine);
  if (!alive()) return;
  log('ok', promote ? 'OK    10/10 pods healthy ✔' : `OK    ${target} on #1839 ✔`);
  transition('pop');
  job = null;
  if (promote) { prod = '#1842'; canary = '#1842'; state = 'live'; }
  else { prod = '#1839'; canary = '#1839'; state = 'rolledback'; }
  result = { kind, target };
  stats.v = 0;
  tween(stats, { v: 1 }, 900, ease.outCubic);
}

function streamLog() {
  if (logTimer || logShown >= LOG.length) return;
  logTimer = setInterval(() => {
    logShown++;
    if (logShown >= LOG.length) { clearInterval(logTimer); logTimer = 0; }
  }, 110);
}

function onAction(name) {
  if (name === 'promote' && !job && prod !== '#1842' && view === 'main') {
    transition('slide-down');
    runJob('promote');
  } else if (name === 'rollback' && canRoll() && view === 'main') {
    transition('slide-left');
    view = 'confirm';
  } else if (name === 'confirm' && view === 'confirm') {
    transition('slide-right');
    view = 'main';
    if (canRoll()) runJob('rollback');
  } else if (name === 'cancel' && view === 'confirm') {
    transition('slide-right');
    view = 'main';
  } else if (name === 'logs' && view === 'main') {
    transition(logOpen ? 'slide-up' : 'slide-down');
    logOpen = !logOpen;
    if (logOpen) streamLog();
  } else if (name === 'replay') {
    logShown = 0; extra = [];
    streamLog();
  } else if (name === 'dismiss') {
    transition('fade');
    result = null;
  }
}

function header() {
  const [label, c, icon] = BADGE[state];
  return `<div class="hd"><img src="${icon}"><div class="grow"><b>Build #1842 passed</b><div class="small muted">litechat/main · 4m 12s · triggered by Leo</div></div>
    <span class="st" style="color: ${c}; background-color: ${alpha(c, 0.16)}">${label}</span></div>`;
}

function details() {
  const steps = STEPS.map(([name, time], i) => {
    const k = clamp((intro * 900 - 120 - i * 150) / 240, 0, 1);
    const d = Math.max(1, Math.round(13 * ease.outBack(k)));
    const icon = k > 0 ? `<img src="icon:check-circle-fill?size=16&color=34c759" width="${d}" height="${d}">` : '<img src="icon:circle?size=16&color=c7c7cc" width="13" height="13">';
    return `<div class="sr"><span class="ic">${icon}</span><span class="grow ${k > 0 ? '' : 'muted'}">${esc(name)}</span><span class="muted">${k >= 1 ? time : ''}</span></div>`;
  }).join('');
  const where = prod === '#1842' ? '<b>#1842</b> <span class="muted">· this build</span>'
    : canary === '#1842' ? '<b>#1839</b> <span class="muted">· canary runs #1842 at 10%</span>'
    : '<b>#1839</b> <span class="muted">· canary rolled back</span>';
  return `<div class="bd">
    <table style="width: 100%">
      <tr><td class="k">Commit</td><td><code>a1b2c3d</code> Render bubbles with litehtml</td></tr>
      <tr><td class="k">Tests</td><td><b class="t-green">${Math.round(tests.v)} passed</b> · <span class="t-orange">3 skipped</span> · 0 failed</td></tr>
      <tr><td class="k">Artifact</td><td>LiteChat.app <span class="muted">(4.1 MB)</span></td></tr>
      <tr><td class="k">Prod</td><td>${where}</td></tr>
    </table>
    <div class="steps">${steps}</div>
    <div class="cap">Build time, last 12 runs</div>
    <img src="${spark()}" width="360" height="44" style="margin-top: 2px">
  </div>`;
}

function jobPanel() {
  const j = job, now = performance.now();
  const c = j.kind === 'promote' ? ['#5856d6', '#7a78e8'] : ['#ff9500', '#ffb340'];
  const off = (now / 25) % 14;
  const bar = `<div class="prog"><div style="width: ${(j.p * 100).toFixed(1)}%; background-image: linear-gradient(45deg, ${c[0]} 25%, ${c[1]} 25%, ${c[1]} 50%, ${c[0]} 50%, ${c[0]} 75%, ${c[1]} 75%); background-size: 14px 14px; background-position: ${off.toFixed(1)}px 0"></div></div>`;
  const glow = 0.5 + 0.5 * Math.sin(now / 90);
  const pods = j.pods.map(s => `<div class="pod" style="background-color: ${s === 1 ? mix(POD[1], '#c9c8ff', 0.6 * glow) : POD[s]}"></div>`).join('');
  const spin = `<span class="spin" style="background: conic-gradient(from ${Math.round(now * 0.6) % 360}deg, ${alpha(c[0], 0)} 0deg, ${c[0]} 300deg, ${alpha(c[0], 0)} 300deg)"></span>`;
  const moved = j.pods.filter(s => s === (j.kind === 'promote' ? 2 : 3)).length;
  const steps = j.steps.map((s, i) => {
    const icon = i < j.step ? '<img src="icon:check-circle-fill?size=16&color=34c759">' : i === j.step ? spin : '<img src="icon:circle?size=16&color=c7c7cc">';
    const label = i === 1 ? `${s} <b>${moved}/10</b> pods` : s;
    return `<div class="js"><span class="ic">${icon}</span><span class="${i > j.step ? 'muted' : ''}">${label}</span></div>`;
  }).join('');
  return `<div class="job"><div class="row between"><b>${j.title}</b><span class="small muted">${Math.round(j.p * 100)}%</span></div>
    <div class="small muted">${j.sub}</div>${bar}<div class="pods">${pods}</div>${steps}</div>`;
}

function resultPanel() {
  const k = stats.v;
  if (result.kind === 'promote')
    return `<div class="win" style="background: linear-gradient(135deg, #34c759, #30b0c7)">
      <div style="font-size: 26px">🎉</div><div style="font-size: 17px; font-weight: 700">#1842 is live in production</div>
      <div class="small" style="color: rgba(255,255,255,0.85)">10/10 pods healthy · 3m 05s · <a href="#" data-action="dismiss">dismiss</a></div>
      <div class="stats"><div><b>${(0.01 * k).toFixed(2)}%</b><div class="tiny">errors</div></div><div><b>${Math.round(176 * k)}ms</b><div class="tiny">p95</div></div><div><b>+${Math.round(4 * k)}%</b><div class="tiny">throughput</div></div></div>
    </div>`;
  const where = result.target === 'production' ? 'Production' : 'Canary';
  return `<div class="win" style="background: linear-gradient(135deg, #ff3b30, #ff9500)">
    <div style="font-size: 17px; font-weight: 700">↩️ Rolled back</div>
    <div class="small">${where} is on <b>#1839</b> again · <a href="#" data-action="dismiss">dismiss</a></div>
    <div class="tiny" style="margin-top: 4px; color: rgba(255,255,255,0.85)">Incident <a href="https://github.com/litehtml/litehtml">INC-2207</a> opened automatically</div>
  </div>`;
}

function logPanel() {
  const lines = LOG.slice(0, logShown).concat(extra).slice(-9);
  const live = !!logTimer || !!job;
  const caret = live && Math.floor(performance.now() / 400) % 2 === 0 ? '▍' : '&nbsp;';
  return `<div class="logbar"><b>build-1842.log</b><span>${live ? '<span class="t-green">● live</span> · ' : ''}<a href="#" data-action="replay">↻ Replay</a></span></div>
    <div class="log">${lines.map(([k, t]) => `<div style="color: ${INK[k] || INK.info}">${esc(t)}</div>`).join('')}<div style="color: #f5c2e7">${caret}</div></div>`;
}

function buttons() {
  const promote = !job && prod !== '#1842'
    ? `<span class="b go" data-action="promote">🚀 ${state === 'rolledback' ? 'Promote again' : 'Promote'}</span>`
    : `<span class="b off">${job && job.kind === 'promote' ? 'Deploying…' : job ? '🚀 Promote' : '✓ Promoted'}</span>`;
  const logs = `<span class="b lg ${logOpen ? 'on' : ''}" data-action="logs">${logOpen ? 'Hide logs' : 'View logs'}</span>`;
  const roll = canRoll()
    ? '<span class="b rb last" data-action="rollback">Rollback</span>'
    : `<span class="b off last">${job && job.kind === 'rollback' ? 'Rolling back…' : 'Rollback'}</span>`;
  return `<div class="acts">${promote}${logs}${roll}</div>`;
}

function confirmPanel() {
  const target = rollTarget();
  return `<div class="warn">
    <div style="font-weight: 700"><img src="icon:warning-fill?size=18&color=ff9500"> Roll back ${target} to #1839?</div>
    <div class="small muted" style="margin: 4px 0 6px 0">This reverts 3 commits${target === 'canary' ? ' on the canary (10% of traffic)' : ''}:</div>
    <ul>${COMMITS.map(([sha, msg]) => `<li><code>${sha}</code> ${esc(msg)}</li>`).join('')}</ul>
    <div class="row"><span class="b yes" data-action="confirm">Yes, roll back</span><span class="b lg last" data-action="cancel">Cancel</span></div>
  </div><div style="height: 14px"></div>`;
}

function render() {
  if (view === 'confirm') return `<div class="card bld">${header()}${confirmPanel()}</div>`;
  return `<div class="card bld">${header()}${details()}${job ? jobPanel() : ''}${result ? resultPanel() : ''}${logOpen ? logPanel() : ''}${buttons()}</div>`;
}
</script>

