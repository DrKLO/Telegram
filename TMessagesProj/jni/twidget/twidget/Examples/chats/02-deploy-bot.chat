  .bld .js { display: flex; align-items: center; height: 20px; }
  .bld .spin { display: inline-block; width: 13px; height: 13px; border-radius: 7px; vertical-align: middle; }
  .bld .logbar { display: flex; justify-content: space-between; margin: 10px 14px 4px 14px; font-size: 12px; }
  .bld .log { margin: 0 14px; padding: 8px 10px; height: 150px; overflow: hidden; border-radius: 10px; background-color: #1e1e2e; color: #cdd6f4; font-family: ui-monospace; font-size: 11px; line-height: 15px; }
  .bld .log div { white-space: nowrap; overflow: hidden; }
