</style>
<p style="margin-bottom: 8px">Made pixel art while you were baking 👾 (each pixel is a div)</p>
<script>
const COLS = 13, ROWS = 10;
const PAL = ['#34c759', '#ff2d55', '#ff3b30', '#ff9500', '#ffcc00', '#30b0c7', '#007aff', '#af52de', '#ffffff'];
const EMPTY = 'rgba(28,28,30,0)';
const CODE = { G: 0, P: 1, R: 2, O: 3, Y: 4, T: 5, B: 6, V: 7 };
const ART = {
  invader: { name: '👾 Invader', ox: 1, oy: 1, rows: ['..G.....G..', '...G...G...', '..GGGGGGG..', '.GG.GGG.GG.', 'GGGGGGGGGGG', 'G.GGGGGGG.G', 'G.G.....G.G', '...GG.GG...'] },
  heart: { name: '🌈 Heart', ox: 2, oy: 1, rows: ['.PP...PP.', 'RRRR.RRRR', 'OOOOOOOOO', 'YYYYYYYYY', '.GGGGGGG.', '..TTTTT..', '...BBB...', '....V....'] },
};
const TOOLS = { pen: '✏️ Pen', fill: '🪣 Fill' };
let grid = Array(COLS * ROWS).fill(-1), color = 0, tool = 'pen', mirror = false, art = 'invader', history = [], edited = false, looping = false;
const anims = new Map();
const fx = { sw: 1 };

const colorOf = v => v < 0 ? EMPTY : PAL[v];

function artGrid(key) {
  const a = ART[key], g = Array(COLS * ROWS).fill(-1);
  a.rows.forEach((row, r) => [...row].forEach((ch, c) => { if (ch !== '.') g[(r + a.oy) * COLS + c + a.ox] = CODE[ch]; }));
  return g;
}

function shown(i, now) {
  const a = anims.get(i);
  if (!a) return colorOf(grid[i]);
  const p = clamp((now - a.t0) / a.ms, 0, 1);
  let c = mix(a.from, a.to, ease.outCubic(p));
  if (a.sparkle && p > 0 && p < 1) c = mix(c, '#ffffff', 0.5 * Math.sin(p * Math.PI));
  return c;
}

function frame(t) {
  for (const [i, a] of anims) if (t >= a.t0 + a.ms) anims.delete(i);
  if (anims.size) requestAnimationFrame(frame); else looping = false;
}

function paint(i, v, delay = 0, ms = 220) {
  if (grid[i] === v) return false;
  const now = performance.now();
  anims.set(i, { from: shown(i, now), to: colorOf(v), t0: now + delay, ms, sparkle: v >= 0 });
  grid[i] = v;
  if (!looping) { looping = true; requestAnimationFrame(frame); }
  return true;
}

function snapshot() {
  history.push(grid.slice());
  if (history.length > 40) history.shift();
}

function reveal(key) {
  const target = artGrid(key);
  target.forEach((v, i) => paint(i, v, (Math.floor(i / COLS) + i % COLS) * 26, 240));
  art = key;
  edited = false;
}

function flood(i) {
  const from = grid[i];
  if (from === color) return;
  snapshot();
  const dist = new Map([[i, 0]]), queue = [i];
  while (queue.length) {
    const j = queue.shift(), r = Math.floor(j / COLS), c = j % COLS;
    for (const [dr, dc] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
      const r2 = r + dr, c2 = c + dc, k = r2 * COLS + c2;
      if (r2 < 0 || r2 >= ROWS || c2 < 0 || c2 >= COLS || dist.has(k) || grid[k] !== from) continue;
      dist.set(k, dist.get(j) + 1);
      queue.push(k);
    }
  }
  for (const [k, d] of dist) paint(k, color, d * 32, 240);
  edited = true;
}

setTimeout(() => reveal('invader'), 250);

function onAction(name, value) {
  if (name === 'px') {
    const i = Number(value);
    if (tool === 'fill') return flood(i);
    const twin = Math.floor(i / COLS) * COLS + (COLS - 1 - i % COLS);
    if (grid[i] === color && (!mirror || grid[twin] === color)) return;
    snapshot();
    paint(i, color, 0, 260);
    if (mirror) paint(twin, color, 70, 260);
    edited = true;
  } else if (name === 'color') {
    color = Number(value);
    fx.sw = 0.5;
    tween(fx, { sw: 1 }, 380, ease.outBack);
  } else if (name === 'tool') {
    if (TOOLS[value]) tool = value;
  } else if (name === 'mirror') {
    mirror = !mirror;
  } else if (name === 'undo') {
    const prev = history.pop();
    if (!prev) return;
    prev.forEach((v, i) => paint(i, v, 0, 180));
    edited = true;
  } else if (name === 'clear') {
    if (grid.every(v => v < 0)) return;
    snapshot();
    grid.forEach((v, i) => { if (v >= 0) paint(i, -1, (ROWS - 1 - Math.floor(i / COLS)) * 40, 220); });
    edited = true;
  } else if (name === 'art') {
    if (!ART[value]) return;
    if (artGrid(value).some((v, i) => v !== grid[i])) snapshot();
    reveal(value);
  } else if (name === 'replay') {
    snapshot();
    anims.clear();
    grid.fill(-1);
    reveal(art);
  }
}

function render() {
  const now = performance.now();
  let rows = '';
  for (let r = 0; r < ROWS; r++) {
    rows += '<div class="pr">';
    for (let c = 0; c < COLS; c++) {
      const i = r * COLS + c;
      rows += `<div class="px" data-action="px" data-value="${i}" style="background-color: ${shown(i, now)}"></div>`;
    }
    rows += '</div>';
  }
  const sw = PAL.map((p, k) => {
    const s = k === color ? 18 + 4 * fx.sw : 18;
    return `<div class="sw${k === color ? ' on' : ''}" data-action="color" data-value="${k}" style="background-color: ${p}; width: ${s.toFixed(1)}px; height: ${s.toFixed(1)}px"></div>`;
  }).join('') + `<div class="sw${color < 0 ? ' on' : ''}" data-action="color" data-value="-1" style="background-color: rgba(127,127,127,0.12)">⌫</div>`;
  const used = grid.filter(v => v >= 0);
  const colours = new Set(used).size;
  const tabs = Object.keys(ART).map(k => `<span class="${k === art && !edited ? 'on' : ''}" data-action="art" data-value="${k}">${ART[k].name}</span>`).join('');
  const tb = (action, value, label, on) => `<button class="tb${on ? ' on' : ''}" data-action="${action}"${value ? ` data-value="${value}"` : ''}>${label}</button>`;
  return `<p style="margin-bottom: 8px">Made pixel art while you were baking 👾 Now it's yours: pick a colour and paint, every pixel is a div.</p>
  <div class="pa">
    <div class="tabs">${tabs}</div>
    <div class="wrap">
      <div><div class="canvas">${rows}</div><div class="pal">${sw}</div></div>
      <div class="side">${tb('tool', 'pen', '✏️', tool === 'pen')}${tb('tool', 'fill', '🪣', tool === 'fill')}${tb('mirror', '', '⇆', mirror)}
        ${tb('undo', '', '↶', false)}${tb('clear', '', '🗑', false)}${tb('replay', '', '✨', false)}</div>
    </div>
    <div class="tiny muted">${TOOLS[tool]}${mirror ? ' · mirror' : ''} · ${used.length} px · ${colours} colour${colours === 1 ? '' : 's'}${history.length ? ` · ${history.length} undo` : ''}${edited ? ' · tap a preset to restore' : ''}</div>
  </div>`;
}
</script>

