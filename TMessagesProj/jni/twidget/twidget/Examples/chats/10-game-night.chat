: 168, bpm: 132, g: ['#1d2b64', '#3fb39c'] },
  { title: 'Reflow (Night Mix)', artist: 'Shrink-to-Fit', album: 'Layout Thrash', art: 'data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27200%27%20height=%27200%27%20viewBox=%270%200%20200%20200%27%3E%3Cdefs%3E%3ClinearGradient%20id=%27g%27%20x1=%270%27%20y1=%271%27%20x2=%270%27%20y2=%270%27%3E%3Cstop%20offset=%270%27%20stop-color=%27%23ffe29f%27/%3E%3Cstop%20offset=%270.5%27%20stop-color=%27%23ffa99f%27/%3E%3Cstop%20offset=%271%27%20stop-color=%27%23ff719a%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width=%27200%27%20height=%27200%27%20fill=%27url%28%23g%29%27/%3E%3Cpath%20d=%27M0%20200V110C60%2070%20120%20140%20200%20100V200Z%27%20fill=%27%23f6a05c%27/%3E%3Cpath%20d=%27M0%20200V140C60%20100%20120%20170%20200%20138V200Z%27%20fill=%27%23e07b39%27/%3E%3Cpath%20d=%27M0%20200V170C60%20130%20120%20200%20200%20176V200Z%27%20fill=%27%23b85a26%27/%3E%3C/svg%3E', len: 236, bpm: 104, g: ['#5a2a0c', '#c9814a'] },
];
const N = 22, ROW = 45;
const REST = Array.from({ length: N }, (_, i) => 0.25 + 0.55 * Math.abs(Math.sin(i * 1.7 + 0.4)));
let cur = 0, pos = 84, playing = false, shuffle = false, repeat = 0, order = [0, 1, 2, 3, 4];
let running = false, lastT = 0, energy = 0, levels = REST.map(() => 0), liked = new Set([2]);
const fx = { enter: 0, press: 1, heart: 1, grad: 1, seek: 0 };
const slot = TRACKS.map((_, i) => ({ p: i }));
let gradFrom = TRACKS[0].g, gradTo = TRACKS[0].g;

setTimeout(() => { tween(fx, { enter: 1 }, 800, ease.outCubic); wake(); }, 250);

function wake() {
  if (running) return;
  running = true;
  lastT = performance.now();
  requestAnimationFrame(step);
}

function step(t) {
  const dt = Math.min(0.1, (t - lastT) / 1000);
  lastT = t;
  const tr = TRACKS[cur];
  if (playing) { pos += dt; if (pos >= tr.len) ended(); }
  energy += ((playing ? 1 : 0) - energy) * Math.min(1, dt * 5);
  const s = t / 1000, beat = Math.pow(Math.max(0, Math.sin(s * Math.PI * tr.bpm / 60)), 6);
  let settled = true;
  levels = levels.map((l, i) => {
    const live = Math.min(1, 0.2 + 0.35 * Math.abs(Math.sin(s * (1.9 + i * 0.37) + i)) + 0.45 * beat * (1 - i / N) + 0.25 * Math.random());
    const target = REST[i] * 0.3 * fx.enter * (1 - energy) + live * energy;
    if (Math.abs(target - l) > 0.004) settled = false;
    return l + (target - l) * (target > l ? 0.5 : 0.22);
  });
  if (playing || !settled || fx.enter < 1) requestAnimationFrame(step); else running = false;
}

function ended() {
  if (repeat === 2) { pos = 0; return; }
  const i = order.indexOf(cur);
  if (i + 1 < order.length) return go(order[i + 1], 'slide-left');
  if (repeat === 1) return go(order[0], 'slide-left');
  playing = false;
  pos = TRACKS[cur].len;
}

function go(i, kind) {
  if (kind) transition(kind);
  gradFrom = TRACKS[cur].g; gradTo = TRACKS[i].g;
  fx.grad = 0;
  tween(fx, { grad: 1 }, 600, ease.inOutSine);
  cur = i;
  pos = 0;
}

function reorder() {
  order = shuffle ? [cur].concat(TRACKS.map((_, i) => i).filter(i => i !== cur).sort(() => Math.random() - 0.5)) : TRACKS.map((_, i) => i);
  order.forEach((t, k) => tween(slot[t], { p: k }, 520 + k * 60, ease.inOutCubic));
}

function onAction(name, value) {
  if (name === 'play') {
    if (!playing && pos >= TRACKS[cur].len) pos = 0;
    playing = !playing;
    fx.press = 0.82;
    tween(fx, { press: 1 }, 380, ease.outBack);
  } else if (name === 'next') {
    const i = order.indexOf(cur);
    go(order[(i + 1) % order.length], 'slide-left');
  } else if (name === 'prev') {
    if (pos > 3) { const p = { v: pos }; tween(p, { v: 0 }, 260, ease.outCubic); animate(260, () => { pos = p.v; }, ease.linear); }
    else { const i = order.indexOf(cur); go(order[(i - 1 + order.length) % order.length], 'slide-right'); }
  } else if (name === 'track') {
    const i = Number(value);
    if (i === cur) playing = !playing;
    else { go(i, 'fade'); playing = true; }
  } else if (name === 'seek') {
    const target = Number(value) / 20 * TRACKS[cur].len;
    const p = { v: pos };
    tween(p, { v: target }, 280, ease.outCubic);
    animate(280, () => { pos = p.v; }, ease.linear);
  } else if (name === 'shuffle') {
    shuffle = !shuffle;
    reorder();
  } else if (name === 'repeat') {
    repeat = (repeat + 1) % 3;
  } else if (name === 'like') {
    if (liked.has(cur)) liked.delete(cur); else liked.add(cur);
    fx.heart = 0.5;
    tween(fx, { heart: 1 }, 420, ease.outBack);
  }
  wake();
}

const mmss = s => Math.floor(s / 60) + ':' + String(Math.floor(s % 60)).padStart(2, '0');
const icon = (name, size, color) => `<img src="icon:${name}?size=${Math.max(1, Math.round(size * 1.2))}&color=${color}">`;

function render() {
  const tr = TRACKS[cur], k = clamp(fx.grad, 0, 1);
  const grad = `linear-gradient(135deg, ${mix(gradFrom[0], gradTo[0], k)}, ${mix(gradFrom[1], gradTo[1], k)})`;
  const bars = levels.map(l => `<div style="height: ${(2 + l * 22).toFixed(1)}px"></div>`).join('');
  const shown = Math.min(pos, tr.len) * (fx.enter < 1 ? fx.enter : 1);
  const pct = shown / tr.len * 100;
  const zones = Array.from({ length: 20 }, (_, i) => `<div class="zone" data-action="seek" data-value="${i}" style="left: ${(i * 17.6).toFixed(1)}px; width: 17.6px"></div>`).join('');
  const heart = liked.has(cur);
  const hs = Math.round(17 * fx.heart);
  const ps = Math.round(50 * fx.press);
  const rows = order.map((t, k) => {
    const x = TRACKS[t], isCur = t === cur;
    const mark = isCur
      ? `<div class="mini">${[3, 9, 15].map(i => `<div style="height: ${(3 + (playing ? levels[i] : 0.2) * 11).toFixed(1)}px"></div>`).join('')}</div>`
      : `<span class="no">${k + 1}</span>`;
    return `<div class="qrow${isCur ? ' cur' : ''}" data-action="track" data-value="${t}" style="top: ${((slot[t].p - k) * ROW).toFixed(1)}px">
      ${mark}<div class="thumb" style="background-image: url(${x.art})"></div>
      <div class="grow"><b class="${isCur ? 't-purple' : ''}">${esc(x.title)}</b><div class="tiny muted">${esc(x.artist)}</div></div>
      <span class="muted small">${liked.has(t) ? '♥ ' : ''}${mmss(x.len)}</span></div>`;
  }).join('');
  return `<div class="card mp">
    <div class="top" style="background: ${grad}">
      <div class="art" style="background-image: url(${tr.art})"></div>
      <div class="grow">
        <div class="row"><div class="lbl grow">${playing ? 'Now playing' : 'Paused'} · Game night mix</div>
          <span class="like" data-action="like">${icon(heart ? 'heart-fill' : 'heart', Math.max(1, hs), heart ? 'ff375f' : 'ffffff')}</span></div>
        <div style="font-size: 18px; font-weight: 800">${esc(tr.title)}</div>
        <div style="font-size: 13px; color: rgba(255,255,255,0.85)">${esc(tr.artist)} — <i>${esc(tr.album)}</i></div>
        <div class="eq">${bars}</div>
      </div>
    </div>
    <div class="body">
      <div class="prog"><div class="rail"></div><div class="fill" style="width: ${(pct * 3.52).toFixed(1)}px"></div>
        <div class="knob" style="left: ${(pct * 3.52).toFixed(1)}px"></div>${zones}</div>
      <div class="row between tiny muted"><span>${mmss(shown)}</span><span>−${mmss(tr.len - shown)}</span></div>
      <div class="ctl">
        <span class="ib" data-action="shuffle">${icon('shuffle', 15, shuffle ? '7f5af0' : '8e8e93')}</span>
        <span class="ib" data-action="prev">${icon('rewind-fill', 20, '7f5af0')}</span>
        <span class="play" data-action="play" style="width: ${ps}px; height: ${ps}px">${icon(playing ? 'pause-fill' : 'play-fill', Math.max(1, Math.round(22 * fx.press)), 'ffffff')}</span>
        <span class="ib" data-action="next">${icon('fast-forward-fill', 20, '7f5af0')}</span>
        <span class="ib" data-action="repeat">${icon(repeat === 2 ? 'repeat-once' : 'repeat', 15, repeat ? '7f5af0' : '8e8e93')}</span>
      </div>
    </div>
    <div class="row" style="padding: 4px 14px 6px 14px"><span class="caps grow">${shuffle ? 'Shuffled queue' : 'Up next'}</span><span class="tiny muted">${repeat === 2 ? 'Repeat one' : repeat === 1 ? 'Repeat all' : ''}</span></div>
    ${rows}
  </div>`;
}
</script>

--- zoe 19:55 bare on=sv-4,ing1,ing3
<style>
  .rp { width: 392px; max-width: 100%; overflow: hidden; }
  .rp .hero { position: relative; height: 140px; border-radius: 13px 13px 0 0; overflow: hidden; background: linear-gradient(rgba(0,0,0,0.05), rgba(0,0,0,0.6)), url(data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27200%27%20height=%27200%27%20viewBox=%270%200%20200%20200%27%3E%3Cdefs%3E%3ClinearGradient%20id=%27g%27%20x1=%270%27%20y1=%271%27%20x2=%270%27%20y2=%270%27%3E%3Cstop%20offset=%270%27%20stop-color=%27%23ffe29f%27/%3E%3Cstop%20offset=%270.5%27%20stop-color=%27%23ffa99f%27/%3E%3Cstop%20offset=%271%27%20stop-color=%27%23ff719a%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width=%27200%27%20height=%27200%27%20fill=%27url%28%23g%29%27/%3E%3Cpath%20d=%27M0%20200V110C60%2070%20120%20140%20200%20100V200Z%27%20fill=%27%23f6a05c%27/%3E%3Cpath%20d=%27M0%20200V140C60%20100%20120%20170%20200%20138V200Z%27%20fill=%27%23e07b39%27/%3E%3Cpath%20d=%27M0%20200V170C60%20130%20120%20200%20200%20176V200Z%27%20fill=%27%23b85a26%27/%3E%3C/svg%3E); background-size: cover; }
  .rp .ttl { position: absolute; left: 14px; width: 360px; }
