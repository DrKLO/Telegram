  .chs .pgn .n { color: #8e8e93; margin-right: 3px; }
  .chs .pgn .m { padding: 1px 4px; border-radius: 4px; margin-right: 2px; }
  .chs .pgn .last { background-color: rgba(205,210,106,0.55); font-weight: 700; }
