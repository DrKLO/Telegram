  .qz .opt.live:hover { background-color: rgba(255,149,0,0.09); border-color: rgba(255,149,0,0.75); }
  .qz .lt { width: 24px; height: 24px; line-height: 24px; border-radius: 12px; text-align: center; font-size: 12px; font-weight: 800; margin-right: 10px; background-color: rgba(127,127,127,0.16); }
