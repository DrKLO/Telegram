</style>
<div class="card pad cal"><b style="font-size: 18px">October 2026</b><div class="small muted">Game night on Sat 3 and Sat 24 · Lisbon trip 9–11 · Kai's birthday on the 17th</div></div>
<script>
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const DOW = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const WEEKDAY = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const TODAY = { y: 2026, m: 9, d: 7 };
const PRESETS = [
  { t: '🎲 Game night', c: '#af52de', time: '19:00 · at Sam’s' },
  { t: '🍕 Dinner', c: '#ff9500', time: '20:00' },
  { t: '🏃 Morning run', c: '#34c759', time: '07:30' },
];
const key = (y, m, d) => `${y}-${m}-${d}`;
const events = {};
const seed = (y, m, days, t, c, time) => { for (const d of days) (events[key(y, m, d)] = events[key(y, m, d)] || []).push({ t, c, time, mine: false, grow: 1, flash: 0 }); };
seed(2026, 8, [5, 19], 'Game night', '#af52de', '19:00 · at Sam’s');
seed(2026, 8, [12], 'Design review', '#007aff', '14:00');
seed(2026, 8, [24], 'Release 0.2', '#34c759', '16:00');
seed(2026, 9, [3, 24], 'Game night', '#af52de', '19:00 · at Sam’s');
seed(2026, 9, [9, 10, 11], '✈️ Lisbon', '#ff9500', 'All day · TP 1351');
seed(2026, 9, [14], 'Sprint review', '#007aff', '11:00');
seed(2026, 9, [17], 'Kai’s 🎂', '#ff2d55', 'All day');
seed(2026, 9, [21], 'Dentist', '#8e8e93', '09:30');
seed(2026, 9, [21], 'Release 0.3', '#34c759', '16:00');
seed(2026, 9, [28, 29], 'Offsite', '#30b0c7', 'All day · Sintra');
seed(2026, 9, [31], '🎃 Party', '#ff9500', '20:00 · costumes!');
seed(2026, 10, [7, 21], 'Game night', '#af52de', '19:00 · at Sam’s');
seed(2026, 10, [11], 'Sprint review', '#007aff', '11:00');
seed(2026, 10, [18], 'Release 0.4', '#34c759', '16:00');

let view = { y: 2026, m: 9 }, sel = { y: 2026, m: 9, d: 7 }, added = 0;
const fx = { enter: 0, sel: 1 };
setTimeout(() => tween(fx, { enter: 1 }, 850, ease.linear), 250);

function shift(dir) {
  transition(dir > 0 ? 'slide-left' : 'slide-right');
  const m = view.m + dir;
  view = { y: view.y + Math.floor(m / 12), m: (m + 12) % 12 };
}

function onAction(name, value) {
  if (name === 'prev') return shift(-1);
  if (name === 'next') return shift(1);
  if (name === 'today') {
    const dir = (TODAY.y - view.y) * 12 + TODAY.m - view.m;
    transition(dir > 0 ? 'slide-left' : dir < 0 ? 'slide-right' : 'fade');
    view = { y: TODAY.y, m: TODAY.m };
    sel = Object.assign({}, TODAY);
    fx.sel = 0; tween(fx, { sel: 1 }, 380, ease.outBack);
    return;
  }
  if (name === 'day') {
    const d = Number(value);
    if (sel && sel.y === view.y && sel.m === view.m && sel.d === d) return;
    transition('fade');
    sel = { y: view.y, m: view.m, d };
    fx.sel = 0; tween(fx, { sel: 1 }, 380, ease.outBack);
    return;
  }
  if (!sel) return;
  const k = key(sel.y, sel.m, sel.d), list = events[k] = events[k] || [];
  if (name === 'add') {
    if (list.length >= 4) return;
    const p = PRESETS[Number(value)];
    const ev = { t: p.t, c: p.c, time: p.time, mine: true, grow: 0, flash: 1 };
    list.push(ev);
    added++;
    transition('pop');
    tween(ev, { grow: 1 }, 520, ease.outCubic);
    tween(ev, { flash: 0 }, 900, ease.inQuad);
    return;
  }
  if (name === 'del') {
    const i = Number(value);
    if (!list[i] || !list[i].mine) return;
    transition('fade');
    list.splice(i, 1);
    added--;
  }
}

function grid() {
  const offset = (new Date(view.y, view.m, 1).getDay() + 6) % 7;
  const days = new Date(view.y, view.m + 1, 0).getDate();
  const rows = Math.ceil((offset + days) / 7);
  let html = '<tr>' + DOW.map(d => `<th>${d}</th>`).join('') + '</tr>';
  for (let r = 0; r < rows; r++) {
    html += '<tr>';
    for (let c = 0; c < 7; c++) {
      const i = r * 7 + c, d = i - offset + 1;
      if (d < 1 || d > days) { html += '<td class="empty">&nbsp;</td>'; continue; }
      const evs = events[key(view.y, view.m, d)] || [];
      const isSel = sel && sel.y === view.y && sel.m === view.m && sel.d === d;
      const isToday = view.y === TODAY.y && view.m === TODAY.m && d === TODAY.d;
      const local = ease.outCubic(clamp(fx.enter * 1.7 - i / 42, 0, 1));
      let dn = '';
      if (isToday) dn = 'background-color: #ff3b30; color: #ffffff';
      else if (isSel) dn = `background-color: ${mix('rgba(0,122,255,0)', '#007aff', clamp(fx.sel, 0, 1))}; color: #ffffff`;
      const shown = evs.length > 2 ? evs.slice(0, 1) : evs;
      const pills = shown.map(e => {
        const w = Math.round(42 * local * clamp(e.grow, 0, 1));
        return `<div class="ev" style="width: ${w}px; background-color: ${e.flash > 0.01 ? mix(e.c, '#ffffff', 0.55 * e.flash) : e.c}">${esc(e.t)}</div>`;
      }).join('') + (evs.length > 2 ? `<div class="more">+${evs.length - 1} more</div>` : '');
      const bg = isSel ? ` style="background-color: rgba(0,122,255,${(0.11 * clamp(fx.sel, 0, 1)).toFixed(3)})"` : '';
      html += `<td class="d${c >= 5 ? ' we' : ''}" data-action="day" data-value="${d}"${bg}><div class="dn" style="${dn}">${d}</div>${pills}</td>`;
    }
    html += '</tr>';
  }
  return html;
}

function details() {
  if (!sel) return '';
  const list = events[key(sel.y, sel.m, sel.d)] || [];
  const wd = WEEKDAY[new Date(sel.y, sel.m, sel.d).getDay()];
  const isToday = sel.y === TODAY.y && sel.m === TODAY.m && sel.d === TODAY.d;
  const rows = list.map((e, i) => `<div class="er"><div class="bar" style="background-color: ${e.c}"></div>
      <div class="grow"><b>${esc(e.t)}</b><div class="tiny muted">${esc(e.time)}${e.mine ? ' · added by you' : ''}</div></div>
      ${e.mine ? `<span class="x" data-action="del" data-value="${i}">✕</span>` : ''}</div>`).join('');
  const presets = list.length < 4 ? `<div class="caps" style="margin-top: 8px">Propose</div><div>${PRESETS.map((p, i) => `<span class="pre" data-action="add" data-value="${i}">${esc(p.t)}</span>`).join('')}</div>` : '';
  return `<div class="day">
    <div class="row"><b class="grow">${wd}, ${MONTHS[sel.m].slice(0, 3)} ${sel.d}${isToday ? ' · <span class="t-red">today</span>' : ''}</b><span class="small muted">${list.length ? `${list.length} event${list.length > 1 ? 's' : ''}` : 'Free'}</span></div>
    ${rows || '<div class="small muted" style="padding: 4px 0">Nothing planned yet.</div>'}${presets}</div>`;
}

function render() {
  const total = Object.keys(events).filter(k => k.startsWith(`${view.y}-${view.m}-`)).reduce((n, k) => n + events[k].length, 0);
  return `<div class="card pad cal">
    <div class="hd"><b class="grow" style="font-size: 18px">${MONTHS[view.m]} <span class="muted">${view.y}</span></b>
      <span class="tdy" data-action="today">Today</span><span class="nav" data-action="prev">‹</span><span class="nav" data-action="next">›</span></div>
    <table>${grid()}</table>
    ${details()}
    <div class="tiny muted" style="margin-top: 6px">${total} event${total === 1 ? '' : 's'} this month${added ? ` · ${added} proposed by you` : ''} · tap a day for details</div>
  </div>`;
}
</script>

