  .chs .rk div { width: 12px; height: 34px; line-height: 34px; font-size: 10px; color: #8e8e93; }
  .chs .fl { display: flex; padding-left: 12px; height: 14px; }
  .chs .fl div { width: 34px; text-align: center; font-size: 10px; line-height: 14px; color: #8e8e93; }
