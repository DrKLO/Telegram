</style>
<div class="card rp"><div class="pad"><b style="font-size: 18px">Pastéis de nata</b><div class="small muted">Dessert · Portugal 🇵🇹 · 25 min prep · 12 min bake · makes 12</div></div></div>
<script>
const ING = [
  { n: 'Puff pastry', q: 2, u: ['sheet', 'sheets'] }, { n: 'Whole milk', q: 250, u: 'ml' }, { n: 'Sugar', q: 200, u: 'g' },
  { n: 'Egg yolks', q: 6, u: null }, { n: 'Flour', q: 30, u: 'g' }, { n: 'Cinnamon stick', q: 1, u: null },
  { n: 'Lemon peel', q: 2, u: ['strip', 'strips'] }, { n: 'Water', q: 140, u: 'ml' },
];
const SIZES = [6, 12, 18, 24, 36];
const STEPS = [
  { e: '🔥', t: 'Preheat the oven as hot as it goes, 290 °C if you can.', s: 'Preheat to 290 °C' },
  { e: '🍯', t: 'Boil sugar, water, cinnamon and lemon peel to a syrup, about 3 minutes, 105 °C.', s: 'Make the syrup', timer: 180, use: [2, 7, 5, 6] },
  { e: '🥛', t: 'Whisk flour into a little cold milk, then add the rest of the milk and cook until thick.', s: 'Cook the milk base', use: [4, 1] },
  { e: '🥚', t: 'Pour the syrup into the milk while whisking. Let it cool for 10 minutes, then whisk in the yolks.', s: 'Combine, cool, add yolks', timer: 600, use: [3] },
  { e: '🥐', t: 'Roll the pastry into a log, slice into 1.5 cm discs and press each into a muffin cup with wet thumbs.', s: 'Shape the shells', use: [0] },
  { e: '♨️', t: 'Fill three-quarters full and bake 10 to 12 minutes, until the tops blister dark brown.', s: 'Fill and bake', timer: 720 },
  { e: '✨', t: 'Dust with cinnamon and powdered sugar. Eat warm. Do not share.', s: 'Dust and serve' },
];
const NUT = [['Calories', 214, ' kcal', 300], ['Sugar', 18, ' g', 30], ['Fat', 11, ' g', 30], ['Protein', 4, ' g', 30]];
const TABS = ['Ingredients', 'Method', 'Nutrition'];

let tab = 0, mode = 'tabs', step = 0, servings = 12, rating = 0, note = '', tickId = 0, noteId = 0;
const ticked = new Set([0, 2]);
const pop = ING.map((_, i) => ticked.has(i) ? 1 : 0);
const timers = {};
const fx = { enter: 0, k: 1, n: 12, ready: 2, step: 0, bars: 0, star: 1, ring: 0 };

setTimeout(() => { tween(fx, { enter: 1 }, 900, ease.linear); tween(fx, { bars: 1 }, 900, ease.outCubic); }, 250);

function qty(i, k) {
  const it = ING[i], v = it.q * k;
  if (typeof it.u === 'string') return `${Math.round(v)} ${it.u}`;
  const r = Math.round(v * 4) / 4, w = Math.floor(r), f = r - w;
  const text = (w ? String(w) : '') + (f === 0.25 ? '¼' : f === 0.5 ? '½' : f === 0.75 ? '¾' : '') || '0';
  return text + (it.u ? ' ' + (r > 1 ? it.u[1] : it.u[0]) : '');
}
const mmss = s => Math.floor(s / 60) + ':' + String(Math.floor(s % 60)).padStart(2, '0');

function flash(text) {
  note = text;
  clearTimeout(noteId);
  noteId = setTimeout(() => { note = ''; }, 2600);
}

function tick() {
  const now = performance.now();
  let live = 0;
  for (const i in timers) {
    const t = timers[i];
    if (!t.running) continue;
    t.left = Math.max(0, (t.endsAt - now) / 1000);
    if (t.left > 0) { live++; continue; }
    t.running = false;
    t.done = true;
    flash(`⏰ Step ${Number(i) + 1} timer is done: ${STEPS[i].s.toLowerCase()}`);
    fx.ring = 0;
    animate(1400, (e, raw) => { fx.ring = Math.abs(Math.sin(raw * Math.PI * 4)); }, ease.linear).then(() => { fx.ring = 0; });
  }
  if (!live) { clearInterval(tickId); tickId = 0; }
}

function timerAction(i, what) {
  const t = timers[i] = timers[i] || { total: STEPS[i].timer, left: STEPS[i].timer, running: false, endsAt: 0, done: false };
  if (what === 'go') {
    if (t.running) { t.left = Math.max(0, (t.endsAt - performance.now()) / 1000); t.running = false; return; }
    if (t.left <= 0) t.left = t.total;
    t.running = true; t.done = false;
    t.endsAt = performance.now() + t.left * 1000;
    if (!tickId) tickId = setInterval(tick, 250);
  } else {
    t.running = false; t.done = false; t.left = t.total;
  }
}

function goStep(i) {
  if (i === step) return;
  transition(i > step ? 'slide-left' : 'slide-right');
  step = i;
  tween(fx, { step: i }, 420, ease.outCubic);
}

function onAction(name, value) {
  if (name === 'tab') {
    const i = Number(value);
    if (i === tab) return;
    transition(i > tab ? 'slide-left' : 'slide-right');
    tab = i;
    fx.bars = 0;
    tween(fx, { bars: 1 }, 700, ease.outCubic);
  } else if (name === 'more' || name === 'less') {
    const i = SIZES.indexOf(servings) + (name === 'more' ? 1 : -1);
    if (i < 0 || i >= SIZES.length) return;
    servings = SIZES[i];
    tween(fx, { k: servings / 12, n: servings }, 520, ease.outCubic);
  } else if (name === 'tick') {
    const i = Number(value);
    if (ticked.has(i)) { ticked.delete(i); pop[i] = 0; }
    else { ticked.add(i); animate(360, e => { pop[i] = e; }, ease.outBack); }
    tween(fx, { ready: ticked.size }, 380, ease.outCubic);
    if (ticked.size === ING.length) flash('All set, mise en place done 👩‍🍳');
  } else if (name === 'cook') {
    transition('slide-up');
    mode = 'cook';
    step = Number(value) || 0;
    fx.step = step;
  } else if (name === 'exit') {
    transition('slide-down');
    mode = 'tabs';
  } else if (name === 'fwd') {
    if (step + 1 < STEPS.length) goStep(step + 1);
    else { transition('pop'); mode = 'done'; rating = 0; }
  } else if (name === 'back') {
    if (step > 0) goStep(step - 1);
  } else if (name === 'jump') {
    goStep(Number(value));
  } else if ((name === 'timer' || name === 'treset') && mode === 'cook' && STEPS[step].timer) {
    timerAction(step, name === 'timer' ? 'go' : 'reset');
  } else if (name === 'rate') {
    rating = Number(value);
    fx.star = 0.4;
    tween(fx, { star: 1 }, 420, ease.outBack);
  } else if (name === 'again') {
    transition('slide-down');
    mode = 'tabs'; tab = 0; step = 0;
  }
}

function hero() {
  const e = ease.outCubic(clamp(fx.enter * 1.6, 0, 1));
  return `<div class="hero"><div class="ttl" style="top: ${(84 + 22 * (1 - e)).toFixed(1)}px; color: rgba(255,255,255,${e.toFixed(2)})">
      <div style="font-size: 11px; font-weight: 700; text-transform: uppercase">Dessert · Portugal 🇵🇹</div>
      <div style="font-size: 24px; font-weight: 800">Pastéis de nata</div></div></div>`;
}

function facts() {
  const e = ease.outCubic(clamp(fx.enter * 1.4 - 0.2, 0, 1));
  return `<div class="facts"><div><b>${Math.round(25 * e)} min</b><span class="muted">prep</span></div><div><b>${Math.round(12 * e)} min</b><span class="muted">bake</span></div>
    <div><b>🌶🌶</b><span class="muted">medium</span></div><div><b>★ ${(4.9 * e).toFixed(1)}</b><span class="muted">${Math.round(312 * e)} cooks</span></div></div>`;
}

function seg() {
  return `<div class="seg">${TABS.map((t, i) => `<span class="${i === tab ? 'on' : ''}" data-action="tab" data-value="${i}">${t}</span>`).join('')}</div>`;
}

function ingredients() {
  const rows = ING.map((it, i) => {
    const on = ticked.has(i), p = clamp(pop[i], 0, 1.3);
    const local = ease.outCubic(clamp(fx.enter * 1.8 - 0.35 - i * 0.07, 0, 1));
    const cb = on ? `background-color: ${mix('rgba(255,149,0,0)', '#ff9500', clamp(p, 0, 1))}; border-color: #ff9500; font-size: ${Math.max(1, 12 * p).toFixed(1)}px` : 'font-size: 12px';
    return `<div class="ing" data-action="tick" data-value="${i}" style="margin-left: ${((1 - local) * 30).toFixed(1)}px; margin-right: ${((local - 1) * 30).toFixed(1)}px">
      <div class="cb" style="${cb}">${on ? '✓' : '&nbsp;'}</div>
      <span class="grow ${on ? 'muted' : 'fg'}" style="${on ? 'text-decoration: line-through' : ''}">${it.n}</span><span class="qty ${on ? 'muted' : 't-orange'}">${qty(i, fx.k)}</span></div>`;
  }).join('');
  return `<div class="row" style="margin: 10px 0 2px 0"><b class="grow" style="font-size: 15px">Makes ${Math.round(fx.n)} tarts</b>
      <span class="stp" data-action="less">−</span><span class="cnt">${Math.round(fx.n)}</span><span class="stp" data-action="more">+</span></div>
    <div class="meter"><div style="width: ${(fx.ready / ING.length * 100).toFixed(1)}%"></div></div>
    <div class="tiny muted" style="margin-bottom: 4px">${ticked.size} of ${ING.length} ready · tap to tick off</div>
    ${rows}
    <div class="row" style="margin-top: 10px"><span class="small muted grow">${note ? esc(note) : 'Quantities follow the batch size'}</span><button class="primary" data-action="cook" data-value="0">▶ Start cooking</button></div>`;
}

function method() {
  const rows = STEPS.map((s, i) => `<div class="mrow" data-action="cook" data-value="${i}"><span class="num">${i + 1}</span>
      <span class="grow">${esc(s.t)}</span>${s.timer ? `<span class="badge orange" style="margin-left: 6px">⏱ ${s.timer / 60}m</span>` : ''}</div>`).join('');
  return `<div style="margin-top: 8px">${rows}</div>
    <div class="row" style="margin-top: 8px"><span class="small muted grow">Tap a step to jump in</span><button class="primary" data-action="cook" data-value="0">▶ Step by step</button></div>`;
}

function nutrition() {
  const rows = NUT.map(([k, v, u, max], i) => {
    const e = ease.outCubic(clamp(fx.bars * 1.5 - i * 0.15, 0, 1));
    return `<div class="nut"><span class="k">${k}</span><div class="b"><div style="width: ${(v / max * 100 * e).toFixed(1)}%"></div></div><span class="v">${Math.round(v * e)}${u}</span></div>`;
  }).join('');
  return `<div class="caps" style="margin-top: 10px">Per tart</div>${rows}
    <div class="nut"><span class="k">Joy</span><div class="b"><div style="width: ${(100 * fx.bars).toFixed(1)}%; background-color: #ff2d55"></div></div><span class="v">∞</span></div>
    <div class="small muted" style="margin: 4px 0 10px 0">Whole batch of ${Math.round(fx.n)}: <b class="fg">${Math.round(214 * fx.n).toLocaleString('en-US')} kcal</b></div>
    <div class="panel" style="font-size: 13px">💡 <b>Tip:</b> the blisters are the point. If your oven tops out at 250 °C, use the grill for the last 2 minutes.</div>`;
}

function ring(p, hot) {
  const arc = p > 0.003 ? `<circle cx='30' cy='30' r='24' fill='none' stroke='${hot ? '#ff3b30' : '#ff9500'}' stroke-width='6' stroke-linecap='round' stroke-dasharray='${(p * 150.8).toFixed(1)} 200' transform='rotate(-90 30 30)'/>` : '';
  return 'data:image/svg+xml;utf8,' + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='60' height='60' viewBox='0 0 60 60'><circle cx='30' cy='30' r='24' fill='none' stroke='rgba(127,127,127,0.22)' stroke-width='6'/>${arc}</svg>`);
}

function cook() {
  const s = STEPS[step];
  const dots = STEPS.map((_, i) => {
    const near = Math.max(0, 1 - Math.abs(fx.step - i));
    return `<div data-action="jump" data-value="${i}" style="width: ${(6 + 16 * near).toFixed(1)}px; background-color: ${i <= fx.step + 0.01 ? '#ff9500' : 'rgba(127,127,127,0.3)'}"></div>`;
  }).join('');
  const need = s.use ? `<div class="need">${s.use.map(i => `<span>${ING[i].n} · <b>${qty(i, fx.k)}</b></span>`).join('')}</div>` : '';
  let timer = '';
  if (s.timer) {
    const t = timers[step] || { total: s.timer, left: s.timer, running: false, done: false };
    const hot = t.done && fx.ring > 0.5;
    timer = `<div class="tmr"><img src="${ring(t.left / t.total, hot)}" width="60" height="60" style="margin-right: 12px">
      <div><b class="${t.done ? 't-red' : ''}">${t.done ? 'Done!' : mmss(Math.ceil(t.left))}</b><div style="margin-top: 4px">
        <button class="primary" data-action="timer">${t.running ? '❚❚ Pause' : t.done ? '↻ Again' : t.left < t.total ? '▶ Resume' : `▶ Start ${s.timer / 60} min`}</button>
        ${t.left < t.total || t.done ? '<button data-action="treset">Reset</button>' : ''}</div></div></div>`;
  }
  const others = Object.keys(timers).filter(i => Number(i) !== step && timers[i].running).map(i => `<span class="badge orange" style="margin-right: 4px">⏱ ${Number(i) + 1} · ${mmss(Math.ceil(timers[i].left))}</span>`).join(' ');
  return `<div class="pad">
    <div class="row"><span class="caps grow">Step ${step + 1} of ${STEPS.length} · ${esc(s.s)}</span>${others}<span class="x" data-action="exit">✕</span></div>
    <div class="dots">${dots}</div>
    <div class="big">${s.e}</div>
    <div class="stxt">${esc(s.t)}</div>
    ${need}${timer}
    ${note ? `<div class="small t-orange center" style="margin-bottom: 8px">${esc(note)}</div>` : ''}
    <div class="row"><button data-action="back" class="${step ? '' : 'muted'}">← Back</button><span class="grow"></span>
      <button class="primary" data-action="fwd">${step + 1 < STEPS.length ? 'Next step →' : 'Done 🎉'}</button></div>
  </div>`;
}

function done() {
  const stars = [1, 2, 3, 4, 5].map(i => {
    const size = i === rating ? 28 * fx.star : 28;
    return `<span class="star" data-action="rate" data-value="${i}" style="font-size: ${size.toFixed(1)}px${i <= rating ? '; color: #ffcc00' : ''}">★</span>`;
  }).join('');
  return `<div class="pad center">
    <div style="font-size: 44px; line-height: 54px">🥧</div>
    <div style="font-size: 20px; font-weight: 800">Bom apetite!</div>
    <div class="small muted" style="margin: 2px 0 10px 0">${servings} pastéis de nata, warm from the oven</div>
    <div style="height: 40px; line-height: 40px">${stars}</div>
    <div class="small muted" style="margin-bottom: 12px">${rating ? `You rated it ${rating}/5${rating === 5 ? ' · new house favourite' : ''}` : 'How did they turn out?'}</div>
    <button class="primary" data-action="again">Back to the recipe</button>
  </div>`;
}

function render() {
  if (mode === 'cook') return `<div class="card rp">${cook()}</div>`;
  if (mode === 'done') return `<div class="card rp">${done()}</div>`;
  const body = tab === 0 ? ingredients() : tab === 1 ? method() : nutrition();
  return `<div class="card rp">${hero()}${facts()}<div class="pad">${seg()}${body}</div></div>`;
}
</script>

