<div class="card pad chs"><b>♟️ Sam vs Kai · Ruy Lopez</b><div class="small muted">1. e4 e5 2. Nf3 Nc6 3. Bb5 · Black to move</div></div>
<script>
const S = 34, FILES = 'abcdefgh';
const VAL = { p: 1, n: 3, b: 3, r: 5, q: 9, k: 0 };
const FILL = { k: '♚', q: '♛', r: '♜', b: '♝', n: '♞', p: '♟︎' };
const LINE = { k: '♔', q: '♕', r: '♖', b: '♗', n: '♘', p: '♙' };
const NAME = { k: 'king', q: 'queen', r: 'rook', b: 'bishop', n: 'knight', p: 'pawn' };
const DIAG = [[1, 1], [1, -1], [-1, 1], [-1, -1]], ORTH = [[1, 0], [-1, 0], [0, 1], [0, -1]], ALL = DIAG.concat(ORTH);
const KNIGHT = [[1, 2], [2, 1], [-1, 2], [-2, 1], [1, -2], [2, -1], [-1, -2], [-2, -1]];
const OPENING = ['e4', 'e5', 'Nf3', 'Nc6', 'Bb5'];
const REPLY = {
  'a6': 'Ba4', 'Nf6': 'O-O', 'Bc5': 'c3', 'd6': 'd4', 'f5': 'Nc3', 'Nd4': 'Nxd4', 'g6': 'c3', 'Nge7': 'c3',
  'a6 Ba4 Nf6': 'O-O', 'a6 Ba4 d6': 'c3', 'a6 Ba4 b5': 'Bb3',
  'a6 Ba4 Nf6 O-O Be7': 'Re1', 'a6 Ba4 Nf6 O-O Nxe4': 'd4', 'a6 Ba4 Nf6 O-O Be7 Re1 b5': 'Bb3',
  'a6 Ba4 Nf6 O-O Be7 Re1 b5 Bb3 O-O': 'c3', 'a6 Ba4 Nf6 O-O Be7 Re1 b5 Bb3 d6': 'c3',
  'a6 Ba4 Nf6 O-O Be7 Re1 b5 Bb3 O-O c3 d5': 'exd5',
  'Nf6 O-O Nxe4': 'Re1', 'Nf6 O-O Bc5': 'Nxe5', 'Nf6 O-O Nxe4 Re1 Nd6': 'Nxe5',
  'Bc5 c3 Nf6': 'O-O', 'Bc5 c3 f5': 'd4', 'd6 d4 Bd7': 'Nc3', 'f5 Nc3 fxe4': 'Nxe4', 'Nd4 Nxd4 exd4': 'O-O',
};
const NAMES = {
  'a6': 'Morphy Defence', 'a6 Ba4 d6': 'Modern Steinitz', 'a6 Ba4 Nf6 O-O Be7': 'Closed Variation',
  'a6 Ba4 Nf6 O-O Nxe4': 'Open Variation', 'a6 Ba4 Nf6 O-O Be7 Re1 b5 Bb3 O-O c3 d5': 'Marshall Attack',
  'Nf6': 'Berlin Defence', 'Nf6 O-O Nxe4': 'Berlin, Open Variation', 'Bc5': 'Classical Defence', 'd6': 'Steinitz Defence',
  'f5': 'Schliemann Gambit', 'Nd4': 'Bird Defence', 'g6': 'Smyslov Defence', 'Nge7': 'Cozio Defence',
};

let board, pieces, kings, history, turn, sel, targets, last, over, thinking, started;
let busy = 0, game = 0, think = 0, z = 0, clockId = 0, note = '', noteId = 0, flipTo = 0;
const clock = { w: 291, b: 298 };
const fx = { hl: 1, sel: 0, dot: 0, flip: 0, over: 0 };

const on = (r, c) => r >= 0 && r < 8 && c >= 0 && c < 8;
const foe = c => c === 'w' ? 'b' : 'w';
const sqName = s => FILES[s & 7] + (8 - (s >> 3));
const plain = text => text.replace(/[+#]/g, '');
const mmss = s => Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');

function put(t, c, s) {
  const p = { t, c, s, x: s & 7, y: s >> 3, a: 1, lift: 0, z: 0, moved: false, dead: false };
  board[s] = p;
  pieces.push(p);
  if (t === 'k') kings[c] = p;
}

function attacked(s, by) {
  const r = s >> 3, c = s & 7;
  const at = (r2, c2) => on(r2, c2) ? board[r2 * 8 + c2] : null;
  const pr = by === 'w' ? r + 1 : r - 1;
  for (const dc of [-1, 1]) { const q = at(pr, c + dc); if (q && q.c === by && q.t === 'p') return true; }
  for (const [dr, dc] of KNIGHT) { const q = at(r + dr, c + dc); if (q && q.c === by && q.t === 'n') return true; }
  for (const [dr, dc] of ALL) { const q = at(r + dr, c + dc); if (q && q.c === by && q.t === 'k') return true; }
  for (const [dirs, kinds] of [[DIAG, 'bq'], [ORTH, 'rq']]) {
    for (const [dr, dc] of dirs) {
      let r2 = r + dr, c2 = c + dc;
      while (on(r2, c2)) {
        const q = board[r2 * 8 + c2];
        if (q) { if (q.c === by && kinds.includes(q.t)) return true; break; }
        r2 += dr; c2 += dc;
      }
    }
  }
  return false;
}

function pseudo(color) {
  const out = [];
  for (const p of pieces) {
    if (p.dead || p.c !== color) continue;
    const s = p.s, r = s >> 3, c = s & 7;
    const add = (r2, c2) => {
      const t = r2 * 8 + c2, q = board[t];
      if (q && q.c === color) return false;
      out.push({ p, from: s, to: t, cap: q, promo: p.t === 'p' && (r2 === 0 || r2 === 7) });
      return !q;
    };
    if (p.t === 'p') {
      const d = color === 'w' ? -1 : 1;
      if (on(r + d, c) && !board[(r + d) * 8 + c]) {
        add(r + d, c);
        if (r === (color === 'w' ? 6 : 1) && !board[(r + 2 * d) * 8 + c]) add(r + 2 * d, c);
      }
      for (const dc of [-1, 1]) if (on(r + d, c + dc)) { const q = board[(r + d) * 8 + c + dc]; if (q && q.c !== color) add(r + d, c + dc); }
    } else if (p.t === 'n' || p.t === 'k') {
      for (const [dr, dc] of p.t === 'n' ? KNIGHT : ALL) if (on(r + dr, c + dc)) add(r + dr, c + dc);
      if (p.t === 'k' && !p.moved && !attacked(s, foe(color))) {
        for (const [rc, step, path] of [[7, 1, [5, 6]], [0, -1, [3, 2, 1]]]) {
          const rook = board[r * 8 + rc];
          if (!rook || rook.t !== 'r' || rook.c !== color || rook.moved) continue;
          if (path.some(f => board[r * 8 + f]) || attacked(s + step, foe(color))) continue;
          out.push({ p, from: s, to: s + 2 * step, cap: null, rook, rookFrom: r * 8 + rc, rookTo: s + step });
        }
      }
    } else {
      for (const [dr, dc] of p.t === 'b' ? DIAG : p.t === 'r' ? ORTH : ALL) {
        let r2 = r + dr, c2 = c + dc;
        while (on(r2, c2) && add(r2, c2)) { r2 += dr; c2 += dc; }
      }
    }
  }
  return out;
}

function make(m) {
  board[m.from] = null;
  if (m.cap) m.cap.dead = true;
  board[m.to] = m.p;
  m.p.s = m.to;
  m.wasMoved = m.p.moved;
  m.p.moved = true;
  if (m.promo) m.p.t = 'q';
  if (m.rook) { board[m.rookFrom] = null; board[m.rookTo] = m.rook; m.rook.s = m.rookTo; m.rook.moved = true; }
  turn = foe(m.p.c);
}

function unmake(m) {
  board[m.to] = m.cap;
  if (m.cap) m.cap.dead = false;
  board[m.from] = m.p;
  m.p.s = m.from;
  m.p.moved = m.wasMoved;
  if (m.promo) m.p.t = 'p';
  if (m.rook) { board[m.rookTo] = null; board[m.rookFrom] = m.rook; m.rook.s = m.rookFrom; m.rook.moved = false; }
  turn = m.p.c;
}

function legal(color) {
  const keep = turn;
  const out = pseudo(color).filter(m => { make(m); const ok = !attacked(kings[color].s, foe(color)); unmake(m); return ok; });
  turn = keep;
  return out;
}

function san(m, list, suffix) {
  let s;
  if (m.rook) s = (m.rookFrom & 7) === 7 ? 'O-O' : 'O-O-O';
  else if (m.p.t === 'p') s = (m.cap ? FILES[m.from & 7] + 'x' : '') + sqName(m.to) + (m.promo ? '=Q' : '');
  else {
    const twins = list.filter(o => o.p !== m.p && o.p.t === m.p.t && o.to === m.to);
    let dis = '';
    if (twins.length) dis = twins.every(o => (o.from & 7) !== (m.from & 7)) ? FILES[m.from & 7]
      : twins.every(o => (o.from >> 3) !== (m.from >> 3)) ? String(8 - (m.from >> 3)) : sqName(m.from);
    s = m.p.t.toUpperCase() + dis + (m.cap ? 'x' : '') + sqName(m.to);
  }
  if (suffix) {
    make(m);
    const them = foe(m.p.c);
    if (attacked(kings[them].s, m.p.c)) s += legal(them).length ? '+' : '#';
    unmake(m);
  }
  return s;
}

function find(color, text) {
  const list = legal(color);
  return [list.find(m => san(m, list, false) === text), list];
}

const line = () => history.slice(OPENING.length).map(m => plain(m.san));

function bookMoves() {
  const k = line().join(' '), pre = k ? k + ' ' : '';
  return Object.keys(REPLY).filter(x => x.startsWith(pre) && x.length > pre.length && !x.slice(pre.length).includes(' '))
    .map(x => x.slice(pre.length)).slice(0, 3);
}

function openingName() {
  const seq = line();
  for (let n = seq.length; n > 0; n--) { const name = NAMES[seq.slice(0, n).join(' ')]; if (name) return name; }
  return '';
}

function commit(m, list) {
  m.san = san(m, list, true);
  make(m);
  history.push(m);
  last = { from: m.from, to: m.to };
  m.p.z = ++z;
  if (m.rook) m.rook.z = z;
}

async function slide(m, back, ms) {
  const g = game;
  busy++;
  const to = back ? m.from : m.to;
  const jobs = [tween(m.p, { x: to & 7, y: to >> 3 }, ms, ease.inOutCubic)];
  if (m.rook) { const rt = back ? m.rookFrom : m.rookTo; jobs.push(tween(m.rook, { x: rt & 7, y: rt >> 3 }, ms, ease.inOutCubic)); }
  if (m.cap) jobs.push(tween(m.cap, { a: back ? 1 : 0 }, ms, back ? ease.outQuad : ease.inQuad));
  fx.hl = 0;
  jobs.push(tween(fx, { hl: 1 }, ms + 120, ease.outQuad));
  await Promise.all(jobs);
  if (g === game) busy--;
}

function pick(list) {
  const want = REPLY[line().join(' ')];
  if (want) { const m = list.find(x => san(x, list, false) === want); if (m) return m; }
  let best = null, top = -Infinity;
  for (const m of list) {
    const v = VAL[m.p.t];
    let sc = (m.cap ? VAL[m.cap.t] * 10 : 0) + (m.promo ? 80 : 0) + Math.random() * 1.5;
    if (attacked(m.from, 'b')) sc += v * 3;
    make(m);
    if (attacked(m.to, 'b')) sc -= attacked(m.to, 'w') ? Math.max(0, v - 3) * 10 : v * 10;
    if (attacked(kings.b.s, 'w')) sc += legal('b').length ? 2 : 10000;
    unmake(m);
    const r = m.to >> 3, c = m.to & 7;
    if ('nbp'.includes(m.p.t)) sc += (3.5 - Math.max(Math.abs(r - 3.5), Math.abs(c - 3.5))) * 0.6;
    if ((m.p.t === 'n' || m.p.t === 'b') && (m.from >> 3) === 7) sc += 1.5;
    if (m.rook) sc += 4; else if (m.p.t === 'k') sc -= 2;
    if (sc > top) { top = sc; best = m; }
  }
  return best;
}

function flash(text) {
  note = text;
  clearTimeout(noteId);
  noteId = setTimeout(() => { note = ''; }, 1800);
}

function stopClock() { if (clockId) clearInterval(clockId); clockId = 0; }
function startClock() {
  started = true;
  if (clockId) return;
  clockId = setInterval(() => {
    if (over) return stopClock();
    clock[turn] = Math.max(0, clock[turn] - 1);
    if (!clock[turn]) finish(turn === 'b' ? 'Kai flagged' : 'Sam flagged', turn === 'b' ? 'Sam wins on time' : 'Kai wins on time 🏆');
  }, 1000);
}

function finish(title, sub) {
  over = { title, sub };
  stopClock();
  clearSel();
  transition('pop');
  fx.over = 0;
  tween(fx, { over: 1 }, 480, ease.outBack);
}

function checkEnd() {
  if (legal(turn).length) return false;
  const mate = attacked(kings[turn].s, foe(turn));
  finish(mate ? 'Checkmate' : 'Stalemate', !mate ? 'Draw 🤝' : turn === 'w' ? 'Kai wins 🏆' : 'Sam wins');
  return true;
}

function clearSel() {
  if (sel >= 0 && board[sel]) tween(board[sel], { lift: 0 }, 160, ease.outQuad);
  sel = -1;
  targets = [];
}

function select(s) {
  clearSel();
  sel = s;
  targets = legal('b').filter(m => m.from === s);
  tween(board[s], { lift: 1 }, 300, ease.outBack);
  fx.sel = 0; fx.dot = 0;
  tween(fx, { sel: 1 }, 180, ease.outQuad);
  tween(fx, { dot: 1 }, 320, ease.outBack);
  if (!targets.length) flash(`That ${NAME[board[s].t]} has no moves`);
}

const idle = () => !busy && !thinking && !over && turn === 'b' && (fx.flip === 0 || fx.flip === 1);

async function userMove(m) {
  const list = legal('b');
  clearSel();
  commit(m, list);
  startClock();
  const g = game;
  await slide(m, false, 300);
  if (g !== game || over || checkEnd()) return;
  reply();
}

async function reply() {
  const g = game, me = ++think;
  thinking = true;
  await sleep(450 + Math.random() * 450);
  if (g !== game || me !== think) return;
  thinking = false;
  if (over) return;
  const list = legal('w');
  const m = pick(list);
  if (!m) return;
  commit(m, list);
  await slide(m, false, 340);
  if (g === game) checkEnd();
}

async function undo() {
  if (busy || history.length <= OPENING.length || (fx.flip !== 0 && fx.flip !== 1)) return;
  think++;
  thinking = false;
  clearSel();
  if (over) {
    transition('fade');
    over = null; fx.over = 0;
    for (const c of 'wb') clock[c] = Math.max(clock[c], 15);
    if (started) startClock();
  }
  const g = game;
  let n = turn === 'b' ? 2 : 1;
  while (n-- > 0 && history.length > OPENING.length) {
    const m = history.pop();
    unmake(m);
    const prev = history[history.length - 1];
    last = prev ? { from: prev.from, to: prev.to } : null;
    m.p.z = ++z;
    await slide(m, true, 240);
    if (g !== game) return;
  }
}

function reset() {
  game++; think++; busy = 0; z = 0;
  board = Array(64).fill(null); pieces = []; kings = {}; history = [];
  turn = 'w'; sel = -1; targets = []; last = null; over = null; thinking = false; started = false; note = '';
  stopClock();
  clock.w = 291; clock.b = 298; fx.over = 0; fx.hl = 1;
  const back = 'rnbqkbnr';
  for (let c = 0; c < 8; c++) { put(back[c], 'b', c); put('p', 'b', 8 + c); put('p', 'w', 48 + c); put(back[c], 'w', 56 + c); }
  for (const text of OPENING.slice(0, 4)) { const [m, list] = find(turn, text); commit(m, list); }
  for (const p of pieces) { p.x = p.s & 7; p.y = p.s >> 3; }
}

function intro() {
  if (history.length !== OPENING.length - 1) return;
  const [m, list] = find('w', 'Bb5');
  commit(m, list);
  slide(m, false, 560);
}

reset();
setTimeout(intro, 250);

function onAction(name, value) {
  if (name === 'sq') {
    if (!idle()) return;
    const s = Number(value), p = board[s];
    if (sel >= 0) {
      const m = targets.find(t => t.to === s);
      if (m) return userMove(m);
      if (p && p.c === 'b' && s !== sel) return select(s);
      return clearSel();
    }
    if (p && p.c === 'b') return select(s);
    if (p) flash("That's Sam's piece, you play Black");
    return;
  }
  if (name === 'book') {
    if (!idle()) return;
    const [m] = find('b', value);
    if (m) userMove(m);
    return;
  }
  if (name === 'undo') return undo();
  if (name === 'flip') {
    clearSel();
    flipTo = 1 - flipTo;
    tween(fx, { flip: flipTo }, 620, ease.inOutCubic);
    return;
  }
  if (name === 'new') {
    transition('fade');
    reset();
    setTimeout(intro, 350);
  }
}

function render() {
  const F = fx.flip > 0.5, hv = Math.abs(fx.flip * 2 - 1);
  const chk = attacked(kings[turn].s, foe(turn)) ? kings[turn].s : -1;
  const tmap = {};
  for (const m of targets) tmap[m.to] = m;
  let sqs = '';
  for (let R = 0; R < 8; R++) {
    sqs += '<div class="rw">';
    for (let C = 0; C < 8; C++) {
      const s = F ? 63 - (R * 8 + C) : R * 8 + C;
      const light = (R + C) % 2 === 0;
      let bg = light ? '#f0d9b5' : '#b58863';
      if (last && (s === last.from || s === last.to)) bg = mix(bg, light ? '#cdd26a' : '#aaa23a', fx.hl * hv);
      if (s === sel) bg = mix(bg, light ? '#f7ec5c' : '#d9c13a', fx.sel * hv);
      if (s === chk) bg = mix(bg, '#ff3b30', 0.62 * hv);
      const t = tmap[s];
      if (t && t.cap) bg = mix(bg, '#e0584a', 0.5 * clamp(fx.dot, 0, 1) * hv);
      let inner = '<div class="hv"></div>';
      if (t && !t.cap) {
        const d = Math.max(0, 11 * fx.dot * hv), pt = (S - d) / 2;
        inner = `<div class="hv" style="height: ${(S - pt).toFixed(1)}px; padding-top: ${pt.toFixed(1)}px"><div class="dot" style="width: ${d.toFixed(1)}px; height: ${d.toFixed(1)}px; border-radius: ${(d / 2).toFixed(1)}px"></div></div>`;
      }
      sqs += `<div class="sq" data-action="sq" data-value="${s}" style="background-color: ${bg}">${inner}</div>`;
    }
    sqs += '</div>';
  }

  const canAct = idle();
  const pcs = pieces.filter(p => !p.dead || p.a > 0.02).sort((a, b) => a.z - b.z).map(p => {
    const X = lerp(p.x, 7 - p.x, fx.flip) * S, Y = lerp(p.y, 7 - p.y, fx.flip) * S - 2 * p.lift;
    const a = clamp(p.a, 0, 1).toFixed(2);
    const act = canAct && !p.dead && (p.c === 'b' || !!tmap[p.s]);
    const glyph = p.c === 'w'
      ? `<span style="color: rgba(255,255,255,${a})">${FILL[p.t]}</span><div class="ol" style="color: rgba(28,28,30,${a})">${LINE[p.t]}</div>`
      : `<span style="color: rgba(28,28,30,${a})">${FILL[p.t]}</span>`;
    return `<div class="pc${act ? ' act' : ''}"${p.dead ? '' : ` data-action="sq" data-value="${p.s}"`} style="left: ${X.toFixed(1)}px; top: ${Y.toFixed(1)}px; font-size: ${(29 + 5 * p.lift).toFixed(1)}px">${glyph}</div>`;
  }).join('');

  const o = clamp(fx.over, 0, 1);
  const banner = over ? `<div class="banner" style="top: ${(98 + 10 * (1 - o)).toFixed(1)}px; background-color: rgba(28,28,30,${(0.88 * o).toFixed(2)})">
      <div style="font-size: ${Math.max(1, 19 * fx.over).toFixed(1)}px; font-weight: 800">${esc(over.title)}</div>
      <div class="small" style="color: rgba(255,255,255,${(0.8 * o).toFixed(2)})">${esc(over.sub)}</div></div>` : '';

  const ranks = [0, 1, 2, 3, 4, 5, 6, 7].map(R => `<div>${F ? R + 1 : 8 - R}</div>`).join('');
  const files = [0, 1, 2, 3, 4, 5, 6, 7].map(C => `<div>${FILES[F ? 7 - C : C]}</div>`).join('');

  const who = { w: 'Sam · White', b: 'Kai · you' };
  const clk = c => `<div class="clk${!over && turn === c ? ' on' : ''}"><div class="tiny">${who[c]}</div><b>${mmss(clock[c])}</b></div>`;
  const taken = c => {
    const gone = pieces.filter(p => p.dead && p.c === foe(c)).sort((a, b) => VAL[b.t] - VAL[a.t]);
    const mine = gone.reduce((n, p) => n + VAL[p.t], 0);
    const theirs = pieces.filter(p => p.dead && p.c === c).reduce((n, p) => n + VAL[p.t], 0);
    const glyphs = gone.map(p => p.c === 'w' ? LINE[p.t] : FILL[p.t]).join('');
    return `<div class="cap">${glyphs || '&nbsp;'}${mine > theirs ? ` <b class="small">+${mine - theirs}</b>` : ''}</div>`;
  };
  const topSide = F ? 'w' : 'b', bottomSide = foe(topSide);
  const name = openingName();
  const book = canAct ? bookMoves() : [];
  const middle = `<div style="margin-top: 6px"><div class="caps">Opening</div><div class="small" style="margin-top: 2px">Ruy Lopez${name ? `<br><span class="muted">${esc(name)}</span>` : ''}</div>
    ${book.length ? `<div class="caps" style="margin-top: 8px">Book</div><div>${book.map(b => `<span class="bk" data-action="book" data-value="${esc(b)}">${esc(b)}</span>`).join('')}</div>` : ''}</div>`;

  const status = over ? `<span class="badge">${esc(over.title)}</span>`
    : thinking ? '<span class="badge purple">Sam is thinking…</span>'
    : chk >= 0 ? '<span class="badge red">Check!</span>'
    : turn === 'b' ? '<span class="badge orange">Black to move</span>' : '<span class="badge">White to move</span>';

  const sans = history.map(m => m.san);
  const first = Math.max(0, sans.length - 16) & ~1;
  let pgn = first ? '<span class="n">…</span>' : '';
  for (let i = first; i < sans.length; i++) {
    pgn += (i % 2 ? '' : `<span class="n">${i / 2 + 1}.</span>`) + `<span class="m${i === sans.length - 1 ? ' last' : ''}">${sans[i]}</span> `;
  }

  const hint = over ? 'Undo, or start a new game' : thinking ? 'Your move is on the board' : sel >= 0 ? `${targets.length} move${targets.length === 1 ? '' : 's'} · tap a dot` : turn === 'b' ? 'Tap a black piece' : 'Sam opens…';
  const canUndo = history.length > OPENING.length && !busy;

  return `<div class="card pad chs">
    <div class="hd"><b class="grow" style="font-size: 16px">♟️ Sam vs Kai</b>${status}</div>
    <div class="tiny ${note ? 't-orange' : 'muted'}">${note ? esc(note) : 'You play Black for Kai · Sam answers from the book'}</div>
    <div class="wrap">
      <div>
        <div class="row" style="align-items: flex-start"><div class="rk">${ranks}</div><div class="bd">${sqs}${pcs}${banner}</div></div>
        <div class="fl">${files}</div>
      </div>
      <div class="side">
        ${clk(topSide)}${taken(topSide)}${middle}
        <div style="position: absolute; left: 0; top: 218px; width: 98px">${taken(bottomSide)}${clk(bottomSide)}</div>
      </div>
    </div>
    <div class="pgn">${pgn}</div>
    <div class="ctl"><span class="small muted grow">${hint}</span>
      <button${canUndo ? '' : ' class="off"'} data-action="undo">↶ Undo</button><button data-action="flip">⇅ Flip</button><button data-action="new">↻ New</button></div>
  </div>`;
}
</script>

