--- ana 07:41 bare
<style>
  .bp { width: 390px; max-width: 100%; }
  .bp .bp-top { padding: 12px 18px 10px 18px; border-radius: 13px 13px 0 0; background: linear-gradient(120deg, #0a84ff, #5e5ce6); color: #ffffff; }
  .bp .lbl { font-size: 10px; font-weight: 700; text-transform: uppercase; color: rgba(255,255,255,0.72); }
  .bp .end { width: 112px; flex-shrink: 0; }
  .bp .city { font-size: 36px; font-weight: 800; line-height: 1.05; }
  .bp .cityname { font-size: 12px; color: rgba(255,255,255,0.85); }
  .bp .route { position: relative; flex-grow: 1; height: 46px; margin: 0 8px; }
  .bp .route .line { position: absolute; left: 0; right: 0; top: 20px; border-top: 2px dotted rgba(255,255,255,0.5); }
  .bp .route .trail { position: absolute; left: 0; top: 20px; height: 2px; background-color: #ffffff; }
  .bp .route .plane { position: absolute; top: 12px; }
  .bp .route .dur { position: absolute; left: 0; right: 0; top: 29px; text-align: center; font-size: 11px; color: rgba(255,255,255,0.9); }
  .bp .tabs { display: flex; margin-top: 10px; padding: 2px; border-radius: 9px; background-color: rgba(255,255,255,0.16); }
  .bp .tab { flex-grow: 1; flex-basis: 0; text-align: center; padding: 3px 0; border-radius: 7px; font-size: 12px; font-weight: 700; color: rgba(255,255,255,0.9); }
  .bp .tab:hover { background-color: rgba(255,255,255,0.18); }
  .bp .tab.on { background-color: #ffffff; color: #0a84ff; }
  .bp .cd { padding: 10px 18px 0 18px; }
  .bp .mono { font-family: ui-monospace; }
  .bp .meter { height: 4px; border-radius: 2px; margin-top: 6px; background-color: rgba(127,127,127,0.2); }
  .bp .meter div { height: 4px; border-radius: 2px; }
  .bp .alert { overflow: hidden; margin: 10px 14px 0 14px; border-radius: 10px; }
  .bp .alert .ok { font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 8px; background-color: rgba(255,149,0,0.22); }
  .bp .alert .ok:hover { background-color: rgba(255,149,0,0.4); }
  .bp .cols { display: flex; padding: 12px 18px 0 18px; }
  .bp .cols > div { flex-grow: 1; flex-basis: 0; }
  .bp .k { font-size: 10px; font-weight: 700; text-transform: uppercase; }
  .bp .v { font-size: 17px; font-weight: 700; height: 24px; line-height: 24px; }
  .bp .seatcell { border-radius: 8px; padding: 0 4px; margin-right: -4px; }
  .bp .seatcell:hover { background-color: rgba(10,132,255,0.12); }
  .bp .perf { position: relative; height: 0; border-top: 2px dashed rgba(127,127,127,0.35); margin: 14px 14px 12px 14px; }
  .bp .notch { position: absolute; top: -12px; width: 22px; height: 22px; border-radius: 11px; }
  .lc-light .bp .notch { background-color: #ffffff; } .lc-dark .bp .notch { background-color: #1e1e1e; }
  .bp .bc { position: relative; height: 46px; margin: 10px 18px 0 18px; overflow: hidden; }
  .bp .barcode { height: 46px; background: repeating-linear-gradient(90deg, #1c1c1e 0px, #1c1c1e 2px, transparent 2px, transparent 4px, #1c1c1e 4px, #1c1c1e 5px, transparent 5px, transparent 8px, #1c1c1e 8px, #1c1c1e 11px, transparent 11px, transparent 12px, #1c1c1e 12px, #1c1c1e 13px, transparent 13px, transparent 16px); }
  .lc-dark .bp .barcode { background: repeating-linear-gradient(90deg, #f2f2f7 0px, #f2f2f7 2px, transparent 2px, transparent 4px, #f2f2f7 4px, #f2f2f7 5px, transparent 5px, transparent 8px, #f2f2f7 8px, #f2f2f7 11px, transparent 11px, transparent 12px, #f2f2f7 12px, #f2f2f7 13px, transparent 13px, transparent 16px); }
  .bp .scan { position: absolute; top: 0; width: 4px; height: 46px; margin-left: -2px; border-radius: 2px; background-color: #34c759; }
  .bp .foot { display: flex; align-items: center; padding: 10px 18px 14px 18px; }
  .bp .wal { margin: 10px 14px 14px 14px; padding: 8px 12px; border-radius: 10px; background-color: rgba(52,199,89,0.14); }
  .bp .spin { display: inline-block; width: 12px; height: 12px; border-radius: 6px; vertical-align: middle; margin-right: 5px; }
  .bp .lnk { font-weight: 600; color: #0a84ff; }
  .bp .lnk:hover { text-decoration: underline; }
  .bp .dl { display: flex; padding: 7px 0; border-top: 1px solid rgba(127,127,127,0.15); }
  .bp .dl:first-child { border-top: 0; }
  .bp .dk { width: 96px; flex-shrink: 0; font-size: 10px; font-weight: 700; text-transform: uppercase; padding-top: 3px; }
  .bp .seats { margin: 8px auto 6px auto; border-collapse: collapse; }
  .bp .seats td { width: 36px; height: 32px; padding: 0; text-align: center; vertical-align: middle; font-size: 11px; }
  .bp .st { width: 26px; height: 24px; line-height: 24px; margin: 0 auto; border-radius: 7px 7px 4px 4px; font-size: 10px; font-weight: 700; }
  .bp .st.free { background-color: rgba(10,132,255,0.12); color: #0a84ff; }
  .bp .st.free:hover { background-color: rgba(10,132,255,0.32); }
  .bp .st.xl { background-color: rgba(52,199,89,0.18); color: #28a745; }
  .bp .st.xl:hover { background-color: rgba(52,199,89,0.38); }
  .bp .st.cur { border: 2px dashed #0a84ff; width: 22px; height: 20px; line-height: 20px; }
  .bp .st.taken { background-color: rgba(127,127,127,0.22); }
  .bp .st.sel { background-color: #0a84ff; color: #ffffff; }
  .bp .st.fr { color: #ffffff; font-size: 9px; }
  .bp .legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin: 0 4px 0 10px; vertical-align: middle; }
</style>
<div class="card bp"><div class="bp-top"><b>TAP Air Portugal</b> · TP 535<div class="city">BER → LIS</div></div><div class="pad small">09 Oct · departs 10:05 · gate B12 · seat 14A</div></div>
<script>
const START = 8 * 3600 + 41 * 60 + 13, BOARD = 9 * 3600 + 20 * 60;
const ROWS = [12, 13, 14, 15, 16, 17], LETTERS = ['A', 'B', 'C', 'D', 'E', 'F'];
const TAKEN = ['12B', '12E', '13A', '13D', '13E', '14D', '14E', '14F', '15C', '15D', '16A', '16B', '16F', '17C', '17D', '17E'];
const FRIENDS = { '14B': ['TB', '#30b0c7'], '14C': ['AS', '#ff9500'] };
let view = 'pass', seat = '14A', pending = '14A', extra = 0;
let gate = 'B12', oldGate = null, wallet = 'none', refreshing = false, checkedAt = START;
const fx = { plane: 0, code: 0, alert: 0, flash: 0, gate: 1, seat: 1, pick: 1, scan: -1, spin: 0 };

const now = () => START + Math.floor(performance.now() / 1000);
const two = n => String(n).padStart(2, '0');
const hhmm = s => two(Math.floor(s / 3600) % 24) + ':' + two(Math.floor(s / 60) % 60);
const mmss = s => two(Math.floor(s / 60)) + ':' + two(s % 60);
const kind = id => /[AF]$/.test(id) ? 'window' : /[CD]$/.test(id) ? 'aisle' : 'middle';
const fee = id => id.startsWith('12') ? 18 : 0;
const spinner = color => `<span class="spin" style="background: conic-gradient(from ${Math.round(fx.spin % 360)}deg, ${alpha(color, 0)} 0deg, ${color} 300deg, ${alpha(color, 0)} 300deg)"></span>`;

setTimeout(() => {
  tween(fx, { plane: 1 }, 900, ease.inOutCubic);
  tween(fx, { code: 1 }, 800, ease.outCubic);
}, 250);
setInterval(() => {}, 1000);
setTimeout(changeGate, 6500);

async function changeGate() {
  if (oldGate) return;
  oldGate = gate; gate = 'B18';
  tween(fx, { alert: 1 }, 420, ease.outCubic);
  fx.gate = 1.5; tween(fx, { gate: 1 }, 800, ease.outElastic);
  for (let i = 0; i < 3; i++) await animate(520, p => { fx.flash = Math.sin(p * Math.PI); }, ease.linear);
  fx.flash = 0;
}

async function addToWallet() {
  if (wallet !== 'none') return;
  wallet = 'adding';
  await animate(850, p => { fx.spin = p * 1000; }, ease.linear);
  if (wallet !== 'adding') return;
  if (view === 'pass') transition('pop');
  wallet = 'added';
  await animate(900, p => { fx.scan = p; }, ease.inOutSine);
  fx.scan = -1;
}

async function refresh() {
  if (refreshing) return;
  refreshing = true;
  await animate(900, p => { fx.spin = p * 1000; }, ease.inOutCubic);
  refreshing = false;
  checkedAt = now();
  if (!oldGate) changeGate();
}

function onAction(name, value) {
  if (name === 'view') {
    if (value === view) return;
    if (value === 'seat') { pending = seat; transition('slide-up'); }
    else if (view === 'seat') transition('slide-down');
    else transition(value === 'details' ? 'slide-left' : 'slide-right');
    view = value;
  } else if (name === 'pick') {
    pending = value;
    fx.pick = 0.55; tween(fx, { pick: 1 }, 420, ease.outBack);
  } else if (name === 'confirm') {
    transition('pop');
    view = 'pass';
    if (pending !== seat) {
      seat = pending; extra = fee(seat);
      fx.seat = 1.5; tween(fx, { seat: 1 }, 900, ease.outElastic);
    }
  } else if (name === 'ack') {
    tween(fx, { alert: 0 }, 320, ease.inOutCubic);
  } else if (name === 'wallet') {
    addToWallet();
  } else if (name === 'unwallet') {
    transition('fade');
    wallet = 'none';
  } else if (name === 'refresh') {
    refresh();
  }
}

function top() {
  const x = (fx.plane * 50).toFixed(1);
  const on = view === 'seat' ? 'pass' : view;
  const tab = (k, label) => `<div class="tab ${on === k ? 'on' : ''}" data-action="view" data-value="${k}">${label}</div>`;
  return `<div class="bp-top">
    <div class="row between"><b>TAP Air Portugal</b><span class="lbl">Boarding pass · Economy</span></div>
    <div class="row" style="margin-top: 8px">
      <div class="end"><div class="city">BER</div><div class="cityname">Berlin Brandenburg</div></div>
      <div class="route"><div class="line"></div><div class="trail" style="width: ${x}%"></div>
        <img class="plane" src="icon:airplane?size=22&color=ffffff" style="left: ${x}%; margin-left: -9px"><div class="dur">3h 35m · nonstop</div></div>
      <div class="end right"><div class="city">LIS</div><div class="cityname">Lisbon Humberto Delgado</div></div>
    </div>
    <div class="tabs">${tab('pass', 'Boarding pass')}${tab('details', 'Details')}</div>
  </div>`;
}

function alertBox() {
  if (!oldGate || fx.alert < 0.01) return '';
  const h = Math.round(46 * Math.min(1, fx.alert));
  return `<div class="alert" style="height: ${h}px; background-color: rgba(255,149,0,${(0.14 + 0.26 * fx.flash).toFixed(3)})">
    <div class="row" style="padding: 7px 10px"><img src="icon:warning-fill?size=19&color=ff9500" style="margin-right: 9px">
      <div class="grow"><b class="small">Gate changed: ${oldGate} → ${gate}</b><div class="tiny muted">About 6 min walk · follow the signs to Pier B</div></div>
      <span class="ok t-orange" data-action="ack">OK</span></div></div>`;
}

function passView() {
  const left = BOARD - now();
  const frac = clamp(1 - left / 3600, 0, 1);
  const cd = left > 0
    ? `<span class="small">Boarding in <b class="mono">${mmss(left)}</b></span><span class="tiny muted">gate closes 09:45</span>`
    : `<b class="small t-green">Boarding now · group 3</b><span class="tiny muted">gate closes 09:45</span>`;
  const foot = wallet === 'added'
    ? `<div class="wal row"><img src="icon:check-circle-fill?size=24&color=34c759" style="margin-right: 9px">
        <div class="grow"><b class="small">Added to Apple Wallet</b><div class="tiny muted">It will show on your lock screen at BER</div></div>
        <span class="lnk small" data-action="unwallet">Remove</span></div>`
    : `<div class="foot"><span class="grow tiny muted">${extra ? `Extra legroom · €${extra} paid` : 'Tap the seat to change it'}</span>
        <button data-action="view" data-value="seat">💺 Seat</button>&nbsp;
        <button class="primary" data-action="wallet">${wallet === 'adding' ? spinner('#ffffff') + 'Adding…' : 'Add to Wallet'}</button></div>`;
  return `<div class="cd"><div class="row between">${cd}</div>
      <div class="meter"><div style="width: ${(frac * 100).toFixed(1)}%; background-color: ${left > 0 ? '#0a84ff' : '#34c759'}"></div></div></div>
    <div class="cols">
      <div><div class="k muted">Flight</div><div class="v">TP 535</div></div>
      <div><div class="k muted">Date</div><div class="v">09 Oct</div></div>
      <div><div class="k muted">Departs</div><div class="v">10:05</div></div>
      <div class="right"><div class="k muted">Arrives</div><div class="v">12:40</div></div>
    </div>
    <div class="cols">
      <div><div class="k muted">Gate</div><div class="v ${oldGate ? 't-orange' : 't-blue'}" style="font-size: ${Math.round(17 * fx.gate)}px">${gate}</div></div>
      <div><div class="k muted">Boarding</div><div class="v">09:20</div></div>
      <div><div class="k muted">Group</div><div class="v">3</div></div>
      <div class="right seatcell" data-action="view" data-value="seat"><div class="k muted">Seat ✎</div><div class="v t-blue" style="font-size: ${Math.round(17 * fx.seat)}px">${seat}</div></div>
    </div>
    <div class="perf"><div class="notch" style="left: -26px"></div><div class="notch" style="right: -26px"></div></div>
    <div class="row between" style="padding: 0 18px"><div><div class="k muted">Passenger</div><b>MORGAN / ALEX</b></div><div class="right"><div class="k muted">Booking ref</div><b class="mono">K7Q2XP</b></div></div>
    <div class="bc"><div class="barcode" style="width: ${(fx.code * 100).toFixed(1)}%"></div>${fx.scan >= 0 ? `<div class="scan" style="left: ${(fx.scan * 100).toFixed(1)}%"></div>` : ''}</div>
    <div class="center tiny muted" style="padding-top: 6px">Pass 1 of 3 · Tom in 14B · Ana in 14C</div>
    ${foot}`;
}

function detailsView() {
  const rows = [
    ['Passenger', 'MORGAN / ALEX', 'TAP Miles&amp;Go Silver · priority bag drop'],
    ['Ticket', '047 2183 554 019', 'Economy Classic · booking ref K7Q2XP'],
    ['Seat', `${seat} · ${kind(seat)}`, extra ? `Extra legroom row, €${extra} paid` : 'Tom 14B · Ana 14C, same booking'],
    ['Baggage', '1 × 23 kg checked', 'Cabin bag up to 8 kg + a personal item'],
    ['Gate', `${gate}${oldGate ? ' <span class="badge orange">changed</span>' : ''}`, 'Terminal 1 · boarding 09:20 · closes 09:45'],
    ['Aircraft', 'Airbus A320neo', 'CS-TVF · Wi-Fi on board · snacks for sale'],
  ].map(([k, v, s]) => `<div class="dl"><div class="dk muted">${k}</div><div class="grow"><b>${v}</b><div class="tiny muted">${s}</div></div></div>`).join('');
  const status = refreshing
    ? `${spinner('#0a84ff')}<span class="small muted">Checking with TAP…</span>`
    : `<span class="badge green">On time</span> <span class="tiny muted">updated ${hhmm(checkedAt)}</span>`;
  return `<div class="pad" style="padding-top: 8px">${rows}
    <div class="row" style="padding-top: 8px; border-top: 1px solid rgba(127,127,127,0.15)"><span class="grow">${status}</span><button data-action="refresh">↻ Refresh</button></div></div>`;
}

function seatView() {
  const cell = id => {
    const f = FRIENDS[id];
    if (f) return `<td><div class="st fr" style="background-color: ${f[1]}">${f[0]}</div></td>`;
    if (TAKEN.includes(id)) return '<td><div class="st taken">&nbsp;</div></td>';
    if (id === pending) {
      const w = Math.round(26 * fx.pick), h = Math.round(24 * fx.pick);
      return `<td><div class="st sel" data-action="pick" data-value="${id}" style="width: ${w}px; height: ${h}px; line-height: ${h}px">✓</div></td>`;
    }
    const cls = id === seat ? 'free cur' : id.startsWith('12') ? 'xl' : 'free';
    return `<td><div class="st ${cls}" data-action="pick" data-value="${id}">${id.slice(-1)}</div></td>`;
  };
  const head = `<tr>${['A', 'B', 'C'].map(c => `<td class="muted">${c}</td>`).join('')}<td>&nbsp;</td>${['D', 'E', 'F'].map(c => `<td class="muted">${c}</td>`).join('')}</tr>`;
  const rows = ROWS.map(r => {
    const cells = LETTERS.map(c => cell(r + c));
    return `<tr>${cells.slice(0, 3).join('')}<td class="muted">${r}</td>${cells.slice(3).join('')}</tr>`;
  }).join('');
  const price = fee(pending);
  return `<div class="pad" style="padding-top: 10px">
    <div class="row between"><b>Choose a seat</b><span class="tiny muted">A320neo · rows 12–17</span></div>
    <table class="seats">${head}${rows}</table>
    <div class="legend tiny muted center"><i style="background-color: #0a84ff; margin-left: 0"></i>yours<i style="background-color: rgba(52,199,89,0.5)"></i>extra legroom<i style="background-color: rgba(127,127,127,0.3)"></i>taken</div>
    <div class="row" style="margin-top: 10px"><span class="grow small"><b>${pending}</b> · ${kind(pending)}${price ? ` · <span class="t-green">+€${price}</span>` : ' · free'}</span>
      <button data-action="view" data-value="pass">Cancel</button>&nbsp;<button class="primary" data-action="confirm">${pending === seat ? 'Keep seat' : 'Confirm'}</button></div>
  </div>`;
}

function render() {
  const body = view === 'details' ? detailsView() : view === 'seat' ? seatView() : passView();
  return `<div class="card bp">${top()}${alertBox()}${body}</div>`;
}
</script>

