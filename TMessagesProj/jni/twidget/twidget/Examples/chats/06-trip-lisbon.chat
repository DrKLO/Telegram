</style>
<div class="card pad wx"><b>☀️ Lisbon · 24°</b><div class="small muted">Sunny, light breeze · H 26° · L 17° · Saturday drizzle</div></div>
<script>
const SLOTS = ['00', '03', '06', '09', '12', '15', '18', '21'];
const SUN = 'sun-fill?size=26&color=ffcc00', PART = 'cloud-sun-fill?size=26&color=ff9f0a';
const DAYS = [
  { n: 'Thu', full: 'Thursday', sky: 'Sunny', icon: SUN, hi: 26, lo: 17, uv: 6, set: '19:12', temp: [18, 17, 17, 21, 25, 26, 23, 20], rain: [0, 0, 0, 0, 0, 0, 5, 5], wind: [6, 6, 8, 12, 16, 19, 15, 9] },
  { n: 'Fri', full: 'Friday', sky: 'Partly cloudy', icon: PART, hi: 24, lo: 17, uv: 5, set: '19:10', temp: [18, 17, 17, 20, 23, 24, 22, 19], rain: [5, 5, 10, 10, 15, 20, 10, 5], wind: [8, 8, 10, 14, 18, 20, 16, 10] },
  { n: 'Sat', full: 'Saturday', sky: 'Drizzle', icon: 'cloud-rain-fill?size=26&color=5ac8fa', hi: 21, lo: 15, uv: 3, set: '19:09', temp: [16, 15, 15, 17, 19, 21, 19, 17], rain: [40, 55, 60, 70, 65, 50, 45, 35], wind: [14, 16, 18, 22, 24, 24, 20, 16] },
  { n: 'Sun', full: 'Sunday', sky: 'Clearing up', icon: PART, hi: 23, lo: 16, uv: 5, set: '19:07', temp: [17, 16, 16, 19, 22, 23, 21, 18], rain: [20, 15, 10, 5, 5, 5, 0, 0], wind: [12, 10, 10, 12, 15, 16, 12, 10] },
  { n: 'Mon', full: 'Monday', sky: 'Sunny and warm', icon: SUN, hi: 27, lo: 18, uv: 7, set: '19:06', temp: [19, 18, 18, 22, 26, 27, 24, 21], rain: [0, 0, 0, 0, 0, 0, 0, 0], wind: [6, 6, 6, 10, 14, 16, 12, 8] },
  { n: 'Tue', full: 'Tuesday', sky: 'Windy', icon: 'wind?size=26&color=8e8e93', hi: 22, lo: 16, uv: 5, set: '19:04', temp: [17, 16, 16, 18, 21, 22, 20, 18], rain: [0, 0, 5, 5, 0, 0, 0, 0], wind: [22, 24, 26, 30, 34, 32, 28, 24] },
  { n: 'Wed', full: 'Wednesday', sky: 'Sunny', icon: SUN, hi: 25, lo: 17, uv: 6, set: '19:03', temp: [18, 17, 17, 21, 24, 25, 22, 19], rain: [0, 0, 0, 0, 0, 0, 0, 0], wind: [8, 8, 8, 12, 15, 16, 12, 9] },
];
const METRICS = { temp: { label: 'Temp', color: '#ff9500', lo: 12, hi: 30 }, rain: { label: 'Rain', color: '#0a84ff', lo: 0, hi: 100 }, wind: { label: 'Wind', color: '#30b0c7', lo: 0, hi: 40 } };
const W = 392, H = 92, TOP = 20, BOT = 6;
let sel = 0, metric = 'temp', unit = 'C', open = true, run = 0;
let ys = Array(8).fill(0), vals = Array(8).fill(0), col = mix('#ff9500', '#ff9500', 1);
const fx = { f: 0, intro: 0 };

const T = c => Math.round(c + fx.f * (c * 0.8 + 32)) + '°';
const speed = v => Math.round(v * (1 - 0.379 * fx.f));
const speedUnit = () => fx.f > 0.5 ? 'mph' : 'km/h';
const hex = c => '#' + String(c).match(/\d+/g).slice(0, 3).map(n => Number(n).toString(16).padStart(2, '0')).join('');
const f1 = n => n.toFixed(1);

function morph(ms) {
  const me = ++run, M = METRICS[metric];
  const fromY = ys.slice(), fromV = vals.slice(), fromC = col;
  const toV = DAYS[sel][metric], toY = toV.map(v => clamp((v - M.lo) / (M.hi - M.lo), 0, 1));
  return animate(ms, p => {
    if (me !== run) return;
    ys = fromY.map((y, i) => lerp(y, toY[i], p));
    vals = fromV.map((v, i) => lerp(v, toV[i], p));
    col = mix(fromC, M.color, p);
  }, ease.outCubic);
}
setTimeout(() => { tween(fx, { intro: 1 }, 850, ease.outCubic); morph(900); }, 250);

function onAction(name, value) {
  if (name === 'unit') {
    if (value === unit) return;
    unit = value;
    tween(fx, { f: unit === 'F' ? 1 : 0 }, 650, ease.inOutCubic);
  } else if (name === 'day') {
    const d = Number(value);
    if (d === sel) { transition('fade'); open = !open; return; }
    if (!open) { transition('fade'); open = true; }
    sel = d;
    morph(650);
  } else if (name === 'metric') {
    if (value === metric) return;
    metric = value;
    morph(550);
  }
}

function curve(pts) {
  let d = `M${f1(pts[0][0])},${f1(pts[0][1])}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[Math.max(0, i - 1)], p1 = pts[i], p2 = pts[i + 1], p3 = pts[Math.min(pts.length - 1, i + 2)];
    d += ` C${f1(p1[0] + (p2[0] - p0[0]) / 6)},${f1(p1[1] + (p2[1] - p0[1]) / 6)} ${f1(p2[0] - (p3[0] - p1[0]) / 6)},${f1(p2[1] - (p3[1] - p1[1]) / 6)} ${f1(p2[0])},${f1(p2[1])}`;
  }
  return d;
}

function label(v) {
  if (metric === 'temp') return T(v);
  if (metric === 'rain') return Math.round(v) + '%';
  return String(speed(v));
}

function chart() {
  const c = hex(col);
  const pts = ys.map((y, i) => [W * (i + 0.5) / 8, TOP + (1 - y) * (H - TOP - BOT)]);
  const line = curve(pts);
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' width='${W}' height='${H}' viewBox='0 0 ${W} ${H}'>` +
    `<defs><linearGradient id='g' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='${c}' stop-opacity='0.35'/><stop offset='1' stop-color='${c}' stop-opacity='0'/></linearGradient></defs>` +
    `<path d='${line} L${f1(pts[7][0])},${H} L${f1(pts[0][0])},${H} Z' fill='url(#g)'/>` +
    `<path d='${line}' fill='none' stroke='${c}' stroke-width='2.5' stroke-linecap='round'/>` +
    pts.map(p => `<circle cx='${f1(p[0])}' cy='${f1(p[1])}' r='3.2' fill='${c}'/>`).join('') + '</svg>';
  const labels = pts.map((p, i) => `<div class="val" style="left: ${Math.round(p[0] - 22)}px; top: ${Math.round(p[1] - 18)}px; color: ${c}">${label(vals[i])}</div>`).join('');
  return `<div class="plot"><img src="data:image/svg+xml;utf8,${encodeURIComponent(svg)}" width="${W}" height="${H}">${labels}</div>`;
}

function hourly() {
  const D = DAYS[sel];
  const tabs = Object.keys(METRICS).map(k => `<span class="${k === metric ? 'on' : ''}" data-action="metric" data-value="${k}">${METRICS[k].label}</span>`).join('');
  const peakAt = D.temp.indexOf(Math.max(...D.temp));
  const note = metric === 'temp' ? `Warmest ${T(D.hi)} around ${SLOTS[peakAt]}:00`
    : metric === 'rain' ? (Math.max(...D.rain) >= 40 ? `Rain up to ${Math.max(...D.rain)}% · bring a jacket` : `Rain up to ${Math.max(...D.rain)}% · stays dry`)
    : `Gusts to ${speed(Math.max(...D.wind) * 1.4)} ${speedUnit()}`;
  return `<div class="hourly"><div class="sep" style="margin-bottom: 8px"></div>
    <div class="row between"><span><b>${D.full}</b> <span class="small muted">· ${D.sky}</span></span><span class="seg">${tabs}</span></div>
    ${chart()}
    <div class="hrs">${SLOTS.map(s => `<div class="muted">${s}</div>`).join('')}</div>
    <div class="tiny muted" style="margin-top: 6px">${note} · UV ${D.uv} · sunset ${D.set}${metric === 'wind' ? ` · ${speedUnit()}` : ''}</div>
  </div>`;
}

function render() {
  const days = DAYS.map((d, i) => {
    const w = (d.hi - d.lo) / 12 * 100 * fx.intro, m = (d.lo - 15) / 12 * 100;
    return `<div class="day ${open && i === sel ? 'on' : ''}" data-action="day" data-value="${i}"><div class="n">${d.n}</div><img src="icon:${d.icon}" style="margin: 4px 0">
      <div class="hi">${T(d.hi)}</div><div class="rng"><div style="width: ${w.toFixed(1)}%; margin-left: ${m.toFixed(1)}%"></div></div><div class="lo muted">${T(d.lo)}</div></div>`;
  }).join('');
  const units = ['C', 'F'].map(u => `<span class="${u === unit ? 'on' : ''}" data-action="unit" data-value="${u}">°${u}</span>`).join('');
  return `<div class="card wx">
    <div class="pad row">
      <img src="icon:sun-fill?size=43&color=ffcc00" style="margin-right: 12px">
      <div class="grow"><div class="caps">Lisbon · now</div><div style="font-size: 30px; font-weight: 800; line-height: 1.1">${T(24 * fx.intro)}</div></div>
      <div class="right small"><span class="seg">${units}</span><div style="margin-top: 4px">Sunny, light breeze</div><div class="muted">H ${T(26)} · L ${T(17)} · UV 6</div></div>
    </div>
    <div class="sep" style="margin: 0 14px"></div>
    <div class="days">${days}</div>
    ${open ? hourly() : '<div class="center tiny muted" style="padding: 0 0 12px 0">Tap a day for the hourly forecast</div>'}
  </div>`;
}
</script>

