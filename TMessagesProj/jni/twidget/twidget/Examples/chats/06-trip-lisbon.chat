<style>
  .pb { width: 360px; max-width: 100%; }
  .pb .cats { display: flex; margin: 8px 0 6px 0; }
  .pb .cat { flex-grow: 1; text-align: center; padding: 3px 0; margin-right: 4px; border-radius: 8px; font-size: 12px; font-weight: 600; background-color: rgba(127,127,127,0.12); }
  .pb .cat:last-child { margin-right: 0; }
  .pb .cat:hover { background-color: rgba(127,127,127,0.24); }
  .pb .cat.on { background-color: #ff9500; color: #ffffff; }
  .pb .pr { padding: 5px 8px; border-bottom: 1px solid rgba(127,127,127,0.2); border-radius: 6px; }
  .pb .pr:hover { background-color: rgba(255,149,0,0.15); }
  .pb .pr.on { background-color: rgba(255,149,0,0.08); }
  .pb .rv { overflow: hidden; }
  .pb .say { font-style: italic; color: #8e8e93; font-size: 13px; }
  .pb .lbar { height: 4px; border-radius: 2px; margin-top: 3px; background-color: rgba(127,127,127,0.2); }
  .pb .lbar div { height: 4px; border-radius: 2px; background-color: #ff9500; }
  .pb .qcard { height: 132px; margin: 8px auto 10px auto; border-radius: 14px; overflow: hidden; color: #ffffff; text-align: center; }
  .pb .qin { width: 330px; padding-top: 26px; }
  .pb .qtag { font-size: 11px; font-weight: 700; text-transform: uppercase; color: rgba(255,255,255,0.75); }
  .pb .qbig { font-size: 22px; font-weight: 800; margin: 8px 0 6px 0; }
  .pb .qsay { font-size: 14px; font-style: italic; color: rgba(255,255,255,0.9); }
  .pb .qcard b.t-orange { color: #ffd60a; }
  .pb .qd { display: inline-block; width: 8px; height: 8px; border-radius: 4px; margin-left: 4px; }
  .pb .qscore { font-size: 40px; font-weight: 800; color: #ff9500; }
  .pb .close { margin-left: 10px; padding: 2px 6px; border-radius: 6px; }
  .pb .close:hover { background-color: rgba(127,127,127,0.18); }
</style>
<p>Survival Portuguese 🇵🇹: Olá · Obrigado/a · Por favor · Uma bica · A conta · Saúde!</p>
<script>
const CATS = [['all', 'All'], ['basics', '👋 Basics'], ['food', '☕ Food'], ['around', '🧭 Around']];
const PH = [
  { c: 'basics', pt: 'Olá / Bom dia', say: 'oh-LAH / bong DEE-ah', en: 'Hi / Good morning' },
  { c: 'basics', pt: 'Obrigado / Obrigada', say: 'oh-bree-GAH-doo / -dah', en: 'Thank you (m / f)' },
  { c: 'basics', pt: 'Por favor', say: 'poor fah-VOR', en: 'Please' },
  { c: 'basics', pt: 'Desculpe', say: 'desh-KOOL-peh', en: 'Excuse me / sorry' },
  { c: 'food', pt: 'Uma bica, por favor', say: 'OO-mah BEE-kah', en: 'An espresso, please' },
  { c: 'food', pt: 'Uma mesa para três', say: 'OO-mah MEH-zah PAH-rah TRESH', en: 'A table for three' },
  { c: 'food', pt: 'A conta, por favor', say: 'ah KON-tah', en: 'The bill, please' },
  { c: 'food', pt: 'Saúde! 🥂', say: 'sah-OO-deh', en: 'Cheers!' },
  { c: 'around', pt: 'Onde fica…?', say: 'ON-deh FEE-kah', en: 'Where is…?' },
  { c: 'around', pt: 'Quanto custa?', say: 'KWAN-too KOOSH-tah', en: 'How much is it?' },
  { c: 'around', pt: 'Fala inglês?', say: 'FAH-lah een-GLAYSH', en: 'Do you speak English?' },
  { c: 'around', pt: 'Não percebo', say: 'nowng per-SEH-boo', en: "I don't understand" },
];
const CW = 330;
let cat = 'all', mode = 'list', deck = [], marks = [], qi = 0, flipped = false, flipping = false, qrun = 0;
const open = new Set(), seen = new Set(), rv = {};
const fx = { intro: 0, flip: 0, learned: 0, score: 0 };

const stress = s => esc(s).replace(/[A-Z]{2,}/g, m => `<b class="t-orange">${m}</b>`);
const visible = () => PH.map((p, i) => i).filter(i => cat === 'all' || PH[i].c === cat);
const learnedTo = () => tween(fx, { learned: seen.size / PH.length }, 500, ease.outCubic);

setTimeout(() => tween(fx, { intro: 1 }, 900, ease.linear), 250);

function reveal(i, on) {
  if (on) { open.add(i); seen.add(i); } else open.delete(i);
  rv[i] = rv[i] || { v: 0 };
  tween(rv[i], { v: on ? 1 : 0 }, on ? 320 : 220, on ? ease.outCubic : ease.inOutCubic);
  learnedTo();
}

function startQuiz() {
  const pool = visible();
  for (let k = pool.length - 1; k > 0; k--) { const j = Math.floor(Math.random() * (k + 1)); [pool[k], pool[j]] = [pool[j], pool[k]]; }
  deck = pool.slice(0, 5); marks = []; qi = 0; flipped = false; flipping = false; qrun++;
  tween(fx, { flip: 0 }, 1); fx.flip = 0;
  mode = 'quiz';
}

async function flip() {
  if (flipping) return;
  const me = qrun;
  flipping = true;
  await tween(fx, { flip: flipped ? 0 : 1 }, 560, ease.inOutSine);
  if (me !== qrun) return;
  flipped = !flipped; flipping = false;
}

function answer(ok) {
  if (!flipped || flipping) return;
  marks.push(ok);
  if (ok) { seen.add(deck[qi]); learnedTo(); }
  qrun++;
  if (qi + 1 >= deck.length) {
    transition('pop');
    mode = 'done';
    fx.score = 0; tween(fx, { score: 1 }, 800, ease.outCubic);
  } else {
    transition('slide-left');
    qi++; flipped = false;
    tween(fx, { flip: 0 }, 1); fx.flip = 0;
  }
}

function onAction(name, value) {
  if (name === 'cat') {
    if (value === cat) return;
    const order = CATS.map(c => c[0]);
    transition(order.indexOf(value) > order.indexOf(cat) ? 'slide-left' : 'slide-right');
    cat = value;
  } else if (name === 'row') {
    const i = Number(value);
    reveal(i, !open.has(i));
  } else if (name === 'all') {
    const list = visible(), on = list.some(i => !open.has(i));
    list.forEach(i => reveal(i, on));
  } else if (name === 'quiz') {
    transition('slide-left');
    startQuiz();
  } else if (name === 'flip') {
    flip();
  } else if (name === 'answer') {
    answer(value === 'yes');
  } else if (name === 'exit') {
    transition('slide-right');
    mode = 'list'; qrun++; flipping = false;
  }
}

function listView() {
  const list = visible();
  const cats = CATS.map(([k, label]) => `<div class="cat ${k === cat ? 'on' : 'fg'}" data-action="cat" data-value="${k}">${label}</div>`).join('');
  const rows = list.map((i, k) => {
    const p = PH[i], e = ease.outCubic(clamp((fx.intro * 900 - k * 45) / 360, 0, 1));
    const r = rv[i] ? rv[i].v : 0;
    const more = r > 0.01 ? `<div class="rv" style="height: ${Math.round(36 * r)}px"><div style="padding-top: 3px; margin-left: ${Math.round((1 - r) * 14)}px">
        <div class="say">🗣 ${stress(p.say)}</div><div class="small">${esc(p.en)}</div></div></div>` : '';
    return `<div class="pr ${open.has(i) ? 'on' : ''}" data-action="row" data-value="${i}" style="margin-left: ${Math.round((1 - e) * 24)}px">
      <div class="row"><b class="grow">${esc(p.pt)}</b><span class="tiny muted">${open.has(i) ? '▴' : seen.has(i) ? '✓ ▾' : '▾'}</span></div>${more}</div>`;
  }).join('');
  const allOpen = list.every(i => open.has(i));
  return `<div class="pb">
    <div class="row"><b class="grow">Survival Portuguese 🇵🇹</b><span class="tiny muted">hover a row, tap to reveal</span></div>
    <div class="cats">${cats}</div>
    ${rows}
    <div class="row" style="margin-top: 8px"><div class="grow" style="margin-right: 10px"><div class="tiny muted">Learned ${seen.size} / ${PH.length}</div><div class="lbar"><div style="width: ${(fx.learned * 100).toFixed(1)}%"></div></div></div>
      <button data-action="all">${allOpen ? 'Hide all' : 'Reveal all'}</button>&nbsp;<button class="primary" data-action="quiz">🎯 Quiz me</button></div>
  </div>`;
}

function quizView() {
  const p = PH[deck[qi]], t = fx.flip, back = t >= 0.5;
  const w = Math.max(2, Math.round(CW * Math.abs(Math.cos(Math.PI * t))));
  const face = back
    ? `<div class="qtag">It means</div><div class="qbig">${esc(p.en)}</div><div class="qsay">🗣 ${stress(p.say)}</div>`
    : `<div class="qtag">What does this mean?</div><div class="qbig">${esc(p.pt)}</div><div class="qtag">tap the card to flip</div>`;
  const dots = deck.map((_, k) => `<span class="qd" style="background-color: ${k < marks.length ? (marks[k] ? '#34c759' : '#ff3b30') : k === qi ? '#ff9500' : 'rgba(127,127,127,0.3)'}"></span>`).join('');
  const btns = flipped && !flipping
    ? '<button data-action="answer" data-value="no">✗ Again</button>&nbsp;<button class="primary" data-action="answer" data-value="yes">✓ Knew it</button>'
    : '<button class="primary" data-action="flip">Flip card</button>';
  return `<div class="pb">
    <div class="row"><b class="grow">🎯 Quiz · card ${qi + 1} of ${deck.length}</b>${dots}<span class="tiny muted close" data-action="exit">✕ Close</span></div>
    <div class="qcard" data-action="flip" style="width: ${w}px; background: ${back ? 'linear-gradient(135deg, #0a84ff, #5e5ce6)' : 'linear-gradient(135deg, #ff9500, #ff2d55)'}">
      <div class="qin" style="margin-left: ${Math.round((w - CW) / 2)}px">${face}</div></div>
    <div class="center">${btns}</div>
  </div>`;
}

function doneView() {
  const right = marks.filter(Boolean).length;
  const msg = right === deck.length ? 'Perfeito! 🏆' : right >= deck.length - 1 ? 'Muito bem! 🎉' : 'Quase! Keep practising 💪';
  return `<div class="pb center">
    <div class="tiny muted" style="margin-top: 4px">QUIZ DONE</div>
    <div class="qscore">${Math.round(right * fx.score)} / ${deck.length}</div>
    <div><b>${msg}</b></div>
    <div class="small muted" style="margin-top: 2px">Learned ${seen.size} of ${PH.length} phrases so far</div>
    <div style="margin-top: 10px"><button data-action="exit">‹ Phrases</button>&nbsp;<button class="primary" data-action="quiz">↻ Again</button></div>
  </div>`;
}

function render() { return mode === 'quiz' ? quizView() : mode === 'done' ? doneView() : listView(); }
</script>
