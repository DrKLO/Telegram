<div class="card pad rs"><b>🍽 Friday lunch — pick one</b><div class="small muted">Sea Me Peixaria · Ao 26 Vegan Food Project · O Trevo</div></div>
<script>
const PLACES = [
  { name: 'Sea Me Peixaria', img: 'data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27200%27%20height=%27200%27%20viewBox=%270%200%20200%20200%27%3E%3Cdefs%3E%3ClinearGradient%20id=%27g%27%20x1=%270%27%20y1=%271%27%20x2=%270%27%20y2=%270%27%3E%3Cstop%20offset=%270%27%20stop-color=%27%2389f7fe%27/%3E%3Cstop%20offset=%270.5%27%20stop-color=%27%2366a6ff%27/%3E%3Cstop%20offset=%271%27%20stop-color=%27%232a5298%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width=%27200%27%20height=%27200%27%20fill=%27url%28%23g%29%27/%3E%3Cpath%20d=%27M0%2070C10%2062%2030%2078%2040%2070C50%2062%2070%2078%2080%2070C90%2062%20110%2078%20120%2070C130%2062%20150%2078%20160%2070C170%2062%20190%2078%20200%2070M0%2094C10%2086%2030%20102%2040%2094C50%2086%2070%20102%2080%2094C90%2086%20110%20102%20120%2094C130%2086%20150%20102%20160%2094C170%2086%20190%20102%20200%2094M0%20118C10%20110%2030%20126%2040%20118C50%20110%2070%20126%2080%20118C90%20110%20110%20126%20120%20118C130%20110%20150%20126%20160%20118C170%20110%20190%20126%20200%20118M0%20142C10%20134%2030%20150%2040%20142C50%20134%2070%20150%2080%20142C90%20134%20110%20150%20120%20142C130%20134%20150%20150%20160%20142C170%20134%20190%20150%20200%20142M0%20166C10%20158%2030%20174%2040%20166C50%20158%2070%20174%2080%20166C90%20158%20110%20174%20120%20166C130%20158%20150%20174%20160%20166C170%20158%20190%20174%20200%20166M0%20190C10%20182%2030%20198%2040%20190C50%20182%2070%20198%2080%20190C90%20182%20110%20198%20120%20190C130%20182%20150%20198%20160%20190C170%20182%20190%20198%20200%20190%27%20fill=%27none%27%20stroke=%27%23ffffff%27%20stroke-opacity=%270.35%27%20stroke-width=%272%27/%3E%3C/svg%3E', kind: 'Seafood', price: '€€€', stars: '4.6', area: 'Chiado', note: 'Sushi-meets-Portuguese. Book ahead.' },
  { name: 'Ao 26 Vegan Food Project', img: 'data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27200%27%20height=%27200%27%20viewBox=%270%200%20200%20200%27%3E%3Cdefs%3E%3ClinearGradient%20id=%27g%27%20x1=%270%27%20y1=%271%27%20x2=%270%27%20y2=%270%27%3E%3Cstop%20offset=%270%27%20stop-color=%27%23d4fc79%27/%3E%3Cstop%20offset=%270.5%27%20stop-color=%27%2396e6a1%27/%3E%3Cstop%20offset=%271%27%20stop-color=%27%233a7d44%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width=%27200%27%20height=%27200%27%20fill=%27url%28%23g%29%27/%3E%3Cpath%20d=%27M-10%20200L10%20130L30%20200Z%27%20fill=%27%232d6a4f%27/%3E%3Cpath%20d=%27M16%20200L36%2093L56%20200Z%27%20fill=%27%231e5631%27/%3E%3Cpath%20d=%27M42%20200L62%20106L82%20200Z%27%20fill=%27%232d6a4f%27/%3E%3Cpath%20d=%27M68%20200L88%20119L108%20200Z%27%20fill=%27%231e5631%27/%3E%3Cpath%20d=%27M94%20200L114%2082L134%20200Z%27%20fill=%27%232d6a4f%27/%3E%3Cpath%20d=%27M120%20200L140%2095L160%20200Z%27%20fill=%27%231e5631%27/%3E%3Cpath%20d=%27M146%20200L166%20108L186%20200Z%27%20fill=%27%232d6a4f%27/%3E%3Cpath%20d=%27M172%20200L192%20121L212%20200Z%27%20fill=%27%231e5631%27/%3E%3Cpath%20d=%27M198%20200L218%2084L238%20200Z%27%20fill=%27%232d6a4f%27/%3E%3C/svg%3E', kind: 'Vegan', price: '€€', stars: '4.7', area: 'Baixa', note: "Tom's choice. The seitan bifana is real." },
  { name: 'O Trevo', img: 'data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27200%27%20height=%27200%27%20viewBox=%270%200%20200%20200%27%3E%3Cdefs%3E%3ClinearGradient%20id=%27g%27%20x1=%270%27%20y1=%271%27%20x2=%270%27%20y2=%270%27%3E%3Cstop%20offset=%270%27%20stop-color=%27%23ffe29f%27/%3E%3Cstop%20offset=%270.5%27%20stop-color=%27%23ffa99f%27/%3E%3Cstop%20offset=%271%27%20stop-color=%27%23ff719a%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width=%27200%27%20height=%27200%27%20fill=%27url%28%23g%29%27/%3E%3Cpath%20d=%27M0%20200V110C60%2070%20120%20140%20200%20100V200Z%27%20fill=%27%23f6a05c%27/%3E%3Cpath%20d=%27M0%20200V140C60%20100%20120%20170%20200%20138V200Z%27%20fill=%27%23e07b39%27/%3E%3Cpath%20d=%27M0%20200V170C60%20130%20120%20200%20200%20176V200Z%27%20fill=%27%23b85a26%27/%3E%3C/svg%3E', kind: 'Bifanas', price: '€', stars: '4.5', area: 'Bairro Alto', note: 'Bourdain ate here. Standing room only.' },
];
const PEOPLE = [{ id: 'ana', ini: 'AS', color: '#ff9500' }, { id: 'tom', ini: 'TB', color: '#30b0c7' }, { id: 'me', ini: 'ME', color: '#007aff' }];
const votes = { ana: 0, tom: 1, me: null };
let view = 'vote', hl = -1, spinning = false, pick = -1, booked = false, run = 0, ref = '';
let shown = [0, 0, 0];
const fx = { pop: 1 };

const counts = () => PLACES.map((_, i) => PEOPLE.filter(p => votes[p.id] === i).length);
const shares = () => { const c = counts(), t = c.reduce((a, b) => a + b, 0) || 1; return c.map(x => x / t); };

function retarget(ms) {
  const from = shown.slice(), to = shares();
  animate(ms, p => { shown = from.map((f, k) => lerp(f, to[k], p)); }, ease.outCubic);
}
setTimeout(() => retarget(850), 250);

async function decide() {
  if (spinning) return;
  const me = ++run;
  spinning = true;
  const w = counts().map(x => 1 + 2 * x), sum = w.reduce((a, b) => a + b, 0);
  let r = Math.random() * sum, target = 0;
  while (target < 2 && r >= w[target]) { r -= w[target]; target++; }
  if (hl < 0) hl = 0;
  const steps = 12 + ((target - hl) % 3 + 3) % 3;
  let delay = 60;
  for (let k = 0; k < steps; k++) {
    await sleep(delay);
    if (me !== run) return;
    hl = (hl + 1) % 3;
    delay *= 1.15;
  }
  await sleep(450);
  if (me !== run) return;
  spinning = false; hl = -1; pick = target; booked = false;
  transition('pop');
  view = 'result';
  fx.pop = 0.3; tween(fx, { pop: 1 }, 800, ease.outElastic);
}

function onAction(name, value) {
  if (name === 'vote') {
    if (spinning) return;
    const i = Number(value);
    votes.me = votes.me === i ? null : i;
    retarget(600);
  } else if (name === 'decide') {
    decide();
  } else if (name === 'book' && !booked) {
    transition('pop');
    booked = true;
    ref = '#' + (4000 + Math.floor(Math.random() * 5000));
  } else if (name === 'reroll') {
    transition('slide-right');
    view = 'vote'; booked = false;
    decide();
  } else if (name === 'back') {
    transition('slide-right');
    view = 'vote'; booked = false;
  }
}

function voteView() {
  const c = counts(), max = Math.max(...c), leaders = c.filter(x => x === max).length;
  const opts = PLACES.map((p, i) => {
    const pc = shown[i] * 100, mine = votes.me === i, lit = hl === i;
    const fill = lit ? 'rgba(10,132,255,0.30)' : mine ? 'rgba(52,199,89,0.22)' : 'rgba(127,127,127,0.14)';
    const voters = PEOPLE.filter(v => votes[v.id] === i).map(v => `<span class="av vt" style="background-color: ${v.color}">${v.ini}</span>`).join('');
    return `<div class="opt fg ${mine ? 'mine' : ''} ${lit ? 'lit' : ''}" data-action="vote" data-value="${i}" style="background: linear-gradient(90deg, ${fill} ${pc.toFixed(1)}%, rgba(127,127,127,0.03) ${pc.toFixed(1)}%)">
      <img src="${p.img}" width="54" height="54"><div class="grow"><b>${esc(p.name)}</b>${mine ? ' <span class="badge green">YOUR VOTE ✓</span>' : ''}
        <div class="small muted">${p.kind} · ${p.price} · <span class="t-orange">★ ${p.stars}</span> · ${p.area}</div><div class="tiny muted">${esc(p.note)}</div></div>
      <div class="right" style="width: 62px"><b>${Math.round(pc)}%</b><div style="margin-top: 3px">${voters || '<span class="tiny muted">no votes</span>'}</div></div></div>`;
  }).join('');
  const status = spinning ? '🎲 The dice are rolling…'
    : votes.me === null ? 'Ana and Tom voted · tap a place to vote'
    : leaders > 1 ? "It's a tie — let the dice decide"
    : `${esc(PLACES[c.indexOf(max)].name)} is winning`;
  return `<div class="card pad rs">
    <div class="row"><b class="grow" style="font-size: 16px">🍽 Friday lunch — pick one</b><span class="small muted">${c.reduce((a, b) => a + b, 0)} of 3 voted</span></div>
    ${opts}
    <div class="row" style="margin-top: 10px"><span class="grow small muted">${status}</span><button class="primary" data-action="decide">${spinning ? '🎲 Rolling…' : '🎲 Decide for us'}</button></div>
  </div>`;
}

function resultView() {
  const p = PLACES[pick], c = counts()[pick];
  return `<div class="card rs">
    <div class="hero" style="background-image: url(${p.img})"><div class="band"><div class="tiny" style="color: rgba(255,255,255,0.8)">FRIDAY LUNCH IS…</div>
      <div class="hn" style="font-size: ${Math.max(1, Math.round(22 * fx.pop))}px">${esc(p.name)} 🎉</div></div></div>
    <div class="pad">
      <div class="small muted">${p.kind} · ${p.price} · <span class="t-orange">★ ${p.stars}</span> · ${p.area}</div>
      <div class="small" style="margin-top: 4px">${esc(p.note)}</div>
      <div class="tiny muted" style="margin-top: 4px">Picked by the dice · ${c} of 3 voted for it</div>
      ${booked ? `<div class="okbox small">✓ <b>Table for 3 · Fri 13:00</b> · ref ${ref}</div>` : ''}
      <div class="row" style="margin-top: 10px"><button data-action="back">‹ Votes</button><span class="grow"></span><button data-action="reroll">↻ Re-roll</button>${booked ? '' : '&nbsp;<button class="primary" data-action="book">Book for 3</button>'}</div>
    </div>
  </div>`;
}

function render() { return view === 'result' ? resultView() : voteView(); }
</script>

