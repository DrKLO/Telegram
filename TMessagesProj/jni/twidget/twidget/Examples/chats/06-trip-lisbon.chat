  .ht .stepper span:hover { background-color: rgba(127,127,127,0.22); }
  .ht .stepper span.off { color: rgba(127,127,127,0.45); }
  .ht .stepper b { width: 24px; text-align: center; font-size: 15px; }
  .ht .amen { margin-top: 10px; }
  .ht .amen span { display: inline-block; font-size: 12px; padding: 2px 9px 2px 6px; border-radius: 12px; background-color: rgba(127,127,127,0.12); margin: 0 4px 4px 0; }
  .ht .amen img { vertical-align: middle; margin-right: 3px; }
  .ht .book { display: block; margin-top: 6px; padding: 8px 0; font-size: 14px; }
  .ht .spin { display: inline-block; width: 12px; height: 12px; border-radius: 6px; vertical-align: middle; margin-right: 6px; }
  .ht .tickbox { height: 58px; }
  .ht .tick { margin: 0 auto; background-color: #34c759; color: #ffffff; text-align: center; font-weight: 800; }
  .ht .code { font-family: ui-monospace; font-size: 24px; font-weight: 800; margin-top: 8px; }
  .ht .sum { margin-top: 10px; padding: 8px 12px; border-radius: 10px; background-color: rgba(127,127,127,0.1); text-align: left; }
  .ht .sum div { display: flex; justify-content: space-between; padding: 2px 0; font-size: 13px; }
  .ht button.red { color: #ff3b30; }
  .ht .meter { height: 4px; border-radius: 2px; background-color: rgba(127,127,127,0.2); }
  .ht .meter div { height: 4px; border-radius: 2px; background-color: #ff9500; }
</style>
<div class="card ht"><div class="ht-img"></div><div class="pad"><b>Casa do Largo</b> · Chiado<div class="small muted">€142 / night · Thu 9 – Sun 12 Oct · 3 guests, 2 rooms</div></div></div>
<script>
const ROOMS = [
  { name: 'Classic double', sub: '18 m² · quiet courtyard side', price: 142 },
  { name: 'Superior with balcony', sub: '24 m² · over Largo do Carmo', price: 168 },
  { name: 'Rooftop suite', sub: '38 m² · private terrace', price: 225 },
];
const WD = ['Thu', 'Fri', 'Sat', 'Sun', 'Mon', 'Tue', 'Wed'];
const ALPHA = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
let room = 0, nights = 3, fav = true, step = 'form', code = '', shown = '', undoRun = 0;
const fx = { night: 0, total: 0, each: 0, pan: 0, heart: 1, check: 1, undo: 0, spin: 0 };

const total = () => ROOMS[room].price * 2 * nights;
const checkout = () => `${WD[nights % 7]} ${9 + nights} Oct`;
const eur = n => '€' + Math.round(n).toLocaleString('en-US');
const rnd = () => ALPHA[Math.floor(Math.random() * ALPHA.length)];

function retarget(ms) { tween(fx, { night: ROOMS[room].price, total: total(), each: total() / 3 }, ms, ease.outCubic); }
setTimeout(() => { retarget(850); tween(fx, { pan: 1 }, 900, ease.inOutSine); }, 250);

async function book() {
  if (step !== 'form') return;
  step = 'booking';
  await animate(900, p => { fx.spin = p * 1080; }, ease.inOutSine);
  if (step !== 'booking') return;
  code = 'CDL-' + Array.from({ length: 5 }, rnd).join('');
  transition('pop');
  step = 'done';
  fx.check = 0; tween(fx, { check: 1 }, 650, ease.outBack);
  await animate(850, (p, t) => {
    shown = code.split('').map((ch, i) => ch === '-' || t * (code.length + 2) > i + 2 ? ch : rnd()).join('');
  }, ease.linear);
  shown = code;
}

async function cancel() {
  if (step !== 'done') return;
  transition('slide-down');
  step = 'cancelled';
  const me = ++undoRun;
  fx.undo = 1;
  await animate(5000, p => { if (me === undoRun) fx.undo = 1 - p; }, ease.linear);
  if (me !== undoRun || step !== 'cancelled') return;
  transition('slide-right');
  step = 'form'; code = ''; shown = '';
}

function onAction(name, value) {
  if (name === 'fav') {
    fav = !fav;
    fx.heart = 0.4; tween(fx, { heart: 1 }, 450, ease.outBack);
  } else if (name === 'room' && step === 'form') {
    room = Number(value); retarget(450);
  } else if (name === 'nights' && step === 'form') {
    const n = clamp(nights + Number(value), 1, 7);
    if (n === nights) return;
    nights = n; retarget(450);
  } else if (name === 'book') {
    book();
  } else if (name === 'modify' && step === 'done') {
    transition('slide-right');
    step = 'form';
  } else if (name === 'cancel') {
    cancel();
  } else if (name === 'undo' && step === 'cancelled') {
    undoRun++;
    transition('pop');
    step = 'done'; shown = code;
    fx.check = 0.3; tween(fx, { check: 1 }, 500, ease.outBack);
  }
}

function hero() {
  const s = Math.max(4, Math.round(20 * fx.heart));
  const stamp = step === 'done' ? '<span class="stamp">BOOKED ✓</span>' : step === 'cancelled' ? '<span class="stamp" style="background-color: #ff3b30">CANCELLED</span>' : '';
  return `<div class="ht-img" style="background-position: ${(25 + 50 * fx.pan).toFixed(1)}% 50%">
    <span class="fav" data-action="fav"><img src="icon:${fav ? 'heart-fill' : 'heart'}?size=24&color=${fav ? 'ff2d55' : 'ffffff'}" width="${s}" height="${s}"></span>
    <span class="price">${eur(fx.night)} / night</span>${stamp}</div>`;
}

function formView() {
  const busy = step === 'booking';
  const rooms = ROOMS.map((r, i) => `<div class="rm ${i === room ? 'on' : ''}" data-action="room" data-value="${i}">
      <span class="radio">${i === room ? '●' : '&nbsp;'}</span><div class="grow"><b class="small">${r.name}</b><div class="tiny muted">${r.sub}</div></div><b class="small">€${r.price}</b></div>`).join('');
  const spin = `<span class="spin" style="background: conic-gradient(from ${Math.round(fx.spin % 360)}deg, rgba(255,255,255,0) 0deg, #ffffff 300deg, rgba(255,255,255,0) 300deg)"></span>`;
  return `<div class="pad">
    <div class="row"><b class="grow" style="font-size: 17px">Casa do Largo</b><span class="badge orange">2 rooms left</span></div>
    <div class="small muted"><span class="t-orange">★★★★★</span> 4.8 · 612 reviews · Chiado, 3 min to metro</div>
    <div class="dates">
      <div><div class="caps">Check-in</div><b>Thu 9 Oct</b><div class="tiny muted">from 14:00</div></div>
      <div class="dv"><div class="caps">Check-out</div><b>${checkout()}</b><div class="tiny muted">until 11:00</div></div>
      <div class="dv"><div class="caps">Guests</div><b>3 · 2 rooms</b><div class="tiny muted">${nights} night${nights > 1 ? 's' : ''}</div></div>
    </div>
    <div class="caps" style="margin-bottom: 5px">Room type</div>${rooms}
    <div class="row" style="margin-top: 8px">
      <div class="stepper"><span class="${nights <= 1 ? 'off' : ''}" data-action="nights" data-value="-1">−</span><b>${nights}</b><span class="${nights >= 7 ? 'off' : ''}" data-action="nights" data-value="1">+</span></div>
      <span class="small muted" style="margin-left: 8px">nights × 2 rooms</span>
      <div class="grow right"><b style="font-size: 17px">${eur(fx.total)}</b><div class="tiny muted">${eur(fx.each)} each, split 3 ways</div></div>
    </div>
    <div class="amen"><span><img src="icon:wifi-high?size=14&color=007aff">Wi-Fi</span><span><img src="icon:coffee-fill?size=14&color=a2845e">Breakfast</span><span><img src="icon:snowflake?size=14&color=5ac8fa">A/C</span><span><img src="icon:sun-horizon-fill?size=14&color=ff9500">Rooftop</span><span><img src="icon:paw-print-fill?size=14&color=8e8e93">Pets OK</span></div>
    <div class="btn primary book center" data-action="book">${busy ? spin + 'Confirming with the hotel…' : 'Book · ' + eur(fx.total)}</div>
    <div class="center tiny muted" style="margin-top: 5px">Free cancellation until Tue 7 Oct</div>
  </div>`;
}

function doneView() {
  const s = Math.max(0.05, fx.check), d = Math.round(48 * s);
  return `<div class="pad center">
    <div class="tickbox"><div class="tick" style="width: ${d}px; height: ${d}px; line-height: ${d}px; border-radius: ${Math.round(d / 2)}px; font-size: ${Math.round(26 * s)}px; margin-top: ${Math.round((52 - d) / 2)}px">✓</div></div>
    <div style="font-size: 17px; font-weight: 700">You're booked at Casa do Largo</div>
    <div class="small muted">Ana, Tom and you · ${ROOMS[room].name} × 2</div>
    <div class="code">${esc(shown)}</div><div class="tiny muted">Booking code · show it at check-in</div>
    <div class="sum">
      <div><span class="muted">Dates</span><b>Thu 9 → ${checkout()}</b></div>
      <div><span class="muted">Nights</span><b>${nights}</b></div>
      <div><span class="muted">Total</span><b>${eur(total())}</b></div>
      <div><span class="muted">Each</span><b>${eur(total() / 3)}</b></div>
    </div>
    <div style="margin-top: 10px"><button data-action="modify">Modify</button>&nbsp;<button class="red" data-action="cancel">Cancel booking</button></div>
  </div>`;
}

function cancelledView() {
  return `<div class="pad">
    <div class="row"><img src="icon:x-circle-fill?size=29&color=ff3b30" style="margin-right: 10px"><div class="grow"><b>Booking ${esc(code)} cancelled</b><div class="small muted">${eur(total())} goes back to your card in 3–5 days</div></div></div>
    <div class="row" style="margin-top: 12px"><div class="grow"><div class="meter"><div style="width: ${(fx.undo * 100).toFixed(1)}%"></div></div><div class="tiny muted" style="margin-top: 4px">Changed your mind? Undo within ${Math.ceil(fx.undo * 5)} s</div></div>
      <button class="primary" data-action="undo" style="margin-left: 12px">Undo</button></div>
  </div>`;
}

function render() {
  const body = step === 'done' ? doneView() : step === 'cancelled' ? cancelledView() : formView();
  return `<div class="card ht">${hero()}${body}</div>`;
}
</script>

