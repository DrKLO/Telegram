<style>
  .ex { width: 420px; max-width: 100%; }
  .ex table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .ex th { text-align: left; font-size: 10px; text-transform: uppercase; padding: 6px 4px; border-bottom: 1px solid rgba(127,127,127,0.3); }
  .ex td { padding: 5px 4px; border-bottom: 1px solid rgba(127,127,127,0.15); }
  .ex tr:hover td { background-color: rgba(0,122,255,0.07); }
  .ex .amt { text-align: right; font-family: ui-monospace; font-size: 12px; }
  .ex .mini { width: 18px; height: 18px; line-height: 18px; font-size: 8px; }
  .ex .x { width: 18px; text-align: center; color: #8e8e93; font-size: 15px; border-radius: 6px; }
  .ex .x:hover { color: #ff3b30; background-color: rgba(255,59,48,0.12); }
  .ex .presets { margin-top: 8px; }
  .ex .chip { font-size: 12px; padding: 2px 10px; }
  .ex .lnk { font-weight: 600; color: #0a84ff; }
  .ex .lnk:hover { text-decoration: underline; }
  .ex .bal { display: flex; align-items: center; margin: 5px 0; font-size: 13px; }
  .ex .bal .who { width: 44px; }
  .ex .bal .track { flex-grow: 1; position: relative; height: 10px; border-radius: 5px; background-color: rgba(127,127,127,0.15); margin: 0 10px; }
  .ex .bal .mid { position: absolute; left: 50%; top: -3px; height: 16px; border-left: 1px solid rgba(127,127,127,0.6); }
  .ex .bal .fill { position: absolute; top: 0; height: 10px; }
  .ex .bal .amt2 { width: 78px; text-align: right; font-weight: 700; }
  .ex .owe { display: flex; align-items: center; padding: 6px 0; border-top: 1px solid rgba(127,127,127,0.15); font-size: 13px; }
  .ex .owe .nm { margin-left: 4px; width: 32px; }
  .ex .path { position: relative; flex-grow: 1; height: 20px; margin: 0 8px; }
  .ex .dots { position: absolute; left: 0; right: 0; top: 9px; border-top: 2px dotted rgba(127,127,127,0.45); }
  .ex .coin { position: absolute; margin-left: -9px; font-size: 15px; line-height: 20px; }
  .ex .owe .amt3 { width: 70px; text-align: right; margin-right: 8px; }
  .ex .paid { padding: 2px 0; }
  .ex .toast { display: flex; align-items: center; margin-top: 8px; padding: 6px 10px; border-radius: 14px; background-color: rgba(255,149,0,0.12); }
  .ex .square { margin-top: 8px; padding: 10px 12px; border-radius: 12px; background-color: rgba(52,199,89,0.14); }
</style>
<div class="card pad ex"><b>💶 Trip expenses</b> · 8 items · €1,404<div class="small muted">€468 each · You owe Ana €361.20 · Tom owes Ana €194.40</div></div>
<script>
const P = { ana: { name: 'Ana', ini: 'AS', color: '#ff9500' }, tom: { name: 'Tom', ini: 'TB', color: '#30b0c7' }, me: { name: 'You', ini: 'ME', color: '#007aff' } };
const WHO = ['ana', 'tom', 'me'];
let items = [
  { id: 1, what: '🏨 Casa do Largo (3 nights)', by: 'ana', amt: 852 },
  { id: 2, what: '✈️ Seat selection', by: 'tom', amt: 87 },
  { id: 3, what: '🏰 Castle tickets', by: 'me', amt: 45 },
  { id: 4, what: '🚆 Sintra train + bus', by: 'me', amt: 38.4 },
  { id: 5, what: '🎸 Fado night', by: 'tom', amt: 96 },
  { id: 6, what: '🍤 Cervejaria Ramiro', by: 'ana', amt: 171.6 },
  { id: 7, what: '🥐 Pastéis (×18, no regrets)', by: 'me', amt: 23.4 },
  { id: 8, what: '🚕 Taxi to the airport', by: 'tom', amt: 90.6 },
];
const PRESETS = [
  { id: 11, what: '🍷 Wine at the miradouro', by: 'tom', amt: 24 },
  { id: 12, what: '🚋 Tram 28 day passes', by: 'ana', amt: 19.2 },
  { id: 13, what: '🍦 Gelato at Santini', by: 'me', amt: 13.5 },
  { id: 14, what: '⛱ Cascais beach chairs', by: 'ana', amt: 30 },
];
let paid = [], removed = null, settling = null, thanks = false;
const flash = {};
const bal = { ana: 0, tom: 0, me: 0, total: 0 };
const fx = { coin: 0, done: 1 };

const money = n => Math.abs(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const av = w => `<span class="av mini" style="background-color: ${P[w].color}">${P[w].ini}</span>`;

function nets() {
  const total = items.reduce((s, i) => s + i.amt, 0), share = total / 3;
  const n = { ana: -share, tom: -share, me: -share, total };
  for (const i of items) n[i.by] += i.amt;
  for (const t of paid) { n[t.from] += t.amt; n[t.to] -= t.amt; }
  return n;
}

function debts(n) {
  const cred = WHO.filter(w => n[w] > 0.005).map(w => ({ w, v: n[w] })).sort((a, b) => b.v - a.v);
  const debt = WHO.filter(w => n[w] < -0.005).map(w => ({ w, v: -n[w] })).sort((a, b) => b.v - a.v);
  const out = [];
  let i = 0, j = 0;
  while (i < debt.length && j < cred.length) {
    const amt = Math.min(debt[i].v, cred[j].v);
    if (amt > 0.005) out.push({ from: debt[i].w, to: cred[j].w, amt });
    debt[i].v -= amt; cred[j].v -= amt;
    if (debt[i].v < 0.005) i++;
    if (cred[j].v < 0.005) j++;
  }
  return out;
}

const retarget = (ms = 700) => tween(bal, nets(), ms, ease.outCubic);
setTimeout(() => retarget(900), 250);

function flashRow(id) {
  flash[id] = 1;
  animate(1400, p => { flash[id] = 1 - p; }, ease.inQuad).then(() => { delete flash[id]; });
}

async function settle(key) {
  if (settling) return;
  const [from, to] = key.split(':');
  const d = debts(nets()).find(x => x.from === from && x.to === to);
  if (!d) return;
  settling = key; fx.coin = 0;
  await animate(650, p => { fx.coin = p; }, ease.inOutCubic);
  paid.push({ from, to, amt: Math.round(d.amt * 100) / 100 });
  await retarget(650);
  settling = null;
  const square = debts(nets()).length === 0;
  transition(square ? 'pop' : 'fade');
  if (from === 'me' && to === 'ana') thanks = true;
  if (square) { fx.done = 0; tween(fx, { done: 1 }, 700, ease.outBack); }
}

async function settleAll() {
  for (const d of debts(nets())) await settle(d.from + ':' + d.to);
}

function onAction(name, value) {
  if (name === 'add') {
    const p = PRESETS.find(x => x.id === Number(value));
    if (!p || items.some(i => i.id === p.id)) return;
    transition('fade');
    items.push(Object.assign({}, p));
    if (removed && removed.item.id === p.id) removed = null;
    flashRow(p.id);
    retarget();
  } else if (name === 'remove') {
    const k = items.findIndex(i => i.id === Number(value));
    if (k < 0) return;
    transition('fade');
    removed = { item: items[k], k };
    items.splice(k, 1);
    retarget();
  } else if (name === 'restore' && removed) {
    transition('fade');
    if (!items.some(i => i.id === removed.item.id)) {
      items.splice(Math.min(removed.k, items.length), 0, removed.item);
      flashRow(removed.item.id);
    }
    removed = null;
    retarget();
  } else if (name === 'settle') {
    settle(value);
  } else if (name === 'settleall') {
    settleAll();
  } else if (name === 'unpay') {
    const t = paid[Number(value)];
    if (!t || settling) return;
    transition('fade');
    paid.splice(Number(value), 1);
    if (t.from === 'me' && t.to === 'ana') thanks = false;
    retarget();
  }
}

function render() {
  const rows = items.map(i => {
    const f = flash[i.id] || 0;
    const bg = f > 0 ? ` style="background-color: rgba(255,204,0,${(0.32 * f).toFixed(3)})"` : '';
    return `<tr><td${bg}>${esc(i.what)}</td><td class="nowrap"${bg}>${av(i.by)} ${P[i.by].name}</td><td class="amt"${bg}>${i.amt.toFixed(2)}</td><td class="x" data-action="remove" data-value="${i.id}"${bg}>×</td></tr>`;
  }).join('');
  const chips = PRESETS.filter(p => !items.some(i => i.id === p.id))
    .map(p => `<span class="chip" data-action="add" data-value="${p.id}">+ ${esc(p.what)} · €${p.amt.toFixed(2)}</span>`).join('');
  const undo = removed ? `<div class="tiny muted" style="margin-top: 4px">Removed ${esc(removed.item.what)} · <span class="lnk" data-action="restore">Undo</span></div>` : '';
  const balances = WHO.map(w => {
    const v = bal[w], pc = Math.min(50, Math.abs(v) / 600 * 50);
    const bar = Math.abs(v) < 0.005 ? '' : v > 0
      ? `<div class="fill" style="left: 50%; width: ${pc.toFixed(2)}%; border-radius: 0 5px 5px 0; background-color: #34c759"></div>`
      : `<div class="fill" style="right: 50%; width: ${pc.toFixed(2)}%; border-radius: 5px 0 0 5px; background-color: #ff3b30"></div>`;
    const cls = v > 0.005 ? 't-green' : v < -0.005 ? 't-red' : 'muted';
    return `<div class="bal"><span class="who">${P[w].name}</span><div class="track"><div class="mid"></div>${bar}</div><span class="amt2 ${cls}">${v > 0.005 ? '+' : v < -0.005 ? '−' : ''}€${money(v)}</span></div>`;
  }).join('');
  const list = debts(bal);
  const owes = list.map(d => {
    const key = d.from + ':' + d.to;
    const coin = settling === key ? `<span class="coin" style="left: ${(fx.coin * 100).toFixed(1)}%; top: ${Math.round(-12 * Math.sin(Math.PI * fx.coin))}px">💶</span>` : '';
    return `<div class="owe">${av(d.from)}<span class="nm">${P[d.from].name}</span><div class="path"><div class="dots"></div>${coin}</div>${av(d.to)}<span class="nm">${P[d.to].name}</span>
      <b class="amt3">€${money(d.amt)}</b>${settling ? '' : `<button class="primary" data-action="settle" data-value="${key}">Settle</button>`}</div>`;
  }).join('');
  const target = debts(nets());
  const square = !settling && target.length === 0
    ? `<div class="square row"><span style="font-size: ${Math.max(1, Math.round(22 * fx.done))}px; margin-right: 10px">🎉</span><div><b class="t-green">All square!</b><div class="tiny muted">Nobody owes anybody. Obrigado, team.</div></div></div>` : '';
  const log = paid.map((t, k) => `<div class="paid small"><span class="t-green">✓</span> <b>${P[t.from].name}</b> paid <b>${P[t.to].name}</b> €${money(t.amt)} · <span class="lnk tiny" data-action="unpay" data-value="${k}">undo</span></div>`).join('');
  const toast = thanks ? `<div class="toast">${av('ana')}<span class="small" style="margin-left: 8px"><b>Ana:</b> Recebido! 💸 Obrigada — see you at the gate 🛫</span></div>` : '';
  return `<div class="card pad ex">
    <div class="row"><b class="grow" style="font-size: 16px">💶 Trip expenses</b><span class="badge blue">${items.length} items · ${'€' + Math.round(bal.total).toLocaleString('en-US')}</span></div>
    <table style="margin-top: 8px">
      <tr><th>What</th><th>Paid by</th><th style="text-align: right">Amount</th><th>&nbsp;</th></tr>
      ${rows}
      <tr><td colspan="2"><b>Total</b> <span class="muted small">· split 3 ways, €${money(bal.total / 3)} each</span></td><td class="amt"><b>${money(bal.total)}</b></td><td>&nbsp;</td></tr>
    </table>
    ${chips ? `<div class="presets">${chips}</div>` : ''}${undo}
    <div class="caps" style="margin: 12px 0 4px 0">Balances</div>
    ${balances}
    <div class="row" style="margin: 12px 0 2px 0"><span class="caps grow">Who owes whom</span>${list.length > 1 && !settling ? '<span class="lnk small" data-action="settleall">Settle all</span>' : ''}</div>
    ${owes}${square}${log ? `<div style="margin-top: 8px">${log}</div>` : ''}${toast}
  </div>`;
}
</script>

--- ana 08:50 bare
<style>
  .pk { width: 380px; max-width: 100%; position: relative; overflow: hidden; }
  .pk .ring { position: relative; width: 60px; height: 60px; margin-right: 12px; flex-shrink: 0; }
  .pk .ring .pc { position: absolute; left: 0; top: 0; width: 60px; line-height: 60px; text-align: center; font-size: 14px; font-weight: 800; }
  .pk .cats { display: flex; margin: 12px 0 6px 0; }
  .pk .cat { flex-grow: 1; flex-basis: 0; text-align: center; padding: 4px 0; margin-right: 5px; border-radius: 9px; font-size: 12px; font-weight: 600; background-color: rgba(127,127,127,0.12); }
  .pk .cat:last-child { margin-right: 0; }
  .pk .cat:hover { background-color: rgba(127,127,127,0.24); }
  .pk .cat.on { background-color: #34c759; color: #ffffff; }
  .pk .cat .n { font-size: 10px; font-weight: 700; }
  .pk .item { display: flex; align-items: center; padding: 7px 4px; border-top: 1px solid rgba(127,127,127,0.15); }
  .pk .item:hover { background-color: rgba(127,127,127,0.08); }
  .pk .box { width: 16px; height: 16px; border-radius: 9px; border: 2px solid rgba(127,127,127,0.5); margin-right: 10px; text-align: center; line-height: 16px; color: #ffffff; font-weight: 800; flex-shrink: 0; }
  .pk .box.on { background-color: #34c759; border-color: #34c759; }
  .pk .who { font-size: 11px; margin-left: 8px; white-space: nowrap; }
  .pk .banner { display: flex; align-items: center; margin-top: 10px; padding: 10px 12px; border-radius: 12px; background-color: rgba(52,199,89,0.15); }
  .pk .banner:hover { background-color: rgba(52,199,89,0.24); }
  .pk .lnk { font-weight: 600; color: #0a84ff; }
  .pk .lnk:hover { text-decoration: underline; }
</style>
<div class="card pad pk"><b>🧳 Packing list</b> · 3 of 10 packed<div class="small muted">Passport · charger · comfy shoes · rain jacket · sunscreen · Viva card · cash · swimsuit · cards · room for pastéis</div></div>
<script>
const ITEMS = [
  { id: 1, cat: 'docs', text: 'Passport / ID', who: 'everyone' },
  { id: 2, cat: 'gear', text: 'Phone charger + adapter (type F)', who: 'everyone' },
  { id: 3, cat: 'clothes', text: 'Comfortable shoes — Lisbon is all hills', who: '!!!' },
  { id: 4, cat: 'clothes', text: 'Rain jacket for Sintra', who: 'Tom says' },
  { id: 5, cat: 'gear', text: 'Sunscreen SPF 50', who: 'Ana' },
  { id: 6, cat: 'docs', text: 'Viva Viagem card (buy at airport)', who: 'You' },
  { id: 7, cat: 'docs', text: 'Cash for tascas (many are card-free)', who: 'You' },
  { id: 8, cat: 'clothes', text: 'Swimsuit — Cascais beach maybe?', who: 'Ana' },
  { id: 9, cat: 'gear', text: 'Card game for the flight 🃏', who: 'Tom' },
  { id: 10, cat: 'gear', text: 'Empty space for 18 pastéis de nata', who: 'critical' },
];
const CATS = [['all', 'All'], ['docs', '🛂 Docs'], ['clothes', '👟 Clothes'], ['gear', '🎒 Gear']];
const PAL = [[255, 45, 85], [255, 204, 0], [52, 199, 89], [10, 132, 255], [191, 90, 242], [255, 159, 10]];
const START = [1, 2, 5];
let cat = 'all', packing = false, party = false, bits = [], flying = false, last = 0;
const done = new Set(START), pops = {};
const fx = { ring: 0, glow: 0, banner: 1 };

setTimeout(() => tween(fx, { ring: done.size / ITEMS.length }, 850, ease.outCubic), 250);

function ringSVG(v) {
  const r = 25, c = 2 * Math.PI * r, color = mix('#34c759', '#ffcc00', fx.glow);
  return 'data:image/svg+xml;utf8,' + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='60' height='60' viewBox='0 0 60 60'>` +
    `<circle cx='30' cy='30' r='${r}' fill='none' stroke='rgba(127,127,127,0.22)' stroke-width='7'/>` +
    (v > 0.001 ? `<circle cx='30' cy='30' r='${r}' fill='none' stroke='${color}' stroke-width='7' stroke-linecap='round' stroke-dasharray='${(c * v).toFixed(2)} ${c.toFixed(2)}' transform='rotate(-90 30 30)'/>` : '') + '</svg>');
}

function burst() {
  const born = performance.now();
  for (let i = 0; i < 48; i++) {
    bits.push({ x: Math.random() * 370, y: -10 - Math.random() * 70, vx: (Math.random() - 0.5) * 70, vy: 90 + Math.random() * 150,
      w: 5 + Math.random() * 4, h: 8 + Math.random() * 5, spin: Math.random() * 6, rate: 4 + Math.random() * 8,
      rgb: PAL[i % PAL.length], born, life: 1700 + Math.random() * 900 });
  }
  bits = bits.slice(-120);
  if (!flying) { flying = true; last = performance.now(); requestAnimationFrame(step); }
}

function step(t) {
  const dt = Math.min(0.05, (t - last) / 1000);
  last = t;
  for (const b of bits) { b.vy += 260 * dt; b.x += b.vx * dt; b.y += b.vy * dt; b.spin += b.rate * dt; }
  bits = bits.filter(b => t - b.born < b.life);
  if (bits.length) requestAnimationFrame(step); else flying = false;
}

function celebrate() {
  party = true;
  transition('pop');
  fx.banner = 0; tween(fx, { banner: 1 }, 650, ease.outBack);
  burst();
  animate(1500, p => { fx.glow = Math.abs(Math.sin(p * Math.PI * 3)) * (1 - p); }, ease.linear);
}

function tick(id, on) {
  if (on === undefined) on = !done.has(id);
  if (on === done.has(id)) return;
  if (on) { done.add(id); pops[id] = 0; animate(360, p => { pops[id] = p; }, ease.outBack); }
  else done.delete(id);
  tween(fx, { ring: done.size / ITEMS.length }, 500, ease.outCubic);
  if (done.size === ITEMS.length && !party) celebrate();
  if (done.size < ITEMS.length && party) { transition('fade'); party = false; }
}

async function packAll() {
  if (packing) return;
  const todo = ITEMS.filter(i => !done.has(i.id));
  if (!todo.length) return burst();
  packing = true;
  if (cat !== 'all') { transition('fade'); cat = 'all'; }
  for (const it of todo) { await sleep(120); tick(it.id, true); }
  packing = false;
}

function onAction(name, value) {
  if (name === 'tick') tick(Number(value));
  else if (name === 'cat') {
    if (value === cat) return;
    const order = CATS.map(c => c[0]);
    transition(order.indexOf(value) > order.indexOf(cat) ? 'slide-left' : 'slide-right');
    cat = value;
  } else if (name === 'all') packAll();
  else if (name === 'party') burst();
  else if (name === 'reset' && !packing) {
    transition('fade');
    done.clear(); START.forEach(i => done.add(i)); party = false;
    tween(fx, { ring: done.size / ITEMS.length }, 600, ease.outCubic);
  }
}

function render() {
  const n = done.size, all = n === ITEMS.length;
  const cats = CATS.map(([k, label]) => {
    const list = ITEMS.filter(i => k === 'all' || i.cat === k), m = list.filter(i => done.has(i.id)).length;
    return `<div class="cat ${k === cat ? 'on' : 'fg'}" data-action="cat" data-value="${k}">${label}<div class="n">${m === list.length ? '✓ packed' : `${m} / ${list.length}`}</div></div>`;
  }).join('');
  const rows = ITEMS.filter(i => cat === 'all' || i.cat === cat).map(i => {
    const on = done.has(i.id), p = pops[i.id] === undefined ? 1 : pops[i.id];
    return `<div class="item fg" data-action="tick" data-value="${i.id}"><span class="box ${on ? 'on' : ''}" style="font-size: ${Math.max(1, Math.round(11 * p))}px">${on ? '✓' : '&nbsp;'}</span>
      <span class="grow"${on ? ' style="text-decoration: line-through; color: #8e8e93"' : ''}>${esc(i.text)}</span><span class="who muted">${esc(i.who)}</span></div>`;
  }).join('');
  const banner = all ? `<div class="banner" data-action="party"><span style="font-size: ${Math.max(1, Math.round(26 * fx.banner))}px; margin-right: 10px">🛫</span>
      <div class="grow"><b class="t-green">All packed — ready for Lisbon!</b><div class="tiny muted">Tap for more confetti · space for 18 pastéis confirmed</div></div></div>` : '';
  const t = performance.now();
  const confetti = bits.map(b => {
    const age = (t - b.born) / b.life, a = age > 0.7 ? Math.max(0, (1 - age) / 0.3) : 1;
    const w = Math.max(1.5, b.w * Math.abs(Math.cos(b.spin)));
    return `<div style="position: absolute; left: ${(b.x - w / 2).toFixed(1)}px; top: ${b.y.toFixed(1)}px; width: ${w.toFixed(1)}px; height: ${b.h.toFixed(0)}px; border-radius: 2px; background-color: rgba(${b.rgb.join(',')},${a.toFixed(2)})"></div>`;
  }).join('');
  return `<div class="card pad pk">
    <div class="row"><div class="ring"><img src="${ringSVG(fx.ring)}" width="60" height="60"><div class="pc">${Math.round(fx.ring * 100)}%</div></div>
      <div class="grow"><b style="font-size: 16px">🧳 Packing list</b><div class="small muted">${n} of ${ITEMS.length} packed${all ? ' · nothing left!' : ''}</div></div>
      ${all ? '<button data-action="reset">↺ Unpack</button>' : `<button class="primary" data-action="all">${packing ? 'Packing…' : 'Pack everything'}</button>`}</div>
    <div class="cats">${cats}</div>
    ${rows}${banner}${confetti}
  </div>`;
}
</script>

