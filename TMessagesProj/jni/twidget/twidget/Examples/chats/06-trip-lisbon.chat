  .it .pin { position: absolute; font-size: 20px; line-height: 22px; }
  .it .facts div { font-size: 12px; padding: 1px 0; }
</style>
<div class="card pad it"><b>🗺 Itinerary</b> · Thu 9 – Sat 11 Oct<div class="small muted">Land at LIS 12:40 · Castelo de São Jorge · Sintra day trip</div></div>
<script>
const DAYS = [
  { tab: 'Thu 9', title: 'Arrival & Chiado', wx: '☀️ 26°', items: [
    { t: '12:40', what: '✈️ Land at LIS', det: 'Metro red line → Alameda, then green line. 25 min, €1.85 with a Viva card.', facts: ['🚇 Red line → Alameda → green line', '⏱ 25 min to Baixa-Chiado', '💶 €1.85 with Viva Viagem'], x: 86, y: 8 },
    { t: '14:00', what: '🏨 Check in · Casa do Largo', det: 'Largo do Carmo 12 — bags can go in early.', facts: ['📍 Largo do Carmo 12, Chiado', '🔑 Door code by SMS at 13:00', '🧳 Bags welcome from 10:00'], x: 48, y: 44 },
    { t: '15:30', what: '🥐 Pastéis at Manteigaria', det: 'Better than Belém, fight me. — Ana', facts: ['📍 Rua do Loreto 2', '🚶 4 min from the hotel', '💶 €1.30 each, warm'], x: 34, y: 52 },
    { t: '17:00', what: '🚋 Tram 28 to Graça', det: 'Board at Martim Moniz to get a seat.', facts: ['📍 Martim Moniz terminus', '⏱ 20 min ride uphill', '🎟 Covered by the Viva day pass'], x: 66, y: 26 },
    { t: '19:30', what: '🌅 Sunset · Miradouro da Senhora do Monte', det: 'Best view of the castle. Bring a jacket.', facts: ['🌇 Sunset 19:12, come early', '🚶 10 min uphill from Graça', '🧥 Windy once the sun is gone'], x: 72, y: 14 },
    { t: '21:00', what: '🍷 Dinner · Taberna da Rua das Flores', det: 'No reservations — get there early.', facts: ['📍 Rua das Flores 103', '⏳ Queue forms from 18:45', '💶 About €30 each'], x: 30, y: 60 },
  ] },
  { tab: 'Fri 10', title: 'Castle, market & fado', wx: '⛅️ 24°', items: [
    { t: '09:30', what: '🏰 Castelo de São Jorge', det: 'Tickets online, skip the queue. 2 h.', facts: ['🎟 3 × €15, already booked', '⏱ About 2 hours', '📍 Rua de Santa Cruz do Castelo'], x: 64, y: 22 },
    { t: '12:30', what: '🐟 Lunch · Time Out Market', det: 'Everyone picks their own stall.', facts: ['📍 Mercado da Ribeira, Cais do Sodré', '🚋 Tram 15E or a 20 min walk', '💶 €12–20 each'], x: 28, y: 62 },
    { t: '15:00', what: '🖼 MAAT + riverside walk', det: 'Walk the roof, then along the Tejo to Belém.', facts: ['🎟 €11, the roof is free', '🚶 3 km along the river to Belém', '🥐 Pastéis de Belém on the way'], x: 8, y: 66 },
    { t: '20:00', what: '🎸 Fado in Alfama', det: 'Tasca do Chico — small, loud, wonderful.', facts: ['📍 Rua dos Remédios 83', '🎶 A new singer every 30 min', '🤫 Total silence during songs'], x: 76, y: 36 },
  ] },
  { tab: 'Sat 11', title: 'Sintra day trip', wx: '🌦 21°', items: [
    { t: '08:45', what: '🚆 Train to Sintra', det: 'From Rossio, 40 min. Pena Palace first, before the crowds.', facts: ['🚉 Rossio station, every 20 min', '⏱ 40 min', '💶 €2.40 each way'], x: 52, y: 40 },
    { t: '13:00', what: '🧀 Picnic in Monserrate gardens', det: 'Tom is in charge of cheese.', facts: ['🌿 Monserrate Palace gardens', '🎟 €12 entry', '🧀 Queijo da Serra, bread, vinho verde'], x: 22, y: 24 },
    { t: '16:30', what: '🌊 Cabo da Roca', det: 'Westernmost point of mainland Europe. Windy!', facts: ['🚌 Bus 403 from Sintra, 40 min', '📸 Lighthouse and cliffs', '🧥 Hold on to your hat'], x: 4, y: 42 },
    { t: '20:30', what: '🎉 Farewell dinner · Cervejaria Ramiro', det: 'Prawns, then a steak sandwich for dessert. Trust the process.', facts: ['📍 Av. Almirante Reis 1', '⏳ Take a number at the door', '🍤 Order the tiger prawns'], x: 70, y: 30 },
  ] },
];
const TOTAL = DAYS.reduce((s, d) => s + d.items.length, 0);
let day = 0, open = null;
const done = new Set(), pops = {};
const fx = { intro: 0, prog: 0, pin: 1 };

const doneIn = d => DAYS[d].items.filter((_, j) => done.has(d + '-' + j)).length;
const frac = d => doneIn(d) / DAYS[d].items.length;

setTimeout(() => tween(fx, { intro: 1 }, 850, ease.linear), 250);

function onAction(name, value) {
  if (name === 'day') {
    const d = Number(value);
    if (d === day) return;
    transition(d > day ? 'slide-left' : 'slide-right');
    day = d; open = null;
    tween(fx, { prog: frac(day) }, 1); fx.prog = frac(day);
  } else if (name === 'tick') {
    if (done.has(value)) done.delete(value);
    else {
      done.add(value);
      pops[value] = 0;
      animate(380, p => { pops[value] = p; }, ease.outBack);
    }
    tween(fx, { prog: frac(day) }, 500, ease.outCubic);
  } else if (name === 'open') {
    transition('fade');
    open = open === value ? null : value;
    if (open) { fx.pin = 0; tween(fx, { pin: 1 }, 750, ease.outBounce); }
  }
}

function event(it, j) {
  const id = day + '-' + j, isDone = done.has(id), isOpen = open === id;
  const e = ease.outCubic(clamp((fx.intro * 850 - j * 90) / 380, 0, 1));
  const p = pops[id] === undefined ? 1 : pops[id];
  const more = isOpen ? `<div class="more">
      <div class="map"><div class="pin" style="left: ${it.x}px; top: ${Math.round(lerp(-26, it.y, fx.pin))}px">📍</div></div>
      <div class="grow"><div class="facts">${it.facts.map(f => `<div>${esc(f)}</div>`).join('')}</div>
        <div style="margin-top: 6px"><button class="${isDone ? '' : 'primary'}" data-action="tick" data-value="${id}">${isDone ? 'Undo' : '✓ Mark done'}</button></div></div>
    </div>` : '';
  return `<div class="ev"><span class="time">${it.t}</span>
    <div class="dot ${isDone ? 'done' : ''}" data-action="tick" data-value="${id}" style="font-size: ${Math.max(1, Math.round(11 * p))}px">${isDone ? '✓' : '&nbsp;'}</div>
    <div class="body" data-action="open" data-value="${id}" style="margin-left: ${Math.round((1 - e) * 28) - 6}px">
      <div class="what ${isDone ? 'muted' : ''}"${isDone ? ' style="text-decoration: line-through"' : ''}>${esc(it.what)} <span class="tiny muted">${isOpen ? '▴' : '▾'}</span></div>
      <div class="det muted">${esc(it.det)}</div></div>${more}</div>`;
}

function render() {
  const D = DAYS[day], n = doneIn(day);
  const tabs = DAYS.map((d, i) => {
    const k = doneIn(i), all = k === d.items.length;
    return `<div class="tab ${i === day ? 'on' : 'fg'}" data-action="day" data-value="${i}">${d.tab}<div class="cnt">${all ? '✓ all done' : `${k} / ${d.items.length}`}</div></div>`;
  }).join('');
  const status = n === D.items.length ? '<span class="small t-green"><b>Day complete 🎉</b></span>' : `<span class="small muted">${n} of ${D.items.length} done</span>`;
  return `<div class="card it">
    <div class="pad" style="padding-bottom: 0">
      <div class="row"><img src="icon:map-trifold-fill?size=22&color=ff9500" style="margin-right: 8px"><b class="grow" style="font-size: 17px">Itinerary</b><span class="badge orange">3 days · ${done.size}/${TOTAL} ✓</span></div>
      <div class="tiny muted">Tap a dot to tick a stop off, tap a stop for details and a map</div>
    </div>
    <div class="tabs">${tabs}</div>
    <div class="sub row"><span class="grow small"><b>${D.title}</b> <span class="muted">· ${D.wx}</span></span>${status}</div>
    <div class="prog"><div style="width: ${(fx.prog * 100).toFixed(1)}%"></div></div>
    <div class="tl">${D.items.map(event).join('')}</div>
  </div>`;
}
</script>

