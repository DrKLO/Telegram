               background: radial-gradient(ellipse at 50% 100%, #5b3a1e 0%, #5b3a1e 34%, rgba(91,58,30,0.18) 36%, rgba(127,127,127,0.08) 70%); }
  .wam .hole.live:hover { background: radial-gradient(ellipse at 50% 100%, #6e4726 0%, #6e4726 34%, rgba(91,58,30,0.26) 36%, rgba(127,127,127,0.16) 70%); }
