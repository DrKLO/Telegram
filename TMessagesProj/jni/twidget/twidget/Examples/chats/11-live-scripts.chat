</style>
<div class="card pad poll"><b>📍 Offsite location</b><p class="small muted">Lisbon · Kyoto · Mexico City · Reykjavík</p></div>
<script>
const SEED = [
  { id: 'lis', label: '🇵🇹 Lisbon', voters: ['Nora', 'Gus', 'Ivo', 'Pia'] },
  { id: 'kyo', label: '🇯🇵 Kyoto', voters: ['Theo', 'Hana', 'Jun', 'Kai', 'Lea', 'Omar'] },
  { id: 'mex', label: '🇲🇽 Mexico City', voters: ['Rui', 'Sam', 'Uma'] },
  { id: 'rey', label: '🇮🇸 Reykjavík', voters: ['Vik', 'Wren'] },
];
const INCOMING = [['Ana', 'lis'], ['Ben', 'mex'], ['Chloé', 'lis'], ['Dev', 'rey'], ['Emil', 'lis']];
const COLORS = ['#ff2d55', '#ff9500', '#34c759', '#00c7be', '#5e5ce6', '#af52de', '#a2845e'];
const ROW = 42;
let options, mine = null, closed = false, tab = 'results', sortTop = true, queue = [], timer = 0;
const total = { v: 0 }, ticker = { text: 'Votes are coming in…', k: 0 };

const count = () => options.reduce((s, o) => s + o.voters.length, 0);
const byId = id => options.find(o => o.id === id);
const order = () => sortTop ? options.slice().sort((a, b) => b.voters.length - a.voters.length || a.idx - b.idx) : options;
function seed() {
  const old = options;
  options = SEED.map((o, idx) => ({ ...o, idx, voters: o.voters.slice(), fx: old ? old[idx].fx : { share: 0, y: 0, flash: 0 } }));
  if (!old) order().forEach((o, rank) => { o.fx.y = rank * ROW; });
}
seed();

function relayout(ms = 650) {
  const sum = count();
  order().forEach((o, rank) => tween(o.fx, { y: rank * ROW, share: o.voters.length / sum }, ms, ease.outCubic));
  tween(total, { v: sum }, 450, ease.outCubic);
}

function arrive() {
  timer = 0;
  if (closed || !queue.length) return;
  const [name, id] = queue.shift();
  const o = byId(id);
  o.voters.push(name);
  o.fx.flash = 1;
  tween(o.fx, { flash: 0 }, 1100, ease.outQuad);
  ticker.text = `${name} voted ${o.label}`;
  ticker.k = 1;
  tween(ticker, { k: 0 }, 1800, ease.inQuad);
  relayout();
  if (queue.length) timer = setTimeout(arrive, 1700 + Math.random() * 1500);
}
function startArrivals(delay) {
  if (timer) clearTimeout(timer);
  timer = queue.length && !closed ? setTimeout(arrive, delay) : 0;
}

setTimeout(() => {
  relayout(800);
  queue = INCOMING.slice();
  startArrivals(1600);
}, 250);

function onAction(name, value) {
  if (name === 'tab') {
    if (value === tab) return;
    transition(value === 'voters' ? 'slide-left' : 'slide-right');
    tab = value;
    return;
  }
  if (name === 'sort') { sortTop = !sortTop; return relayout(); }
  if (name === 'close') {
    transition(closed ? 'fade' : 'pop');
    closed = !closed;
    if (!closed) startArrivals(1400);
    else if (timer) { clearTimeout(timer); timer = 0; }
    return;
  }
  if (name === 'reset') {
    transition('fade');
    seed();
    mine = null; closed = false; tab = 'results';
    queue = INCOMING.slice();
    ticker.text = 'Poll reset · votes are coming in…'; ticker.k = 0;
    relayout(800);
    startArrivals(1600);
    return;
  }
  if (closed) return;
  if (mine) byId(mine).voters = byId(mine).voters.filter(v => v !== 'You');
  mine = mine === value ? null : value;
  if (mine) {
    byId(mine).voters.push('You');
    byId(mine).fx.flash = 0.8;
    tween(byId(mine).fx, { flash: 0 }, 700, ease.outQuad);
  }
  relayout();
}

const initials = n => esc(n.slice(0, 2));
const color = n => n === 'You' ? '#007aff' : COLORS[[...n].reduce((s, c) => s + c.charCodeAt(0), 0) % COLORS.length];

function results() {
  const sum = count();
  const [lead, second] = options.slice().sort((a, b) => b.voters.length - a.voters.length);
  const tie = lead.voters.length === second.voters.length;
  const rows = options.map(o => {
    const pc = o.fx.share * 100, me = o.id === mine, won = closed && (o === lead || (tie && o === second));
    const base = won ? '52,199,89' : '0,122,255';
    const fill = `rgba(${base},${((me ? 0.3 : 0.16) + 0.26 * o.fx.flash).toFixed(3)})`;
    const plus = o.fx.flash > 0.05 ? `<span class="plus" style="color: ${alpha('#34c759', o.fx.flash)}">+1</span>` : '<span class="plus"></span>';
    return `<div class="opt ${me ? 'mine' : ''} ${closed ? '' : 'open'}" ${closed ? '' : `data-action="vote" data-value="${o.id}"`}
                 style="top: ${o.fx.y.toFixed(1)}px; background: linear-gradient(90deg, ${fill} ${pc.toFixed(1)}%, rgba(127,127,127,0.10) ${pc.toFixed(1)}%)">
      <span class="lbl">${o.label}${me ? ' ✓' : ''}${won ? ' 🏆' : ''}</span>${plus}
      <span class="small muted">${o.voters.length}</span><span class="pc">${Math.round(pc)}%</span></div>`;
  }).join('');
  const banner = closed ? `<div class="win"><b>${tie ? `🤝 Tie: ${lead.label} and ${second.label}` : `🏆 ${lead.label} wins`}</b>
      <div class="small muted">${lead.voters.length} of ${sum} votes · ${Math.round(lead.voters.length / sum * 100)}%${mine ? ` · you picked ${byId(mine).label}` : ''}</div></div>` : '';
  return `<div class="list" style="height: ${options.length * ROW - 6}px">${rows}</div>${banner}`;
}

function voters() {
  return '<div style="margin-top: 6px">' + order().map(o => {
    const avs = o.voters.slice(-8).map(n => `<span class="av" style="background-color: ${color(n)}">${initials(n)}</span>`).join('');
    const more = o.voters.length > 8 ? `<span class="small muted">+${o.voters.length - 8}</span>` : '';
    return `<div class="who"><div class="row between"><b class="small">${o.label}</b><span class="small muted">${o.voters.length} · ${esc(o.voters.slice(-3).join(', '))}</span></div>
      <div>${avs || '<span class="small muted">No votes yet</span>'}${more}</div></div>`;
  }).join('') + '</div>';
}

function render() {
  const tabs = [['results', 'Results'], ['voters', 'Voters']].map(([id, label]) =>
    `<span class="tab ${tab === id ? 'on' : ''}" data-action="tab" data-value="${id}">${label}</span>`).join('');
  const tick = ticker.k > 0.01 ? mix('#8e8e93', '#007aff', ticker.k) : '#8e8e93';
  return `<div class="card pad poll">
    <div class="row between"><b>📍 Offsite location</b>
      <span><span class="small muted">${Math.round(total.v)} votes</span> <span class="badge ${closed ? '' : 'red'}">${closed ? 'closed' : '● live'}</span></span></div>
    <div class="ticker" style="color: ${tick}">${esc(ticker.text)}</div>
    <div class="bar2"><span>${tabs}</span>${tab === 'results' ? `<a class="lnk" href="#" data-action="sort">⇅ ${sortTop ? 'Top first' : 'Original order'}</a>` : ''}</div>
    ${tab === 'results' ? results() : voters()}
    <div class="foot"><span class="tiny muted">${closed ? 'Voting is closed' : mine ? 'You voted · tap your choice again to take it back' : 'Tap an option to vote'}</span>
      <span><a class="lnk" href="#" data-action="reset">↻ Reset</a>&nbsp; <button ${closed ? '' : 'class="primary"'} data-action="close">${closed ? 'Reopen' : 'Close poll'}</button></span></div>
  </div>`;
}
</script>

--- nora 10:06
Tic-tac-toe against Pixel. Pick Easy or Hard (Hard is a full minimax, it never loses) and who starts. The bot thinks for a moment (a <code>setTimeout</code>), pieces spring in with <code>tween()</code>, the winning line pulses, and the result card arrives with <code>transition('pop')</code>.

--- nora 10:06 bare
<style>[hidden]{display:none!important}
  .ttt { width: 300px; max-width: 100%; }
  .ttt .opts { display: flex; justify-content: space-between; margin-top: 8px; }
  .ttt .seg span { display: inline-block; padding: 2px 9px; margin-right: 3px; border-radius: 7px; font-size: 12px; font-weight: 600; background-color: rgba(127,127,127,0.12); }
  .ttt .seg span:hover { background-color: rgba(127,127,127,0.24); }
  .ttt .seg span.on { background-color: #5e5ce6; color: #ffffff; }
  .ttt table { border-collapse: collapse; margin: 10px auto 8px auto; }
  .ttt td { width: 66px; height: 66px; padding: 0; text-align: center; vertical-align: middle; line-height: 66px; font-weight: 800; border: 2px solid rgba(127,127,127,0.35); }
  .ttt tr:first-child td { border-top: 0; } .ttt tr:last-child td { border-bottom: 0; }
  .ttt td:first-child { border-left: 0; } .ttt td:last-child { border-right: 0; }
  .ttt td.free:hover { background-color: rgba(127,127,127,0.10); }
  .ttt .x { color: #ff2d55; } .ttt .o { color: #5e5ce6; }
  .ttt .score { display: flex; justify-content: space-around; align-items: center; height: 24px; font-size: 13px; }
  .ttt .foot { text-align: center; margin-top: 8px; }
  .ttt .foot button { margin: 0 3px; }
  .ttt .result { margin-top: 8px; padding: 10px; border-radius: 12px; text-align: center; }
  .ttt .result .t { font-size: 18px; font-weight: 800; }
</style>
<div class="card pad ttt"><b>Tic-tac-toe</b></div>
<script>
const LINES = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];
let board, pops, winner, line, thinking, flash = 0, game = 0, hint = -1, moves = 0, level = 'hard', first = 'you', streak = 0, hints = 0;
const score = { X: 0, O: 0, draw: 0 }, bump = { X: 1, O: 1, draw: 1 }, glow = { h: 0 };
const memo = new Map();
const pick = list => list[Math.floor(Math.random() * list.length)];

function outcome(b) {
  for (const l of LINES) if (b[l[0]] && b[l[0]] === b[l[1]] && b[l[0]] === b[l[2]]) return { who: b[l[0]], line: l };
  return b.every(Boolean) ? { who: 'draw', line: [] } : null;
}

function solve(b, turn) {
  let key = turn === 'X' ? 1 : 2;
  for (let i = 0; i < 9; i++) key = key * 3 + (b[i] === 'X' ? 1 : b[i] === 'O' ? 2 : 0);
  let hit = memo.get(key);
  if (hit) return hit;
  const r = outcome(b);
  if (r) { let empty = 1; for (let i = 0; i < 9; i++) if (!b[i]) empty++; hit = { v: r.who === 'draw' ? 0 : -empty, moves: [] }; }
  else {
    const other = turn === 'X' ? 'O' : 'X';
    let best = -Infinity, moves = [];
    for (let i = 0; i < 9; i++) if (!b[i]) {
      b[i] = turn;
      const v = -solve(b, other).v;
      b[i] = '';
      if (v > best) { best = v; moves = [i]; } else if (v === best) moves.push(i);
    }
    hit = { v: best, moves };
  }
  memo.set(key, hit);
  return hit;
}

function botMove() {
  const free = board.map((v, i) => v ? -1 : i).filter(i => i >= 0);
  if (level === 'hard') return free.length === 9 ? pick([0, 2, 4, 6, 8]) : pick(solve(board.slice(), 'O').moves);
  for (const i of free) { const b = board.slice(); b[i] = 'O'; if (outcome(b)?.who === 'O') return i; }
  if (Math.random() < 0.5) for (const i of free) { const b = board.slice(); b[i] = 'X'; if (outcome(b)?.who === 'X') return i; }
  return pick(free);
}

function pulse() {
  const me = game;
  animate(1680, p => { if (me === game) flash = p >= 1 ? 0.6 : Math.abs(Math.sin(p * 4 * Math.PI)); }, ease.linear);
}

function place(i, who) {
  board[i] = who; moves++; hint = -1;
  pops[i].s = 0;
  tween(pops[i], { s: 1 }, 340, ease.outBack);
  const r = outcome(board);
  if (!r) return;
  transition('pop');
  winner = r.who; line = r.line; score[r.who]++;
  streak = r.who === 'X' ? streak + 1 : 0;
  bump[r.who] = 1.7;
  tween(bump, { [r.who]: 1 }, 520, ease.outBack);
  if (r.who !== 'draw') pulse();
}

function botTurn() {
  thinking = true;
  const me = game;
  setTimeout(() => {
    if (me !== game || winner) return;
    place(botMove(), 'O');
    thinking = false;
  }, 380 + Math.random() * 300);
}

function newGame() {
  game++;
  board = Array(9).fill('');
  pops = board.map(() => ({ s: 1 }));
  winner = null; line = []; thinking = false; flash = 0; hint = -1; moves = 0;
  if (first === 'pixel') botTurn();
}
newGame();
const intro = { ms: -1 };
setTimeout(() => animate(1000, (_, t) => { intro.ms = t < 1 ? t * 1000 : -1; }, ease.linear), 250);
const ghost = i => {
  if (intro.ms < 0) return 0;
  const k = (intro.ms - (Math.floor(i / 3) + i % 3) * 110) / 420;
  return k > 0 && k < 1 ? Math.sin(k * Math.PI) : 0;
};

function onAction(name, value) {
  if (name === 'new') { transition('pop'); return newGame(); }
  if (name === 'level' || name === 'first') {
    if ((name === 'level' ? level : first) === value) return;
    if (name === 'level') level = value; else first = value;
    transition('fade');
    return newGame();
  }
  if (name === 'hint') {
    if (winner || thinking) return;
    hint = pick(solve(board.slice(), 'X').moves);
    hints++;
    const me = game, mine = hint;
    animate(1140, p => { if (me === game && hint === mine) glow.h = p >= 1 ? 0.5 : Math.abs(Math.sin(p * 3 * Math.PI)); }, ease.linear);
    return;
  }
  const i = Number(value);
  if (winner || thinking || board[i]) return;
  place(i, 'X');
  if (!winner) botTurn();
}

function render() {
  const cells = board.map((v, i) => {
    const bg = line.includes(i) ? `background-color: ${alpha('#34c759', 0.12 + 0.4 * flash)};`
             : i === hint ? `background-color: ${alpha('#ffcc00', 0.15 + 0.35 * glow.h)};` : '';
    const size = Math.max(1, Math.round(40 * pops[i].s));
    const open = !v && !winner && !thinking;
    const g = v ? 0 : ghost(i);
    const mark = v === 'X' ? '✕' : v === 'O' ? '◯' : g > 0.02 ? (i % 2 ? '◯' : '✕') : '&nbsp;';
    const tint = g > 0.02 ? ` color: ${alpha(i % 2 ? '#5e5ce6' : '#ff2d55', 0.4 * g)};` : '';
    return `<td class="${open ? 'free' : ''}" ${open ? `data-action="cell" data-value="${i}"` : ''} style="${bg}">
      <span class="${v === 'X' ? 'x' : 'o'}" style="font-size: ${v ? size : 40}px;${tint}">${mark}</span></td>`;
  });
  const rows = [0, 3, 6].map(r => `<tr>${cells.slice(r, r + 3).join('')}</tr>`).join('');
  const status = winner ? `${moves} moves` : thinking ? 'Pixel is thinking…' : 'Your move (✕)';
  const chip = (act, val, label, on) => `<span class="${on ? 'on' : ''}" data-action="${act}" data-value="${val}">${label}</span>`;
  const big = k => `font-size: ${Math.round(13 * bump[k])}px`;
  const result = winner === 'X' ? ['You win! 🎉', streak > 1 ? `${streak} wins in a row` : 'Nicely played', 'rgba(52,199,89,0.16)']
               : winner === 'O' ? ['Pixel wins 🤖', level === 'hard' ? 'Hard mode never loses. Try Easy?' : 'Best of three?', 'rgba(94,92,230,0.16)']
               : ['Draw 🤝', level === 'hard' ? 'The best you can do against Hard' : 'Evenly matched', 'rgba(127,127,127,0.14)'];
  const foot = winner
    ? `<div class="result" style="background-color: ${result[2]}"><div class="t">${result[0]}</div><div class="small muted">${result[1]}</div>
         <button class="primary" data-action="new" style="margin-top: 8px">Play again</button></div>`
    : `<div class="foot"><button data-action="hint">💡 Hint${hints ? ` · ${hints}` : ''}</button><button data-action="new">↻ Restart</button></div>`;
  return `<div class="card pad ttt">
    <div class="row between"><b>Tic-tac-toe</b><span class="small muted">${status}</span></div>
    <div class="opts"><span class="seg">${chip('level', 'easy', 'Easy', level === 'easy')}${chip('level', 'hard', 'Hard', level === 'hard')}</span>
      <span class="seg">${chip('first', 'you', '✕ first', first === 'you')}${chip('first', 'pixel', '◯ first', first === 'pixel')}</span></div>
    <table>${rows}</table>
    <div class="score"><span style="${big('X')}"><b class="x">You</b> ${score.X}</span><span class="muted" style="${big('draw')}">Draws ${score.draw}</span><span style="${big('O')}"><b class="o">Pixel</b> ${score.O}</span></div>
    ${foot}
  </div>`;
}
</script>

