  .sw .l .a { width: 40%; } .sw .l .b { width: 30%; text-align: right; } .sw .l .c { width: 30%; text-align: right; }
  .sw .bars { margin-top: 6px; }
  .sw .br { display: flex; align-items: center; height: 18px; font-size: 11px; font-family: ui-monospace; }
  .sw .br .n { width: 30px; } .sw .br .v { width: 64px; text-align: right; }
  .sw .br .track { flex: 1; min-width: 0; height: 10px; }
  .sw .br .fill { height: 10px; border-radius: 3px; }
</style>
<div class="card pad sw"><b>⏱ Stopwatch</b></div>
<script>
let running = false, startedAt = 0, banked = 0, laps = [], view = 'laps', looping = false, unwind = null;
const sweep = { a: -1 }, grow = { k: 1 }, fresh = { a: 0 };
const elapsed = () => banked + (running ? performance.now() - startedAt : 0);
const lapBase = () => laps.length ? laps[laps.length - 1].total : 0;
const fmt = ms => {
  const m = Math.floor(ms / 60000), s = Math.floor(ms / 1000) % 60, cs = Math.floor(ms / 10) % 100;
  return [String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0'), String(cs).padStart(2, '0')];
};
const full = ms => fmt(ms).join('.');
function frame() { if (running) requestAnimationFrame(frame); else looping = false; }

function onAction(name, value) {
  if (name === 'toggle') {
    if (running) { banked = elapsed(); running = false; return; }
    unwind = null;
    startedAt = performance.now(); running = true;
    if (!looping) { looping = true; requestAnimationFrame(frame); }
  } else if (name === 'lap' && running) {
    transition('slide-up');
    const total = elapsed();
    laps.push({ t: total - lapBase(), total });
    fresh.a = 1;
    tween(fresh, { a: 0 }, 900, ease.outQuad);
    if (view === 'chart') { grow.k = 0.6; tween(grow, { k: 1 }, 500, ease.outCubic); }
  } else if (name === 'reset' && !running) {
    if (laps.length) transition('fade');
    const u = unwind = { from: banked, k: 1 };
    animate(550, (p, raw) => { if (unwind === u) { u.k = 1 - p; if (raw >= 1) unwind = null; } }, ease.outCubic);
    banked = 0; laps = []; view = 'laps';
  } else if (name === 'view' && value !== view) {
    transition(value === 'chart' ? 'slide-left' : 'slide-right');
    view = value;
    grow.k = 0;
    tween(grow, { k: 1 }, 650, ease.outCubic);
  }
}
setTimeout(() => { if (!running && !banked) animate(800, (p, raw) => { sweep.a = raw >= 1 ? -1 : p; }, ease.inOutCubic); }, 250);

function lapList(best, worst) {
  const rows = laps.slice().reverse().slice(0, 5).map((l, k) => {
    const n = laps.length - k, i = n - 1;
    const tone = i === best ? 't-green' : i === worst ? 't-red' : '';
    const tag = i === best ? ' ▲' : i === worst ? ' ▼' : '';
    const bg = k === 0 && fresh.a > 0.01 ? ` style="background-color: ${alpha('#ff9500', 0.22 * fresh.a)}"` : '';
    return `<div class="l"${bg}><span class="a ${tone}">Lap ${n}${tag}</span><span class="b ${tone}">${full(l.t)}</span><span class="c muted">${full(l.total)}</span></div>`;
  }).join('');
  const more = laps.length > 5 ? `<div class="tiny muted center" style="margin-top: 3px">+${laps.length - 5} earlier laps</div>` : '';
  return `<div class="laps">${rows}</div>${more}`;
}

function lapChart(best, worst) {
  const shown = laps.slice(-8), max = Math.max(...shown.map(l => l.t));
  const offset = laps.length - shown.length;
  return `<div class="bars">${shown.map((l, k) => {
    const i = offset + k, c = i === best ? '#34c759' : i === worst ? '#ff3b30' : '#ff9500';
    const d = clamp(grow.k * 1.6 - k * 0.08, 0, 1);
    return `<div class="br"><span class="n muted">L${i + 1}</span><div class="track"><div class="fill" style="width: ${Math.max(2, 100 * l.t / max * ease.outCubic(d)).toFixed(1)}%; background-color: ${c}"></div></div><span class="v">${full(l.t)}</span></div>`;
  }).join('')}</div>`;
}

function render() {
  const ms = unwind ? unwind.from * unwind.k : elapsed();
  const deg = (ms % 60000) / 60000 * 360;
  const [main, cs] = fmt(ms);
  let ring = deg < 0.5 ? 'background-color: rgba(127,127,127,0.18)' : `background: conic-gradient(#ff9500 ${deg.toFixed(1)}deg, rgba(127,127,127,0.18) ${deg.toFixed(1)}deg)`;
  if (sweep.a >= 0 && !ms) {
    const s = sweep.a * 360;
    ring = `background: conic-gradient(${alpha('#ff9500', 0.15 + 0.6 * (1 - sweep.a))} ${s.toFixed(1)}deg, rgba(127,127,127,0.18) ${s.toFixed(1)}deg)`;
  }
  let best = -1, worst = -1;
  if (laps.length > 1) laps.forEach((l, i) => { if (best < 0 || l.t < laps[best].t) best = i; if (worst < 0 || l.t > laps[worst].t) worst = i; });
  const cur = ms - lapBase();
  const delta = laps.length > 1 && running ? cur - laps[best].t : null;
  const now = laps.length ? `<div class="now ${delta === null ? 'muted' : delta > 0 ? 't-red' : 't-green'}">L${laps.length + 1} ${full(cur)}</div>` : '';
  const tabs = laps.length ? `<div class="tabs"><span>${[['laps', 'Laps'], ['chart', 'Chart']].map(([id, label]) =>
    `<span class="tab ${view === id ? 'on' : ''}" data-action="view" data-value="${id}">${label}</span>`).join('')}</span>
    <span class="tiny muted">${laps.length} lap${laps.length > 1 ? 's' : ''}${best >= 0 ? ` · best ${full(laps[best].t)}` : ''}</span></div>` : '';
  return `<div class="card pad sw">
    <div class="row between"><b>⏱ Stopwatch</b><span class="badge ${running ? 'green' : ms ? 'orange' : ''}">${running ? 'running' : ms ? 'paused' : 'ready'}</span></div>
    <div class="ring" style="${ring}">
      <div class="face"><div class="big">${main}</div><div class="cs">.${cs}</div>${now}</div>
    </div>
    <div class="btns">
      <button data-action="${running ? 'lap' : 'reset'}">${running ? 'Lap' : 'Reset'}</button>
      <button class="primary" data-action="toggle">${running ? 'Stop' : ms ? 'Resume' : 'Start'}</button>
    </div>
    ${tabs}${laps.length ? (view === 'laps' ? lapList(best, worst) : lapChart(best, worst)) : ''}
  </div>`;
}
</script>

