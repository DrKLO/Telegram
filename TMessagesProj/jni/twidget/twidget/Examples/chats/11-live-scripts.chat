@chat Live Scripts
@subtitle JavaScript inside messages: state → render() → HTML
@icon curlybraces
@participant me | You | #007aff | me
@participant nora | Nora Patel | #ff2d55
@participant theo | Theo Brandt | #34c759
@participant pixel | Pixel | #5e5ce6

--- nora 10:00
These cards are <b>scripted messages</b>. Each one carries a <code>&lt;script&gt;</code> that runs in its own JavaScriptCore sandbox. It defines <code>render()</code> (state → HTML) and <code>onAction(name, value)</code>, which is called when you click anything with a <code>data-action</code>. Every click updates the same bubble in place: <code>tween()</code> and <code>animate()</code> move numbers, sizes and colours at up to 60 fps, and <code>transition('pop')</code> or <code>'slide-left'</code> lets the bubble animate natively when its content swaps. Right-click a card and pick <i>Script Log…</i> to see its console.

--- pixel 10:01 bare
<style>
  .ctr { width: 320px; max-width: 100%; }
  .ctr .seg { position: relative; width: 150px; height: 26px; border-radius: 8px; background-color: rgba(127,127,127,0.14); }
  .ctr .pill { position: absolute; top: 2px; width: 46px; height: 22px; border-radius: 6px; background-color: #ffffff; }
  .lc-dark .ctr .pill { background-color: #5a5a5f; }
  .ctr .opt { position: absolute; top: 0; width: 50px; height: 26px; line-height: 26px; text-align: center; font-size: 12px; font-weight: 700; }
  .ctr .opt:hover { color: #af52de; }
  .ctr .num { text-align: center; height: 68px; line-height: 68px; font-weight: 800; }
  .ctr .btns { text-align: center; }
  .ctr .btns button { width: 66px; margin: 0 4px; font-size: 16px; }
  .ctr .spark { margin-top: 12px; padding: 6px 8px; }
  .ctr .stats { display: flex; justify-content: space-between; font-size: 11px; margin-top: 3px; }
  .ctr .undo:hover { text-decoration: underline; }
</style>
<div class="card pad ctr"><b>Counter</b><p class="small muted">Static fallback: shown if the script can't run.</p></div>
<script>
const STEPS = [1, 5, 10], SLOTS = 24, W = 276, H = 44;
let count = 0, step = 1, history = [0];
const shown = { v: 0 }, pop = { s: 1 }, pill = { x: 2 }, spark = { k: 1, u: 1, lo: -1.2, hi: 1.2, tail: null };

function bounds() {
  const vals = history.slice(-SLOTS - 1);
  const lo = Math.min(0, ...vals), hi = Math.max(0, ...vals), pad = Math.max(1.2, (hi - lo) * 0.15);
  return { lo: lo - pad, hi: hi + pad };
}

function show(next) {
  count = next;
  console.log('count is now', count);
  tween(shown, { v: count }, 320, ease.outCubic);
  pop.s = 1.3;
  tween(pop, { s: 1 }, 420, ease.outBack);
}

function onAction(name, value) {
  if (name === 'step') {
    step = Number(value);
    tween(pill, { x: 2 + STEPS.indexOf(step) * 50 }, 320, ease.outBack);
    return;
  }
  if (name === 'undo') {
    if (history.length < 2) return;
    const tail = { v: history.pop() };
    show(history[history.length - 1]);
    spark.tail = tail;
    spark.u = 1;
    tween(spark, bounds(), 320, ease.outCubic);
    animate(320, (p, raw) => {
      if (spark.tail !== tail) return;
      spark.u = 1 - p;
      if (raw >= 1) spark.tail = null;
    }, ease.outCubic);
    return;
  }
  const next = name === 'add' ? count + Number(value) * step : 0;
  if (next === count && name === 'reset') return;
  history.push(next);
  if (history.length > 400) history.shift();
  show(next);
  spark.tail = null;
  spark.k = 0;
  tween(spark, { k: 1, ...bounds() }, 360, ease.outCubic);
}

setTimeout(() => {
  pop.s = 0.2;
  tween(pop, { s: 1 }, 650, ease.outBack);
  spark.k = 0;
  tween(spark, { k: 1 }, 650, ease.outCubic);
}, 250);

function sparkURI() {
  const series = spark.tail ? [...history, spark.tail.v] : history;
  const pts = series.slice(-SLOTS - 1), n = pts.length, dx = (W - 8) / (SLOTS - 1), k = spark.tail ? spark.u : spark.k;
  const y = v => H - 4 - (v - spark.lo) / (spark.hi - spark.lo) * (H - 8);
  const P = pts.map((v, i) => [W - 4 - (n - 1 - i) * dx + (1 - k) * dx,
                               i === n - 1 && n > 1 ? lerp(y(pts[n - 2]), y(v), k) : y(v)]);
  const d = P.map(([a, b], i) => `${i ? 'L' : 'M'}${a.toFixed(1)} ${b.toFixed(1)}`).join(' ');
  const [lx, ly] = P[n - 1], zero = y(0).toFixed(1);
  const area = n > 1 ? `<path d='${d} L${lx.toFixed(1)} ${H} L${P[0][0].toFixed(1)} ${H} Z' fill='#af52de' fill-opacity='0.14'/>
    <path d='${d}' fill='none' stroke='#af52de' stroke-width='2' stroke-linejoin='round' stroke-linecap='round'/>` : '';
  return 'data:image/svg+xml;utf8,' + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='${W}' height='${H}' viewBox='0 0 ${W} ${H}'>
    <line x1='0' y1='${zero}' x2='${W}' y2='${zero}' stroke='#8e8e93' stroke-opacity='0.55' stroke-dasharray='3 3'/>${area}
    <circle cx='${lx.toFixed(1)}' cy='${ly.toFixed(1)}' r='3.5' fill='#af52de'/></svg>`);
}

function render() {
  const tone = count > 0 ? 't-green' : count < 0 ? 't-red' : 'fg';
  const seg = STEPS.map((s, i) => `<div class="opt ${s === step ? 'fg' : 'muted'}" style="left: ${i * 50}px" data-action="step" data-value="${s}">×${s}</div>`).join('');
  const lo = Math.min(...history), hi = Math.max(...history);
  return `<div class="card pad ctr">
    <div class="row between"><b>Counter</b>
      <div class="seg"><div class="pill" style="left: ${pill.x.toFixed(1)}px"></div>${seg}</div></div>
    <div class="num ${tone}" style="font-size: ${Math.max(1, Math.round(46 * pop.s))}px">${Math.round(shown.v)}</div>
    <div class="btns">
      <button data-action="add" data-value="-1">−${step}</button>
      <button data-action="reset">↺</button>
      <button class="primary" data-action="add" data-value="1">+${step}</button>
    </div>
    <div class="panel spark"><img src="${sparkURI()}" width="${W}" height="${H}">
      <div class="stats muted"><span>min ${lo} · max ${hi} · ${history.length - 1} changes</span>
        ${history.length > 1 ? '<a class="undo" href="#" data-action="undo">↶ Undo</a>' : '<span>history</span>'}</div></div>
  </div>`;
}
</script>

