<style>
  .sw { width: 100%; box-sizing: border-box; }
  .sw .ring { width: 128px; height: 128px; border-radius: 75px; margin: 12px auto 10px auto; padding: 11px; }
  .sw .face { width: 128px; height: 128px; border-radius: 64px; background-color: #ffffff; text-align: center; }
  .lc-dark .sw .face { background-color: #1c1c1e; }
  .sw .big { font-size: 28px; font-weight: 700; font-family: ui-monospace; padding-top: 30px; line-height: 32px; }
  .sw .cs { font-size: 15px; color: #8e8e93; font-family: ui-monospace; }
  .sw .now { font-size: 11px; font-family: ui-monospace; margin-top: 3px; }
  .sw .btns { display: flex; justify-content: center; gap: 8px; }
  .sw .btns button { flex: 1; min-width: 0; max-width: 104px; padding: 5px 10px; white-space: nowrap; }
  .sw .tabs { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }
