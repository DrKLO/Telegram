  .wam .stats b { display: block; font-size: 19px; }
</style>
<div class="card pad wam"><b>🔨 Whack-a-mole</b></div>
<script>
const LEVELS = {
  easy:   { label: 'Easy',   stay: 1100, gap: [560, 950], gold: 0.10, bomb: 0 },
  normal: { label: 'Normal', stay: 800,  gap: [380, 820], gold: 0.10, bomb: 0.10 },
  hard:   { label: 'Hard',   stay: 560,  gap: [260, 560], gold: 0.12, bomb: 0.16 },
};
const RISE = 150, FALL = 160, GAME = 20000, COUNT = 2400, FACE = { mole: '🐹', gold: '🌟', bomb: '💣' };
let mode = 'idle', level = 'normal', t = 0, looping = false, holes = [], fx = [], introMs = -1, newBest = false;
let score = 0, hits = 0, escaped = 0, whiffs = 0, bombs = 0, combo = 0, bestCombo = 0, endsAt = 0, nextSpawn = 0, countFrom = 0;
const best = { easy: 0, normal: 0, hard: 0 }, shown = { v: 0 };
const clearHoles = () => { holes = Array.from({ length: 9 }, () => ({ live: false, t0: 0, hit: false, stay: 800, kind: 'mole' })); };
clearHoles();

function height(h) {
  if (!h.live) return 0;
  const dt = t - h.t0;
  if (dt < RISE) return ease.outBack(dt / RISE);
  if (dt < RISE + h.stay) return 1;
  return Math.max(0, 1 - ease.inQuad((dt - RISE - h.stay) / FALL));
}

function spawn() {
  const L = LEVELS[level], idle = holes.filter(h => !h.live), h = idle[Math.floor(Math.random() * idle.length)];
  if (h) {
    const r = Math.random();
    Object.assign(h, { live: true, t0: t, hit: false, stay: L.stay * (0.85 + Math.random() * 0.3),
                       kind: r < L.bomb ? 'bomb' : r < L.bomb + L.gold ? 'gold' : 'mole' });
  }
  const speedup = 1 - 0.35 * clamp(1 - (endsAt - t) / GAME, 0, 1);
  nextSpawn = t + (L.gap[0] + Math.random() * (L.gap[1] - L.gap[0])) * speedup;
}

function finish() {
  transition('pop');
  mode = 'over';
  clearHoles();
  newBest = score > best[level];
  best[level] = Math.max(best[level], score);
  shown.v = 0;
  tween(shown, { v: score }, 800, ease.outCubic);
}

function tick(now) {
  t = now;
  if (mode === 'count' && t >= countFrom + COUNT) { mode = 'play'; endsAt = t + GAME; nextSpawn = t + 120; }
  if (mode === 'play') {
    for (const h of holes) if (h.live && t - h.t0 > RISE + h.stay + FALL) {
      if (!h.hit && h.kind !== 'bomb') { escaped++; combo = 0; }
      h.live = false;
    }
    if (t >= nextSpawn) spawn();
    if (t >= endsAt) finish();
  }
  fx = fx.filter(f => t - f.born < 750);
  if (mode === 'play' || mode === 'count' || fx.length) requestAnimationFrame(tick); else looping = false;
}
function loop() { if (!looping) { looping = true; requestAnimationFrame(tick); } }

function pop(i, text, color) {
  fx.push({ i, text, color, born: t });
  if (fx.length > 12) fx.shift();
  loop();
}

function whack(i) {
  const h = holes[i];
  if (!(h.live && !h.hit && height(h) > 0.3)) { whiffs++; combo = 0; return pop(i, 'miss', '#8e8e93'); }
  h.hit = true;
  h.t0 = t - RISE - h.stay + 140;
  if (h.kind === 'bomb') { bombs++; combo = 0; score = Math.max(0, score - 5); return pop(i, '−5', '#ff3b30'); }
  hits++; combo++;
  bestCombo = Math.max(bestCombo, combo);
  const pts = (h.kind === 'gold' ? 3 : 1) * (1 + Math.floor(combo / 5));
  score += pts;
  pop(i, `+${pts}`, h.kind === 'gold' ? '#ff9500' : '#34c759');
}

function onAction(name, value) {
  t = performance.now();
  if (name === 'level') { level = value; return; }
  if (name === 'start') {
    transition('fade');
    mode = 'count'; countFrom = t; introMs = -1;
    score = hits = escaped = whiffs = bombs = combo = bestCombo = 0;
    clearHoles(); fx = [];
    return loop();
  }
  if (name === 'stop' && mode === 'play') return finish();
  if (name === 'whack' && mode === 'play') whack(Number(value));
}

setTimeout(() => animate(1150, (_, k) => { introMs = mode === 'idle' && k < 1 ? k * 1150 : -1; }, ease.linear), 250);

function render() {
  const cells = holes.map((h, i) => {
    let up = height(h), face = h.hit ? '💥' : FACE[h.kind];
    if (introMs >= 0) { const k = (introMs - i * 70) / 520; up = k > 0 && k < 1 ? 0.85 * Math.sin(k * Math.PI) : 0; face = '🐹'; }
    const live = mode === 'play';
    return `<div class="hole ${live ? 'live' : ''}" ${live ? `data-action="whack" data-value="${i}"` : ''}>
      <div class="mole" style="margin-top: ${Math.round(70 - 56 * up)}px">${up > 0 ? face : ''}</div></div>`;
  }).join('');
  const floats = fx.map(f => {
    const k = (t - f.born) / 750;
    return `<div class="fx" style="left: ${(f.i % 3) * 103}px; top: ${Math.round(Math.floor(f.i / 3) * 80 + 6 - 30 * ease.outCubic(k))}px; color: ${alpha(f.color, 1 - k * k)}">${f.text}</div>`;
  }).join('');
  let overlay = '';
  if (mode === 'count') {
    const phase = (t - countFrom) / 600, n = 3 - Math.floor(phase), f = phase % 1;
    overlay = `<div class="count" style="font-size: ${Math.round(28 + 44 * ease.outBack(Math.min(1, f * 3)))}px; color: ${alpha('#ff9500', 1 - 0.7 * f)}">${n > 0 ? n : 'Go!'}</div>`;
  }
  const left = mode === 'play' ? Math.max(0, endsAt - t) : mode === 'count' ? GAME : 0;
  const chips = Object.keys(LEVELS).map(k => `<span class="${k === level ? 'on' : ''}" data-action="level" data-value="${k}">${LEVELS[k].label}</span>`).join('');
  let bottom;
  if (mode === 'idle') bottom = `<div class="small muted center">🐹 +1 · 🌟 +3 · 💣 −5 · every 5 hits in a row raises the multiplier</div>
    <div class="menu"><span class="seg">${chips}</span><button class="primary" data-action="start">Start</button></div>`;
  else if (mode === 'over') {
    const shots = hits + whiffs + bombs;
    bottom = `<div class="panel"><div class="row between"><b>Time's up!</b>${newBest ? '<span class="badge green">New best 🏆</span>' : `<span class="small muted">Best ${best[level]}</span>`}</div>
      <div class="stats"><div><b>${Math.round(shown.v)}</b><span class="tiny muted">score</span></div><div><b>${hits}</b><span class="tiny muted">hits</span></div>
        <div><b>${shots ? Math.round(hits / shots * 100) : 0}%</b><span class="tiny muted">accuracy</span></div><div><b>×${bestCombo}</b><span class="tiny muted">best combo</span></div></div>
      <div class="tiny muted center">${escaped} got away${bombs ? ` · ${bombs} 💣 hit` : ''}</div></div>
      <div class="menu"><span class="seg">${chips}</span><button class="primary" data-action="start">Play again</button></div>`;
  } else {
    const mult = 1 + Math.floor(combo / 5);
    bottom = `<div class="hud"><span>Score <b>${score}</b></span><span class="${mult > 1 ? 't-orange' : 'muted'}">Combo ${combo}${mult > 1 ? ` · ×${mult}` : ''}</span><span>Best <b>${best[level]}</b></span></div>`;
  }
  const head = mode === 'play' ? `<span><span class="badge orange">${Math.ceil(left / 1000)} s</span> <button data-action="stop">■</button></span>`
             : `<span class="badge">${LEVELS[level].label}</span>`;
  return `<div class="card pad wam">
    <div class="row between"><b>🔨 Whack-a-mole</b>${head}</div>
    ${mode === 'play' || mode === 'count' ? `<div class="timer"><div style="width: ${(left / GAME * 100).toFixed(1)}%; background-color: ${mix('#ff3b30', '#34c759', left / GAME)}"></div></div>` : ''}
    <div class="field">${cells}${floats}${overlay}</div>
    ${bottom}
  </div>`;
}
</script>

--- me 10:11
How does the stopwatch stay accurate if it's paused while scrolled away?

--- pixel 10:11
It never counts ticks. It stores <code>startedAt</code> and computes <code>performance.now() - startedAt</code> in <code>render()</code>, up to 60 times a second while it runs. Animation frames stop while a message is off screen and pick up again when it comes back, and the frame loop ends as soon as you press Stop.

