<div class="card pad dice"><b>🎲 Dice</b></div>
<script>
const PIPS = {
  1: [[50, 50]], 2: [[30, 30], [70, 70]], 3: [[30, 30], [50, 50], [70, 70]],
  4: [[30, 30], [70, 30], [30, 70], [70, 70]], 5: [[30, 30], [70, 30], [50, 50], [30, 70], [70, 70]],
  6: [[30, 28], [70, 28], [30, 50], [70, 50], [30, 72], [70, 72]],
};
const PIP = ['#ff2d55', '#5e5ce6', '#34c759', '#ff9500', '#00c7be'], SIZE = [84, 84, 76, 64, 54];
const die = (n, angle, pip, held) => 'data:image/svg+xml;utf8,' + encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100' viewBox='0 0 100 100'>
     <g transform='rotate(${angle.toFixed(1)} 50 50)'>
       <rect x='14' y='14' width='72' height='72' rx='15' fill='#ffffff' stroke='${held ? '#ffd60a' : '#c7c7cc'}' stroke-width='${held ? 6 : 2}'/>
       ${PIPS[n].map(([x, y]) => `<circle cx='${x}' cy='${y}' r='7.5' fill='${pip}'/>`).join('')}
     </g></svg>`);
const d6 = () => 1 + Math.floor(Math.random() * 6);

let n = 2, faces = [3, 5, 1, 6, 2], spin = [0, 0, 0, 0, 0], drop = [1, 1, 1, 1, 1], held = [false, false, false, false, false];
let rolling = false, rolled = false, history = [], label = '';
const lift = [0, 1, 2, 3, 4].map(() => ({ y: 0 })), total = { v: 0 }, pop = { s: 1 }, glow = { a: 0 };
const sum = () => faces.slice(0, n).reduce((s, f) => s + f, 0);

function settle(i, ms, delay = 0) {
  return animate(ms, (_, raw) => { drop[i] = 1 - ease.outBounce(clamp(raw * (1 + delay), 0, 1)); }, ease.linear);
}
setTimeout(() => {
  for (let i = 0; i < n; i++) settle(i, 900, i * 0.15);
  tween(total, { v: sum() }, 700, ease.outCubic);
}, 250);

function judge(f) {
  if (f.length < 2) return '';
  const s = f.slice().sort();
  if (s.every(v => v === s[0])) return ['', '', 'Doubles!', 'Triple!', 'Four of a kind!', 'Yahtzee! 🎉'][f.length];
  if (f.length === 5 && s.every((v, i) => i === 0 || v === s[i - 1] + 1)) return 'Straight! 🔥';
  return '';
}

function roll() {
  const idx = [...Array(n).keys()].filter(i => !held[i]);
  if (rolling || !idx.length) return;
  rolling = true; label = '';
  const final = faces.slice();
  idx.forEach(i => { final[i] = d6(); });
  const turns = idx.map((_, k) => (k % 2 ? -1 : 1) * (360 + Math.random() * 360));
  animate(1100, (p, raw) => {
    idx.forEach((i, k) => {
      spin[i] = turns[k] * (1 - p);
      drop[i] = 1 - ease.outBounce(clamp(raw * (1 + 0.07 * k), 0, 1));
      faces[i] = raw >= 0.8 ? final[i] : Math.random() < 0.5 ? d6() : faces[i];
    });
    if (raw >= 1) land(final);
  }, ease.outCubic);
}

function land(final) {
  faces = final; rolling = false; rolled = true;
  transition('pop');
  const s = sum();
  label = judge(faces.slice(0, n));
  history = [{ s, n, special: !!label }, ...history].slice(0, 12);
  total.v = 0;
  tween(total, { v: s }, 450, ease.outCubic);
  pop.s = 1.5;
  tween(pop, { s: 1 }, 520, ease.outBack);
  if (label) { glow.a = 1; tween(glow, { a: 0 }, 1400, ease.inQuad); }
}

function onAction(name, value) {
  if (name === 'roll') return roll();
  if (rolling) return;
  if (name === 'hold' && rolled) {
    const i = Number(value);
    held[i] = !held[i];
    tween(lift[i], { y: held[i] ? 1 : 0 }, 260, ease.outBack);
  } else if (name === 'release') {
    held = held.map(() => false);
    lift.forEach(l => tween(l, { y: 0 }, 260, ease.outCubic));
  } else if (name === 'dice') {
    const next = clamp(n + Number(value), 1, 5);
    if (next === n) return;
    if (next < n) { transition('fade'); held[n - 1] = false; lift[n - 1].y = 0; }
    else { faces[next - 1] = d6(); spin[next - 1] = 0; settle(next - 1, 800); }
    n = next; label = '';
    tween(total, { v: sum() }, 400, ease.outCubic);
  } else if (name === 'clear') {
    transition('slide-up');
    history = [];
  }
}

function render() {
  const size = SIZE[n - 1], room = 132 - size - 18;
  const tray = faces.slice(0, n).map((f, i) => {
    const top = Math.round(4 + room * (1 - drop[i]) - 8 * lift[i].y);
    return `<span class="d ${rolled && !rolling ? 'can' : ''}" ${rolled && !rolling ? `data-action="hold" data-value="${i}"` : ''} style="margin-top: ${top}px">
      <img src="${die(f, spin[i], PIP[i], held[i])}" width="${size}" height="${size}"><div class="tag">${held[i] ? 'HELD' : '&nbsp;'}</div></span>`;
  }).join('');
  const all = held.slice(0, n).every(Boolean), anyHeld = held.slice(0, n).some(Boolean);
  const avg = history.length ? (history.reduce((s, h) => s + h.s, 0) / history.length).toFixed(1) : '–';
  const tint = glow.a > 0.01 ? `background-color: ${alpha('#ffd60a', 0.25 * glow.a)}; border-radius: 8px;` : '';
  return `<div class="card pad dice">
    <div class="row between"><b>🎲 Dice</b>
      <span class="step"><span class="small muted">Dice&nbsp;</span><button data-action="dice" data-value="-1">−</button><b>${n}</b><button data-action="dice" data-value="1">+</button></span></div>
    <div class="tray">${tray}</div>
    <div class="sum" style="${tint}">
      <span>${rolling ? '<span class="muted">Rolling…</span>' : `Total <span class="total" style="font-size: ${Math.round(20 * pop.s)}px">${Math.round(total.v)}</span>`}
        ${label && !rolling ? `<span class="badge orange">${label}</span>` : ''}</span>
      <span>${anyHeld && !rolling ? '<a class="lnk" href="#" data-action="release">Release all</a>&nbsp; ' : ''}<button class="primary" data-action="roll">${rolling ? '…' : all ? 'All held' : 'Roll'}</button></span>
    </div>
    <div class="tiny muted">${rolled ? 'Tap a die to hold it between rolls' : 'Roll, then tap dice to hold them'}</div>
    ${history.length ? `<div class="hist">${history.map(h => `<span class="${h.special ? 'hi' : ''}">${h.s}</span>`).join('')}</div>
      <div class="row between tiny muted"><span>${history.length} rolls · avg ${avg}</span><a class="lnk" href="#" data-action="clear">Clear</a></div>` : ''}
  </div>`;
}
</script>

--- theo 10:17
OK but what stops a message from freezing my app? 🤔

--- pixel 10:17
Every call into a script is capped at <b>50 ms</b>, and a message gets at most <b>200 ms of JS per second</b>. Break either rule and the script is stopped for good. The card keeps its last HTML, or the static HTML around the <code>&lt;script&gt;</code>. Here are some badly behaved messages:

--- pixel 10:18 bare
<div class="card pad" style="width: 330px"><b>🛑 Runaway at load</b><p class="small muted" style="margin: 4px 0 0 0">This script is just <code>while (true) {}</code>. JavaScriptCore terminates it after 50 ms, and this static HTML around the <code>&lt;script&gt;</code> stays as the fallback.</p></div>
<script>
while (true) {}
</script>

--- pixel 10:18 bare
<div class="card pad" style="width: 330px"><b>Don't press</b></div>
<script>
let presses = 0;
function render() {
  return `<div class="card pad" style="width: 330px">
    <div class="row between"><b>🧨 Don't press</b><span class="small muted">pressed ${presses}×</span></div>
    <p class="small muted" style="margin: 6px 0 8px 0">“Safe” counts up. “Hang” runs <code>for (;;) {}</code> inside <code>onAction</code>.</p>
    <button data-action="safe">Safe</button> <button class="primary" data-action="hang" style="background-color: #ff3b30">Hang</button>
  </div>`;
}
function onAction(name) {
  presses++;
  if (name === 'hang') for (;;) {}
}
</script>

--- pixel 10:19 bare
<div class="card pad" style="width: 330px"><b>Greedy timer</b></div>
<script>
let ticks = 0, greedy = false;
function busy(ms) { const end = Date.now() + ms; while (Date.now() < end) {} }
function render() {
  return `<div class="card pad" style="width: 330px">
    <div class="row between"><b>🐷 Greedy timer</b><span class="badge ${greedy ? 'orange' : ''}">${ticks} ticks</span></div>
    <p class="small muted" style="margin: 6px 0 8px 0">Each tick burns 40 ms of CPU, 10 times a second. Every call is under 50 ms, but together they blow the 200 ms per second budget.</p>
    <button class="primary" data-action="go">${greedy ? 'Burning…' : 'Start'}</button>
  </div>`;
}
function onAction() {
  if (greedy) return;
  greedy = true;
  setInterval(() => { busy(40); ticks++; }, 100);
}
</script>

--- pixel 10:20 bare
<div class="card pad" style="width: 330px"><b>Buggy button</b></div>
<script>
let ok = 0;
function render() {
  return `<div class="card pad" style="width: 330px">
    <div class="row between"><b>🐛 Buggy button</b><span class="small muted">${ok} good clicks</span></div>
    <p class="small muted" style="margin: 6px 0 8px 0">An exception isn't fatal. The error shows under the card until a later action succeeds.</p>
    <button data-action="bug">Throw</button> <button class="primary" data-action="ok">Works</button>
  </div>`;
}
function onAction(name) {
  if (name === 'bug') frobnicate(42); // ReferenceError
  ok++;
}
</script>

--- pixel 10:21 bare
<style>
  .seen { width: 380px; }
  .seen .g { display: flex; flex-wrap: wrap; }
  .seen .g span { width: 50%; font-size: 12px; font-family: ui-monospace; padding: 1px 0; white-space: nowrap; }
</style>
<div class="card pad seen"><b>What can a script see?</b></div>
<script>
const absent = ['fetch', 'XMLHttpRequest', 'WebSocket', 'document', 'window', 'localStorage', 'require', 'process', 'WebAssembly', 'navigator'];
const present = ['setTimeout', 'setInterval', 'requestAnimationFrame', 'animate', 'tween', 'transition', 'ease', 'sleep', 'lerp', 'clamp', 'mix', 'alpha', 'esc', 'performance', 'update', 'console'];
const check = name => { try { return typeof globalThis[name] !== 'undefined'; } catch (e) { return false; } };
function render() {
  const rows = (names, want) => names.map(n => {
    const has = check(n);
    return `<span class="${has === want ? 't-green' : 't-red'}">${has ? '●' : '○'} ${n}</span>`;
  }).join('');
  return `<div class="card pad seen">
    <b>🔍 What can a script see?</b>
    <div class="caps" style="margin: 8px 0 3px 0">Not there: no I/O at all</div><div class="g">${rows(absent, false)}</div>
    <div class="caps" style="margin: 8px 0 3px 0">Provided by LiteChat</div><div class="g">${rows(present, true)}</div>
    <div class="tiny muted" style="margin-top: 6px">Plus the standard built-ins: Math, Date, JSON, Map, Promise, Intl…</div>
  </div>`;
}
</script>

