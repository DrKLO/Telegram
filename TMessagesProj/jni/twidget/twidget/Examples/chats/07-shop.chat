  .pd .nav:hover { background-color: rgba(0,0,0,0.48); }
  .pd .nav.l { left: 10px; } .pd .nav.r { right: 10px; }
  .pd .cap { position: absolute; left: 12px; bottom: 11px; padding: 2px 9px; border-radius: 9px; font-size: 11px; font-weight: 700; color: #ffffff; background-color: rgba(0,0,0,0.38); }
  .pd .dots { position: absolute; right: 12px; bottom: 15px; height: 7px; line-height: 7px; }
  .pd .dot { display: inline-block; height: 7px; border-radius: 4px; margin-left: 5px; background-color: rgba(255,255,255,0.6); }
  .pd .dot:hover { background-color: #ffffff; }
  .pd .pr { line-height: 24px; font-size: 18px; display: inline-block; }
  .pd .lbl { margin-top: 12px; }
  .pd .opts { margin-top: 5px; }
  .pd .sw { display: inline-block; width: 30px; height: 30px; border-radius: 17px; margin-right: 8px; border: 2px solid transparent; }
  .pd .sw:hover { border-color: rgba(127,127,127,0.5); }
  .pd .sw span { display: block; width: 24px; height: 24px; margin: 3px; border-radius: 12px; }
  .pd .size { display: inline-block; position: relative; width: 48px; height: 18px; line-height: 18px; padding: 6px 0; margin-right: 6px; text-align: center; border-radius: 9px; border: 1px solid rgba(127,127,127,0.35); font-weight: 600; font-size: 13px; }
  .pd .size:hover { border-color: #34c759; }
  .pd .size.sel { background-color: #1c1c1e; color: #ffffff; border-color: #1c1c1e; }
  .lc-dark .pd .size.sel { background-color: #f2f2f7; color: #1c1c1e; border-color: #f2f2f7; }
  .pd .size.out { color: rgba(142,142,147,0.8); text-decoration: line-through; border-style: dashed; }
  .pd .size.out.sel { background-color: rgba(255,59,48,0.12); color: #ff3b30; border-color: #ff3b30; }
  .lc-dark .pd .size.out.sel { background-color: rgba(255,69,58,0.2); color: #ff453a; border-color: #ff453a; }
