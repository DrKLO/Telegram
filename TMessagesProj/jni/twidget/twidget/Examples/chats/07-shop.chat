<style>
  .rc { width: 420px; max-width: 100%; font-size: 13px; }
  .rc .logo { text-align: center; padding: 16px 0 6px 0; }
  .rc .dash { border-top: 1px dashed rgba(127,127,127,0.45); margin: 8px 0; }
  .rc .li { overflow: hidden; }
  .rc .lr { position: relative; display: flex; align-items: flex-start; padding: 5px 6px; border-radius: 8px; }
  .rc .lr:hover { background-color: rgba(127,127,127,0.10); }
  .rc .lr.open { background-color: rgba(0,122,255,0.10); }
  .rc .q { width: 26px; flex-shrink: 0; }
  .rc .p, .rc .mono { font-family: ui-monospace; font-size: 12px; white-space: nowrap; }
  .rc .p { text-align: right; }
  .rc .chev { width: 16px; flex-shrink: 0; text-align: right; color: #8e8e93; font-size: 12px; }
  .rc .gone { text-decoration: line-through; color: #8e8e93; }
  .rc .det { margin: 2px 6px 6px 32px; padding: 9px 10px; border-radius: 9px; background-color: rgba(127,127,127,0.10); font-size: 12px; }
  .rc .det img { margin-right: 10px; }
  .rc .kv { display: flex; justify-content: space-between; padding: 2px 0; }
  .rc .det button { padding: 3px 10px; font-size: 12px; }
  .rc .m { display: flex; justify-content: space-between; color: #8e8e93; font-size: 12px; padding: 2px 6px; }
  .rc .tot { display: flex; justify-content: space-between; align-items: center; height: 26px; padding: 6px 6px 0 6px; font-size: 16px; font-weight: 800; }
  .rc .tot .p { font-size: 16px; }
  .rc .opt { display: flex; align-items: center; padding: 5px 6px; border-radius: 8px; }
  .rc .opt.tap:hover { background-color: rgba(127,127,127,0.08); }
  .rc .tip { display: inline-block; padding: 3px 10px; margin-left: 4px; border-radius: 12px; font-size: 12px; font-weight: 600; background-color: rgba(127,127,127,0.14); }
  .rc .tip:hover { background-color: rgba(127,127,127,0.26); }
  .rc .tip.on { background-color: #34c759; color: #ffffff; }
  .rc .tg { display: inline-block; position: relative; width: 40px; height: 24px; border-radius: 12px; }
  .rc .kn { display: block; position: absolute; top: 2px; width: 20px; height: 20px; border-radius: 10px; background-color: #ffffff; }
  .rc .splitp { margin: 4px 6px 0 6px; padding: 10px; border-radius: 10px; background-color: rgba(127,127,127,0.10); }
  .rc .splitp button { padding: 2px 10px; }
  .rc .avs { display: flex; margin: 8px 0; }
  .rc .pp { width: 58px; text-align: center; }
  .rc .pp .av { width: 30px; height: 30px; line-height: 30px; border-radius: 15px; font-size: 11px; }
  .rc .bc { display: inline-block; width: 220px; height: 34px; background: repeating-linear-gradient(90deg, #1c1c1e 0px, #1c1c1e 1px, transparent 1px, transparent 3px, #1c1c1e 3px, #1c1c1e 6px, transparent 6px, transparent 7px, #1c1c1e 7px, #1c1c1e 8px, transparent 8px, transparent 11px); }
  .lc-dark .rc .bc { background: repeating-linear-gradient(90deg, #e5e5ea 0px, #e5e5ea 1px, transparent 1px, transparent 3px, #e5e5ea 3px, #e5e5ea 6px, transparent 6px, transparent 7px, #e5e5ea 7px, #e5e5ea 8px, transparent 8px, transparent 11px); }
  .rc .zig { height: 10px; background-image: linear-gradient(135deg, transparent 50%, rgba(127,127,127,0.18) 50%), linear-gradient(225deg, transparent 50%, rgba(127,127,127,0.18) 50%); background-size: 10px 10px; }
</style>
<div class="card rc"><div class="pad"><b>NORTHWIND OUTFITTERS</b><div class="small muted">Order #NW-58214 · 10 items · total €310.53 · Visa ···· 4242</div></div></div>
<script>
const ITEMS = [
  { q: 1, name: 'Trailhead Rain Jacket', sub: 'Forest · M', sku: 'TRJ-FOR-M', unit: 129, icon: 'cloud-rain-fill', tint: '2d6a4f', note: '20,000 mm waterproof 3-layer shell' },
  { q: 1, name: 'Dune Daypack 22L', sub: 'Sand · one size · −30%', sku: 'DDP-SND-22', unit: 62.3, icon: 'bag-fill', tint: 'e07b39', note: 'Was €89.00 · recycled nylon' },
  { q: 2, name: 'Tide Water Bottle', sub: 'Ocean · 750 ml', sku: 'TWB-OCN-750', unit: 34, icon: 'drop-fill', tint: '2a5298', note: 'Insulated · cold 24 h, hot 12 h' },
  { q: 3, name: 'Merino Hiking Socks', sub: 'Charcoal · 39–42', sku: 'MHS-CHR-3942', unit: 15, icon: 'person-simple-walk', tint: '636366', note: '70% merino wool · cushioned heel' },
  { q: 1, name: 'Packable Sun Hat', sub: 'Natural · L', sku: 'PSH-NAT-L', unit: 29, icon: 'sun-fill', tint: 'ff9500', note: 'UPF 50+ · folds flat into a pocket' },
  { q: 1, name: 'Trail First-Aid Kit', sub: '42 pieces', sku: 'TFA-42', unit: 24.9, icon: 'first-aid-kit-fill', tint: 'ff3b30', note: 'Waterproof roll-top pouch' },
  { q: 1, name: 'Gift wrap', sub: 'Recycled kraft paper', sku: 'GFT-KRF', unit: 3.5, icon: 'gift-fill', tint: 'af52de', note: 'A service, so it can’t be returned', final: true },
];
const TIPS = [['No tip', 0], ['€2', 2], ['€5', 5], ['€10', 10]];
const PEOPLE = [['AM', '#007aff'], ['JK', '#af52de'], ['MR', '#30b0c7'], ['SL', '#ff9500'], ['TB', '#34c759'], ['NP', '#ff2d55']];
let open = -1, tip = 0, split = false, people = 2, requested = false;
const returned = new Set();
const shown = { sub: 0, disc: 0, coupon: 0, vat: 0, tip: 0, total: 0, per: 0, owed: 0, refund: 0, pts: 0 };
const knob = { x: 0 }, intro = { t: 0 }, pop = { total: 1, req: 1 };

const r2 = x => Math.round(x * 100) / 100;
function goods(skip) {
  const sub = r2(ITEMS.reduce((s, it, i) => s + (skip.has(i) ? 0 : it.q * it.unit), 0));
  const disc = r2(sub * 0.1), coupon = sub - disc >= 15 ? 15 : 0;
  return { sub, disc, coupon, net: r2(sub - disc - coupon) };
}
const FULL = goods(new Set()).net;
function totals() {
  const g = goods(returned);
  const t = TIPS[tip][1];
  const total = r2(g.net + t);
  return { sub: g.sub, disc: g.disc, coupon: g.coupon, vat: r2(g.net * 19 / 119), tip: t, total,
           per: r2(total / people), owed: r2(total - total / people), refund: r2(FULL - g.net), pts: Math.floor(g.net) };
}
function retarget(ms) {
  tween(shown, totals(), ms || 650, ease.outCubic);
  pop.total = 1.14; tween(pop, { total: 1 }, 450, ease.outBack);
}

setTimeout(() => {
  tween(intro, { t: 1 }, 900, ease.linear);
  tween(shown, totals(), 900, ease.outCubic);
}, 250);

function onAction(name, value) {
  const i = Number(value);
  if (name === 'item') { transition('fade'); open = open === i ? -1 : i; }
  else if (name === 'ret') { transition('fade'); returned.has(i) ? returned.delete(i) : returned.add(i); retarget(); }
  else if (name === 'tip') { if (i === tip) return; if ((tip === 0) !== (i === 0)) transition('fade'); tip = i; retarget(); }
  else if (name === 'split') { transition('fade'); split = !split; requested = false; tween(knob, { x: split ? 1 : 0 }, 340, ease.outBack); retarget(400); }
  else if (name === 'ppl') { const n = clamp(people + i, 2, PEOPLE.length); if (n === people) return; transition('fade'); people = n; requested = false; retarget(450); }
  else if (name === 'request') { transition('fade'); requested = true; pop.req = 1.4; tween(pop, { req: 1 }, 450, ease.outBack); }
}

function detail(it, i) {
  const ret = returned.has(i);
  return `<div class="det">
    <div class="row" style="margin-bottom: 4px"><img src="icon:${it.icon}?size=26&color=${it.tint}"><div class="grow"><b>${esc(it.name)}</b><div class="tiny muted">${esc(it.note)}</div></div></div>
    <div class="kv"><span class="muted">SKU</span><span class="mono">${it.sku}</span></div>
    <div class="kv"><span class="muted">Unit price</span><span class="mono">${it.q} × ${it.unit.toFixed(2)}</span></div>
    <div class="kv"><span class="muted">Returns</span><span>${it.final ? 'Not returnable' : ret ? '<b class="t-orange">Return label emailed</b>' : 'Free until 6 Nov 2026'}</span></div>
    ${it.final ? '' : `<div class="right" style="margin-top: 6px"><button data-action="ret" data-value="${i}">${ret ? 'Cancel return' : '↩ Start a return'}</button></div>`}
  </div>`;
}

function splitHTML() {
  const avs = PEOPLE.slice(0, people).map(([ini, c], i) => `<div class="pp"><span class="av" style="background-color: ${c}">${ini}</span><div class="tiny ${i ? 'mono' : 'muted'}" style="margin-top: 3px">${i ? '€' + shown.per.toFixed(2) : 'You paid'}</div></div>`).join('');
  return `<div class="splitp">
    <div class="row"><span class="grow small">Split between <b>${people}</b> people</span><button data-action="ppl" data-value="-1">−</button><button data-action="ppl" data-value="1" style="margin-left: 4px">+</button></div>
    <div class="avs">${avs}</div>
    <div class="row small"><span class="grow muted">Each pays <b class="fg mono">€${shown.per.toFixed(2)}</b></span>${requested
      ? `<b class="t-green" style="font-size: ${(12 * pop.req).toFixed(1)}px">✓ ${people - 1} request${people > 2 ? 's' : ''} sent</b>`
      : `<button class="primary" data-action="request">Request €${shown.owed.toFixed(2)}</button>`}</div>
  </div>`;
}

function render() {
  const items = ITEMS.reduce((s, it, i) => s + (returned.has(i) ? 0 : it.q), 0);
  const rows = ITEMS.map((it, i) => {
    const e = intro.t >= 1 ? 1 : ease.outCubic(clamp((intro.t * 900 - i * 75) / 330, 0, 1));
    const ret = returned.has(i);
    const row = `<div class="li"><div class="lr${open === i ? ' open' : ''}" data-action="item" data-value="${i}" style="left: ${Math.round((1 - e) * 440)}px">
      <span class="q muted">${it.q}×</span>
      <div class="grow"><b class="${ret ? 'gone' : ''}">${esc(it.name)}</b>${ret ? ' <span class="badge orange">RETURN</span>' : ''}<div class="tiny muted">${esc(it.sub)}</div></div>
      <span class="p${ret ? ' gone' : ''}">${(it.q * it.unit).toFixed(2)}</span><span class="chev">${open === i ? '▾' : '›'}</span></div></div>`;
    return open === i ? row + detail(it, i) : row;
  }).join('');
  const m = (label, value, cls) => `<div class="m"><span>${label}</span><span class="p${cls ? ' ' + cls : ''}">${value}</span></div>`;
  const tips = TIPS.map(([l], i) => `<span class="tip${tip === i ? ' on' : ''}" data-action="tip" data-value="${i}">${l}</span>`).join('');
  return `<div class="card rc">
    <div class="logo"><img src="icon:mountains-fill?size=31&color=34c759"><div style="font-weight: 800; font-size: 16px; margin-top: 2px">NORTHWIND OUTFITTERS</div><div class="tiny muted">Order #NW-58214 · 7 Oct 2026, 14:07</div></div>
    <div class="pad" style="padding-top: 4px">
      <div class="dash"></div>
      <div class="tiny muted" style="padding: 0 6px 3px 6px">Tap an item for details or to start a return</div>
      ${rows}
      <div class="dash"></div>
      ${m(`Subtotal (${items} item${items === 1 ? '' : 's'})`, shown.sub.toFixed(2))}
      ${m('Member discount (10%)', '−' + shown.disc.toFixed(2), 't-green')}
      ${m('Coupon <code>TRAIL15</code>', '−' + shown.coupon.toFixed(2), 't-green')}
      ${m('Shipping · Express (1–2 days)', '0.00')}
      ${tip ? m('Courier tip', shown.tip.toFixed(2)) : ''}
      ${m('VAT 19% (included)', shown.vat.toFixed(2))}
      <div class="tot"><span>Total</span><span class="p" style="font-size: ${(16 * pop.total).toFixed(1)}px">€${shown.total.toFixed(2)}</span></div>
      ${returned.size ? m('Refund to Visa ···· 4242', '+' + shown.refund.toFixed(2), 't-green') : ''}
      <div class="dash"></div>
      <div class="opt"><span class="grow">Tip your courier</span>${tips}</div>
      <div class="opt tap" data-action="split"><span class="grow">Split the bill</span><span class="tg" style="background-color: ${mix('rgba(120,120,128,0.32)', '#34c759', clamp(knob.x, 0, 1))}"><span class="kn" style="left: ${(2 + 16 * knob.x).toFixed(1)}px"></span></span></div>
      ${split ? splitHTML() : ''}
      <div class="dash"></div>
      ${m('Paid with', '<img src="icon:credit-card-fill?size=14&color=8e8e93"> Visa ···· 4242')}
      ${m('Ship to', 'Alex Morgan, Torstraße 12, Berlin')}
      ${m('Points earned', `+${Math.round(shown.pts)} ✦`, 't-orange')}
      <div class="center" style="margin-top: 12px"><div class="bc"></div><div class="tiny muted" style="font-family: ui-monospace">NW58214 2026 1007 1407</div></div>
      <div class="center small" style="margin-top: 8px">Thank you for shopping sustainably 🌱</div>
    </div>
    <div class="zig"></div>
  </div>`;
}
</script>

--- shop 14:08 bare
<style>
  .tr { width: 460px; max-width: 100%; }
  .tr .pref { display: inline-block; margin-top: 6px; padding: 2px 9px; border-radius: 9px; font-weight: 600; background-color: rgba(0,122,255,0.12); color: #007aff; }
  .tr .map { position: relative; height: 128px; margin: 10px 0 10px 0; overflow: hidden; border-radius: 12px; background-image: url(data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27360%27%20height=%27150%27%20viewBox=%270%200%20360%20150%27%3E%3Crect%20width=%27360%27%20height=%27150%27%20fill=%27%23f2efe9%27/%3E%3Crect%20x=%2730%27%20y=%2720%27%20width=%2790%27%20height=%2760%27%20rx=%2718%27%20fill=%27%23c8e6c9%27/%3E%3Cpath%20d=%27M0%20120C120%2080%20240%20150%20360%20100%27%20fill=%27none%27%20stroke=%27%23aad3df%27%20stroke-width=%2714%27/%3E%3Cpath%20d=%27M0%2060L360%2050M200%200L230%20150M90%200L140%20150M0%20140L360%2030%27%20fill=%27none%27%20stroke=%27%23ffffff%27%20stroke-width=%276%27/%3E%3Ccircle%20cx=%27207%27%20cy=%2751%27%20r=%2711%27%20fill=%27%23ff3b30%27/%3E%3Cpath%20d=%27M199%2056L207%2072L215%2056Z%27%20fill=%27%23ff3b30%27/%3E%3Ccircle%20cx=%27207%27%20cy=%2751%27%20r=%274%27%20fill=%27%23ffffff%27/%3E%3C/svg%3E); background-size: cover; background-position: center; }
  .tr .route { position: absolute; left: 0; top: 0; }
  .tr .mk { position: absolute; width: 28px; height: 28px; line-height: 28px; border-radius: 14px; text-align: center; }
  .tr .truck { background-color: #007aff; }
  .tr .halo { position: absolute; border-style: solid; border-width: 2px; }
  .tr .eta { position: absolute; left: 10px; bottom: 10px; padding: 3px 9px; border-radius: 9px; font-size: 11px; font-weight: 700; color: #ffffff; background-color: rgba(0,0,0,0.6); }
  .tr .lv { position: absolute; right: 10px; top: 10px; padding: 1px 8px; border-radius: 9px; font-size: 11px; font-weight: 800; color: #ffffff; background-color: #ff3b30; }
  .tr .steps { display: flex; }
  .tr .st { flex-grow: 1; flex-basis: 0; position: relative; padding: 4px 0; text-align: center; font-size: 11px; border-radius: 9px; }
  .tr .st:hover { background-color: rgba(127,127,127,0.10); }
  .tr .st.sel { background-color: rgba(0,122,255,0.10); }
  .tr .st .ln { position: absolute; top: 16px; left: 50%; width: 100%; height: 3px; background-color: rgba(127,127,127,0.2); z-index: 1; }
  .tr .st .ln div { height: 3px; }
  .tr .st .dot { position: relative; z-index: 2; width: 26px; height: 26px; line-height: 26px; margin: 0 auto 4px auto; border-radius: 13px; color: #ffffff; font-size: 12px; font-weight: 800; background-color: rgba(142,142,147,0.45); }
  .tr .det { display: flex; align-items: flex-start; margin-top: 8px; padding: 9px 10px; border-radius: 10px; background-color: rgba(127,127,127,0.10); font-size: 12.5px; }
  .tr .det img { margin: 1px 9px 0 0; }
  .tr .x { width: 20px; height: 20px; line-height: 20px; text-align: center; border-radius: 10px; color: #8e8e93; font-size: 11px; }
  .tr .x:hover { background-color: rgba(127,127,127,0.2); }
  .tr .ev { display: flex; padding: 7px 4px; border-top: 1px solid rgba(127,127,127,0.15); font-size: 13px; }
  .tr .ev .t { width: 96px; flex-shrink: 0; font-size: 12px; }
  .tr .ev img { margin-right: 8px; }
  .tr .more { padding: 6px 0 2px 0; text-align: center; font-size: 12px; font-weight: 600; color: #007aff; }
  .tr .more:hover { text-decoration: underline; }
  .tr .rate { margin-top: 6px; padding: 6px 10px; border-radius: 10px; background-color: rgba(255,159,10,0.10); }
  .tr .rate span.s { display: inline-block; width: 24px; height: 26px; line-height: 26px; text-align: center; }
  .tr .rate span.s:hover { color: #ff9f0a; }
  .tr .acts { margin-top: 10px; }
  .tr .acts button { margin-left: 6px; }
  .tr .acts button:first-child { margin-left: 0; }
  .tr button.liveon { background-color: rgba(255,59,48,0.14); color: #ff3b30; }
  .tr .opt { display: flex; align-items: center; padding: 9px 10px; margin-top: 6px; border-radius: 11px; border: 1px solid rgba(127,127,127,0.25); }
  .tr .opt:hover { background-color: rgba(127,127,127,0.08); }
  .tr .opt.on { border-color: #007aff; background-color: rgba(0,122,255,0.08); }
  .tr .opt img { margin-right: 10px; }
  .tr .radio { width: 18px; height: 18px; border-radius: 11px; border: 2px solid rgba(127,127,127,0.45); }
  .tr .opt.on .radio { border-color: #007aff; }
  .tr .rd { display: block; background-color: #007aff; }
  .tr .back { width: 64px; font-weight: 600; color: #007aff; }
  .tr .back:hover { text-decoration: underline; }
  .tr .spacer { width: 64px; }
</style>
<div class="card pad tr"><b>📦 Order #NW-58214</b> <span class="badge blue">OUT FOR DELIVERY</span><div class="small muted">DHL Express · arriving today, 16:00–18:00 · 14 stops before you</div></div>
<script>
const STAGES = [
  { name: 'Ordered', when: 'Yesterday 14:07', icon: 'seal-check-fill', text: 'Payment authorised · Visa ···· 4242 · €310.53' },
  { name: 'Packed', when: 'Yesterday 16:40', icon: 'package-fill', text: 'Packed by Mia at the Hamburg warehouse · 1 box · 2.4 kg' },
  { name: 'Shipped', when: 'Yesterday 17:02', icon: 'airplane', text: 'DHL Express JD014600006281 · via Leipzig/Halle hub' },
  { name: 'On the way', when: 'Today 08:12', icon: 'truck-fill', text: '' },
  { name: 'Delivered', when: '', icon: 'house-fill', text: '' },
];
const PREFS = [
  ['bell-fill', 'Hand it to me', 'Jonas rings the bell and waits'],
  ['users-fill', 'Leave with a neighbour', 'Jana Weber, 2nd floor'],
  ['house-fill', 'Leave at the door', 'Jonas takes a photo on delivery'],
  ['lock-fill', 'Parcel locker', 'Packstation 112, Torstraße 20'],
];
const DELIVERED = ['Handed to resident · signed “A. Morgan”', 'Handed to you · signed “A. Morgan”', 'Left with Jana Weber, 2nd floor', 'Left at your door · photo taken', 'In Packstation 112 · pickup code 4471'];
const MILESTONES = [
  { pos: 5, time: 'Today 13:05', title: '9 stops before you', sub: 'Arrival window narrowed', eta: '16:10–17:10' },
  { pos: 10, time: 'Today 15:20', title: '4 stops before you', sub: 'Jonas is on Invalidenstraße', eta: '16:15–16:45' },
  { pos: 14, time: 'Today 16:12', title: 'You’re next! 🚚', sub: 'Jonas is around the corner', eta: '16:15–16:25' },
  { pos: 15, time: 'Today 16:21', delivered: true },
];
const ROUTE = [[24, 104], [84, 104], [108, 74], [176, 74], [204, 42], [276, 42], [304, 88], [366, 88], [390, 58], [434, 58]];
const DONE_BEFORE = 6, BEFORE = 14, TOTAL = DONE_BEFORE + BEFORE + 1;
const SEG = ROUTE.slice(1).map((p, i) => Math.hypot(p[0] - ROUTE[i][0], p[1] - ROUTE[i][1]));
const LEN = SEG.reduce((a, b) => a + b, 0);

let evId = 0;
const ev = (time, icon, color, title, sub) => ({ id: ++evId, time, icon, color, title, sub });
const seed = () => [
  ev('Today 08:12', 'truck-fill', '007aff', 'Out for delivery', 'Berlin-Mitte depot · driver Jonas · 14 stops before you'),
  ev('Today 05:40', 'buildings-fill', '8e8e93', 'Arrived at local depot', 'Berlin-Mitte'),
  ev('Yesterday 22:15', 'airplane', '8e8e93', 'Departed hub', 'Leipzig/Halle (LEJ)'),
  ev('Yesterday 17:02', 'package', '8e8e93', 'Picked up by DHL', 'Northwind warehouse, Hamburg'),
  ev('Yesterday 14:07', 'seal-check-fill', '34c759', 'Order confirmed', 'Payment authorised'),
];

let pos, nextEv, delivered, events, eta, freshId, rating;
let sel = -1, showAll = false, page = 'main', pref = -1, pick = -1, live = false, liveTimer = 0, pulseRun = 0, routeKey = '', routeImg = '';
const prog = { v: 0 }, fx = { ring: -1, fresh: 0, home: 0, pref: 1, rate: 1, radio: 1 };
function reset() { pos = 0; nextEv = 0; delivered = false; events = seed(); eta = '16:00–18:00'; freshId = -1; rating = 0; fx.home = 0; }
reset();

const stopsLeft = () => Math.max(0, BEFORE - pos);
const goal = () => 3 + (DONE_BEFORE + pos) / TOTAL;
function along(f) {
  let d = f * LEN;
  const pts = [ROUTE[0]];
  for (let i = 0; i < SEG.length; i++) {
    if (d <= SEG[i]) { const k = SEG[i] ? d / SEG[i] : 0; pts.push([lerp(ROUTE[i][0], ROUTE[i + 1][0], k), lerp(ROUTE[i][1], ROUTE[i + 1][1], k)]); return pts; }
    d -= SEG[i];
    pts.push(ROUTE[i + 1]);
  }
  return pts;
}
const at = f => { const p = along(f); return p[p.length - 1]; };

function route(f) {
  const key = f.toFixed(3);
  if (key === routeKey) return routeImg;
  const line = p => p.map(q => q[0].toFixed(1) + ',' + q[1].toFixed(1)).join(' ');
  let dots = '';
  for (let k = 1; k < TOTAL; k++) if (k / TOTAL > f + 0.002) { const [x, y] = at(k / TOTAL); dots += `<circle cx='${x.toFixed(1)}' cy='${y.toFixed(1)}' r='3.5' fill='#ff9500' stroke='#ffffff' stroke-width='1.5'/>`; }
  const body = `<polyline points='${line(ROUTE)}' fill='none' stroke='#ffffff' stroke-opacity='0.9' stroke-width='9' stroke-linejoin='round' stroke-linecap='round'/>` +
    `<polyline points='${line(ROUTE)}' fill='none' stroke='#8e8e93' stroke-width='3' stroke-dasharray='1 6' stroke-linecap='round'/>` +
    `<polyline points='${line(along(f))}' fill='none' stroke='#007aff' stroke-width='5' stroke-linejoin='round' stroke-linecap='round'/>` +
    `<circle cx='${ROUTE[0][0]}' cy='${ROUTE[0][1]}' r='6' fill='#636366' stroke='#ffffff' stroke-width='2'/>` + dots;
  routeKey = key;
  routeImg = 'data:image/svg+xml;utf8,' + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='460' height='128' viewBox='0 0 460 128'>${body}</svg>`);
  return routeImg;
}

function pulse() {
  const me = ++pulseRun;
  animate(2850, (_, t) => { if (me === pulseRun) fx.ring = t >= 1 ? -1 : ease.outCubic((t * 3) % 1); }, ease.linear);
}

function arrive() {
  tween(prog, { v: goal() }, 900, ease.inOutCubic);
  setTimeout(pulse, 900);
}

function freshen() {
  events = events.slice(0, 12);
  freshId = events[0].id; fx.fresh = 1;
  tween(fx, { fresh: 0 }, 1800, ease.inQuad);
}

function reach(m) {
  if (m.delivered) {
    transition('pop');
    delivered = true;
    setLive(false);
    events.unshift(ev(m.time, 'check-circle-fill', '34c759', 'Delivered', DELIVERED[pref + 1]));
    fx.home = 0; tween(fx, { home: 1 }, 600, ease.outBack);
  } else {
    eta = m.eta;
    events.unshift(ev(m.time, 'truck-fill', '007aff', m.title, m.sub + ' · ETA ' + m.eta));
  }
  freshen();
}

function move() {
  tween(prog, { v: goal() }, 1000, ease.inOutCubic);
  const m = MILESTONES[nextEv];
  if (m && pos >= m.pos) { nextEv++; reach(m); }
  if (!delivered) pulse();
}

function setLive(on) {
  live = on;
  if (liveTimer) { clearInterval(liveTimer); liveTimer = 0; }
  if (on) liveTimer = setInterval(() => { if (delivered) return setLive(false); pos++; move(); }, 1400);
}

setTimeout(arrive, 250);

function onAction(name, value) {
  if (name === 'next') {
    if (delivered) {
      transition('fade');
      setLive(false); reset(); sel = -1; showAll = false;
      arrive();
      return;
    }
    pos = MILESTONES[nextEv].pos;
    move();
  } else if (name === 'live') setLive(!live);
  else if (name === 'stage') { const i = Number(value); transition('fade'); sel = sel === i ? -1 : i; }
  else if (name === 'all') { transition('fade'); showAll = !showAll; }
  else if (name === 'opts') { transition('slide-left'); page = 'opts'; pick = pref; }
  else if (name === 'pick') { pick = Number(value); fx.radio = 0.3; tween(fx, { radio: 1 }, 360, ease.outBack); }
  else if (name === 'back' || name === 'save') {
    transition('slide-right');
    page = 'main';
    if (name === 'save' && pick >= 0 && pick !== pref) {
      pref = pick;
      fx.pref = 1.3; tween(fx, { pref: 1 }, 450, ease.outBack);
      events.unshift(ev('Just now', 'pencil-circle-fill', 'af52de', 'Delivery instructions updated', PREFS[pref][1]));
      freshen();
    }
  } else if (name === 'rate') { rating = Number(value); fx.rate = 1.5; tween(fx, { rate: 1 }, 420, ease.outBack); }
}

function halo(x, y, base) {
  if (fx.ring < 0) return '';
  const s = base + 22 * fx.ring;
  return `<span class="halo" style="left: ${(x - s / 2 - 2).toFixed(1)}px; top: ${(y - s / 2 - 2).toFixed(1)}px; width: ${s.toFixed(1)}px; height: ${s.toFixed(1)}px; border-radius: ${(s / 2 + 2).toFixed(1)}px; border-color: ${alpha('#007aff', 0.7 * (1 - fx.ring))}"></span>`;
}

function optsHTML() {
  const opts = PREFS.map(([icon, title, subtitle], i) => {
    const on = pick === i, r = 10 * fx.radio;
    return `<div class="opt${on ? ' on' : ''}" data-action="pick" data-value="${i}"><img src="icon:${icon}?size=22&color=${on ? '007aff' : '8e8e93'}"><div class="grow"><b>${title}</b><div class="tiny muted">${subtitle}</div></div>
      <span class="radio">${on ? `<span class="rd" style="width: ${r.toFixed(1)}px; height: ${r.toFixed(1)}px; margin: ${(9 - r / 2).toFixed(1)}px; border-radius: ${(r / 2).toFixed(1)}px"></span>` : ''}</span></div>`;
  }).join('');
  return `<div class="card pad tr">
    <div class="row"><span class="back" data-action="back">‹ Back</span><b class="grow center" style="font-size: 15px">Delivery options</b><span class="spacer">&nbsp;</span></div>
    <div class="small muted center" style="margin: 2px 0 4px 0">${delivered ? 'Saved for your next deliveries' : 'Jonas sees your choice on his scanner'}</div>
    ${opts}
    <div class="row" style="margin-top: 10px"><span class="grow tiny muted">Order #NW-58214 · DHL Express</span><button class="primary" data-action="save">${pick >= 0 && pick !== pref ? 'Save' : 'Done'}</button></div>
  </div>`;
}

function render() {
  if (page === 'opts') return optsHTML();
  const f = clamp(prog.v - 3, 0, 1), [tx, ty] = at(f), [hx, hy] = ROUTE[ROUTE.length - 1], left = stopsLeft();
  const steps = STAGES.map((s, i) => {
    const done = delivered || prog.v >= i + 1;
    const now = !done && prog.v >= i - 0.001;
    const k = i >= 3 ? fx.home : ease.outBack(clamp((prog.v - i - 1) / 0.25, 0, 1));
    const dot = done ? `<div class="dot" style="background-color: #34c759; font-size: ${Math.max(1, 12 * k).toFixed(1)}px">✓</div>`
      : now ? `<div class="dot" style="background-color: #007aff">${i + 1}${halo(13, 13, 26)}</div>`
      : `<div class="dot">${i + 1}</div>`;
    const line = i < 4 ? `<div class="ln"><div style="width: ${(clamp(prog.v - i, 0, 1) * 100).toFixed(1)}%; background-color: ${i === 3 && !delivered ? '#007aff' : '#34c759'}"></div></div>` : '';
    const label = now ? `<b class="t-blue">${s.name}</b>` : done ? s.name : `<span class="muted">${s.name}</span>`;
    return `<div class="st${sel === i ? ' sel' : ''}" data-action="stage" data-value="${i}">${line}${dot}${label}</div>`;
  }).join('');
  let detail = '';
  if (sel >= 0) {
    const s = STAGES[sel];
    const text = sel === 3 ? `Driver Jonas · van B-NW 5821 · ${delivered ? 'route finished' : left + ' stop' + (left === 1 ? '' : 's') + ' before you'}`
      : sel === 4 ? (delivered ? DELIVERED[pref + 1] : `Expected today ${eta}` + (pref >= 0 ? ' · ' + PREFS[pref][1].toLowerCase() : ' · no signature needed'))
      : s.text;
    const when = sel === 4 ? (delivered ? 'Today 16:21' : 'Pending') : s.when;
    detail = `<div class="det"><img src="icon:${s.icon}?size=19&color=007aff"><div class="grow"><b>${s.name}</b> <span class="tiny muted">${when}</span><div class="small" style="margin-top: 2px">${esc(text)}</div></div><span class="x" data-action="stage" data-value="${sel}">✕</span></div>`;
  }
  const list = showAll ? events : events.slice(0, 3);
  const feed = list.map((e, i) => `<div class="ev"${e.id === freshId && fx.fresh > 0.01 ? ` style="background-color: ${alpha('#007aff', 0.18 * fx.fresh)}"` : ''}><span class="t muted">${e.time}</span><img src="icon:${e.icon}?size=18&color=${i === 0 ? e.color : '8e8e93'}"><div class="grow">${i === 0 ? `<b>${esc(e.title)}</b>` : esc(e.title)}<div class="tiny muted">${esc(e.sub)}</div></div></div>`).join('');
  const truck = delivered && f > 0.98 ? '' : `${delivered ? '' : halo(tx, ty, 28)}<span class="mk truck" style="left: ${(tx - 14).toFixed(1)}px; top: ${(ty - 14).toFixed(1)}px"><img src="icon:truck-fill?size=16&color=ffffff"></span>`;
  const homeSize = delivered ? 13 * Math.max(0.2, fx.home) : 13;
  const rate = delivered ? `<div class="rate row"><span class="grow small">${rating ? `Thanks! You rated Jonas <b>${rating}★</b>` : 'How was your delivery?'}</span>${[1, 2, 3, 4, 5].map(n => `<span class="s" data-action="rate" data-value="${n}" style="color: ${n <= rating ? '#ff9f0a' : 'rgba(142,142,147,0.6)'}; font-size: ${(n === rating ? 20 * fx.rate : 20).toFixed(1)}px">★</span>`).join('')}</div>` : '';
  return `<div class="card pad tr">
    <div class="row"><img src="icon:package-fill?size=24&color=34c759" style="margin-right: 8px"><b class="grow" style="font-size: 16px">Order #NW-58214</b><span class="badge ${delivered ? 'green' : 'blue'}">${delivered ? 'DELIVERED' : 'OUT FOR DELIVERY'}</span></div>
    <div class="small muted" style="margin-top: 2px">${delivered ? 'DHL Express · delivered <b class="fg">today, 16:21</b>' : `DHL Express · arriving <b class="fg">today, ${eta}</b>`}</div>
    ${pref >= 0 ? `<span class="pref" style="font-size: ${(12 * fx.pref).toFixed(1)}px">📦 ${PREFS[pref][1]}</span>` : ''}
    <div class="map">
      <img class="route" src="${route(f)}" width="460" height="128">
      <span class="mk" style="left: ${hx - 14}px; top: ${hy - 14}px; background-color: ${delivered ? '#34c759' : '#ffffff'}"><img src="icon:house-fill?size=${(homeSize * 1.2).toFixed(0)}&color=${delivered ? 'ffffff' : '34c759'}"></span>
      ${truck}
      <span class="eta">${delivered ? '✓ Delivered at 16:21' : `${left} stop${left === 1 ? '' : 's'} before you · ETA ${eta}`}</span>
      ${live ? '<span class="lv">● LIVE</span>' : ''}
    </div>
    <div class="steps">${steps}</div>
    ${detail}
    <div style="margin-top: 10px">${feed}</div>
    ${events.length > 3 ? `<div class="more" data-action="all">${showAll ? 'Show less' : `Show all ${events.length} updates`}</div>` : ''}
    ${rate}
    <div class="row acts"><button data-action="opts">Delivery options</button><span class="grow"></span>${delivered ? '' : `<button class="${live ? 'liveon' : ''}" data-action="live">${live ? '⏸ Pause' : '● Live'}</button>`}<button class="primary" data-action="next">${delivered ? '↻ Replay' : 'Next update ›'}</button></div>
  </div>`;
}
</script>

