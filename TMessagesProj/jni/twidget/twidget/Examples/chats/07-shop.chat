<style>
  .rv { width: 460px; max-width: 100%; }
  .rv .big { font-size: 44px; font-weight: 800; line-height: 1; }
  .rv .stars { position: relative; display: inline-block; white-space: nowrap; font-size: 15px; color: rgba(127,127,127,0.35); }
  .rv .stars div { position: absolute; left: 0; top: 0; overflow: hidden; white-space: nowrap; color: #ff9f0a; }
  .rv .hist { display: flex; align-items: center; font-size: 12px; padding: 2px 4px; border-radius: 6px; }
  .rv .hist:hover { background-color: rgba(127,127,127,0.10); }
  .rv .hist.on { background-color: rgba(255,159,10,0.16); }
  .rv .hist .lab { width: 26px; }
  .rv .hist .b { flex-grow: 1; height: 7px; border-radius: 4px; background-color: rgba(127,127,127,0.18); margin: 0 8px; }
  .rv .hist .b div { height: 7px; border-radius: 4px; }
  .rv .hist .n { width: 30px; text-align: right; }
  .rv .fit { margin-top: 10px; }
  .rv .trk { position: relative; height: 4px; margin: 6px 0 4px 0; border-radius: 2px; background-color: rgba(127,127,127,0.2); }
  .rv .mk { position: absolute; top: -4px; width: 12px; height: 12px; margin-left: -6px; border-radius: 6px; background-color: #ff9f0a; }
  .rv .ctl { margin-top: 12px; }
  .rv .seg { display: inline-block; padding: 2px; border-radius: 9px; white-space: nowrap; background-color: rgba(127,127,127,0.14); }
  .rv .seg span { display: inline-block; padding: 3px 9px; border-radius: 7px; font-size: 12px; font-weight: 600; }
  .rv .seg span:hover { background-color: rgba(127,127,127,0.18); }
  .rv .seg span.on { background-color: #ffffff; color: #1c1c1e; }
  .lc-dark .rv .seg span.on { background-color: #636366; color: #ffffff; }
  .rv .chip2 { display: inline-block; padding: 2px 9px; border-radius: 10px; font-size: 12px; font-weight: 700; background-color: rgba(255,159,10,0.18); color: #c76a00; }
  .lc-dark .rv .chip2 { color: #ffb340; }
  .rv .chip2:hover { background-color: rgba(255,159,10,0.3); }
  .rv .list { margin-top: 8px; }
  .rv .rw { overflow: hidden; }
  .rv .rev { position: relative; border-top: 1px solid rgba(127,127,127,0.18); padding: 10px 0 4px 0; }
  .rv .who2 { font-weight: 700; font-size: 13px; }
  .rv .rev p { font-size: 13px; margin: 4px 0 6px 0; }
  .rv .more { color: #007aff; font-weight: 600; }
  .rv .more:hover { text-decoration: underline; }
  .rv .help { font-size: 11px; }
  .rv .hb { display: inline-block; height: 18px; line-height: 18px; padding: 1px 9px; border-radius: 10px; font-size: 11px; background-color: rgba(127,127,127,0.12); }
  .rv .hb:hover { background-color: rgba(127,127,127,0.24); }
  .rv .hb.on { background-color: rgba(0,122,255,0.16); color: #007aff; }
  .rv .pg { margin-top: 8px; padding: 7px 0; text-align: center; border-radius: 9px; font-size: 12px; font-weight: 600; color: #007aff; background-color: rgba(0,122,255,0.08); }
  .rv .pg:hover { background-color: rgba(0,122,255,0.16); }
</style>
<div class="card pad rv"><b style="font-size: 18px">4.9 ★★★★★</b> <span class="small muted">218 reviews · Trailhead Rain Jacket</span><p class="small" style="margin: 6px 0 0 0">“Sideways rain, zero leaks.” — Julia K.</p></div>
<script>
const HIST = [[5, 192], [4, 19], [3, 4], [2, 2], [1, 1]], TOTAL = 218, AVG = 4.9, FIT = 0.66;
const R = [
  { who: 'Julia K.', ini: 'JK', col: '#af52de', stars: 5, days: 3, variant: 'Forest, M', helpful: 48, text: 'Wore it for a week in the Scottish Highlands. Sideways rain, zero leaks. The hood actually stays put in wind, which is rare. We walked from Fort William to Kinlochleven in one of the wettest Augusts on record and my base layer was dry every single evening. The pit zips are small, but the fabric breathes far better than my old 2-layer shell.' },
  { who: 'Marco R.', ini: 'MR', col: '#30b0c7', stars: 4, days: 12, variant: 'Tide, M', helpful: 31, text: 'Great jacket, runs slightly large. I’m usually an L and the M fits perfectly with a fleece underneath.' },
  { who: 'Sofia L.', ini: 'SL', col: '#ff9500', stars: 5, days: 20, variant: 'Dune, S', helpful: 22, text: 'Packs down to the size of a burrito 🌯 — lives in my daypack permanently now.' },
  { who: 'Henrik B.', ini: 'HB', col: '#5856d6', stars: 3, days: 6, variant: 'Forest, L', helpful: 17, text: 'Totally waterproof, no complaints there. On steep climbs it gets clammy though: I was soaked from the inside on a fast hike up Snowdon. Fine for walking in the rain, less so for running or anything high-output. Proper pit zips would fix it.' },
  { who: 'Aiko T.', ini: 'AT', col: '#ff2d55', stars: 5, days: 1, variant: 'Tide, S', helpful: 9, text: 'Third Northwind jacket I own. The Tide colour is even nicer in person.' },
  { who: 'Tom H.', ini: 'TH', col: '#34c759', stars: 4, days: 33, variant: 'Dune, XL', helpful: 14, text: 'Solid shell and a great hood. One star off because the hand pockets sit under a hip belt, so you can’t reach them with a pack on.' },
  { who: 'Dan P.', ini: 'DP', col: '#8e8e93', stars: 2, days: 45, variant: 'Forest, XL', helpful: 6, text: 'The zip started snagging after a month of daily commuting. Customer service sent a replacement within a week, which was great, but I expected better at this price. The new one has been fine so far, so maybe I was just unlucky with the first.' },
  { who: 'Lea W.', ini: 'LW', col: '#ff3b30', stars: 1, days: 58, variant: 'Dune, M', helpful: 3, text: 'Arrived in the wrong colour and the exchange took three weeks.' },
].map((r, id) => Object.assign(r, { id }));
const SORTS = [['helpful', 'Helpful'], ['newest', 'Newest'], ['critical', 'Critical']];
const BY = {
  helpful: (a, b) => b.helpful - a.helpful,
  newest: (a, b) => a.days - b.days,
  critical: (a, b) => a.stars - b.stars || b.helpful - a.helpful,
};
let filter = 0, sort = 'helpful', limit = 3;
const open = new Set(), voted = new Set();
const pops = R.map(() => ({ s: 1 }));
const intro = { t: 0 };
const ago = d => d === 1 ? 'yesterday' : d < 14 ? d + ' days ago' : d < 60 ? Math.round(d / 7) + ' weeks ago' : Math.round(d / 30) + ' months ago';
const stars = n => '★★★★★'.slice(0, n) + '☆☆☆☆☆'.slice(0, 5 - n);
const visible = () => R.filter(r => !filter || r.stars === filter).sort(BY[sort]);

setTimeout(() => tween(intro, { t: 1 }, 900, ease.linear), 250);

function onAction(name, value) {
  if (name === 'filter') { const s = Number(value); transition('fade'); filter = filter === s ? 0 : s; limit = 3; }
  else if (name === 'sort') { if (sort === value) return; transition('fade'); sort = value; limit = 3; }
  else if (name === 'more') { const id = Number(value); transition('fade'); if (open.has(id)) open.delete(id); else open.add(id); }
  else if (name === 'page') { transition('fade'); limit = visible().length > limit ? limit + 3 : 3; }
  else if (name === 'help') {
    const id = Number(value), was = voted.has(id);
    if (was) voted.delete(id); else voted.add(id);
    pops[id].s = was ? 0.7 : 1.7;
    tween(pops[id], { s: 1 }, 420, ease.outBack);
  }
}

function review(r, i) {
  const e = intro.t >= 1 ? 1 : ease.outCubic(clamp((intro.t * 900 - 300 - i * 110) / 320, 0, 1));
  const long = r.text.length > 150, isOpen = open.has(r.id);
  const text = long && !isOpen ? esc(r.text.slice(0, r.text.lastIndexOf(' ', 130))) + '… ' : esc(r.text) + ' ';
  const more = long ? `<span class="more" data-action="more" data-value="${r.id}">${isOpen ? 'Show less' : 'Read more'}</span>` : '';
  const on = voted.has(r.id);
  return `<div class="rw"><div class="rev" style="left: ${Math.round((1 - e) * 460)}px">
    <div class="row"><span class="av" style="background-color: ${r.col}; margin-right: 8px">${r.ini}</span><span class="who2 grow">${esc(r.who)} <span class="tiny muted">· ${ago(r.days)}</span></span><span class="t-orange small">${stars(r.stars)}</span></div>
    <p>${text}${more}</p>
    <div class="row"><span class="help muted grow">Verified purchase · ${esc(r.variant)}</span><span class="hb${on ? ' on' : ''}" data-action="help" data-value="${r.id}">👍 Helpful · <b style="font-size: ${(11 * pops[r.id].s).toFixed(1)}px">${r.helpful + (on ? 1 : 0)}</b></span></div>
  </div></div>`;
}

function render() {
  const k = ease.outCubic(intro.t);
  const hist = HIST.map(([s, n], i) => {
    const e = ease.outCubic(clamp((intro.t * 900 - i * 80) / 520, 0, 1));
    const w = Math.max(n / TOTAL * 100, 1.5) * e;
    return `<div class="hist${filter === s ? ' on' : ''}" data-action="filter" data-value="${s}"><span class="lab">${s}★</span><div class="b"><div style="width: ${w.toFixed(1)}%; background-color: ${filter && filter !== s ? 'rgba(255,159,10,0.35)' : '#ff9f0a'}"></div></div><span class="n muted">${Math.round(n * e)}</span></div>`;
  }).join('');
  const all = visible(), rest = all.length - limit;
  const list = all.slice(0, limit).map(review).join('');
  const segs = SORTS.map(([key, label]) => `<span class="${sort === key ? 'on' : ''}" data-action="sort" data-value="${key}">${label}</span>`).join('');
  const pager = rest > 0 ? `<div class="pg" data-action="page">Show ${Math.min(3, rest)} more · ${rest} left</div>` : limit > 3 ? '<div class="pg" data-action="page">Show fewer</div>' : '';
  return `<div class="card pad rv">
    <div class="row" style="align-items: flex-start">
      <div style="width: 120px; text-align: center; margin-right: 14px">
        <div class="big">${(AVG * k).toFixed(1)}</div>
        <div class="stars">★★★★★<div style="width: ${(AVG / 5 * 100 * k).toFixed(1)}%">★★★★★</div></div>
        <div class="tiny muted">${Math.round(TOTAL * k)} reviews</div>
      </div>
      <div class="grow">${hist}</div>
    </div>
    <div class="fit row"><span class="caps" style="width: 40px">Fit</span><div class="grow">
      <div class="trk"><div class="mk" style="left: ${(FIT * 100 * k).toFixed(1)}%"></div></div>
      <div class="row between tiny muted"><span>Runs small</span><span>True to size</span><span>Runs large</span></div></div></div>
    <div class="row ctl"><span class="grow small">${filter
      ? `<span class="chip2" data-action="filter" data-value="${filter}">${filter}★ only · ${all.length} ✕</span>`
      : '<span class="muted">Tap a bar to filter</span>'}</span><span class="seg">${segs}</span></div>
    <div class="list">${list || '<div class="small muted center" style="padding: 14px 0">No written reviews with that rating yet</div>'}</div>
    ${pager}
  </div>`;
}
</script>

