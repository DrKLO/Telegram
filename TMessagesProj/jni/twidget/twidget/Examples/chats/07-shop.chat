--- shop 14:12
<style>
  .cp { width: 380px; max-width: 100%; border: 2px dashed #34c759; border-radius: 16px; padding: 14px 16px; background-color: rgba(52,199,89,0.07); }
  .cp .ring { position: relative; width: 64px; height: 64px; flex-shrink: 0; margin-right: 14px; border-radius: 32px; }
  .cp .hole { position: absolute; left: 8px; top: 8px; width: 48px; height: 48px; line-height: 48px; border-radius: 24px; text-align: center; font-weight: 800; }
  .cp .code { position: relative; height: 42px; line-height: 42px; margin-top: 12px; overflow: hidden; border-radius: 10px; text-align: center; font-family: ui-monospace; font-weight: 800; border: 1px dashed rgba(52,199,89,0.6); background-color: rgba(52,199,89,0.10); }
  .cp .code.foil:hover { border-color: #34c759; border-style: solid; }
  .cp .cv { color: #248a3d; }
  .lc-dark .cp .cv { color: #30d158; }
  .cp .fb { position: absolute; width: 8.34%; height: 21px; }
  .cp .lab { position: absolute; left: 0; top: 0; width: 100%; height: 42px; line-height: 42px; text-align: center; font-family: -apple-system; font-size: 13px; font-weight: 700; }
  .cp .acts { display: flex; margin-top: 10px; }
  .cp .acts button { flex-grow: 1; flex-basis: 0; line-height: 20px; }
  .cp .acts button:first-child { margin-right: 8px; }
  .cp .acts button.ok { background-color: #34c759; color: #ffffff; }
  .cp .bagl { margin-top: 10px; padding: 8px 10px; border-radius: 10px; background-color: rgba(127,127,127,0.10); font-size: 13px; }
  .cp .old { text-decoration: line-through; }
  .cp .cd { font-family: ui-monospace; }
</style>
<div class="cp"><b>15% off your next trip</b><div class="small muted">Code <kbd>NEXTTRAIL</kbd> · expires 31 Dec · 3 of 4 orders to Gold ✦</div></div>
<script>
const CODE = 'NEXTTRAIL', COLS_N = 12, N = 24, BASE = 74, OFF = 0.15;
const EXPIRES = new Date(2026, 11, 31, 23, 59, 59).getTime();
const order = Array.from({ length: N }, (_, i) => [i, (i % COLS_N) + Math.random() * 4]).sort((a, b) => a[1] - b[1]).map(p => p[0]);
const foil = Array(N).fill(1);
let scratched = 0, taps = 0, revealed = false, copied = false, applied = false, copyRun = 0, now = Date.now();
const fx = { ring: 0, pct: 0, code: 1, price: BASE, save: 1, copy: 1, gold: 1 };
const pad = n => String(n).padStart(2, '0');
const r2 = x => Math.round(x * 100) / 100;

setTimeout(() => tween(fx, { ring: 0.75, pct: 15 }, 900, ease.outCubic), 250);
setInterval(() => { now = Date.now(); }, 1000);

function scratch() {
  if (revealed || scratched >= N) return;
  taps++;
  const take = taps >= 3 ? N - scratched : taps === 1 ? 10 : 9;
  const batch = order.slice(scratched, scratched + take);
  scratched += take;
  const last = scratched >= N;
  animate(560, (_, t) => {
    batch.forEach((b, j) => { foil[b] = Math.min(foil[b], 1 - ease.outQuad(clamp((t * 560 - j * 30) / 240, 0, 1))); });
    if (t >= 1 && last && !revealed) {
      transition('fade');
      revealed = true;
      fx.code = 1.4; tween(fx, { code: 1 }, 500, ease.outBack);
    }
  }, ease.linear);
}

function onAction(name) {
  if (name === 'scratch') return scratch();
  if (name === 'copy') {
    copyText(CODE);
    copied = true;
    fx.copy = 1.3; tween(fx, { copy: 1 }, 400, ease.outBack);
    const me = ++copyRun;
    setTimeout(() => { if (me === copyRun) copied = false; }, 1800);
  } else if (name === 'apply') {
    transition('fade');
    applied = !applied;
    tween(fx, { price: applied ? r2(BASE * (1 - OFF)) : BASE }, 900, ease.outCubic);
    tween(fx, { ring: applied ? 1 : 0.75 }, 800, ease.inOutCubic);
    if (applied) {
      fx.save = 0.2; tween(fx, { save: 1 }, 520, ease.outBack);
      fx.gold = 0.4; tween(fx, { gold: 1 }, 600, ease.outBack);
    }
  }
}

function render() {
  const left = Math.max(0, EXPIRES - now);
  const cd = left ? `${Math.floor(left / 86400000)}d ${pad(Math.floor(left / 3600000) % 24)}:${pad(Math.floor(left / 60000) % 60)}:${pad(Math.floor(left / 1000) % 60)}` : 'expired';
  const deg = fx.ring * 360, gold = applied && fx.ring > 0.995;
  const ring = deg < 0.5 ? 'background-color: rgba(127,127,127,0.2)' : `background: conic-gradient(${gold ? '#ff9f0a' : '#34c759'} ${deg.toFixed(1)}deg, rgba(127,127,127,0.2) ${deg.toFixed(1)}deg)`;
  const cover = foil.map((a, i) => a < 0.01 ? '' : `<span class="fb" style="left: ${((i % COLS_N) * 100 / COLS_N).toFixed(2)}%; top: ${Math.floor(i / COLS_N) * 21}px; background-color: rgba(${(i + Math.floor(i / COLS_N)) % 2 ? '170,170,176' : '188,188,194'},${a.toFixed(2)})"></span>`).join('');
  const rest = foil.reduce((s, a) => s + a, 0) / N;
  const label = rest > 0.05 ? `<span class="lab" style="color: rgba(60,60,67,${clamp(rest * 1.6 - 0.5, 0, 1).toFixed(2)})">${taps ? 'Keep scratching ✦' : '✦ Tap to scratch ✦'}</span>` : '';
  const after = revealed ? `<div class="acts">
      <button class="${copied ? 'ok' : ''}" data-action="copy" style="font-size: ${(14 * fx.copy).toFixed(1)}px">${copied ? '✓ Copied!' : 'Copy code'}</button>
      <button class="${applied ? '' : 'primary'}" data-action="apply">${applied ? 'Remove' : 'Apply to bag'}</button></div>
    <div class="bagl">
      <div class="row"><span class="grow">Saved bag <span class="muted">· socks ×3, sun hat</span></span>${applied ? `<span class="small muted old">€${BASE.toFixed(2)}</span>` : ''}<b style="margin-left: 6px">€${fx.price.toFixed(2)}</b></div>
      ${applied ? `<div class="row small" style="margin-top: 3px"><span class="grow t-green">${CODE} · 15% off</span><span class="badge green" style="font-size: ${(11 * fx.save).toFixed(1)}px">You save €${(BASE * OFF).toFixed(2)}</span></div>` : ''}
    </div>` : '<div class="tiny muted center" style="margin-top: 6px">Scratch the foil to reveal your code</div>';
  return `<div class="cp">
    <div class="row">
      <div class="ring" style="${ring}"><div class="hole card" style="font-size: ${gold ? (13 * fx.gold).toFixed(1) : 16}px">${gold ? 'GOLD' : Math.round(fx.pct) + '%'}</div></div>
      <div class="grow">
        <div class="caps t-green">Thanks for your order</div>
        <div style="font-size: 16px; font-weight: 800">15% off your next trip</div>
        <div class="small muted">${gold ? 'This order unlocks Gold ✦' : '3 of 4 orders to Gold ✦'}</div>
      </div>
    </div>
    <div class="code${revealed ? '' : ' foil'}"${revealed ? '' : ' data-action="scratch"'}><span class="cv" style="font-size: ${(20 * fx.code).toFixed(1)}px">${CODE}</span>${cover}${label}</div>
    ${after}
    <div class="row tiny muted" style="margin-top: 8px"><span class="grow">⏳ Expires 31 Dec</span><span class="cd">${cd}</span></div>
  </div>`;
}
</script>

