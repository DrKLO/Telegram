  .pd .tbar div { height: 3px; border-radius: 2px; background-color: #34c759; }
  .pd .bagp { margin-top: 10px; padding: 10px 12px; border-radius: 11px; background-color: rgba(127,127,127,0.10); }
  .pd .bl { display: flex; align-items: center; padding: 6px 0; border-bottom: 1px solid rgba(127,127,127,0.18); font-size: 13px; }
  .pd .swd { width: 12px; height: 12px; border-radius: 6px; margin-right: 8px; }
  .pd .rm { width: 22px; height: 22px; line-height: 22px; margin-left: 8px; border-radius: 11px; text-align: center; font-size: 11px; color: #8e8e93; }
  .pd .rm:hover { background-color: rgba(255,59,48,0.14); color: #ff3b30; }
  .pd .feats { margin-top: 12px; }
  .pd .fr { height: 21px; overflow: hidden; white-space: nowrap; font-size: 13px; }
