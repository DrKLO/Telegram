<div class="card pd"><div class="pad"><b style="font-size: 18px">Trailhead Rain Jacket · €129</b><div class="small muted">Forest, Tide or Dune · sizes S–XXL · free returns</div></div></div>
<script>
const COLS = [
  { id: 'green', name: 'Forest', hex: '#2d6a4f', photo: 'data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27200%27%20height=%27200%27%20viewBox=%270%200%20200%20200%27%3E%3Cdefs%3E%3ClinearGradient%20id=%27g%27%20x1=%270%27%20y1=%271%27%20x2=%270%27%20y2=%270%27%3E%3Cstop%20offset=%270%27%20stop-color=%27%23d4fc79%27/%3E%3Cstop%20offset=%270.5%27%20stop-color=%27%2396e6a1%27/%3E%3Cstop%20offset=%271%27%20stop-color=%27%233a7d44%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width=%27200%27%20height=%27200%27%20fill=%27url%28%23g%29%27/%3E%3Cpath%20d=%27M-10%20200L10%20130L30%20200Z%27%20fill=%27%232d6a4f%27/%3E%3Cpath%20d=%27M16%20200L36%2093L56%20200Z%27%20fill=%27%231e5631%27/%3E%3Cpath%20d=%27M42%20200L62%20106L82%20200Z%27%20fill=%27%232d6a4f%27/%3E%3Cpath%20d=%27M68%20200L88%20119L108%20200Z%27%20fill=%27%231e5631%27/%3E%3Cpath%20d=%27M94%20200L114%2082L134%20200Z%27%20fill=%27%232d6a4f%27/%3E%3Cpath%20d=%27M120%20200L140%2095L160%20200Z%27%20fill=%27%231e5631%27/%3E%3Cpath%20d=%27M146%20200L166%20108L186%20200Z%27%20fill=%27%232d6a4f%27/%3E%3Cpath%20d=%27M172%20200L192%20121L212%20200Z%27%20fill=%27%231e5631%27/%3E%3Cpath%20d=%27M198%20200L218%2084L238%20200Z%27%20fill=%27%232d6a4f%27/%3E%3C/svg%3E', where: 'Sintra, after the rain' },
  { id: 'blue', name: 'Tide', hex: '#2a5298', photo: 'data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27200%27%20height=%27200%27%20viewBox=%270%200%20200%20200%27%3E%3Cdefs%3E%3ClinearGradient%20id=%27g%27%20x1=%270%27%20y1=%271%27%20x2=%270%27%20y2=%270%27%3E%3Cstop%20offset=%270%27%20stop-color=%27%2389f7fe%27/%3E%3Cstop%20offset=%270.5%27%20stop-color=%27%2366a6ff%27/%3E%3Cstop%20offset=%271%27%20stop-color=%27%232a5298%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width=%27200%27%20height=%27200%27%20fill=%27url%28%23g%29%27/%3E%3Cpath%20d=%27M0%2070C10%2062%2030%2078%2040%2070C50%2062%2070%2078%2080%2070C90%2062%20110%2078%20120%2070C130%2062%20150%2078%20160%2070C170%2062%20190%2078%20200%2070M0%2094C10%2086%2030%20102%2040%2094C50%2086%2070%20102%2080%2094C90%2086%20110%20102%20120%2094C130%2086%20150%20102%20160%2094C170%2086%20190%20102%20200%2094M0%20118C10%20110%2030%20126%2040%20118C50%20110%2070%20126%2080%20118C90%20110%20110%20126%20120%20118C130%20110%20150%20126%20160%20118C170%20110%20190%20126%20200%20118M0%20142C10%20134%2030%20150%2040%20142C50%20134%2070%20150%2080%20142C90%20134%20110%20150%20120%20142C130%20134%20150%20150%20160%20142C170%20134%20190%20150%20200%20142M0%20166C10%20158%2030%20174%2040%20166C50%20158%2070%20174%2080%20166C90%20158%20110%20174%20120%20166C130%20158%20150%20174%20160%20166C170%20158%20190%20174%20200%20166M0%20190C10%20182%2030%20198%2040%20190C50%20182%2070%20198%2080%20190C90%20182%20110%20198%20120%20190C130%20182%20150%20198%20160%20190C170%20182%20190%20198%20200%20190%27%20fill=%27none%27%20stroke=%27%23ffffff%27%20stroke-opacity=%270.35%27%20stroke-width=%272%27/%3E%3C/svg%3E', where: 'Atlantic coast' },
  { id: 'sand', name: 'Dune', hex: '#e07b39', photo: 'data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27200%27%20height=%27200%27%20viewBox=%270%200%20200%20200%27%3E%3Cdefs%3E%3ClinearGradient%20id=%27g%27%20x1=%270%27%20y1=%271%27%20x2=%270%27%20y2=%270%27%3E%3Cstop%20offset=%270%27%20stop-color=%27%23ffe29f%27/%3E%3Cstop%20offset=%270.5%27%20stop-color=%27%23ffa99f%27/%3E%3Cstop%20offset=%271%27%20stop-color=%27%23ff719a%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width=%27200%27%20height=%27200%27%20fill=%27url%28%23g%29%27/%3E%3Cpath%20d=%27M0%20200V110C60%2070%20120%20140%20200%20100V200Z%27%20fill=%27%23f6a05c%27/%3E%3Cpath%20d=%27M0%20200V140C60%20100%20120%20170%20200%20138V200Z%27%20fill=%27%23e07b39%27/%3E%3Cpath%20d=%27M0%20200V170C60%20130%20120%20200%20200%20176V200Z%27%20fill=%27%23b85a26%27/%3E%3C/svg%3E', where: 'Comporta dunes' },
];
const SIZES = ['S', 'M', 'L', 'XL', 'XXL'];
const STOCK = { green: [6, 2, 9, 4, 0], blue: [0, 7, 3, 0, 1], sand: [5, 1, 0, 6, 0] };
const SLIDES = ['Studio', 'On location', 'Packs small'];
const FEATS = [
  ['drop-fill', '007aff', '20,000 mm waterproof, taped seams'],
  ['wind', '8e8e93', 'Breathable 3-layer shell'],
  ['leaf-fill', '34c759', '100% recycled face fabric'],
  ['scales-fill', 'af52de', 'Packs into its own pocket · 310 g'],
];
const PRICE = 129, FREE_SHIP = 150, MAX_QTY = 5;

let col = 0, size = 1, qty = 1, slide = 0, nextId = 1, bag = [], toast = null, toastRun = 0, bagOpen = false, placed = null;
let fromHex = COLS[0].hex, prevPhoto = COLS[0].photo;
const notify = {};
const paint = { k: 1 }, car = { x: 0 }, price = { v: 0 }, sub = { v: 0, ship: 0 }, life = { toast: 0 };
const pop = { price: 1, bag: 1, qty: 1, size: 1, notify: 1 };
const intro = { drop: 0, rows: 0 };

const hex = c => { const m = /\(([^)]*)\)/.exec(c); return m ? '#' + m[1].split(',').slice(0, 3).map(n => Math.round(Number(n)).toString(16).padStart(2, '0')).join('') : c; };
const shade = (c, t) => hex(mix(c, '#000000', t));
const tint = (c, t) => hex(mix(c, '#ffffff', t));
const tone = () => paint.k >= 1 ? COLS[col].hex : hex(mix(fromHex, COLS[col].hex, paint.k));
const svg = (w, body) => 'data:image/svg+xml;utf8,' + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='${w}' height='${w}' viewBox='0 0 200 200'>${body}</svg>`);
const memo = fn => { const cache = new Map(); return c => { if (!cache.has(c)) { if (cache.size > 64) cache.clear(); cache.set(c, fn(c)); } return cache.get(c); }; };
const stock = () => STOCK[COLS[col].id][size];
const maxQty = () => Math.min(MAX_QTY, stock());
const count = () => bag.reduce((s, l) => s + l.qty, 0);

const jacket = memo(c => {
  const d = shade(c, 0.28), l = tint(c, 0.16), z = shade(c, 0.55);
  return svg(176, `<ellipse cx='100' cy='191' rx='62' ry='6' fill='#000000' fill-opacity='0.13'/>
    <path d='M66 50 C50 54 40 62 36 76 L22 146 C21 152 25 156 31 156 L41 156 C45 156 48 153 49 149 L60 100 Z' fill='${d}'/>
    <path d='M134 50 C150 54 160 62 164 76 L178 146 C179 152 175 156 169 156 L159 156 C155 156 152 153 151 149 L140 100 Z' fill='${d}'/>
    <rect x='22' y='146' width='27' height='10' rx='4' fill='${z}'/><rect x='151' y='146' width='27' height='10' rx='4' fill='${z}'/>
    <path d='M66 48 C80 42 120 42 134 48 L146 92 L148 174 C148 180 144 184 138 184 L62 184 C56 184 52 180 52 174 L54 92 Z' fill='${c}'/>
    <path d='M66 48 C80 42 100 42 100 42 L100 184 L62 184 C56 184 52 180 52 174 L54 92 Z' fill='${l}'/>
    <path d='M68 54 C66 30 80 14 100 14 C120 14 134 30 132 54 C120 60 80 60 68 54 Z' fill='${d}'/>
    <path d='M80 52 C80 36 88 26 100 26 C112 26 120 36 120 52 C110 56 90 56 80 52 Z' fill='${z}'/>
    <path d='M100 57 L100 184' stroke='${z}' stroke-width='3'/>
    <rect x='97' y='62' width='6' height='13' rx='2' fill='#d1d1d6'/>
    <path d='M112 84 L132 80 M64 134 L84 141 M136 134 L116 141' stroke='${z}' stroke-width='3' stroke-linecap='round'/>
    <path d='M92 57 L90 76 M108 57 L110 76' stroke='#f2f2f7' stroke-width='2' stroke-linecap='round'/>
    <circle cx='90' cy='77' r='2.5' fill='#f2f2f7'/><circle cx='110' cy='77' r='2.5' fill='#f2f2f7'/>
    <circle cx='75' cy='82' r='4' fill='#ffffff' fill-opacity='0.75'/>`);
});

const pouch = memo(c => {
  const d = shade(c, 0.28), l = tint(c, 0.16), z = shade(c, 0.55);
  return svg(150, `<ellipse cx='100' cy='186' rx='52' ry='6' fill='#000000' fill-opacity='0.13'/>
    <path d='M60 72 C60 62 68 58 78 58 L122 58 C132 58 140 62 140 72 L146 166 C146 174 140 180 132 180 L68 180 C60 180 54 174 54 166 Z' fill='${c}'/>
    <path d='M60 72 C60 62 68 58 78 58 L100 58 L100 180 L68 180 C60 180 54 174 54 166 Z' fill='${l}'/>
    <rect x='58' y='58' width='84' height='14' rx='7' fill='${d}'/>
    <path d='M84 60 C84 40 116 40 116 60' stroke='${z}' stroke-width='3' fill='none'/>
    <rect x='94' y='36' width='12' height='14' rx='4' fill='#d1d1d6'/>
    <path d='M66 120 L134 120' stroke='${d}' stroke-width='2' stroke-dasharray='5 4'/>
    <circle cx='100' cy='146' r='9' fill='#ffffff' fill-opacity='0.75'/>`);
});

function bump(key, from, ms) { pop[key] = from; tween(pop, { [key]: 1 }, ms || 420, ease.outBack); }
function retarget() { tween(price, { v: PRICE * qty }, 450, ease.outCubic); bump('price', 1.18); }
function clampQty() { const m = Math.max(1, maxQty()); if (qty > m) { qty = m; retarget(); } }
function syncBag() { const total = count() * PRICE; tween(sub, { v: total, ship: Math.min(1, total / FREE_SHIP) }, 600, ease.outCubic); }

function showToast(line) {
  const me = ++toastRun;
  toast = line; life.toast = 1;
  animate(5000, (_, t) => {
    if (me !== toastRun) return;
    life.toast = 1 - t;
    if (t >= 1) { transition('fade'); toast = null; }
  }, ease.linear);
}

setTimeout(() => {
  tween(intro, { drop: 1 }, 750, ease.outBack);
  tween(intro, { rows: 1 }, 900, ease.linear);
  tween(price, { v: PRICE * qty }, 700, ease.outCubic);
}, 250);

function onAction(name, value) {
  const c = COLS[col];
  if (name === 'col') {
    const i = Number(value);
    if (i === col) return;
    fromHex = tone();
    if (paint.k > 0.5) prevPhoto = c.photo;
    col = i; paint.k = 0;
    tween(paint, { k: 1 }, 650, ease.inOutCubic);
    clampQty();
  } else if (name === 'size') {
    size = Number(value);
    bump('size', 1.3, 360);
    clampQty();
  } else if (name === 'qty') {
    const n = clamp(qty + Number(value), 1, Math.max(1, maxQty()));
    if (n === qty) return bump('qty', 0.75, 320);
    qty = n;
    bump('qty', 1.4, 380);
    retarget();
  } else if (name === 'slide') {
    slide = value === 'next' ? (slide + 1) % SLIDES.length : value === 'prev' ? (slide + SLIDES.length - 1) % SLIDES.length : Number(value);
    tween(car, { x: slide }, 480, ease.outCubic);
  } else if (name === 'add') {
    const left = stock();
    if (!left) return;
    const n = Math.min(qty, left);
    STOCK[c.id][size] -= n;
    const line = { id: nextId++, col, size, qty: n };
    bag.push(line);
    transition('fade');
    placed = null;
    showToast(line);
    bump('bag', 1.7, 480);
    clampQty();
    syncBag();
  } else if (name === 'undo' || name === 'remove') {
    const id = name === 'undo' ? (toast ? toast.id : -1) : Number(value);
    const line = bag.find(l => l.id === id);
    if (!line) return;
    bag = bag.filter(l => l !== line);
    STOCK[COLS[line.col].id][line.size] += line.qty;
    transition('fade');
    if (toast && toast.id === id) { toastRun++; toast = null; }
    bump('bag', 0.5);
    syncBag();
  } else if (name === 'notify') {
    const key = c.id + SIZES[size];
    notify[key] = !notify[key];
    bump('notify', 1.25, 380);
  } else if (name === 'bag') {
    transition('fade');
    bagOpen = !bagOpen;
    if (!bagOpen) placed = null;
  } else if (name === 'checkout') {
    if (!bag.length) return;
    transition('pop');
    placed = { items: count(), total: count() * PRICE };
    bag = []; toastRun++; toast = null;
    syncBag();
  } else if (name === 'done') {
    transition('fade');
    placed = null; bagOpen = false;
  }
}

function slideHTML(i, t) {
  if (i === 0) return `<div class="studio" style="background: linear-gradient(165deg, ${tint(t, 0.9)}, ${tint(t, 0.62)})"><img class="jk" src="${jacket(t)}" width="176" height="176" style="margin-top: ${Math.round(20 - 46 * (1 - intro.drop))}px"></div>`;
  if (i === 1) {
    const top = COLS[col].photo;
    if (paint.k >= 1 || prevPhoto === top) return `<div class="ph" style="background-image: url(${top})"></div>`;
    return `<div class="ph" style="background-image: url(${prevPhoto})"></div><div class="wipe" style="width: ${(paint.k * 100).toFixed(1)}%"><div class="ph" style="background-image: url(${top})"></div></div>`;
  }
  return `<div class="studio pk" style="background: linear-gradient(165deg, #f5f5f7, ${tint(t, 0.75)})"><img src="${pouch(t)}" width="150" height="150"><div class="pkt"><div class="big">310 g</div>Stuffs into its own<br>chest pocket</div></div>`;
}

function bagHTML(n) {
  if (placed) return `<div class="bagp center">
      <div style="font-size: 30px">🎉</div><b>Order placed</b>
      <div class="small muted">${placed.items} item${placed.items > 1 ? 's' : ''} · €${placed.total.toFixed(2)} · free express delivery</div>
      <button class="primary" data-action="done" style="margin-top: 8px">Done</button></div>`;
  const lines = bag.map(l => `<div class="bl"><span class="swd" style="background-color: ${COLS[l.col].hex}"></span><span class="grow">Rain Jacket <span class="muted">· ${COLS[l.col].name} · ${SIZES[l.size]}</span></span><span class="muted" style="margin-right: 10px">${l.qty} × €${PRICE}</span><b>€${l.qty * PRICE}</b><span class="rm" data-action="remove" data-value="${l.id}">✕</span></div>`).join('');
  const need = FREE_SHIP - sub.v;
  return `<div class="bagp">
    <div class="row between"><b>🛍 Your bag</b><span class="small muted">${n} item${n === 1 ? '' : 's'}</span></div>
    ${lines || '<div class="small muted" style="padding: 8px 0">Your bag is empty</div>'}
    <div class="small" style="margin-top: 8px">${need > 0.5 ? `Add <b>€${need.toFixed(0)}</b> more for free express shipping` : '✓ <b class="t-green">Free express shipping</b> unlocked'}</div>
    <div class="bar" style="margin: 5px 0 8px 0"><div style="width: ${(sub.ship * 100).toFixed(1)}%; background-color: ${sub.ship >= 0.999 ? '#34c759' : '#ff9500'}"></div></div>
    <div class="row"><span class="grow">Subtotal <b>€${sub.v.toFixed(2)}</b></span>${n ? '<button class="primary" data-action="checkout">Checkout</button>' : ''}</div>
  </div>`;
}

function render() {
  const c = COLS[col], t = tone(), st = stock(), sel = SIZES[size], n = count(), key = c.id + sel;
  const slides = SLIDES.map((_, i) => {
    const off = i - car.x;
    return Math.abs(off) < 0.999 ? `<div class="slide" style="left: ${(off * 100).toFixed(2)}%">${slideHTML(i, t)}</div>` : '';
  }).join('');
  const near = Math.round(car.x);
  const dots = SLIDES.map((_, i) => `<span class="dot" data-action="slide" data-value="${i}" style="width: ${(7 + 12 * Math.max(0, 1 - Math.abs(i - car.x))).toFixed(1)}px"></span>`).join('');
  const swatches = COLS.map((k, i) => `<span class="sw" data-action="col" data-value="${i}"${i === col ? ` style="border-color: ${t}"` : ''}><span style="background-color: ${k.hex}"></span></span>`).join('');
  const sizes = SIZES.map((s, i) => {
    const left = STOCK[c.id][i];
    const cls = 'size' + (i === size ? ' sel' : '') + (left === 0 ? ' out' : '');
    return `<span class="${cls}" data-action="size" data-value="${i}"><span style="transform: scale(${(i === size ? pop.size : 1).toFixed(3)})">${s}</span>${left > 0 && left <= 3 ? '<span class="lo"></span>' : ''}</span>`;
  }).join('');
  const stockLine = st === 0 ? `<span class="t-red">●</span> ${sel} is sold out in ${c.name}${notify[key] ? ' · we’ll email you when it’s back' : ''}`
    : st <= 3 ? `<span class="t-orange">●</span> Only <b>${st}</b> left in ${c.name} · ${sel}`
    : '<span class="t-green">●</span> In stock · ships in 1–2 days';
  const qtyHTML = `<div class="qty"><button class="${qty <= 1 ? 'dim' : ''}" data-action="qty" data-value="-1">−</button><span class="qn" style="transform: scale(${pop.qty.toFixed(3)})">${qty}</span><button class="${qty >= maxQty() ? 'dim' : ''}" data-action="qty" data-value="1">+</button></div>`;
  const buy = st === 0
    ? `<button class="grow addb${notify[key] ? ' ok' : ''}" data-action="notify" style="transform: scale(${pop.notify.toFixed(3)})">${notify[key] ? '✓ We’ll email you' : '🔔 Notify me when it’s back'}</button>`
    : `<button class="primary grow addb" data-action="add">Add to bag · €${Math.round(price.v)}</button>`;
  const toastHTML = toast ? `<div class="toast"><div class="row"><img src="icon:check-circle-fill?size=22&color=34c759" style="margin-right: 8px">
      <div class="grow"><b>Added to bag</b><div class="tiny muted">${COLS[toast.col].name} · ${SIZES[toast.size]} · ${toast.qty} × €${PRICE}</div></div>
      <button data-action="undo">Undo</button>${bagOpen ? '' : '<button data-action="bag" style="margin-left: 6px">View bag</button>'}</div>
      <div class="tbar"><div style="width: ${(life.toast * 100).toFixed(1)}%"></div></div></div>` : '';
  const feats = FEATS.map(([icon, tintHex, text], i) => {
    const e = ease.outCubic(clamp((intro.rows * 900 - 180 - i * 110) / 320, 0, 1));
    return `<div class="fr"><div style="left: ${Math.round((1 - e) * 440)}px"><img src="icon:${icon}?size=16&color=${tintHex}">${text}</div></div>`;
  }).join('');
  return `<div class="card pd">
    <div class="hero">${slides}
      <span class="badge ret" style="background-color: ${t}">FREE RETURNS</span>
      <span class="bagb" data-action="bag" style="transform: scale(${pop.bag.toFixed(3)})">🛍 ${n || ''}</span>
      <span class="nav l" data-action="slide" data-value="prev">‹</span><span class="nav r" data-action="slide" data-value="next">›</span>
      <span class="cap">${esc(near === 1 ? c.name + ' · ' + c.where : SLIDES[near])}</span><span class="dots">${dots}</span>
    </div>
    <div class="pad">
      <div class="row"><b class="grow" style="font-size: 18px">Trailhead Rain Jacket</b><b class="pr" style="transform: scale(${pop.price.toFixed(3)})">€${Math.round(price.v)}</b></div>
      <div class="row small muted" style="margin-top: 2px"><span class="grow"><span class="t-orange">★★★★★</span> 4.9 · 218 reviews</span><span>${qty > 1 ? `${qty} × €${PRICE}` : 'Free returns · 60 days'}</span></div>
      <div class="caps lbl">Colour: <span class="fg">${c.name}</span></div>
      <div class="opts">${swatches}</div>
      <div class="row lbl"><span class="caps grow">Size: <span class="fg">${sel}</span></span><span class="tiny muted">Runs large · between sizes, size down</span></div>
      <div class="opts">${sizes}</div>
      <div class="small stock">${stockLine}</div>
      <div class="row buy">${qtyHTML}${buy}</div>
      ${toastHTML}${bagOpen ? bagHTML(n) : ''}
      <div class="feats">${feats}</div>
    </div>
  </div>`;
}
</script>

