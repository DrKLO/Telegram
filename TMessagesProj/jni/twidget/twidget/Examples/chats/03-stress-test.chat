<style>
  .im { width: 340px; max-width: 100%; }
  .im .seg { display: flex; margin: 8px 0; padding: 2px; border-radius: 9px; background-color: rgba(127,127,127,0.12); }
  .im .seg span { flex-grow: 1; text-align: center; padding: 3px 0; border-radius: 7px; font-size: 12px; font-weight: 600; color: #8e8e93; }
  .im .seg span:hover { background-color: rgba(127,127,127,0.14); }
  .im .seg span.on { background-color: #007aff; color: #ffffff; }
  .im .frame { width: 340px; height: 180px; overflow: hidden; border-radius: 12px; background-color: rgba(127,127,127,0.10); }
  .im .strip { display: flex; width: 2380px; }
  .im .slot { width: 340px; height: 180px; }
  .im .pic { background-size: cover; background-position: center; margin-left: auto; margin-right: auto; }
  .im .cap { display: flex; align-items: center; margin: 6px 0 4px 0; font-size: 12px; }
  .im .nav { display: block; width: 26px; line-height: 22px; text-align: center; border-radius: 7px; font-weight: 700; background-color: rgba(127,127,127,0.14); }
  .im .nav:hover { background-color: rgba(127,127,127,0.28); }
  .im .thumbs { display: flex; align-items: center; justify-content: space-between; height: 52px; }
  .im .thumb { border-radius: 9px; background-size: cover; background-position: center; border: 2px solid rgba(0,0,0,0); }
  .im .thumb:hover { border-color: rgba(127,127,127,0.55); }
  .im .thumb.on { border-color: #007aff; }
  .im .ss { height: 3px; border-radius: 2px; margin-top: 3px; background-color: rgba(127,127,127,0.18); }
  .im .ss div { height: 3px; border-radius: 2px; background-color: #007aff; }
  .im .opts { display: flex; align-items: center; flex-wrap: wrap; margin: 4px 0; }
  .im .lbl { width: 54px; font-size: 10px; font-weight: 700; text-transform: uppercase; color: #8e8e93; }
  .im .o { padding: 2px 8px; margin-right: 4px; border-radius: 7px; font-size: 12px; background-color: rgba(127,127,127,0.12); }
  .im .o:hover { background-color: rgba(127,127,127,0.26); }
  .im .o.on { background-color: #007aff; color: #ffffff; }
  .im .big { height: 128px; text-align: center; border-radius: 12px; background-color: rgba(127,127,127,0.10); }
  .im .syms { display: flex; flex-wrap: wrap; margin: 8px 0 4px 0; }
  .im .sym { width: 30px; height: 30px; line-height: 30px; text-align: center; margin: 0 4px 4px 0; border-radius: 8px; border: 1px solid rgba(127,127,127,0.25); }
  .im .sym:hover { background-color: rgba(127,127,127,0.14); }
  .im .sym.on { background-color: rgba(0,122,255,0.16); border-color: #007aff; }
  .im .sw { width: 16px; height: 16px; margin-right: 7px; border-radius: 10px; border: 2px solid rgba(0,0,0,0); }
  .im .sw:hover { border-color: rgba(127,127,127,0.45); }
  .im .sw.on { border-color: rgba(127,127,127,0.95); }
  .im .url { font-family: ui-monospace; font-size: 10.5px; margin-top: 4px; }
</style>
