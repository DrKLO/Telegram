<div style="display: flex; justify-content: space-between; background-color: rgba(127,127,127,0.14); border-radius: 8px; padding: 4px; font-size: 11px; color: #ffffff">
  <div style="background-color: #ff2d55; padding: 4px 10px; border-radius: 5px">space-</div><div style="background-color: #ff9500; padding: 4px 10px; border-radius: 5px">between</div><div style="background-color: #34c759; padding: 4px 10px; border-radius: 5px">→</div>
</div>
<script>
const W = 320, H = 104, M = 3, LH = 18;
const COLORS = ['#ff2d55', '#ff9500', '#34c759', '#007aff', '#5856d6', '#af52de', '#30b0c7', '#ffb300', '#ff3b30'];
const WID = [56, 40, 68, 46, 52, 62, 44, 58, 50];
const HEI = [30, 46, 22, 38, 28, 42, 24, 34, 40];
const JUSTIFY = [['flex-start', 'start'], ['center', 'center'], ['flex-end', 'end'], ['space-between', 'between'], ['space-around', 'around'], ['space-evenly', 'evenly']];
const ALIGN = [['flex-start', 'start'], ['center', 'center'], ['flex-end', 'end'], ['stretch', 'stretch']];

let n = 5, s = { justify: 'space-between', align: 'center', wrap: false, grow: 0 };
let from = {}, to = {}, raw = 0, animating = true, easing = ease.outBounce, delay = 0.09, run = 0, changed = '';
const fx = { hl: 0, pop: 1 };

const growOf = (mode, i) => mode === 0 ? 0 : mode === 1 ? 1 : (i % 3 === 1 ? 2 : 1);

function layout(count, st) {
  const items = [];
  for (let i = 0; i < count; i++) items.push({ i, base: WID[i] + 2 * M, oh: st.align === 'stretch' ? null : HEI[i] + 2 * M, grow: growOf(st.grow, i) });
  const lines = [];
  let line = [], sum = 0;
  for (const it of items) {
    if (line.length && st.wrap && sum + it.base > W) { lines.push(line); line = []; sum = 0; }
    line.push(it); sum += it.base;
  }
  if (line.length) lines.push(line);
  for (const ln of lines) {
    const total = ln.reduce((a, it) => a + it.base, 0);
    ln.forEach(it => { it.main = it.base; });
    if (total < W) {
      const g = ln.reduce((a, it) => a + it.grow, 0);
      if (g > 0) ln.forEach(it => { if (it.grow) it.main = it.base + (W - total) * it.grow / g; });
    } else if (total > W) {
      const inner = ln.reduce((a, it) => a + it.base - 2 * M, 0);
      ln.forEach(it => { it.main = it.base + (W - total) * (it.base - 2 * M) / inner; });
    }
    ln.cross = Math.max(...ln.map(it => it.oh === null ? LH + 2 * M : it.oh));
  }
  const free = H - lines.reduce((a, ln) => a + ln.cross, 0);
  if (free > 0) lines.forEach(ln => { ln.cross += free / lines.length; });
  const rects = {};
  let y = 0;
  for (const ln of lines) {
    const freeMain = W - ln.reduce((a, it) => a + it.main, 0);
    let j = st.justify, pos = 0, before = 0, after = 0;
    if (j === 'space-between' && (ln.length === 1 || freeMain < 0)) j = 'flex-start';
    if ((j === 'space-around' || j === 'space-evenly') && (ln.length === 1 || freeMain < 0)) j = 'center';
    if (j === 'flex-end') pos = freeMain;
    else if (j === 'center') pos = freeMain / 2;
    else if (j === 'space-between') after = freeMain / (ln.length - 1);
    else if (j === 'space-around') before = after = freeMain / (ln.length * 2);
    else if (j === 'space-evenly') before = freeMain / (ln.length + 1);
    for (const it of ln) {
      pos += before;
      const oh = it.oh === null ? ln.cross : it.oh;
      const top = st.align === 'center' ? y + ln.cross / 2 - oh / 2 : st.align === 'flex-end' ? y + ln.cross - oh : y;
      rects[it.i] = { x: pos + M, y: top + M, w: it.main - 2 * M, h: oh - 2 * M, lh: st.align === 'stretch' ? LH : oh - 2 * M };
      pos += it.main + after;
    }
    y += ln.cross;
  }
  return rects;
}

const progress = i => {
  const ids = Object.keys(to).map(Number);
  const span = 1 - delay * Math.max(0, ids.length - 1);
  return easing(clamp((raw - delay * i) / Math.max(0.2, span), 0, 1));
};
function frame() {
  const out = {};
  for (const id of new Set([...Object.keys(from), ...Object.keys(to)].map(Number))) {
    const a = from[id], b = to[id], e = progress(id);
    out[id] = { x: lerp(a.x, b.x, e), y: lerp(a.y, b.y, e), w: Math.max(0, lerp(a.w, b.w, e)), h: Math.max(0, lerp(a.h, b.h, e)), lh: lerp(a.lh, b.lh, e) };
  }
  return out;
}

function play(ms) {
  const me = ++run;
  raw = 0; animating = true;
  animate(ms, (_, t) => {
    if (me !== run) return;
    raw = t;
    if (t >= 1) { animating = false; from = {}; to = {}; }
  }, ease.linear);
}

function morph(apply, curve = ease.outBack, stagger = 0.03) {
  const before = animating ? frame() : layout(n, s);
  apply();
  const after = layout(n, s);
  const dot = r => ({ x: r.x + r.w / 2, y: r.y + r.h / 2, w: 0, h: 0, lh: r.lh });
  from = {}; to = {};
  for (const id of new Set([...Object.keys(before), ...Object.keys(after)].map(Number))) {
    from[id] = before[id] || dot(after[id]);
    to[id] = after[id] || dot(before[id]);
  }
  easing = curve; delay = stagger;
  play(560);
}

(function intro() {
  to = layout(n, s);
  for (const id in to) from[id] = Object.assign({}, to[id], { y: to[id].y - 120 });
})();
setTimeout(() => play(900), 250);

function flash(key) { changed = key; fx.hl = 1; tween(fx, { hl: 0 }, 900, ease.inQuad); }

function onAction(name, value) {
  if (name === 'justify') { morph(() => { s.justify = value; }); flash('justify'); }
  else if (name === 'align') { morph(() => { s.align = value; }); flash('align'); }
  else if (name === 'wrap') { morph(() => { s.wrap = value === '1'; }); flash('wrap'); }
  else if (name === 'grow') { morph(() => { s.grow = Number(value); }); flash('grow'); }
  else if (name === 'count') {
    const next = clamp(n + Number(value), 1, WID.length);
    if (next === n) return;
    morph(() => { n = next; }, ease.outBack, 0.02);
    fx.pop = 1.5; tween(fx, { pop: 1 }, 380, ease.outBack);
