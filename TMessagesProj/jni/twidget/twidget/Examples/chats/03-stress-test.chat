0210%20126%27%20fill=%27none%27%20stroke=%27%2338d39f%27%20stroke-opacity=%270.31%27%20stroke-width=%2710%27/%3E%3Cpath%20d=%27M0.8%200a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M53.8%2029a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M106.8%2058a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M159.8%2087a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M12.8%206a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M65.8%2035a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M118.8%2064a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M171.8%2093a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M24.8%2012a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M77.8%2041a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M130.8%2070a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M183.8%2099a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M36.8%2018a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M89.8%2047a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M142.8%2076a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M195.8%20105a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M48.8%2024a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M101.8%2053a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M154.8%2082a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M7.8%201a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M60.8%2030a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M113.8%2059a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M166.8%2088a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M19.8%207a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M72.8%2036a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M125.8%2065a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M178.8%2094a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M31.8%2013a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M84.8%2042a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M137.8%2071a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M190.8%20100a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M43.8%2019a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M96.8%2048a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M149.8%2077a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M2.8%20106a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M55.8%2025a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M108.8%2054a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M161.8%2083a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M14.8%202a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6M67.8%2031a.8%20.8%200%201%200%200%201.6a.8%20.8%200%201%200%200-1.6%27%20fill=%27%23ffffff%27%20fill-opacity=%270.8%27/%3E%3Cpath%20d=%27M0%20200V165C70%20140%20130%20185%20200%20160V200Z%27%20fill=%27%23081322%27/%3E%3C/svg%3E', ocean: 'data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27200%27%20height=%27200%27%20viewBox=%270%200%20200%20200%27%3E%3Cdefs%3E%3ClinearGradient%20id=%27g%27%20x1=%270%27%20y1=%271%27%20x2=%270%27%20y2=%270%27%3E%3Cstop%20offset=%270%27%20stop-color=%27%2389f7fe%27/%3E%3Cstop%20offset=%270.5%27%20stop-color=%27%2366a6ff%27/%3E%3Cstop%20offset=%271%27%20stop-color=%27%232a5298%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width=%27200%27%20height=%27200%27%20fill=%27url%28%23g%29%27/%3E%3Cpath%20d=%27M0%2070C10%2062%2030%2078%2040%2070C50%2062%2070%2078%2080%2070C90%2062%20110%2078%20120%2070C130%2062%20150%2078%20160%2070C170%2062%20190%2078%20200%2070M0%2094C10%2086%2030%20102%2040%2094C50%2086%2070%20102%2080%2094C90%2086%20110%20102%20120%2094C130%2086%20150%20102%20160%2094C170%2086%20190%20102%20200%2094M0%20118C10%20110%2030%20126%2040%20118C50%20110%2070%20126%2080%20118C90%20110%20110%20126%20120%20118C130%20110%20150%20126%20160%20118C170%20110%20190%20126%20200%20118M0%20142C10%20134%2030%20150%2040%20142C50%20134%2070%20150%2080%20142C90%20134%20110%20150%20120%20142C130%20134%20150%20150%20160%20142C170%20134%20190%20150%20200%20142M0%20166C10%20158%2030%20174%2040%20166C50%20158%2070%20174%2080%20166C90%20158%20110%20174%20120%20166C130%20158%20150%20174%20160%20166C170%20158%20190%20174%20200%20166M0%20190C10%20182%2030%20198%2040%20190C50%20182%2070%20198%2080%20190C90%20182%20110%20198%20120%20190C130%20182%20150%20198%20160%20190C170%20182%20190%20198%20200%20190%27%20fill=%27none%27%20stroke=%27%23ffffff%27%20stroke-opacity=%270.35%27%20stroke-width=%272%27/%3E%3C/svg%3E', dunes: 'data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27200%27%20height=%27200%27%20viewBox=%270%200%20200%20200%27%3E%3Cdefs%3E%3ClinearGradient%20id=%27g%27%20x1=%270%27%20y1=%271%27%20x2=%270%27%20y2=%270%27%3E%3Cstop%20offset=%270%27%20stop-color=%27%23ffe29f%27/%3E%3Cstop%20offset=%270.5%27%20stop-color=%27%23ffa99f%27/%3E%3Cstop%20offset=%271%27%20stop-color=%27%23ff719a%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width=%27200%27%20height=%27200%27%20fill=%27url%28%23g%29%27/%3E%3Cpath%20d=%27M0%20200V110C60%2070%20120%20140%20200%20100V200Z%27%20fill=%27%23f6a05c%27/%3E%3Cpath%20d=%27M0%20200V140C60%20100%20120%20170%20200%20138V200Z%27%20fill=%27%23e07b39%27/%3E%3Cpath%20d=%27M0%20200V170C60%20130%20120%20200%20200%20176V200Z%27%20fill=%27%23b85a26%27/%3E%3C/svg%3E', forest: 'data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27200%27%20height=%27200%27%20viewBox=%270%200%20200%20200%27%3E%3Cdefs%3E%3ClinearGradient%20id=%27g%27%20x1=%270%27%20y1=%271%27%20x2=%270%27%20y2=%270%27%3E%3Cstop%20offset=%270%27%20stop-color=%27%23d4fc79%27/%3E%3Cstop%20offset=%270.5%27%20stop-color=%27%2396e6a1%27/%3E%3Cstop%20offset=%271%27%20stop-color=%27%233a7d44%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width=%27200%27%20height=%27200%27%20fill=%27url%28%23g%29%27/%3E%3Cpath%20d=%27M-10%20200L10%20130L30%20200Z%27%20fill=%27%232d6a4f%27/%3E%3Cpath%20d=%27M16%20200L36%2093L56%20200Z%27%20fill=%27%231e5631%27/%3E%3Cpath%20d=%27M42%20200L62%20106L82%20200Z%27%20fill=%27%232d6a4f%27/%3E%3Cpath%20d=%27M68%20200L88%20119L108%20200Z%27%20fill=%27%231e5631%27/%3E%3Cpath%20d=%27M94%20200L114%2082L134%20200Z%27%20fill=%27%232d6a4f%27/%3E%3Cpath%20d=%27M120%20200L140%2095L160%20200Z%27%20fill=%27%231e5631%27/%3E%3Cpath%20d=%27M146%20200L166%20108L186%20200Z%27%20fill=%27%232d6a4f%27/%3E%3Cpath%20d=%27M172%20200L192%20121L212%20200Z%27%20fill=%27%231e5631%27/%3E%3Cpath%20d=%27M198%20200L218%2084L238%20200Z%27%20fill=%27%232d6a4f%27/%3E%3C/svg%3E', map: 'data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27360%27%20height=%27150%27%20viewBox=%270%200%20360%20150%27%3E%3Crect%20width=%27360%27%20height=%27150%27%20fill=%27%23f2efe9%27/%3E%3Crect%20x=%2730%27%20y=%2720%27%20width=%2790%27%20height=%2760%27%20rx=%2718%27%20fill=%27%23c8e6c9%27/%3E%3Cpath%20d=%27M0%20120C120%2080%20240%20150%20360%20100%27%20fill=%27none%27%20stroke=%27%23aad3df%27%20stroke-width=%2714%27/%3E%3Cpath%20d=%27M0%2060L360%2050M200%200L230%20150M90%200L140%20150M0%20140L360%2030%27%20fill=%27none%27%20stroke=%27%23ffffff%27%20stroke-width=%276%27/%3E%3Ccircle%20cx=%27207%27%20cy=%2751%27%20r=%2711%27%20fill=%27%23ff3b30%27/%3E%3Cpath%20d=%27M199%2056L207%2072L215%2056Z%27%20fill=%27%23ff3b30%27/%3E%3Ccircle%20cx=%27207%27%20cy=%2751%27%20r=%274%27%20fill=%27%23ffffff%27/%3E%3C/svg%3E', logo: 'data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%2764%27%20height=%2764%27%20viewBox=%270%200%2064%2064%27%3E%3Cdefs%3E%3ClinearGradient%20id=%27g%27%20x1=%270%27%20y1=%271%27%20x2=%271%27%20y2=%270%27%3E%3Cstop%20offset=%270%27%20stop-color=%27%237f5af0%27/%3E%3Cstop%20offset=%271%27%20stop-color=%27%232cb67d%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width=%2764%27%20height=%2764%27%20rx=%2714%27%20fill=%27url%28%23g%29%27/%3E%3Cpath%20d=%27M24.5%2024.5L16%2032L24.5%2039.5M39.5%2024.5L48%2032L39.5%2039.5M35.5%2022L28.5%2042%27%20fill=%27none%27%20stroke=%27%23ffffff%27%20stroke-width=%273.6%27%20stroke-linecap=%27round%27%20stroke-linejoin=%27round%27/%3E%3C/svg%3E' };
const PICS = [
  { id: 'sunset', name: 'Sunset', size: '360×180' }, { id: 'aurora', name: 'Aurora', size: '200×200' },
  { id: 'ocean', name: 'Ocean', size: '200×200' }, { id: 'dunes', name: 'Dunes', size: '200×200' },
  { id: 'forest', name: 'Forest', size: '200×200' }, { id: 'map', name: 'Map', size: '360×150' },
  { id: 'logo', name: 'Logo', size: '64×64' },
];
const SHAPES = [['Cover', 340, 180, 12], ['Square', 180, 180, 16], ['Circle', 180, 180, 90], ['Pill', 340, 96, 48]];
const SYMBOLS = [
  ['cloud-sun', '5ac8fa'], ['flame', 'ff9500'], ['heart', 'ff2d55'], ['lightning', 'ffcc00'], ['leaf', '34c759'],
  ['drop', '007aff'], ['moon-stars', '5856d6'], ['rabbit', '8e8e93'], ['paper-plane-tilt', '30b0c7'], ['trophy', 'ffcc00'],
];
const SWATCHES = ['ff2d55', 'ff9500', 'ffcc00', '34c759', '30b0c7', '007aff', '5856d6', 'af52de', '8e8e93', '1c1c1e'];
const WEIGHTS = ['light', 'regular', 'bold', 'fill'];
const SLOT = 340, SLIDE_MS = 2200;

let tab = 0, idx = 1, shape = 0, sym = 2, color = 'ff2d55', weight = 'fill';
let show = false, showRun = 0, shown = 0;
const fx = { off: SLOT, w: 340, h: 180, r: 12, reveal: 0, pop: 1, ss: 0 };
const th = {};
PICS.forEach((_, i) => { th[i] = 0; });

setTimeout(() => {
  tween(fx, { reveal: 1 }, 700, ease.outCubic);
  PICS.forEach((_, i) => setTimeout(() => tween(th, { [i]: i === idx ? 46 : 38 }, 420, ease.outBack), 60 + i * 50));
}, 250);

function go(next) {
  idx = (next + PICS.length) % PICS.length;
  tween(fx, { off: idx * SLOT }, 520, ease.outCubic);
  PICS.forEach((_, i) => tween(th, { [i]: i === idx ? 46 : 38 }, 360, ease.outBack));
}

function stopShow() { show = false; showRun++; fx.ss = 0; }
function slide(me) {
  animate(SLIDE_MS, (p, t) => {
    if (me !== showRun) return;
    fx.ss = p;
    if (t < 1) return;
    go(idx + 1);
    if (++shown >= PICS.length) stopShow(); else slide(me);
  }, ease.linear);
}

function onAction(name, value) {
  if (name === 'tab') {
    const next = Number(value);
    if (next === tab) return;
    transition(next > tab ? 'slide-left' : 'slide-right');
    tab = next;
    stopShow();
    if (tab === 1) { fx.pop = 0.4; tween(fx, { pop: 1 }, 520, ease.outBack); }
    return;
  }
  if (name === 'show') {
    if (show) { stopShow(); return; }
    show = true; shown = 0;
    slide(++showRun);
    return;
  }
  if (name === 'go' || name === 'step' || name === 'shape') stopShow();
  if (name === 'go') go(Number(value));
  else if (name === 'step') go(idx + Number(value));
  else if (name === 'shape') {
    shape = Number(value);
    const [, w, h, r] = SHAPES[shape];
    tween(fx, { w, h, r }, 560, ease.outBack);
  } else {
    if (name === 'sym') sym = Number(value);
    else if (name === 'color') color = value;
    else if (name === 'weight') weight = value;
    else if (name === 'random') {
      sym = Math.floor(Math.random() * SYMBOLS.length);
      color = SWATCHES[Math.floor(Math.random() * SWATCHES.length)];
      weight = WEIGHTS[Math.floor(Math.random() * WEIGHTS.length)];
    }
    fx.pop = 0.55;
    tween(fx, { pop: 1 }, 480, ease.outBack);
  }
}

function photos() {
  const w = Math.max(1, fx.w), h = Math.max(1, fx.h), r = clamp(fx.r, 0, Math.min(w, h) / 2);
  const drop = (1 - fx.reveal) * 180;
  const slots = PICS.map(p => `<div class="slot"><div class="pic" style="width: ${w.toFixed(1)}px; height: ${h.toFixed(1)}px; border-radius: ${r.toFixed(1)}px; margin-top: ${((180 - h) / 2 + drop).toFixed(1)}px; background-image: url(${ART[p.id]})"></div></div>`).join('');
  const thumbs = PICS.map((p, i) => {
    const s = Math.max(0, th[i]);
    return s < 1 ? '<div style="width: 38px">&nbsp;</div>' : `<div class="thumb ${i === idx ? 'on' : ''}" style="width: ${s.toFixed(1)}px; height: ${s.toFixed(1)}px; background-image: url(${ART[p.id]})" data-action="go" data-value="${i}"></div>`;
  }).join('');
  const P = PICS[idx];
  return `<div class="frame"><div class="strip" style="margin-left: ${(-fx.off).toFixed(1)}px">${slots}</div></div>
    ${show ? `<div class="ss"><div style="width: ${(fx.ss * 100).toFixed(1)}%"></div></div>` : ''}
    <div class="cap"><span class="nav" data-action="step" data-value="-1">‹</span>
      <div class="grow center"><b>${P.name}</b> <span class="muted">· ${P.id}.svg · ${P.size}</span></div>
      <span class="nav" data-action="step" data-value="1">›</span></div>
    <div class="thumbs">${thumbs}</div>
    <div class="opts"><span class="lbl">Shape</span>${SHAPES.map((s, i) => `<span class="o ${i === shape ? 'on' : ''}" data-action="shape" data-value="${i}">${s[0]}</span>`).join('')}
      <span class="o ${show ? 'on' : ''}" style="margin-left: auto" data-action="show">${show ? '■ Stop' : '▶ Slideshow'}</span></div>`;
}

function symbols() {
  const [name] = SYMBOLS[sym];
  const query = `size=77&color=${color}&weight=${weight}`;
  const H = Math.max(4, 68 * fx.pop);
  const grid = SYMBOLS.map(([n, c], i) => `<div class="sym ${i === sym ? 'on' : ''}" data-action="sym" data-value="${i}"><img src="icon:${n}-fill?size=22&color=${c}" style="vertical-align: middle"></div>`).join('');
  const sw = SWATCHES.map(c => `<div class="sw ${c === color ? 'on' : ''}" style="background: #${c}" data-action="color" data-value="${c}"></div>`).join('');
  return `<div class="big"><img src="icon:${name}?${query}" style="height: ${H.toFixed(1)}px; margin-top: ${((128 - H) / 2).toFixed(1)}px"></div>
    <div class="url muted center">${esc(`icon:${name}?${query}`)}</div>
    <div class="syms">${grid}</div>
    <div class="opts"><span class="lbl">Colour</span>${sw}</div>
    <div class="opts"><span class="lbl">Weight</span>${WEIGHTS.map(w => `<span class="o ${w === weight ? 'on' : ''}" data-action="weight" data-value="${w}">${w}</span>`).join('')}
      <span class="o" style="margin-left: auto" data-action="random">🎲</span></div>`;
}

function render() {
  return `<div class="im">
    <div class="row between"><b>${tab === 0 ? '🖼 Gallery' : '✦ Icons'}</b><span class="small muted">${tab === 0 ? `${idx + 1} / ${PICS.length}` : `${SYMBOLS.length} icons`}</span></div>
    <div class="seg"><span class="${tab === 0 ? 'on' : ''}" data-action="tab" data-value="0">Images</span><span class="${tab === 1 ? 'on' : ''}" data-action="tab" data-value="1">Icons</span></div>
    ${tab === 0 ? photos() : symbols()}
  </div>`;
}
</script>

