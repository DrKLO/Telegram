<style>
  .tb { width: 350px; max-width: 100%; }
  .tb .grid { width: 100%; border-collapse: collapse; font-size: 12px; margin: 6px 0; }
  .tb .grid td, .tb .grid th { border: 1px solid #b0b0b8; padding: 3px 6px; }
  .lc-dark .tb .grid td, .lc-dark .tb .grid th { border-color: #4a4a50; }
  .tb .grid th { background-color: #5856d6; color: #ffffff; font-weight: 600; white-space: nowrap; }
  .tb .grid th.s:hover { background-color: #706ef0; }
  .tb .grid th.on { background-color: #3f3db8; }
  .tb .grid tr.odd td { background-color: rgba(88,86,214,0.10); }
  .tb .grid tr.r:hover td { background-color: rgba(88,86,214,0.20); }
  .tb .grid td.nm { white-space: nowrap; }
  .tb .grid td.nm:hover { color: #5856d6; }
  .tb .num { text-align: right; white-space: nowrap; }
  .tb .up { color: #248a3d; } .tb .down { color: #d70015; }
  .lc-dark .tb .up { color: #30d158; } .lc-dark .tb .down { color: #ff453a; }
  .tb .grid tr.det td { padding: 6px 8px 4px 8px; background-color: rgba(127,127,127,0.08); }
  .tb .pt { display: flex; align-items: center; height: 18px; font-size: 11.5px; }
  .tb .pn { display: block; width: 66px; }
  .tb .pb { width: 10px; flex-grow: 1; margin-right: 8px; }
  .tb .pb div { height: 4px; border-radius: 2px; margin: 1px 0; }
  .tb .b1 { background-color: rgba(127,127,127,0.45); } .tb .b2 { background-color: #5856d6; }
  .tb .pv { display: block; width: 96px; text-align: right; font-family: ui-monospace; font-size: 10.5px; }
  .tb .status { display: flex; align-items: center; height: 22px; font-size: 12px; }
  .tb .share { width: 48px; height: 6px; border-radius: 3px; margin: 0 6px 0 8px; background-color: rgba(127,127,127,0.22); }
  .tb .share div { height: 6px; border-radius: 3px; background-color: #007aff; }
  .tb .x { display: block; padding: 0 6px; border-radius: 6px; color: #8e8e93; }
  .tb .x:hover { background-color: rgba(127,127,127,0.16); }
</style>
<div class="tb"><p><b>Revenue by region</b> — rowspan, colspan</p>
<table class="grid">
  <tr><th rowspan="2">Region</th><th colspan="2">Q1</th><th colspan="2">Q2</th></tr>
  <tr><th>Revenue</th><th>Δ</th><th>Revenue</th><th>Δ</th></tr>
  <tr><td>EMEA</td><td>$1.20M</td><td>+4%</td><td>$1.31M</td><td>+9%</td></tr>
  <tr><td><b>Total</b></td><td><b>$4.43M</b></td><td>&nbsp;</td><td><b>$4.68M</b></td><td><b>+5.6%</b></td></tr>
</table></div>
<script>
const REGIONS = [
  { name: 'EMEA', q1: 1.20, d1: 4, q2: 1.31, d2: 9, parts: [['UK', 0.42, 0.45], ['Germany', 0.38, 0.43], ['France', 0.24, 0.26], ['Other', 0.16, 0.17]] },
  { name: 'Americas', q1: 2.04, d1: -2, q2: 2.10, d2: 3, parts: [['USA', 1.52, 1.58], ['Canada', 0.30, 0.29], ['Mexico', 0.22, 0.23]] },
  { name: 'APAC', q1: 0.88, d1: 12, q2: 0.97, d2: 10, parts: [['Japan', 0.36, 0.39], ['Australia', 0.24, 0.27], ['Singapore', 0.16, 0.18], ['India', 0.12, 0.13]] },
  { name: 'LATAM', q1: 0.31, d1: -8, q2: 0.30, d2: -3, parts: [['Brazil', 0.19, 0.18], ['Chile', 0.07, 0.07], ['Argentina', 0.05, 0.05]] },
];
const KEYS = ['name', 'q1', 'd1', 'q2', 'd2'];
const LABELS = ['Region', 'Q1 revenue', 'Q1 Δ', 'Q2 revenue', 'Q2 Δ'];
const T1 = REGIONS.reduce((s, r) => s + r.q1, 0), T2 = REGIONS.reduce((s, r) => s + r.q2, 0);
const GROWTH = (T2 / T1 - 1) * 100;

let order = REGIONS.map((_, i) => i), sortKey = null, sortDir = 1, sel = null, open = -1, moved = new Set();
const fx = { intro: 0, flash: 0, hl: 0, grow: 0, share: 0 };

const money = v => '$' + v.toFixed(2) + 'M';
const pct = (d, digits = 0) => (d > 0 ? '+' : d < 0 ? '−' : '') + Math.abs(d).toFixed(digits) + '%';

setTimeout(() => tween(fx, { intro: 1 }, 900, ease.linear), 250);

function onAction(name, value) {
  if (name === 'sort') {
    const key = KEYS[Number(value)];
    if (sortKey === key) sortDir = -sortDir; else { sortKey = key; sortDir = key === 'name' ? 1 : -1; }
    const prev = order.slice();
    order.sort((a, b) => {
      const A = REGIONS[a][key], B = REGIONS[b][key];
      return (typeof A === 'string' ? A.localeCompare(B) : A - B) * sortDir;
    });
    moved = new Set(order.filter((r, i) => prev[i] !== r));
    transition('fade');
    fx.flash = 1;
    tween(fx, { flash: 0 }, 1100, ease.inQuad);
  } else if (name === 'cell') {
    const [r, c] = value.split(':').map(Number);
    if (sel && sel.r === r && sel.c === c) { sel = null; return; }
    sel = { r, c };
    fx.hl = 0;
    tween(fx, { hl: 1 }, 320, ease.outCubic);
    const R = REGIONS[r], v = R[KEYS[c]];
    tween(fx, { share: c === 1 ? v / T1 : c === 3 ? v / T2 : Math.min(1, Math.abs(v) / 12) }, 600, ease.outBack);
  } else if (name === 'expand') {
    const r = Number(value);
    transition(open === r ? 'slide-up' : 'slide-down');
    open = open === r ? -1 : r;
    fx.grow = 0;
    if (open >= 0) tween(fx, { grow: 1 }, 750, ease.linear);
  } else if (name === 'clear') {
    sel = null;
  } else if (name === 'reset') {
    transition('slide-up');
    order = REGIONS.map((_, i) => i); sortKey = null; sortDir = 1; sel = null; open = -1; moved = new Set();
  }
}

function detail(R) {
  const max = Math.max(...R.parts.map(p => Math.max(p[1], p[2])));
  const lines = R.parts.map(([n, a, b], i) => {
    const g = ease.outCubic(clamp(fx.grow * 1.5 - i * 0.12, 0, 1));
    const d = Math.round((b / a - 1) * 100);
    return `<div class="pt"><span class="pn">${n}</span>
      <div class="pb"><div class="b1" style="width: ${(a / max * 100 * g).toFixed(1)}%"></div><div class="b2" style="width: ${(b / max * 100 * g).toFixed(1)}%"></div></div>
      <span class="pv">${money(b)} <span class="${d >= 0 ? 'up' : 'down'}">${pct(d)}</span></span></div>`;
  }).join('');
  return `<tr class="det"><td colspan="5">${lines}<div class="tiny muted" style="margin-top: 2px">grey Q1 · purple Q2 · top markets in ${R.name}</div></td></tr>`;
}

function render() {
  const k = pos => fx.intro >= 1 ? 1 : ease.outCubic(clamp(fx.intro * 1.4 - pos * 0.12, 0, 1));
  const tint = (ri, ci) => {
    if (!sel) return '';
    const a = ri === sel.r && ci === sel.c ? 0.32 : ri === sel.r || ci === sel.c ? 0.12 : 0;
    return a ? `background-color: rgba(0,122,255,${(a * fx.hl).toFixed(3)});` : '';
  };
  const arrow = i => sortKey === KEYS[i] ? (sortDir > 0 ? ' ▲' : ' ▼') : '';
  const th = (i, text, extra = '') => `<th class="s ${sortKey === KEYS[i] ? 'on' : ''}" ${extra} data-action="sort" data-value="${i}">${text}${arrow(i)}</th>`;
  const rows = order.map((ri, pos) => {
    const R = REGIONS[ri], kk = k(pos);
    const flash = moved.has(ri) && fx.flash > 0.01 ? `background-color: rgba(255,204,0,${(0.42 * fx.flash).toFixed(3)});` : '';
    const td = (ci, html, cls) => `<td class="${cls}" style="${tint(ri, ci) || flash}" data-action="cell" data-value="${ri}:${ci}">${html}</td>`;
    let out = `<tr class="r ${pos % 2 ? 'odd' : ''}">
      <td class="nm" style="${tint(ri, 0) || flash}" data-action="expand" data-value="${ri}">${open === ri ? '▾' : '▸'} ${R.name}</td>
      ${td(1, money(R.q1 * kk), 'num')}${td(2, pct(Math.round(R.d1 * kk)), 'num ' + (R.d1 >= 0 ? 'up' : 'down'))}
      ${td(3, money(R.q2 * kk), 'num')}${td(4, pct(Math.round(R.d2 * kk)), 'num ' + (R.d2 >= 0 ? 'up' : 'down'))}</tr>`;
    if (open === ri) out += detail(R);
    return out;
  }).join('');
  const kt = k(order.length);
  const tsel = c => sel && sel.c === c ? `style="background-color: rgba(0,122,255,${(0.12 * fx.hl).toFixed(3)})"` : '';
  let status = '<span class="muted">Sort by any header · click a cell · ▸ opens a region</span>';
  if (sel) {
    const R = REGIONS[sel.r], key = KEYS[sel.c], v = R[key];
    const isRev = sel.c === 1 || sel.c === 3;
    status = `<span><b>${R.name}</b> · ${LABELS[sel.c]} <b>${isRev ? money(v) : pct(v)}</b></span>
      <div class="share"><div style="width: ${(clamp(fx.share, 0, 1) * 100).toFixed(1)}%"></div></div>
      <span class="grow muted">${isRev ? (fx.share * 100).toFixed(1) + '% of total' : 'total ' + pct(GROWTH, 1)}</span>
      <span class="x" data-action="clear">✕</span>`;
  }
  return `<div class="tb">
    <div class="row between"><b>Revenue by region</b><span><span class="badge purple">rowspan</span> <span class="badge blue">colspan</span></span></div>
    <table class="grid">
      <tr>${th(0, 'Region', 'rowspan="2"')}<th colspan="2">Q1</th><th colspan="2">Q2</th></tr>
      <tr>${th(1, 'Revenue')}${th(2, 'Δ')}${th(3, 'Revenue')}${th(4, 'Δ')}</tr>
      ${rows}
      <tr><td><b>Total</b></td><td class="num" ${tsel(1)}><b>${money(T1 * kt)}</b></td><td ${tsel(2)}>&nbsp;</td>
        <td class="num" ${tsel(3)}><b>${money(T2 * kt)}</b></td><td class="num up" ${tsel(4)}><b>${pct(GROWTH * kt, 1)}</b></td></tr>
    </table>
    <div class="status">${status}</div>
    <div class="row between" style="margin-top: 2px"><span class="tiny muted">${sortKey ? 'Sorted by ' + LABELS[KEYS.indexOf(sortKey)] + (sortDir > 0 ? ', ascending' : ', descending') : 'Original order'}</span>
      <a class="small" href="#" data-action="reset">↺ Reset</a></div>
  </div>`;
}
</script>

