<style>[hidden]{display:none!important}
  .ty { width: 360px; max-width: 100%; }
  .ty .tabs { display: flex; margin: 8px 0 8px 0; padding: 2px; border-radius: 9px; background-color: rgba(127,127,127,0.12); }
  .ty .tab { display: block; flex-grow: 1; text-align: center; padding: 3px 0; border-radius: 7px; font-size: 12px; font-weight: 600; color: #8e8e93; }
  .ty .tab:hover { background-color: rgba(127,127,127,0.14); }
  .ty .tab.on { background-color: #007aff; color: #ffffff; }
  .ty .stage { display: flex; align-items: center; height: 120px; overflow: hidden; padding: 0 12px; border-radius: 12px; background-color: rgba(127,127,127,0.10); }
  .ty .meta { font-family: ui-monospace; font-size: 11px; margin: 5px 2px 6px 2px; }
  .ty .opts { display: flex; align-items: center; margin: 5px 0; }
  .ty .lbl { display: block; width: 56px; font-size: 10px; font-weight: 700; text-transform: uppercase; color: #8e8e93; }
  .ty .sl { position: relative; width: 288px; height: 30px; }
  .ty .trk { height: 3px; margin-top: 6px; border-radius: 2px; background-color: rgba(127,127,127,0.25); }
  .ty .trk div { height: 3px; border-radius: 2px; background-color: #007aff; }
  .ty .th { position: absolute; top: 1px; width: 9px; height: 9px; border-radius: 7px; border: 2px solid #ffffff; background-color: #007aff; }
  .ty .cells { display: flex; margin-top: 6px; }
  .ty .cells span { display: block; text-align: center; font-size: 10px; border-radius: 5px; color: #8e8e93; }
  .ty .cells span:hover { background-color: rgba(0,122,255,0.12); color: #007aff; }
  .ty .cells span.on { color: #007aff; font-weight: 700; }
  .ty .fams { display: flex; flex-wrap: wrap; width: 300px; }
  .ty .chip2 { display: block; padding: 2px 8px; margin: 0 4px 4px 0; border-radius: 8px; font-size: 12px; background-color: rgba(127,127,127,0.12); }
  .ty .chip2:hover { background-color: rgba(127,127,127,0.24); }
  .ty .chip2.on { background-color: rgba(0,122,255,0.16); color: #007aff; }
  .ty .row2 { display: flex; align-items: center; padding: 3px 6px; border-radius: 8px; }
  .ty .row2:hover { background-color: rgba(127,127,127,0.12); }
  .ty .row2.on { background-color: rgba(0,122,255,0.12); }
  .ty .tag { display: block; width: 92px; font-family: ui-monospace; font-size: 10.5px; color: #8e8e93; }
  .ty .clip { white-space: nowrap; overflow: hidden; width: 244px; }
</style>
<h1>Heading 1</h1>
<h2>Heading 2</h2>
<p><span style="font-size: 9px">9px</span> · <span style="font-size: 15px">15px</span> · <span style="font-size: 28px">28px</span> · <b>700</b> · <i>italic</i></p>
<script>
const FAMILIES = [
  { name: 'System', css: '-apple-system' }, { name: 'Rounded', css: 'ui-rounded' }, { name: 'New York', css: 'serif' },
  { name: 'Georgia', css: 'Georgia' }, { name: 'Avenir Next', css: "'Avenir Next'" }, { name: 'Helvetica Neue', css: "'Helvetica Neue'" },
  { name: 'Menlo', css: 'Menlo' }, { name: 'SF Mono', css: 'ui-monospace' },
];
const SIZES = [9, 12, 15, 17, 20, 28, 36];
const WEIGHTS = ['Thin', 'Ultralight', 'Light', 'Regular', 'Medium', 'Semibold', 'Bold', 'Heavy', 'Black'];
const SAMPLES = ['The quick brown fox', 'Sphinx of black quartz', 'Hamburgefonstiv', 'Aa Gg Qq 0123', 'Heading 1'];
const SCALE = [
  { tag: 'h1', size: 22, weight: 700 }, { tag: 'h2', size: 19, weight: 700 }, { tag: 'h3', size: 17, weight: 700 },
  { tag: 'h4', size: 15, weight: 700 }, { tag: 'body', size: 13, weight: 400 }, { tag: 'small', size: 12, weight: 400 },
  { tag: 'caption', size: 9, weight: 600 },
];
const TABS = ['Specimen', 'Scale', 'Weights'];
const TRACK = 288;

let tab = 0, fam = 0, sample = 0, italic = false, upper = false, under = false;
const v = { size: 9, weight: 100, wave: 1 };

const weightOf = w => clamp(Math.round(w / 100) * 100, 100, 900);
const px = s => Math.round(s * 2) / 2;
function setSize(s) { tween(v, { size: s }, 520, ease.outBack); }
function setWeight(w) { tween(v, { weight: w }, 480, ease.outCubic); }

setTimeout(() => { tween(v, { size: 28 }, 850, ease.outBack); tween(v, { weight: 700 }, 850, ease.inOutSine); }, 250);

function onAction(name, value) {
  if (name === 'tab') {
    const next = Number(value);
    if (next === tab) return;
    transition(next > tab ? 'slide-left' : 'slide-right');
    tab = next;
    v.wave = 0;
    tween(v, { wave: 1 }, 700, ease.outCubic);
  } else if (name === 'fam') {
    transition('fade');
    fam = Number(value);
  } else if (name === 'size') setSize(Number(value));
  else if (name === 'weight') setWeight(Number(value));
  else if (name === 'italic') italic = !italic;
  else if (name === 'upper') upper = !upper;
  else if (name === 'under') under = !under;
  else if (name === 'sample') { transition('slide-up'); sample = (sample + 1) % SAMPLES.length; }
  else if (name === 'pick') {
    const s = SCALE[Number(value)];
    transition('slide-right');
    tab = 0;
    setSize(s.size); setWeight(s.weight);
  } else if (name === 'pickw') {
    transition('slide-right');
    tab = 0;
    setWeight(Number(value));
  }
}

function slider(stops, value, action, label) {
  const cell = TRACK / stops.length;
  let k = 0;
  if (value <= stops[0]) k = 0;
  else if (value >= stops[stops.length - 1]) k = stops.length - 1;
  else for (let i = 0; i < stops.length - 1; i++)
    if (value >= stops[i] && value <= stops[i + 1]) { k = i + (value - stops[i]) / (stops[i + 1] - stops[i]); break; }
  const x = k * cell;
  const near = stops.reduce((b, s, i) => Math.abs(s - value) < Math.abs(stops[b] - value) ? i : b, 0);
  const cells = stops.map((s, i) => `<span class="${i === near ? 'on' : ''}" style="width: ${cell.toFixed(2)}px" data-action="${action}" data-value="${s}">${label(s)}</span>`).join('');
  return `<div class="sl">
    <div class="trk" style="margin-left: ${(cell / 2).toFixed(1)}px; width: ${(TRACK - cell).toFixed(1)}px"><div style="width: ${x.toFixed(1)}px"></div></div>
    <div class="th" style="left: ${(cell / 2 + x - 6.5).toFixed(1)}px"></div>
    <div class="cells">${cells}</div></div>`;
}

function specimen() {
  const F = FAMILIES[fam], w = weightOf(v.weight);
  const style = `font-family: ${F.css}; font-size: ${px(v.size)}px; font-weight: ${w}; line-height: 1.12;${italic ? ' font-style: italic;' : ''}${upper ? ' text-transform: uppercase;' : ''}${under ? ' text-decoration: underline;' : ''}`;
  const fams = FAMILIES.map((f, i) => `<span class="chip2 ${i === fam ? 'on' : ''}" style="font-family: ${f.css}" data-action="fam" data-value="${i}">${f.name}</span>`).join('');
  const tog = (key, on, text) => `<span class="chip2 ${on ? 'on' : ''}" data-action="${key}">${text}</span>`;
  return `<div class="stage"><div style="${style}">${esc(SAMPLES[sample])}</div></div>
    <div class="meta muted">${esc(F.name)} · ${Math.round(v.size)}px · ${w} ${WEIGHTS[w / 100 - 1]}${italic ? ' · italic' : ''}${upper ? ' · uppercase' : ''}</div>
    <div class="opts"><span class="lbl">Size</span>${slider(SIZES, v.size, 'size', s => s)}</div>
    <div class="opts"><span class="lbl">Weight</span>${slider([100, 200, 300, 400, 500, 600, 700, 800, 900], v.weight, 'weight', s => s)}</div>
    <div class="opts"><span class="lbl">Style</span>${tog('italic', italic, '<i>Italic</i>')}${tog('upper', upper, 'UPPER')}${tog('under', under, '<u>Underline</u>')}${tog('sample', false, '↻ Sample')}</div>
    <div class="opts" style="align-items: flex-start"><span class="lbl" style="padding-top: 3px">Family</span><div class="fams">${fams}</div></div>`;
}

function scale() {
  const F = FAMILIES[fam];
  return SCALE.map((s, i) => {
    const k = ease.outBack(clamp(v.wave * 1.5 - i * 0.07, 0, 1));
    const on = Math.round(v.size) === s.size && weightOf(v.weight) === s.weight;
    return `<div class="row2 ${on ? 'on' : ''}" data-action="pick" data-value="${i}"><span class="tag">${s.tag} · ${s.size}</span>
      <div class="clip" style="font-family: ${F.css}; font-size: ${Math.max(1, px(s.size * (0.4 + 0.6 * k)))}px; font-weight: ${s.weight}; line-height: ${Math.round(s.size * 1.3)}px">${esc(SAMPLES[sample])}</div></div>`;
  }).join('');
}

function weights() {
  const F = FAMILIES[fam];
  return WEIGHTS.map((n, i) => {
    const target = (i + 1) * 100;
    const k = clamp(v.wave * 1.6 - i * 0.07, 0, 1);
    const w = weightOf(100 + (target - 100) * k);
    const on = weightOf(v.weight) === target;
    return `<div class="row2 ${on ? 'on' : ''}" data-action="pickw" data-value="${target}"><span class="tag">${target} ${n}</span>
      <div class="clip" style="font-family: ${F.css}; font-size: 15px; font-weight: ${w}">${esc(SAMPLES[sample])}</div></div>`;
  }).join('');
}

function render() {
  const tabs = TABS.map((t, i) => `<span class="tab ${i === tab ? 'on' : ''}" data-action="tab" data-value="${i}">${t}</span>`).join('');
  return `<div class="ty">
    <div class="row between"><b>Aa Type specimen</b><span class="small muted">${esc(FAMILIES[fam].name)}</span></div>
    <div class="tabs">${tabs}</div>
    ${tab === 0 ? specimen() : tab === 1 ? scale() : weights()}
  </div>`;
}
</script>

