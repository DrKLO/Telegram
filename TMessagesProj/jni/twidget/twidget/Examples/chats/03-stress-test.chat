function render() {
  let boxes = '', stage;
  if (animating) {
    const r = frame();
    for (const id in r) {
      const b = r[id];
      if (b.w < 0.5 || b.h < 0.5) continue;
      boxes += `<div class="bx" style="position: absolute; left: ${b.x.toFixed(1)}px; top: ${b.y.toFixed(1)}px; width: ${b.w.toFixed(1)}px; height: ${b.h.toFixed(1)}px; line-height: ${Math.min(b.lh, b.h).toFixed(1)}px; background-color: ${COLORS[id]}">${Number(id) + 1}</div>`;
    }
    stage = `<div class="in" style="position: relative">${boxes}</div>`;
  } else {
    for (let i = 0; i < n; i++) {
      const g = growOf(s.grow, i);
      const size = s.align === 'stretch' ? `line-height: ${LH}px` : `height: ${HEI[i]}px; line-height: ${HEI[i]}px`;
      boxes += `<div class="bx" style="width: ${WID[i]}px; ${size}; margin: ${M}px;${g ? ` flex-grow: ${g};` : ''} background-color: ${COLORS[i]}">${i + 1}</div>`;
    }
    stage = `<div class="in" style="display: flex; justify-content: ${s.justify}; align-items: ${s.align}; flex-wrap: ${s.wrap ? 'wrap' : 'nowrap'}">${boxes}</div>`;
  }
  const hl = key => key === changed && fx.hl > 0.01 ? ` style="background-color: rgba(255,204,0,${(0.45 * fx.hl).toFixed(3)}); border-radius: 3px"` : '';
  const decl = (key, prop, val) => `<span${hl(key)}><span class="k">${prop}</span>: <span class="v">${val}</span>;</span>`;
  const growText = s.grow === 0 ? '0' : s.grow === 1 ? '1' : '1 | 2 | 1';
  const opts = (action, list, current) => list.map(([v, label]) => `<span class="o ${String(current) === v ? 'on' : ''}" data-action="${action}" data-value="${v}">${label}</span>`).join('');
  return `<div class="fx">
    <div class="row between"><b>Flexbox playground</b>
      <div class="cnt"><span class="b" data-action="count" data-value="-1">−</span><span class="n" style="font-size: ${Math.round(13 * fx.pop)}px">${n}</span><span class="b" data-action="count" data-value="1">+</span></div></div>
    <div class="stage">${stage}</div>
    <div class="code"><span class="k">display</span>: <span class="v">flex</span>; ${decl('justify', 'justify-content', s.justify)} ${decl('align', 'align-items', s.align)} ${decl('wrap', 'flex-wrap', s.wrap ? 'wrap' : 'nowrap')} ${decl('grow', 'flex-grow', growText)}</div>
    <div class="opts"><span class="lbl">Justify</span>${opts('justify', JUSTIFY, s.justify)}</div>
    <div class="opts"><span class="lbl">Align</span>${opts('align', ALIGN, s.align)}</div>
    <div class="opts"><span class="lbl">Wrap</span>${opts('wrap', [['0', 'nowrap'], ['1', 'wrap']], s.wrap ? '1' : '0')}<span class="lbl" style="width: auto; margin: 0 6px 0 10px">Grow</span>${opts('grow', [['0', '0'], ['1', 'all 1'], ['2', '1 · 2 · 1']], String(s.grow))}</div>
  </div>`;
}
</script>

