<script>
const P = '<span class="g">~/litechat</span> <span class="m">(feature/html-bubbles)</span> <span class="w">$</span> ';
const E = [];
const cmd = (text, make) => E.push({ cmd: text, make: !!make });
const out = (html, d, v, pct) => E.push({ html, d: d || 90, v: !!v, pct: pct || 0 });
const obj = (pct, kind, file, v) => out(`[${String(pct).padStart(3)}%] <span class="g">Building ${kind} object</span> ${file}`, 170, v, pct);
cmd('make dev', true);
out('<span class="dim">cmake -S . -B build -DCMAKE_BUILD_TYPE=Release</span>', 160);
