  ['AppKit', '0x000000018dd30f00', '-[NSView layoutSubtreeIfNeeded] + 112'],
  ['AppKit', '0x000000018dd2a8b4', '-[NSWindow(NSDisplayCycle) _layoutViewTree] + 108'],
  ['AppKit', '0x000000018dd2a670', '__NSWindowGetDisplayCycleObserverForLayout_block_invoke + 364'],
  ['AppKit', '0x000000018dd29f1c', 'NSDisplayCycleObserverInvoke + 168'],
  ['QuartzCore', '0x000000019153a4c0', 'CA::Transaction::run_commit_handlers(CATransactionPhase) + 120'],
  ['CoreFoundation', '0x000000018a2d2b70', '__CFRUNLOOP_IS_CALLING_OUT_TO_AN_OBSERVER_CALLBACK_FUNCTION__ + 36'],
  ['HIToolbox', '0x0000000195e5c8a8', 'RunCurrentEventLoopInMode + 292'],
  ['AppKit', '0x000000018dc6a2c4', '-[NSApplication run] + 476'],
  ['LiteChat', '0x00000001029e1a40', 'main + 132', 'main.m:14', 'return NSApplicationMain(argc, argv);'],
];
const APP = FR.map((f, i) => f[0] === 'LiteChat' ? i : -1).filter(i => i >= 0);
const PEOPLE = [['LP', 'Leo', '#34c759'], ['RS', 'Rin', '#ff9500'], ['MC', 'Maya', '#af52de'], ['ME', 'You', '#007aff']];
const EVENTS = [1, 0, 2, 1, 1, 3, 1, 0, 2, 1, 3, 2];
const TOTAL = EVENTS.reduce((a, b) => a + b, 0);
const NOISE = '0123456789abcdef_:<>[]';
const short = (s, n = 44) => s.length > n ? s.slice(0, n - 1) + '…' : s;
const raw = i => `0x1029e0000 + ${parseInt(FR[i][1], 16) - BASE}`;

let appOnly = true, open = -1, symbolicated = false, symRun = 0, symIdx = -1, symP = 0, symProg = 0;
let assignee = -1, picking = false, state = 'new', intro = 0;
const resolved = FR.map(f => f[0] !== 'LiteChat');
const sw = { k: 1 }, tone = { k: 0 }, pop = { s: 1 }, flashes = {};
setTimeout(() => animate(850, p => { intro = p; }, ease.outCubic), 250);

async function symbolicate() {
  if (symbolicated || symIdx >= 0) return;
  const me = ++symRun;
  const todo = APP.filter(i => !resolved[i]);
  for (let k = 0; k < todo.length; k++) {
    symIdx = todo[k];
    await animate(260, p => { if (me === symRun) { symP = p; symProg = (k + p) / todo.length; } }, ease.linear);
    if (me !== symRun) return;
    resolved[symIdx] = true;
    const f = flashes[symIdx] = { a: 1 };
    tween(f, { a: 0 }, 700, ease.inQuad);
  }
  symIdx = -1; symbolicated = true;
}

function onAction(name, v) {
  const i = Number(v);
  if (name === 'apponly') {
    transition(appOnly ? 'slide-down' : 'slide-up');
    appOnly = !appOnly;
    tween(sw, { k: appOnly ? 1 : 0 }, 300, ease.outBack);
  } else if (name === 'frame') {
    transition(open === i ? 'slide-up' : 'slide-down');
    open = open === i ? -1 : i;
  } else if (name === 'sym') {
    symbolicate();
  } else if (name === 'unsym') {
    if (!symbolicated) return;
    transition('fade');
    symbolicated = false; symRun++;
    for (const a of APP) resolved[a] = false;
  } else if (name === 'assign') {
    if (state === 'resolved') return;
    transition(picking ? 'slide-up' : 'slide-down');
    picking = !picking;
  } else if (name === 'who') {
    transition('fade');
    assignee = i; picking = false;
    if (state === 'new') state = 'assigned';
    pop.s = 0.4;
    tween(pop, { s: 1 }, 420, ease.outBack);
  } else if (name === 'resolve') {
    const resolving = state !== 'resolved';
    transition(resolving ? 'pop' : 'fade');
    state = resolving ? 'resolved' : assignee >= 0 ? 'assigned' : 'new';
    picking = false;
    tween(tone, { k: resolving ? 1 : 0 }, 650, ease.outCubic);
  }
}

function symText(i) {
  if (resolved[i]) return esc(short(FR[i][2]));
  if (i !== symIdx) return raw(i);
  const target = short(FR[i][2]), n = Math.floor(symP * target.length);
  let noise = '';
  for (let k = n; k < Math.min(target.length, n + 14); k++) noise += NOISE[Math.floor(Math.random() * NOISE.length)];
  return `${esc(target.slice(0, n))}<span style="color: #ff9500">${esc(noise)}</span>`;
}

function frameRow(i) {
  const f = FR[i], app = f[0] === 'LiteChat', fa = flashes[i] ? flashes[i].a : 0;
  const bg = fa > 0.01 ? ` style="background-color: ${alpha('#34c759', 0.3 * fa)}"` : '';
  let row = `<tr class="f ${open === i ? 'op' : ''}" data-action="frame" data-value="${i}"><td class="i"${bg}>${i}</td><td class="${app ? 'ours' : 'm'}"${bg}>${f[0]}</td><td${bg}>${symText(i)}</td></tr>`;
  if (open === i) {
    const where = !app ? `${f[0]} · system image · ${f[1]}`
      : resolved[i] ? `<b>${f[3]}</b> · ${f[1]}` : `${f[1]} · no debug symbols yet, symbolicate to see the file`;
    const src = app && resolved[i] ? `<pre class="src">${f[3].split(':')[1]} │ ${esc(f[4])}</pre>` : '';
    row += `<tr class="dt"><td>&nbsp;</td><td colspan="2"><div class="det"><div>${resolved[i] ? esc(f[2]) : raw(i)}</div><div class="muted" style="font-family: -apple-system; font-size: 11px">${where}</div>${src}</div></td></tr>`;
  }
  return row;
}

function render() {
  const k = clamp(intro, 0, 1), t = tone.k;
  const rows = [];
  for (let i = 0; i < FR.length; i++) {
    if (appOnly && FR[i][0] !== 'LiteChat') {
      if (i === 7) rows.push(`<tr class="hid" data-action="apponly"><td colspan="3">⋯ ${FR.length - APP.length} system frames hidden · show all</td></tr>`);
      continue;
    }
    rows.push(frameRow(i));
  }
  const maxE = Math.max(...EVENTS);
  const spark = EVENTS.map((e, i) => `<div style="height: ${Math.max(2, 18 * e / maxE * clamp(k * 1.6 - i * 0.05, 0, 1)).toFixed(1)}px; background-color: ${mix([255, 59, 48, 0.85], [52, 199, 89, 0.85], t)}"></div>`).join('');
  const badge = state === 'resolved' ? '<span class="badge green">RESOLVED</span>'
    : state === 'assigned' ? `<span class="badge orange" style="font-size: ${(11 * pop.s).toFixed(1)}px">ASSIGNED · ${PEOPLE[assignee][1]}</span>`
    : `<span class="badge red">NEW · ${Math.round(3 * k)} users</span>`;
  const unresolved = APP.filter(i => !resolved[i]).length;
  const symb = symIdx >= 0
    ? `<div class="symb"><div class="grow">Symbolicating with LiteChat.app.dSYM… ${APP.length - unresolved}/${APP.length}<div class="sbar"><div style="width: ${(symProg * 100).toFixed(1)}%"></div></div></div></div>`
    : symbolicated ? '<div class="symb ok"><span class="grow">✓ Symbolicated · LiteChat.app.dSYM · UUID 4F2A9C1E</span><span class="lnk" data-action="unsym">↺ Raw</span></div>'
    : `<div class="symb"><span class="grow">⚠ ${unresolved} app frames are not symbolicated</span><button data-action="sym">Symbolicate</button></div>`;
  const who = assignee >= 0 ? PEOPLE[assignee] : null;
  const assignBtn = state === 'resolved' ? '' : `<button data-action="assign" style="margin-right: 6px">${who ? `<span class="av" style="background-color: ${who[2]}; width: 18px; height: 18px; line-height: 18px; font-size: 8px; margin-right: 4px">${who[0]}</span>${who[1]} ▾` : '👤 Assign ▾'}</button>`;
  const pick = picking ? `<div class="pick">${PEOPLE.map((p, i) => `<span class="who" data-action="who" data-value="${i}"><span class="av" style="background-color: ${p[2]}">${p[0]}</span>${p[1]}</span>`).join('')}</div>` : '';
  return `<div class="card cr">
    <div class="crh" style="background-color: ${mix([255, 59, 48, 0.10], [52, 199, 89, 0.12], t)}; border-bottom-color: ${mix([255, 59, 48, 0.25], [52, 199, 89, 0.3], t)}">
      <div class="row"><img src="icon:${state === 'resolved' ? 'seal-check-fill?size=22&color=34c759' : 'x-circle-fill?size=22&color=ff3b30'}" style="margin-right: 8px"><b class="grow" style="font-size: 14px">Crash in nightly 0.2.0 (318)</b>${badge}</div>
      <div class="small" style="margin-top: 4px"><code>EXC_BAD_ACCESS (SIGSEGV)</code> at <code>0x18</code> · Thread 0</div>
      <div class="row" style="margin-top: 6px"><div class="spark">${spark}</div><span class="tiny muted">${Math.round(TOTAL * k)} events in 12 h · last seen 4 min ago</span></div>
    </div>
    <div class="pad" style="padding-bottom: 2px">
      <div class="small"><b>Likely cause:</b> a bubble's <code>LHDocument</code> was laid out after its container was destroyed during a conversation switch; the document holds a <i>raw</i> pointer to its container.</div>
      <div class="small muted" style="margin-top: 4px">Fix: destroy the document before the container (<code>_doc.reset()</code> in <code>-dealloc</code>), already on main in a1b2c3d.</div>
    </div>
    <div class="fbar"><span class="caps grow">Thread 0 · ${FR.length} frames</span><span class="tgl" data-action="apponly"><span class="sw" style="background-color: ${mix([127, 127, 127, 0.35], [52, 199, 89, 1], clamp(sw.k, 0, 1))}"><div class="knob" style="margin-left: ${(2 + 14 * clamp(sw.k, -0.1, 1.1)).toFixed(1)}px"></div></span>App frames only</span></div>
    ${symb}
    <div style="padding: 0 8px 6px 8px"><table class="st2">${rows.join('')}</table></div>
    ${pick}
    <div class="acts">${assignBtn}<button class="${state === 'resolved' ? '' : 'done'}" data-action="resolve">${state === 'resolved' ? '↺ Reopen' : '✓ Resolve'}</button><span class="grow"></span><span class="tiny muted">${state === 'resolved' ? 'Fixed in a1b2c3d · ships in 0.2.1' : who ? `${who[1]} is on it` : 'Unassigned'}</span></div>
  </div>`;
}
</script>

