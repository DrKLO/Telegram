  .js .k { color: #af52de; } .js .s { color: #248a3d; } .js .n { color: #c93400; } .js .bo { color: #007aff; } .js .nl { color: #8e8e93; }
  .lc-dark .js .k { color: #da8ee7; } .lc-dark .js .s { color: #a6e3a1; } .lc-dark .js .n { color: #fab387; } .lc-dark .js .bo { color: #89b4fa; }
  .js .anc .k { color: #007aff; font-weight: 700; } .js .anc .tg { color: #007aff; }
  .lc-dark .js .anc .k { color: #64a8ff; }
  .js .crumb { font-family: ui-monospace; font-size: 11px; }
  .js .crumb .c { padding: 1px 2px; border-radius: 4px; color: #007aff; }
  .js .crumb .c:hover { background-color: rgba(0,122,255,0.12); }
</style>
<div class="card pad js">
  <div class="row"><span class="badge green" style="margin-right: 8px">200 OK</span><code class="grow">GET /v1/conversations/42/messages?limit=3</code></div>
  <pre>{ "conversation": 42, "has_more": true, "items": [ … 3 items ], "meta": { … } }</pre>
</div>
<script>
const DATA = {
  conversation: 42,
  has_more: true,
  items: [
    { id: 'msg_8f2a', sender: 'leo', format: 'html', body: '<p>Floats work <b>too</b>.</p>', bytes: 1734, edited: false },
    { id: 'msg_8f2b', sender: 'rin', format: 'html', body: '<table class="grid">…', bytes: 9120, reactions: { '👍': 3, '🎯': 1 } },
    { id: 'msg_8f2c', sender: 'ci', format: 'html', body: null, attachments: [] },
  ],
  meta: { request_id: 'req_01HZX4', region: 'eu-central-1', rate_limit: { remaining: 4987, reset: 1759852800 } },
};
const NODES = [];
function build(key, value, depth, parent, last) {
  const id = NODES.length;
  const kind = value !== null && typeof value === 'object' ? (Array.isArray(value) ? 'arr' : 'obj') : 'prim';
  const node = { id, key, value, depth, parent, kind, last, children: [] };
  NODES.push(node);
  if (kind !== 'prim') {
    const entries = kind === 'arr' ? value.map((v, i) => [i, v]) : Object.entries(value);
    entries.forEach(([k, v], i) => node.children.push(build(k, v, depth + 1, id, i === entries.length - 1)));
  }
  return id;
}
build(null, DATA, 0, -1, true);
const byKey = k => NODES.find(n => n.key === k).id;
const ITEMS = byKey('items'), REMAIN = byKey('remaining'), REQID = byKey('request_id');
const svg = body => 'data:image/svg+xml;utf8,' + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'>${body}</svg>`);
const SPIN = Array.from({ length: 12 }, (_, i) => svg(`<circle cx='8' cy='8' r='6' fill='none' stroke='#8e8e93' stroke-opacity='0.3' stroke-width='2'/><path d='M8 2 A6 6 0 0 1 14 8' fill='none' stroke='#0a84ff' stroke-width='2' stroke-linecap='round' transform='rotate(${i * 30} 8 8)'/>`));

const open = { 0: true };
let sel = -1, loading = true, ms = 0, fetchRun = 0, copied = false, copyRun = 0, touched = false, anc = new Set();
const pop = { b: 1 }, selFl = { a: 0 }, flashes = {};

function chain(id) { const out = []; for (let n = id; n >= 0; n = NODES[n].parent) out.unshift(n); return out; }
function seg(id) {
  const n = NODES[id];
  if (n.parent < 0) return '$';
  if (typeof n.key === 'number') return `[${n.key}]`;
  return /^[A-Za-z_]\w*$/.test(n.key) ? '.' + n.key : `[${JSON.stringify(n.key)}]`;
}
const prim = v => v === null ? '<span class="nl">null</span>' : typeof v === 'string' ? `<span class="s">${esc(JSON.stringify(v))}</span>` : typeof v === 'boolean' ? `<span class="bo">${v}</span>` : `<span class="n">${v}</span>`;
function info(n) {
  if (n.kind === 'arr') return `array · ${n.children.length} item${n.children.length === 1 ? '' : 's'}`;
  if (n.kind === 'obj') return `object · ${n.children.length} key${n.children.length === 1 ? '' : 's'}`;
  return n.value === null ? 'null' : `${typeof n.value} · ${esc(String(n.value).slice(0, 40))}`;
}
function flash(id) { const f = flashes[id] || (flashes[id] = { a: 0 }); f.a = 1; tween(f, { a: 0 }, 1200, ease.inQuad); }

function line(n, html, inSel, main) {
  let bg = '';
  if (n.id === sel && main) bg = alpha('#007aff', 0.14 + 0.3 * selFl.a);
  else if (inSel) bg = 'rgba(0,122,255,0.06)';
  const f = flashes[n.id] ? flashes[n.id].a : 0;
  if (f > 0.01) bg = mix(bg || 'rgba(255,204,0,0)', 'rgba(255,204,0,0.55)', f);
  const cls = main && anc.has(n.id) ? 'ln anc' : 'ln';
  return `<div class="${cls}" data-action="pick" data-value="${n.id}" style="padding-left: ${8 + n.depth * 14}px${bg ? '; background-color: ' + bg : ''}">${html}</div>`;
}
function emit(id, out, inSel) {
  const n = NODES[id];
  const s = inSel || id === sel;
  const key = n.key === null || typeof n.key === 'number' ? '' : `<span class="k">${esc(JSON.stringify(n.key))}</span>: `;
  const comma = n.last ? '' : ',';
  if (n.kind === 'prim') { out.push(line(n, `<span class="tg">&nbsp;</span>${key}${prim(n.value)}${comma}`, s, true)); return; }
  const [o, c] = n.kind === 'arr' ? ['[', ']'] : ['{', '}'];
  const count = n.children.length;
  if (!count) { out.push(line(n, `<span class="tg">&nbsp;</span>${key}${o}${c}${comma}`, s, true)); return; }
  const tg = `<span class="tg" data-action="fold" data-value="${id}">${open[id] ? '▾' : '▸'}</span>`;
  if (!open[id]) {
    const word = n.kind === 'arr' ? (count === 1 ? 'item' : 'items') : (count === 1 ? 'key' : 'keys');
    out.push(line(n, `${tg}${key}${o}<span class="sum" data-action="fold" data-value="${id}">… ${count} ${word}</span>${c}${comma}`, s, true));
    return;
  }
  out.push(line(n, `${tg}${key}${o}`, s, true));
  for (const ch of n.children) emit(ch, out, s);
  out.push(line(n, `<span class="tg">&nbsp;</span>${c}${comma}`, s, false));
}

async function refetch(first) {
  const me = ++fetchRun;
  loading = true; ms = 0;
  const target = first ? 84 : 58 + Math.round(Math.random() * 70);
  await animate(first ? 450 : 520, p => { if (me === fetchRun) ms = Math.round(target * p); }, ease.linear);
  if (me !== fetchRun) return;
  loading = false; pop.b = 0.6;
  tween(pop, { b: 1 }, 380, ease.outBack);
  if (first) {
    await sleep(150);
    if (touched || open[ITEMS]) return;
    transition('slide-down');
    open[ITEMS] = true; open[NODES[ITEMS].children[0]] = true;
    return;
  }
  NODES[REMAIN].value -= 1;
  NODES[REQID].value = 'req_01HZ' + Math.floor(Math.random() * 46656).toString(36).toUpperCase().padStart(3, '0');
  flash(REMAIN); flash(REQID);
}
setTimeout(() => refetch(true), 250);

function setOpen(pred, kind) {
  const changed = NODES.some(n => n.kind !== 'prim' && !!open[n.id] !== pred(n));
  if (!changed) return;
  transition(kind);
  for (const n of NODES) if (n.kind !== 'prim') open[n.id] = pred(n);
}

function onAction(name, v) {
  const id = Number(v);
  if (name === 'fold') {
    touched = true;
    transition(open[id] ? 'slide-up' : 'slide-down');
    open[id] = !open[id];
  } else if (name === 'expand') {
    touched = true;
    setOpen(() => true, 'slide-down');
  } else if (name === 'collapse') {
    touched = true;
    setOpen(n => n.id === 0, 'slide-up');
  } else if (name === 'pick') {
    sel = sel === id ? -1 : id;
    const hidden = sel >= 0 ? chain(sel).slice(0, -1).filter(a => !open[a]) : [];
    if (hidden.length) { transition('slide-down'); for (const a of hidden) open[a] = true; }
    copied = false; copyRun++;
    selFl.a = 1;
    tween(selFl, { a: 0 }, 700, ease.outCubic);
  } else if (name === 'copy') {
    if (sel < 0) return;
    copyText(chain(sel).map(seg).join(''));
    copied = true;
    const me = ++copyRun;
    setTimeout(() => { if (me === copyRun) copied = false; }, 1500);
  } else if (name === 'refetch') {
    refetch(false);
  }
}

function render() {
  anc = new Set(sel >= 0 ? chain(sel).slice(0, -1) : []);
  const out = [];
  emit(0, out, false);
  const badge = loading ? '<span class="badge" style="margin-right: 8px">· · ·</span>'
    : `<span class="badge green" style="margin-right: 8px; font-size: ${(11 * pop.b).toFixed(1)}px">200 OK</span>`;
  const meta = loading ? `<img src="${SPIN[Math.floor(performance.now() / 70) % 12]}" width="12" height="12">waiting… ${ms} ms` : `${ms} ms · 1.2 KB · ${out.length} lines`;
  const crumb = sel < 0 ? '<span class="muted">Click a line to highlight its path</span>'
    : chain(sel).map(i => `<span class="c" data-action="pick" data-value="${i}">${esc(seg(i))}</span>`).join('');
  return `<div class="card pad js">
    <div class="row">${badge}<span class="req grow"><b>GET</b> /v1/conversations/42/messages?limit=3</span></div>
    <div class="tb"><span class="small muted grow">${meta}</span><span class="bt" data-action="expand">Expand all</span><span class="bt" data-action="collapse">Collapse all</span><span class="bt" data-action="refetch">↻</span></div>
    <div class="tree">${out.join('')}</div>
    <div class="row" style="margin-top: 8px"><span class="crumb grow">${crumb}</span>${sel >= 0 ? `<span class="bt ${copied ? 'ok' : ''}" data-action="copy">${copied ? '✓ Copied' : 'Copy path'}</span>` : ''}</div>
    ${sel >= 0 ? `<div class="tiny muted" style="margin-top: 2px">${info(NODES[sel])}</div>` : ''}
  </div>`;
}
</script>

