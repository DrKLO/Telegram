let shown = 0, typed = 0, running = false, done = false, cleared = false, verbose = false, speed = 1, fast = false;
let run = 0, t0 = 0, t1 = 0, livep = 0, liveIdx = -1, blinkUntil = 0, blinkTimer = 0;
const pv = { x: 0 };

function reset(isFast) { shown = 0; typed = 0; running = true; done = false; cleared = false; fast = isFast; t0 = performance.now(); liveIdx = -1; pv.x = 0; }
function finish() {
  running = false; done = true; t1 = performance.now(); shown = E.length; typed = 0; liveIdx = -1;
  tween(pv, { x: 0 }, 300);
  blinkUntil = performance.now() + 4000;
  if (blinkTimer) clearInterval(blinkTimer);
  blinkTimer = setInterval(() => { if (performance.now() > blinkUntil) { clearInterval(blinkTimer); blinkTimer = 0; } }, 500);
}
async function typeCmd(i, perChar, ok) {
  const n = E[i].cmd.length;
  await animate(n * perChar / speed, (_, t) => { if (ok()) typed = Math.round(t * n); }, ease.linear);
}
async function intro() {
  const me = ++run, ok = () => me === run;
  reset(true);
  await typeCmd(0, 30, ok);
  if (!ok()) return;
  shown = 1;
  await animate(560, p => { if (ok()) shown = Math.max(shown, 1 + Math.floor(p * (E.length - 1))); }, ease.outQuad);
  if (ok()) finish();
}
async function play() {
  const me = ++run, ok = () => me === run;
  const wait = async ms => { await sleep(Math.max(50, ms / speed)); return ok(); };
  reset(false);
  for (let i = 0; i < E.length; i++) {
    const e = E[i];
    if (e.cmd) {
      typed = 0;
      if (!(await wait(420))) return;
      await typeCmd(i, 45, ok);
      if (!ok() || !(await wait(240))) return;
      pv.x = 0;
    } else if (e.live) {
      if (!(await wait(e.d))) return;
      liveIdx = i; livep = 0;
      await animate(e.ms / speed, p => { if (ok()) { livep = p; pv.x = p; } }, ease.outCubic);
      if (!ok()) return;
      liveIdx = -1;
    } else if (verbose || !e.v) {
      if (!(await wait(e.d))) return;
      if (e.pct) tween(pv, { x: e.pct / 100 }, 260, ease.outCubic);
    }
    shown = i + 1;
  }
  finish();
}
setTimeout(intro, 250);

function onAction(name) {
  if (name === 'rerun') { transition('fade'); play(); }
  else if (name === 'skip') { if (!running) return; run++; transition('slide-up'); finish(); }
  else if (name === 'clear') { if (running || cleared) return; transition('slide-up'); cleared = true; }
  else if (name === 'verbose') { transition('fade'); verbose = !verbose; }
  else if (name === 'speed') speed = speed >= 4 ? 1 : speed * 2;
}

function render() {
  const now = performance.now();
  const blinkOn = running || now < blinkUntil ? Math.floor(now / 500) % 2 === 0 : true;
  const caret = `<span class="cur"${blinkOn ? '' : ' style="background-color: rgba(205,214,244,0)"'}></span>`;
  const rows = [];
  if (!cleared) for (let i = 0; i < shown && i < E.length; i++) {
    const e = E[i];
    if (e.v && !verbose) continue;
    rows.push(e.cmd ? P + esc(e.cmd) : e.live ? e.live(1) : e.html);
  }
  if (running) {
    const cur = E[shown];
    if (cur && cur.cmd) rows.push(P + esc(cur.cmd.slice(0, typed)) + caret);
    else if (cur && cur.live && liveIdx === shown) rows.push(cur.live(livep));
    else rows.push(caret);
  } else rows.push(P + caret);
  const secs = (((running ? now : t1) - t0) / 1000).toFixed(1);
  const state = running ? `<span class="y">● running${fast ? '' : ' ' + secs + 's'}</span>`
    : done && !cleared ? `<span class="g">✓ exit 0</span>${fast ? '' : ' · ' + secs + 's'}` : 'idle';
  return `<div class="term">
    <div class="bar" data-pin="top"><span class="dot" style="background-color: #ff5f57"></span><span class="dot" style="background-color: #febc2e"></span><span class="dot" style="background-color: #28c840"></span><span class="grow" style="margin-left: 8px">zsh — litechat — 120×32</span><span>${state}</span></div>
    <div class="prog"><div style="width: ${(pv.x * 100).toFixed(1)}%"></div></div>
    <div class="scr">${rows.map(r => `<div>${r}</div>`).join('')}</div>
    <div class="foot" data-pin="bottom"><span class="tb" data-action="rerun">↻ ${running ? 'Restart' : 'Rerun'}</span>${running ? '<span class="tb" data-action="skip">⏭ Skip</span>' : '<span class="tb" data-action="clear">⌘K Clear</span>'}<span class="tb ${verbose ? 'on' : ''}" data-action="verbose">${verbose ? '✓ ' : ''}Verbose</span><span class="tb" data-action="speed">${speed}× speed</span><span class="grow"></span><span class="st">${rows.length - 1} lines</span></div>
  </div>`;
}
</script>

