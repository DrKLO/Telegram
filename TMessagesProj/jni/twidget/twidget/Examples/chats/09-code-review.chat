--- leo 16:00 bare
<style>
  .pr { width: 420px; max-width: 100%; }
  .pr .br { font-family: ui-monospace; font-size: 11px; padding: 1px 6px; border-radius: 6px; background-color: rgba(0,122,255,0.12); color: #007aff; }
  .lc-dark .pr .br { background-color: rgba(10,132,255,0.22); color: #6cb2ff; }
  .pr .ttl { font-size: 16px; font-weight: 800; line-height: 1.25; margin: 6px 0 4px 0; }
  .pr .add { color: #34c759; font-weight: 700; } .pr .del { color: #ff3b30; font-weight: 700; }
  .pr .blocks { display: inline-block; vertical-align: middle; margin-left: 4px; }
  .pr .blocks span { display: inline-block; width: 8px; height: 8px; margin-right: 1px; border-radius: 2px; }
  .pr .rv { display: flex; align-items: center; height: 28px; margin-top: 6px; }
  .pr .rvw { display: flex; align-items: center; margin-right: 12px; font-size: 12px; }
  .pr .rvw .av { margin-right: 5px; }
  .pr .hd { display: flex; align-items: center; justify-content: space-between; margin-top: 6px; padding-bottom: 3px; }
  .pr .lnk { font-size: 12px; font-weight: 600; color: #007aff; padding: 1px 6px; border-radius: 6px; }
  .pr .lnk:hover { background-color: rgba(0,122,255,0.12); }
  .pr .chk { display: flex; align-items: center; height: 28px; border-top: 1px solid rgba(127,127,127,0.15); font-size: 12.5px; }
  .pr .ic { display: flex; align-items: center; justify-content: center; width: 16px; height: 16px; margin-right: 8px; }
  .pr .d { margin-left: 6px; }
  .pr .cbar { width: 60px; height: 4px; border-radius: 2px; background-color: rgba(127,127,127,0.2); }
  .pr .cbar div { height: 4px; border-radius: 2px; background-color: #0a84ff; }
  .pr .merge { margin-top: 8px; padding: 10px 12px; border-radius: 10px; border: 1px solid rgba(52,199,89,0.35); }
  .pr .seg { display: inline-block; border-radius: 8px; background-color: rgba(127,127,127,0.14); padding: 2px; }
  .pr .seg span { display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 11.5px; font-weight: 600; }
  .pr .seg span:hover { background-color: rgba(127,127,127,0.2); }
  .pr .seg span.on { background-color: #ffffff; color: #1c1c1e; }
  .lc-dark .pr .seg span.on { background-color: rgba(255,255,255,0.2); color: #ffffff; }
  .pr button.ok, .pr button.go { background-color: #34c759; color: #ffffff; }
  .pr button.ok:hover, .pr button.go:hover { background-color: #2db24f; }
  .pr button.ok:active, .pr button.go:active { background-color: #248a3d; }
  .pr button.bad { background-color: rgba(255,59,48,0.14); color: #ff3b30; }
  .pr button.bad:hover { background-color: rgba(255,59,48,0.24); }
  .pr button.bad:active { background-color: rgba(255,59,48,0.34); }
  .pr .off { display: inline-block; padding: 5px 13px; border-radius: 9px; font-size: 14px; font-weight: 600; background-color: rgba(127,127,127,0.12); color: #8e8e93; }
  .pr .off img { margin-right: 6px; }
  .pr .rs { display: inline-block; font-size: 12px; padding: 3px 10px; margin: 6px 6px 0 0; border-radius: 12px; border: 1px solid rgba(127,127,127,0.35); }
  .pr .rs:hover { border-color: #ff3b30; }
  .pr .rs.on { border-color: #ff3b30; background-color: rgba(255,59,48,0.12); color: #ff3b30; }
  .pr .dbar { height: 4px; border-radius: 2px; margin-top: 6px; background-color: rgba(175,82,222,0.18); }
  .pr .dbar div { height: 4px; border-radius: 2px; background-color: #af52de; }
</style>
<div class="card pad pr">
  <div class="row"><span class="badge green" style="margin-right: 8px">OPEN</span><span class="muted small">#128 · opened 2 hours ago by leo</span></div>
  <div class="ttl">Render chat bubbles with litehtml instead of NSAttributedString</div>
  <div class="small muted">feature/html-bubbles → main · 14 files · +412 −87 · 3 of 4 checks passed</div>
</div>
<script>
const CHECKS = [
  { name: 'build', ok: 'macOS 14 · arm64 + x86_64 · 3m 41s', ms: 1500 },
  { name: 'unit-tests', ok: '412 passed · 3 skipped · 1m 55s', ms: 1300 },
  { name: 'lint', ok: '2 warnings in LHContainer.mm', warn: true, ms: 800 },
  { name: 'perf-benchmark', ok: 'layout −38% · scroll at 120 fps', ms: 1700 },
];
const REASONS = ['Add a test for the shrink-to-fit epsilon', 'Fix the 2 lint warnings first', 'Split the renderer swap into its own PR'];
const STRATS = [['Squash', 'Squash and merge'], ['Merge', 'Create merge commit'], ['Rebase', 'Rebase and merge']];
const svg = body => 'data:image/svg+xml;utf8,' + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'>${body}</svg>`);
const SPIN = Array.from({ length: 12 }, (_, i) => svg(`<circle cx='8' cy='8' r='6' fill='none' stroke='#8e8e93' stroke-opacity='0.3' stroke-width='2'/><path d='M8 2 A6 6 0 0 1 14 8' fill='none' stroke='#0a84ff' stroke-width='2' stroke-linecap='round' transform='rotate(${i * 30} 8 8)'/>`));
const spinner = (z = 16) => `<img src="${SPIN[Math.floor(performance.now() / 70) % 12]}" width="${z}" height="${z}">`;

const checks = CHECKS.map((c, i) => ({ state: i < 3 ? 'done' : 'queued', p: 0, pop: 1 }));
let mine = 'pending', phase = 'open', composing = false, reason = 0, strat = 0, note = '';
let intro = 0, deploy = 0, merging = 0, checkRun = 0, mergeRun = 0;
const pop = { me: 1, head: 1 };
let tone = [52, 199, 89, 1];

const busy = () => checks.some(c => c.state !== 'done');
function status() {
  const left = checks.filter(c => c.state !== 'done').length;
  if (left) return { tone: [255, 149, 0, 1], title: `⏳ Waiting for ${left} check${left > 1 ? 's' : ''}`, sub: 'Merging unlocks when every required check has run' };
  if (mine === 'changes') return { tone: [255, 59, 48, 1], title: '✗ Changes requested', sub: 'Merging is blocked until your review is dismissed' };
  if (mine !== 'approved') return { tone: [52, 199, 89, 1], title: '✓ No conflicts with main', sub: 'Merging requires 1 more approving review' };
  return { tone: [52, 199, 89, 2], title: '✓ Ready to merge', sub: '2 approvals · all checks passed · no conflicts' };
}
function retone() {
  const from = tone.slice(), to = status().tone;
  animate(450, p => { tone = from.map((f, i) => lerp(f, to[i], p)); }, ease.outCubic);
}
function bump(key) { pop[key] = 0; tween(pop, { [key]: 1 }, 420, ease.outBack); }

async function runChecks(list) {
  const me = ++checkRun;
  for (const i of list) { checks[i].state = 'queued'; checks[i].p = 0; }
  retone();
  for (const i of list) {
    checks[i].state = 'running';
    await animate(CHECKS[i].ms, p => { if (me === checkRun) checks[i].p = p; }, ease.inOutSine);
    if (me !== checkRun) return;
    checks[i].state = 'done';
    checks[i].pop = 0;
    tween(checks[i], { pop: 1 }, 380, ease.outBack);
  }
  retone();
}

async function merge() {
  if (phase !== 'open' || busy() || mine !== 'approved') return;
  const me = ++mergeRun;
  phase = 'merging'; merging = 0;
  await animate(900, p => { if (me === mergeRun) merging = p; }, ease.inOutCubic);
  if (me !== mergeRun) return;
  transition('pop');
  phase = 'merged'; deploy = 0;
  bump('head');
  await sleep(500);
  if (me !== mergeRun) return;
  await animate(2600, p => { if (me === mergeRun) deploy = p; }, ease.inOutSine);
}

setTimeout(() => {
  animate(850, p => { intro = p; }, ease.outCubic);
  runChecks([3]);
}, 250);

function onAction(name, value) {
  if (name === 'merge') return merge();
  if (name === 'undo') {
    if (phase !== 'merged') return;
    mergeRun++;
    transition('slide-right');
    phase = 'open'; deploy = 0;
    return;
  }
  if (phase !== 'open') return;
  if (name === 'approve') {
    if (mine === 'approved') return;
    transition('fade');
    composing = false; mine = 'approved'; note = '';
    bump('me'); retone();
  } else if (name === 'compose') {
    transition(composing ? 'slide-up' : 'slide-down');
    composing = !composing;
  } else if (name === 'reason') {
    reason = Number(value);
  } else if (name === 'submit') {
    transition('fade');
    composing = false; mine = 'changes'; note = REASONS[reason];
    bump('me'); retone();
  } else if (name === 'dismiss') {
    if (mine === 'pending') return;
    transition('fade');
    mine = 'pending'; note = '';
    retone();
  } else if (name === 'strat') {
    strat = Number(value);
  } else if (name === 'rerun') {
    runChecks([0, 1, 2, 3]);
  }
}

function checkRows() {
  return CHECKS.map((c, i) => {
    const s = checks[i];
    let icon, desc, extra = '';
    if (s.state === 'done') {
      const z = Math.max(3, Math.round(15 * s.pop));
      icon = `<img src="icon:${c.warn ? 'warning-fill' : 'check-circle-fill'}?size=18&color=${c.warn ? 'ff9500' : '34c759'}" style="width: ${z}px; height: ${z}px">`;
      desc = c.ok;
    } else if (s.state === 'running') {
      icon = spinner();
      desc = `running · ${Math.round(s.p * 100)}%`;
      extra = `<div class="cbar"><div style="width: ${(s.p * 100).toFixed(1)}%"></div></div>`;
    } else {
      icon = '<img src="icon:clock-fill?size=17&color=8e8e93">';
      desc = `queued · position ${checks.slice(0, i).filter(x => x.state !== 'done').length + 1}`;
    }
    return `<div class="chk"><span class="ic">${icon}</span><b>${c.name}</b><span class="d muted grow">${desc}</span>${extra}</div>`;
  }).join('');
}

function mergeBox() {
  if (phase === 'merged') {
    return `<div class="merge" style="background-color: rgba(175,82,222,0.10); border-color: rgba(175,82,222,0.4)">
      <div class="row"><b class="t-purple grow">✓ Merged into main</b><span class="tiny muted">${STRATS[strat][0].toLowerCase()} · a1b2c3d</span></div>
      <div class="tiny muted" style="margin-top: 2px">Branch <span class="br">feature/html-bubbles</span> was deleted</div>
      <div class="small" style="margin-top: 8px">${deploy >= 1 ? '🚀 <b>Live on staging</b> · staging.litechat.dev' : `🚚 Deploying to staging… <b>${Math.round(deploy * 100)}%</b>`}</div>
      <div class="dbar"><div style="width: ${(deploy * 100).toFixed(1)}%"></div></div></div>`;
  }
  const st = status(), open = phase === 'open';
  const c = tone.slice(0, 3).map(Math.round).join(','), a = tone[3];
  const can = !busy() && mine === 'approved';
  const btn = phase === 'merging' ? `<span class="off">${spinner(14)}Merging… ${Math.round(merging * 100)}%</span>`
    : can ? `<button class="go" data-action="merge">${STRATS[strat][1]}</button>`
    : `<span class="off">${STRATS[strat][1]}</span>`;
  const seg = STRATS.map((s, i) => `<span class="${i === strat ? 'on' : ''}"${open ? ` data-action="strat" data-value="${i}"` : ''}>${s[0]}</span>`).join('');
  return `<div class="merge" style="background-color: rgba(${c},${(0.08 * a).toFixed(3)}); border-color: rgba(${c},${(0.3 + 0.2 * (a - 1)).toFixed(3)})">
    <b style="color: rgb(${c})">${st.title}</b><div class="tiny muted">${st.sub}</div>
    <div class="row" style="margin-top: 8px"><span class="seg">${seg}</span><span class="grow"></span>${btn}</div></div>`;
}

function actions() {
  const gh = '<a class="btn" href="https://github.com/litehtml/litehtml">GitHub ↗</a>';
  if (phase === 'merged') return `<div class="row" style="margin-top: 10px"><button data-action="undo">↶ Undo merge</button><span class="grow"></span>${gh}</div>`;
  if (phase === 'merging') return `<div class="row" style="margin-top: 10px"><span class="small muted grow">Merging into main…</span>${gh}</div>`;
  if (composing) {
    const chips = REASONS.map((r, i) => `<span class="rs ${i === reason ? 'on' : ''}" data-action="reason" data-value="${i}">${esc(r)}</span>`).join('');
    return `<div class="panel" style="margin-top: 10px"><b class="small">Request changes</b> <span class="tiny muted">· pick a comment</span><div>${chips}</div>
      <div class="row" style="margin-top: 10px"><button class="bad" data-action="submit" style="margin-right: 6px">Submit review</button><button data-action="compose">Cancel</button></div></div>`;
  }
  const left = mine === 'approved' ? '<b class="small t-green" style="margin-right: 6px">✓ You approved</b><span class="lnk" data-action="dismiss">Undo</span>'
    : mine === 'changes' ? '<button class="ok" data-action="approve" style="margin-right: 6px">Approve instead</button><span class="lnk" data-action="dismiss">Dismiss review</span>'
    : '<button class="ok" data-action="approve" style="margin-right: 6px">✓ Approve</button><button data-action="compose">Request changes</button>';
  return `<div class="row" style="margin-top: 10px">${left}<span class="grow"></span>${gh}</div>`;
}

function render() {
  const merged = phase === 'merged';
  const k = clamp(intro, 0, 1);
  const blocks = [0, 1, 2, 3, 4].map(i => `<span style="background-color: ${mix([127, 127, 127, 0.25], i < 4 ? [52, 199, 89, 1] : [255, 59, 48, 1], clamp(k * 5 - i, 0, 1))}"></span>`).join('');
  const head = merged
    ? `<img src="icon:git-merge?size=22&color=af52de" style="margin-right: 8px"><span class="badge purple" style="margin-right: 8px; font-size: ${(11 * clamp(0.6 + 0.4 * pop.head, 0.6, 1.3)).toFixed(1)}px">MERGED</span><span class="muted small grow">#128 · merged just now by <b class="fg">leo</b></span>`
    : `<img src="icon:git-pull-request?size=22&color=34c759" style="margin-right: 8px"><span class="badge green" style="margin-right: 8px">OPEN</span><span class="muted small grow">#128 · opened 2 hours ago by <b class="fg">leo</b></span>`;
  const meState = mine === 'approved' ? '<span class="t-green">✓ approved</span>' : mine === 'changes' ? '<span class="t-red">✗ changes</span>' : '<span class="t-orange">● pending</span>';
  const perf = checks[3].state === 'done' ? '<span class="badge green">perf ✓</span>' : '<span class="badge orange">needs-perf-review</span>';
  const noteHtml = note && !merged ? `<div class="panel small" style="margin-top: 8px"><b>You</b> requested changes: ${esc(note)} 🙏</div>` : '';
  return `<div class="card pad pr">
    <div class="row">${head}</div>
    <div class="ttl">Render chat bubbles with litehtml instead of NSAttributedString</div>
    <div class="small"><span class="br">feature/html-bubbles</span> <span class="muted">→</span> <span class="br">main</span>
      <span class="muted" style="margin-left: 6px">14 files ·</span> <span class="add">+${Math.round(412 * k)}</span> <span class="del">−${Math.round(87 * k)}</span><span class="blocks">${blocks}</span></div>
    <div style="margin-top: 8px"><span class="badge purple">rendering</span> <span class="badge blue">macOS</span> ${perf}</div>
    <div class="rv">
      <span class="rvw"><span class="av" style="background-color: #ff9500">RS</span>Rin&nbsp;<span class="t-green">✓ approved</span></span>
      <span class="rvw"><span class="av" style="background-color: #007aff">ME</span>You&nbsp;<span style="font-size: ${(12 * (0.5 + 0.5 * pop.me)).toFixed(1)}px">${meState}</span></span>
      <span class="rvw"><span class="av" style="background-color: #af52de">MC</span>Maya&nbsp;<span class="muted">💬 2</span></span>
    </div>
    <div class="hd"><span class="caps">Checks</span>${phase === 'open' ? '<span class="lnk" data-action="rerun">↻ Re-run all</span>' : ''}</div>
    ${checkRows()}${mergeBox()}${noteHtml}${actions()}
  </div>`;
}
</script>

