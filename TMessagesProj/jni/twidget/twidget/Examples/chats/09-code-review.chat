<div class="card pad api">
  <div class="row"><span class="meth">POST</span><span class="ep grow">/v1/messages</span><span class="badge blue">v1 · stable</span></div>
  <p class="small muted" style="margin: 6px 0 0 0">Sends a message to a conversation. Params: conversation, format, body, widget, on.</p>
</div>
<script>
const LANGS = [
  { name: 'cURL', src: [
    'curl https://api.litechat.dev/v1/messages \\',
    '  -H "Authorization: Bearer $TOKEN" \\',
    '  -H "Content-Type: application/json" \\',
    '  -d \'{"conversation": 42, "format": "html",',
    '       "body": "<p>Hello <b>world</b></p>"}\'',
  ] },
  { name: 'Swift', src: [
    'let body = Message(conversation: 42, format: .html,',
    '                   body: "<p>Hello <b>world</b></p>")',
    'var req = URLRequest(url: api.appending(path: "v1/messages"))',
    'req.httpMethod = "POST"',
    'req.httpBody = try JSONEncoder().encode(body)',
    'let (data, _) = try await URLSession.shared.data(for: req)',
  ] },
  { name: 'Python', src: [
    'import requests',
    '',
    'r = requests.post(',
    '    "https://api.litechat.dev/v1/messages",',
    '    headers={"Authorization": f"Bearer {token}"},',
    '    json={"conversation": 42, "format": "html",',
    '          "body": "<p>Hello <b>world</b></p>"},',
    ')',
    'r.raise_for_status()',
  ] },
  { name: 'JS', src: [
    'const url = "https://api.litechat.dev/v1/messages";',
    'const res = await fetch(url, {',
    '  method: "POST",',
    '  headers: { Authorization: `Bearer ${token}` },',
    '  body: JSON.stringify({ conversation: 42, format: "html",',
    '    body: "<p>Hello <b>world</b></p>" }),',
    '});',
  ] },
];
const PARAMS = [
  { n: 'conversation', req: true, t: 'integer', d: 'Conversation ID.', more: 'Example: 42 · you must be a member' },
  { n: 'format', t: '"text" | "html"', d: 'Defaults to <code>text</code>. With <code>html</code>, <code>body</code> may contain any HTML and CSS.', more: 'Example: "html"' },
  { n: 'body', req: true, t: 'string', d: 'Up to 256&nbsp;KB. A <code>&lt;script&gt;</code> runs sandboxed; clicks update the card in place.', more: 'Example: "&lt;p&gt;Hello &lt;b&gt;world&lt;/b&gt;&lt;/p&gt;"' },
  { n: 'widget', t: 'boolean', d: 'Show inside a bubble instead of fullsize.', more: 'Not set in this example · defaults to false' },
  { n: 'on', t: 'string[]', d: 'Initially active toggle keys, e.g. <code>["tab-1"]</code>.', more: 'Not set in this example' },
];
const RESP = {
  201: { label: 'Created', short: 'Created', badge: 'green', t: 't-green', ms: 142, body: ['{', '  "id": "msg_8f2d",', '  "conversation": 42,', '  "format": "html",', '  "bytes": 34,', '  "created_at": "2026-10-08T16:20:03Z"', '}'] },
  413: { label: 'Payload Too Large', short: 'Body too large', badge: 'orange', t: 't-orange', ms: 61, body: ['{', '  "error": "body_too_large",', '  "message": "Body is 301 KB, the limit is 256 KB"', '}'] },
  422: { label: 'Unprocessable', short: 'Invalid HTML', badge: 'red', t: 't-red', ms: 97, body: ['{', '  "error": "invalid_html",', '  "message": "Unclosed <b> at line 1",', '  "line": 1, "column": 18', '}'] },
  429: { label: 'Too Many Requests', short: 'Rate limited', badge: 'red', t: 't-red', ms: 38, body: ['{', '  "error": "rate_limited",', '  "retry_after": 12', '}'] },
};
const CODES = [201, 413, 422, 429];
const KWS = new Set(['let', 'var', 'try', 'await', 'import', 'const', 'curl', 'new', 'true', 'false']);
const TOK = /("(?:[^"\\]|\\.)*"|`[^`]*`)|(-[A-Za-z]\b)|([A-Za-z_$][\w$]*)|(\d+(?:\.\d+)?)|([\s\S])/g;
function tokenize(line) {
  const out = [];
  let m;
  TOK.lastIndex = 0;
  while ((m = TOK.exec(line))) {
    if (m[1]) out.push({ c: 's', s: m[1], w: m[1].slice(1, -1) });
    else if (m[2]) out.push({ c: 'fl', s: m[2] });
    else if (m[3]) out.push({ c: KWS.has(m[3]) ? 'kw' : '', s: m[3], w: m[3] });
    else if (m[4]) out.push({ c: 'nu', s: m[4] });
    else out.push({ c: '', s: m[5] });
  }
  return out;
}
for (const L of LANGS) L.toks = L.src.map(tokenize);
for (const c of CODES) RESP[c].toks = RESP[c].body.map(tokenize);
const svg = body => 'data:image/svg+xml;utf8,' + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'>${body}</svg>`);
const SPIN = Array.from({ length: 12 }, (_, i) => svg(`<circle cx='8' cy='8' r='6' fill='none' stroke='#8e8e93' stroke-opacity='0.35' stroke-width='2'/><path d='M8 2 A6 6 0 0 1 14 8' fill='none' stroke='#89b4fa' stroke-width='2' stroke-linecap='round' transform='rotate(${i * 30} 8 8)'/>`));
const spinner = (z = 14) => `<img src="${SPIN[Math.floor(performance.now() / 70) % 12]}" width="${z}" height="${z}">`;

let tab = 0, param = -1, mock = 0, req = null, reqRun = 0, copied = '', copyRun = 0, intro = 0, retryTimer = 0;
const ind = { x: 0 }, hlA = { a: 0 }, cp = { s: 1 };
setTimeout(() => animate(700, p => { intro = p; }, ease.outCubic), 250);

function codeHtml(toks, word) {
  return toks.map(line => line.map(t => {
    const h = t.c ? `<span class="${t.c}">${esc(t.s)}</span>` : esc(t.s);
    return word && t.w === word ? `<span class="mk" style="background-color: rgba(255,214,10,${(0.32 + 0.45 * hlA.a).toFixed(2)})">${h}</span>` : h;
  }).join('')).join('\n');
}
function copy(what) {
  copied = what; cp.s = 0.7;
  tween(cp, { s: 1 }, 380, ease.outBack);
  const me = ++copyRun;
  setTimeout(() => { if (me === copyRun) copied = ''; }, 1600);
}
function stopRetry() { if (retryTimer) { clearInterval(retryTimer); retryTimer = 0; } }

async function tryIt() {
  const me = ++reqRun, code = CODES[mock], R = RESP[code];
  stopRetry();
  transition(req ? 'fade' : 'slide-down');
  req = { phase: 'up', p: 0, ms: 0, code, retry: 0 };
  await animate(420, p => { if (me === reqRun) req.p = p; }, ease.outCubic);
  if (me !== reqRun) return;
  req.phase = 'wait';
  await animate(480, p => { if (me === reqRun) req.ms = Math.round(R.ms * 0.8 * p); }, ease.linear);
  if (me !== reqRun) return;
  transition('pop');
  req.phase = 'done'; req.ms = R.ms;
  if (code === 429) {
    req.retry = 12;
    retryTimer = setInterval(() => {
      if (me !== reqRun || !req) return stopRetry();
      req.retry = Math.max(0, req.retry - 1);
      if (!req.retry) stopRetry();
    }, 1000);
  }
}

function onAction(name, v) {
  const i = Number(v);
  if (name === 'tab') {
    if (i === tab) return;
    transition(i > tab ? 'slide-left' : 'slide-right');
    tab = i;
    tween(ind, { x: i * 64 }, 320, ease.outCubic);
  } else if (name === 'param') {
    transition(param === i ? 'slide-up' : 'slide-down');
    param = param === i ? -1 : i;
    hlA.a = 1;
    tween(hlA, { a: 0 }, 900, ease.outCubic);
  } else if (name === 'mock') {
    mock = i;
    if (req) tryIt();
  } else if (name === 'try') {
    if (req && req.phase !== 'done') return;
    tryIt();
  } else if (name === 'close') {
    if (!req) return;
    reqRun++; stopRetry();
    transition('slide-up');
    req = null;
  } else if (name === 'copy') {
    if (v === 'resp' && req) copyText(RESP[req.code].body.join('\n'));
    else if (v === 'code') copyText(LANGS[tab].src.join('\n'));
    copy(v);
  }
}

function respHtml() {
  if (!req) return '';
  const R = RESP[req.code];
  if (req.phase !== 'done') {
    const label = req.phase === 'up' ? `Sending 214 B… ${Math.round(req.p * 100)}%` : `Waiting for api.litechat.dev… ${req.ms} ms`;
    return `<div class="resp"><div class="rh">${spinner()}<span class="grow">${label}</span></div>
      <div class="rbar"><div style="width: ${(req.phase === 'up' ? req.p * 100 : 100).toFixed(1)}%"></div></div>
      <div class="rb"><pre>→ POST /v1/messages HTTP/2
  Host: api.litechat.dev
  Content-Type: application/json</pre></div></div>`;
  }
  const isCopied = copied === 'resp';
  const retry = req.code === 429 ? `<div class="rh" style="border-top: 1px solid #45475a">${req.retry ? `⏳ Retry-After: <b style="margin-left: 4px">${req.retry}s</b>` : '<span class="grow">✓ You can retry now</span><span class="tbtn" data-action="try">↻ Retry</span>'}</div>` : '';
  return `<div class="resp"><div class="rh"><span class="badge ${R.badge}">${req.code} ${R.label}</span><span class="grow" style="margin-left: 8px">${req.ms} ms · application/json</span>
      <span class="tbtn ${isCopied ? 'ok' : ''}" data-action="copy" data-value="resp"${isCopied ? ` style="font-size: ${(11.5 * cp.s).toFixed(1)}px"` : ''}>${isCopied ? '✓ Copied' : 'Copy'}</span><span class="tbtn" data-action="close">✕</span></div>
    <div class="rb"><pre>${codeHtml(R.toks, '')}</pre></div>${retry}</div>`;
}

function render() {
  const L = LANGS[tab], word = param >= 0 ? PARAMS[param].n : '';
  const ep = '/v1/messages'.slice(0, Math.ceil(12 * clamp(intro * 1.3, 0, 1)));
  const busy = req && req.phase !== 'done';
  const tryBtn = busy ? `<span class="off">${spinner()}Sending…</span>` : '<button class="primary" data-action="try">▶ Try it</button>';
  const rows = PARAMS.map((p, i) => `<tr class="p ${i === param ? 'on' : ''}" data-action="param" data-value="${i}"><td class="n"><div class="pn">${p.n}</div><div class="ty">${esc(p.t)}</div>${p.req ? '<div class="req">REQUIRED</div>' : ''}</td><td>${p.d}${i === param ? `<div class="more">${p.more}${LANGS[tab].toks.some(l => l.some(t => t.w === p.n)) ? ' · highlighted below' : ''}</div>` : ''}</td></tr>`).join('');
  const tabs = LANGS.map((l, i) => `<span class="tab ${i === tab ? 'on' : ''}" data-action="tab" data-value="${i}">${l.name}</span>`).join('');
  const isCopied = copied === 'code';
  const codes = CODES.map((c, i) => `<span class="c ${i === mock ? 'on' : ''}" data-action="mock" data-value="${i}"><b class="${RESP[c].t}">${c}</b> ${RESP[c].short}</span>`).join('');
  return `<div class="card pad api">
    <div class="row"><span class="meth">POST</span><span class="ep grow">${ep}&nbsp;</span>${tryBtn}</div>
    <p class="small muted" style="margin: 6px 0 4px 0">Sends a message to a conversation. HTML bodies are rendered by litehtml on every client. <span class="badge blue">v1 · stable</span></p>
    <table class="pt"><tr><th>Parameter</th><th>Description</th></tr>${rows}</table>
    <div class="tabs">${tabs}<span class="grow"></span><span class="tbtn ${isCopied ? 'ok' : ''}" data-action="copy" data-value="code"${isCopied ? ` style="font-size: ${(11.5 * cp.s).toFixed(1)}px"` : ''}>${isCopied ? '✓ Copied' : 'Copy'}</span></div>
    <div class="track"><div class="ind" style="margin-left: ${ind.x.toFixed(1)}px; width: ${(64 * clamp(intro, 0, 1.2)).toFixed(1)}px"></div></div>
    <div class="code"><pre>${codeHtml(L.toks, word)}</pre></div>
    <div class="caps" style="margin-top: 10px">Responses <span class="tiny" style="text-transform: none; font-weight: 400">· pick one, then Try it</span></div>
    <div class="codes">${codes}</div>
    ${respHtml()}
  </div>`;
}
</script>

