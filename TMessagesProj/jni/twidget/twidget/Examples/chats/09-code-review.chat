obj(47, 'CXX', 'litehtml/render_flex.cpp.o');
obj(61, 'CXX', 'litehtml/render_table.cpp.o', true);
obj(74, 'CXX', 'litehtml/style.cpp.o', true);
obj(89, 'OBJCXX', 'lhmac/LHContainer.mm.o');
