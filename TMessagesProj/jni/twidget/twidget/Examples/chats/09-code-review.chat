<div class="card df">
  <div class="fh"><b class="grow">src/LHDocument.mm</b><span class="t-green" style="margin-right: 6px">+16</span><span class="t-red">−4</span></div>
  <div class="fh"><b class="grow">src/LHContainer.mm</b><span class="t-green" style="margin-right: 6px">+2</span><span class="t-red">−1</span></div>
</div>
<script>
const FILES = [
  { name: 'src/LHDocument.mm', hunks: [
    { head: '@@ -41,8 +41,19 @@ @implementation LHDocument', o: 41, n: 41, lines: [
      ' - (CGSize)layoutWithMaxWidth:(CGFloat)width',
      ' {',
      '-    NSAttributedString *s = [self attributedString];',
      '-    CGRect r = [s boundingRectWithSize:CGSizeMake(width, CGFLOAT_MAX)',
      '-                               options:0];',
      '-    return r.size; // ignores tables, floats and CSS',
      '+    width = std::max<CGFloat>(1, std::floor(width));',
      '+    if(std::fabs(width - _lastWidth) < 0.5)',
      '+        return _size; // cached: scrolling never re-lays out',
      '+    _lastWidth = width;',
      '+',
      '+    lh::pixel_t natural = _doc->render(width);',
      '+    CGFloat w = width;',
      '+    if(natural > 0 && natural < width)',
      '+    {',
      '+        // shrink-to-fit: render again at the natural width',
      '+        w = std::ceil(natural + 0.01);',
      '+        _doc->render(w);',
      '+    }',
      '+    _size = CGSizeMake(w, std::ceil(_doc->height()));',
      '+    return _size;',
      ' }',
      ' ',
    ] },
    { head: '@@ -96,4 +107,5 @@ - (void)dealloc', o: 96, n: 107, lines: [
      ' - (void)dealloc',
      ' {',
      '+    _doc.reset(); // the document points at the container',
      '     delete _container;',
      ' }',
    ] },
  ] },
  { name: 'src/LHContainer.mm', hunks: [
    { head: '@@ -210,5 +230,6 @@ void LHContainer::draw_text(...)', o: 210, n: 230, lines: [
      ' void LHContainer::draw_text(uint_ptr hdc, const char* text,',
      '         uint_ptr hFont, web_color color, const position& pos)',
      ' {',
      '-    CGContextSetTextPosition(ctx, pos.x, pos.y);',
      '+    CGContextSetTextMatrix(ctx, CGAffineTransformMakeScale(1, -1));',
      '+    CGContextSetTextPosition(ctx, pos.x, pos.y + f->ascent);',
      '     CTLineDraw(line, ctx);',
    ] },
  ] },
];
const SAY = {
  '+': ['Can we cover this with a test?', 'Nice, much easier to follow 👍', 'Is this on the hot path? Worth a benchmark.'],
  '-': ['🎉 Good riddance.', 'Is anything else still calling this?'],
  ' ': ['Nit: a short comment here would help.', 'Unrelated, but this could be const.'],
};
const KW = new Set(['return', 'if', 'else', 'self', 'const', 'void', 'delete', 'auto', 'nullptr']);
function hl(src) {
  if (!src.trim()) return '&nbsp;';
  const re = /(\/\/.*$)|("(?:[^"\\]|\\.)*")|([A-Za-z_]\w*)|(\d+(?:\.\d+)?)|([\s\S])/g;
  let out = '', m;
  while ((m = re.exec(src))) {
    if (m[1]) out += `<span class="cmt">${esc(m[1])}</span>`;
    else if (m[2]) out += `<span class="st">${esc(m[2])}</span>`;
    else if (m[3]) out += KW.has(m[3]) ? `<span class="kw">${m[3]}</span>` : m[3];
    else if (m[4]) out += `<span class="nu">${m[4]}</span>`;
    else out += esc(m[5]);
  }
  return out;
}
for (const F of FILES) {
  F.adds = 0; F.dels = 0;
  for (const H of F.hunks) {
    let o = H.o, n = H.n;
    H.rows = H.lines.map((s, i) => {
      const t = s[0];
      if (t === '+') F.adds++; else if (t === '-') F.dels++;
      return { t, i, html: hl(s.slice(1)), o: t === '+' ? 0 : o++, n: t === '-' ? 0 : n++ };
    });
    H.pairs = [];
    for (let i = 0; i < H.rows.length;) {
      if (H.rows[i].t === ' ') { H.pairs.push([H.rows[i], H.rows[i]]); i++; continue; }
      const dels = [], adds = [];
      while (i < H.rows.length && H.rows[i].t === '-') dels.push(H.rows[i++]);
      while (i < H.rows.length && H.rows[i].t === '+') adds.push(H.rows[i++]);
      for (let k = 0; k < Math.max(dels.length, adds.length); k++) H.pairs.push([dels[k] || null, adds[k] || null]);
    }
  }
}

let mode = 'u', intro = 0, said = 0;
const folded = {}, closed = {}, viewed = {}, notes = {};
const vp = { x: 0 }, fl = { key: '', a: 0 }, cnt = { s: 1 };
setTimeout(() => animate(850, p => { intro = p; }, ease.outCubic), 250);

const STAG = 0.025;
function tint(r, key, gi) {
  const f = fl.key === key ? fl.a : 0;
  if (r.t === ' ' && f < 0.01) return null;
  const w = clamp(intro * (1 + 40 * STAG) - gi * STAG, 0, 1);
  if (w >= 1 && f < 0.01) return null;
  const base = r.t === '+' ? [52, 199, 89] : r.t === '-' ? [255, 59, 48] : [127, 127, 127];
  const on = r.t === ' ' ? 0 : w;
  const c = a => mix([...base, a * on], [255, 204, 0, 0.5], f);
  return { cd: ` style="background-color: ${c(0.13)}"`, ln: ` style="background-color: ${c(0.22)}"` };
}
const mark = k => notes[k] ? `<span style="font-size: ${Math.max(1, 10 * notes[k].pop).toFixed(1)}px">💬</span>` : '<span class="plus">+</span>';
function noteRow(k) {
  const n = k && notes[k];
  if (!n) return '';
  return `<tr class="nr"><td colspan="5"><div class="note"><span class="av" style="background-color: #007aff">ME</span><div class="grow"><b>You</b> <span class="tiny muted">· ${n.at} · pending</span><div>${esc(n.text)}</div></div><span class="x" data-action="unnote" data-value="${k}">✕</span></div></td></tr>`;
}
function hunkHead(H, hk) {
  return `<tr class="hk" data-action="hunk" data-value="${hk}"><td class="g">${folded[hk] ? '▸' : '▾'}</td><td colspan="4">${esc(H.head)}${folded[hk] ? ` <b>· ${H.rows.length} lines folded</b>` : ''}</td></tr>`;
}
function unified(f, gi) {
  return FILES[f].hunks.map((H, h) => {
    const hk = f + '.' + h;
    if (folded[hk]) return hunkHead(H, hk);
    return hunkHead(H, hk) + H.rows.map(r => {
      const key = hk + '.' + r.i, c = r.t === '+' ? 'a' : r.t === '-' ? 'd' : '', tn = tint(r, key, gi.n++);
      const ln = tn ? tn.ln : '', cd = tn ? tn.cd : '';
      return `<tr class="l" data-action="line" data-value="${key}"><td class="g">${mark(key)}</td><td class="ln ${c}"${ln}>${r.o || '&nbsp;'}</td><td class="ln ${c}"${ln}>${r.n || '&nbsp;'}</td><td class="sg ${c}"${cd}>${r.t === '+' ? '+' : r.t === '-' ? '−' : '&nbsp;'}</td><td class="cd ${c}"${cd}>${r.html}</td></tr>${noteRow(key)}`;
    }).join('');
  }).join('');
}
function split(f, gi) {
  return FILES[f].hunks.map((H, h) => {
    const hk = f + '.' + h;
    if (folded[hk]) return hunkHead(H, hk);
    return hunkHead(H, hk) + H.pairs.map(([L, R]) => {
      const lk = L && hk + '.' + L.i, rk = R && hk + '.' + R.i;
      const side = (r, k, right) => {
        if (!r) return '<td class="ln nil">&nbsp;</td><td class="cd h nil">&nbsp;</td>';
        const c = r.t === '+' ? 'a' : r.t === '-' ? 'd' : '', tn = tint(r, k, gi.n++);
        return `<td class="ln ${c}"${tn ? tn.ln : ''}>${right ? r.n : r.o}</td><td class="cd h hv ${c}"${tn ? tn.cd : ''} data-action="line" data-value="${k}">${r.html}</td>`;
      };
      const g = lk && notes[lk] ? mark(lk) : rk && notes[rk] ? mark(rk) : '<span class="plus">+</span>';
      return `<tr class="l2"><td class="g">${g}</td>${side(L, lk, false)}${side(R, rk, true)}</tr>${noteRow(lk)}${rk !== lk ? noteRow(rk) : ''}`;
    }).join('');
  }).join('');
}

function toggle(key) {
  if (notes[key]) { transition('slide-up'); delete notes[key]; return; }
  const [f, h, i] = String(key).split('.').map(Number);
  const H = FILES[f] && FILES[f].hunks[h], r = H && H.rows[i];
  if (!r) return;
  transition('slide-down');
  const pool = SAY[r.t];
  notes[key] = { text: pool[said++ % pool.length], at: r.t === '-' ? 'L' + r.o : 'R' + r.n, pop: 0 };
  tween(notes[key], { pop: 1 }, 420, ease.outBack);
  fl.key = key; fl.a = 1;
  tween(fl, { a: 0 }, 1100, ease.inQuad);
  cnt.s = 1.7;
  tween(cnt, { s: 1 }, 380, ease.outBack);
}

function onAction(name, v) {
  if (name === 'mode') {
    if (v === mode) return;
    transition(v === 's' ? 'slide-left' : 'slide-right');
    mode = v;
  } else if (name === 'hunk') {
    transition(folded[v] ? 'slide-down' : 'slide-up');
    folded[v] = !folded[v];
  } else if (name === 'file') {
    transition(closed[v] ? 'slide-down' : 'slide-up');
    closed[v] = !closed[v];
  } else if (name === 'viewed') {
    viewed[v] = !viewed[v];
    if (!!closed[v] !== viewed[v]) { transition(viewed[v] ? 'slide-up' : 'slide-down'); closed[v] = viewed[v]; }
    tween(vp, { x: FILES.filter((_, f) => viewed[f]).length / FILES.length }, 500, ease.outCubic);
  } else if (name === 'line') {
    toggle(v);
  } else if (name === 'unnote') {
    if (!notes[v]) return;
    transition('slide-up');
    delete notes[v];
  }
}

function render() {
  const k = clamp(intro * 1.4, 0, 1), gi = { n: 0 };
  const nNotes = Object.keys(notes).length, nViewed = FILES.filter((_, f) => viewed[f]).length;
  const files = FILES.map((F, f) => {
    const open = !closed[f];
    const head = `<div class="fh"><span class="chev" data-action="file" data-value="${f}">${open ? '▾' : '▸'}</span><img src="icon:file-text?size=14&color=8e8e93" style="margin: 0 5px 0 2px"><b class="grow">${F.name}</b><span class="t-green" style="margin-right: 5px">+${Math.round(F.adds * k)}</span><span class="t-red">−${Math.round(F.dels * k)}</span><span class="vw ${viewed[f] ? 'on' : ''}" data-action="viewed" data-value="${f}"><span class="box">✓</span>Viewed</span></div>`;
    return head + (open ? `<table>${mode === 's' ? split(f, gi) : unified(f, gi)}</table>` : '');
  }).join('');
  const seg = [['u', 'Unified'], ['s', 'Split']].map(([m, t]) => `<span class="${m === mode ? 'on' : ''}" data-action="mode" data-value="${m}">${t}</span>`).join('');
  return `<div class="card df">
    <div class="tb"><span class="seg">${seg}</span><span class="grow"></span>
      <span class="small muted" style="margin-right: 10px">💬 <b class="fg" style="font-size: ${(12 * cnt.s).toFixed(1)}px">${nNotes}</b></span>
      <span class="small muted">${nViewed}/${FILES.length} viewed</span><div class="vp"><div style="width: ${(vp.x * 100).toFixed(1)}%"></div></div></div>
    ${files}
    <div class="ft tiny muted">${nViewed === FILES.length ? '<b class="t-green">✓ All files viewed</b> · ' : ''}Click a line to comment · click @@ to fold a hunk</div>
  </div>`;
}
</script>

