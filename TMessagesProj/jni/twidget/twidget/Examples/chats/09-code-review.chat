  .sc .seg { display: flex; border-radius: 9px; padding: 2px; margin: 6px 0; background-color: rgba(0,0,0,0.08); }
  .lc-dark .sc .seg { background-color: rgba(255,255,255,0.08); }
  .sc .seg span { flex-grow: 1; text-align: center; padding: 3px 0; border-radius: 7px; font-size: 12px; font-weight: 600; }
  .sc .seg span:hover { background-color: rgba(0,0,0,0.08); }
  .lc-dark .sc .seg span:hover { background-color: rgba(255,255,255,0.1); }
  .sc .seg span.on { background-color: #ffffff; color: #1c1c1e; }
  .lc-dark .sc .seg span.on { background-color: rgba(255,255,255,0.22); color: #ffffff; }
  .sc .chips { display: flex; align-items: center; flex-wrap: wrap; margin-bottom: 4px; font-size: 12px; }
  .sc .fc { display: inline-block; padding: 1px 9px; margin: 2px 4px 2px 0; border-radius: 11px; border: 1px solid rgba(127,127,127,0.5); font-size: 12px; }
  .sc .fc:hover { background-color: rgba(0,0,0,0.08); }
  .lc-dark .sc .fc:hover { background-color: rgba(255,255,255,0.1); }
  .sc .fc.on { background-color: rgba(0,0,0,0.72); border-color: rgba(0,0,0,0); color: #ffffff; }
  .lc-dark .sc .fc.on { background-color: rgba(255,255,255,0.85); color: #1c1c1e; }
  .sc .r { display: flex; align-items: center; height: 30px; padding: 0 6px; margin: 0 -6px; border-radius: 8px; border-bottom: 1px solid rgba(127,127,127,0.22); font-size: 13px; }
  .sc .r:hover { background-color: rgba(0,0,0,0.07); }
  .lc-dark .sc .r:hover { background-color: rgba(255,255,255,0.08); }
  .sc .keys { display: flex; align-items: flex-start; height: 24px; }
  .sc .kc { display: inline-block; margin-left: 3px; border-radius: 5px; border: 1px solid rgba(0,0,0,0.22); background-color: #ffffff; color: #1c1c1e; font-family: ui-monospace; font-size: 11.5px; }
  .lc-dark .sc .kc { background-color: #3a3a3c; color: #f2f2f7; border-color: rgba(0,0,0,0.6); }
  .sc .kc span { display: inline-block; min-width: 10px; padding: 1px 5px; text-align: center; border-radius: 4px; }
  .sc .last { margin-top: 6px; font-size: 12px; }
  .sc .nx { font-weight: 700; padding: 2px 8px; border-radius: 8px; background-color: rgba(0,0,0,0.1); }
  .sc .nx:hover { background-color: rgba(0,0,0,0.18); }
  .lc-dark .sc .nx { background-color: rgba(255,255,255,0.12); }
  .lc-dark .sc .nx:hover { background-color: rgba(255,255,255,0.2); }
</style>
<p style="margin-bottom: 6px">Cheat sheet for the team ⌨️</p>
<p><kbd>Return</kbd> Send · <kbd>⌘</kbd><kbd>O</kbd> Open · <kbd>⌘</kbd><kbd>R</kbd> Reload · <kbd>⌘</kbd><kbd>Q</kbd> Quit</p>
<script>
const CATS = [
  { name: 'Chat', items: [['Send message', ['Return']], ['New line', ['⇧', 'Return']], ['Edit last message', ['↑']], ['Search in chat', ['⌘', 'F']], ['Jump to latest', ['⌘', '↓']]] },
  { name: 'Edit', items: [['Copy', ['⌘', 'C']], ['Paste', ['⌘', 'V']], ['Undo', ['⌘', 'Z']], ['Redo', ['⇧', '⌘', 'Z']], ['Bold', ['⌘', 'B']], ['Select all', ['⌘', 'A']]] },
  { name: 'App', items: [['Open .chat / .html', ['⌘', 'O']], ['Reload chats', ['⌘', 'R']], ['Toggle sidebar', ['⌃', '⌘', 'S']], ['Next chat', ['⌃', 'Tab']], ['Settings', ['⌘', ',']], ['Quit', ['⌘', 'Q']]] },
];
const FILTERS = [['⌘', '⌘ Command'], ['⇧', '⇧ Shift'], ['⌃', '⌃ Control'], ['none', 'No modifier']];
const MODS = ['⌘', '⇧', '⌃'];
const ALL = CATS.flatMap(c => c.items);
const QUIZ = CATS.length;

let tab = 0, filter = '', last = null, pressed = 0, pressRun = 0, wave = -1, quiz = null, score = 0, asked = 0;
const D = {}, shake = { x: 0 }, ok = { s: 1 };
const dn = k => D[k] || (D[k] = { d: 0 });
const match = it => !filter || (filter === 'none' ? !it[1].some(k => MODS.includes(k)) : it[1].includes(filter));

setTimeout(() => animate(850, (_, t) => { wave = t * 850; }, ease.linear).then(() => { wave = -1; }), 250);
const waveD = (r, j) => { if (wave < 0) return 0; const x = (wave - r * 90 - j * 45) / 260; return x > 0 && x < 1 ? Math.sin(x * Math.PI) : 0; };

async function press(prefix, keys) {
  const me = ++pressRun;
  for (let j = 0; j < keys.length; j++) {
    tween(dn(prefix + ':' + j), { d: 1 }, 110, ease.outQuad);
    await sleep(120);
    if (me !== pressRun) break;
  }
  await sleep(260);
  for (let j = 0; j < keys.length; j++) tween(dn(prefix + ':' + j), { d: 0 }, 260, ease.outBack);
}

function cap(k, d) {
  const p = clamp(d, 0, 1), z = Math.round(2 * p);
  const glow = p > 0.01 ? ` style="background-color: rgba(255,214,10,${(0.9 * p).toFixed(2)}); color: #1c1c1e"` : '';
  return `<span class="kc" style="margin-top: ${z}px; border-bottom-width: ${3 - z}px"><span${glow}>${esc(k)}</span></span>`;
}

function shuffle(a) { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; }
function newQuestion() {
  const target = ALL[Math.floor(Math.random() * ALL.length)];
  const others = shuffle(ALL.filter(it => it[1].join() !== target[1].join())).slice(0, 2);
  quiz = { target, opts: shuffle([target, ...others]), pick: -1 };
  for (let i = 0; i < 3; i++) for (let j = 0; j < 3; j++) dn(`q${i}:${j}`).d = 0;
}

function onAction(name, v) {
  if (name === 'tab') {
    const t = Number(v);
    if (t === tab) return;
    transition(t > tab ? 'slide-left' : 'slide-right');
    tab = t;
    if (t === QUIZ && !quiz) newQuestion();
  } else if (name === 'filter') {
    transition('fade');
    filter = filter === v ? '' : v;
  } else if (name === 'press') {
    const [t, i] = String(v).split(':').map(Number);
    const it = CATS[t] && CATS[t].items[i];
    if (!it) return;
    last = it; pressed++;
    ok.s = 0.5;
    tween(ok, { s: 1 }, 380, ease.outBack);
    press(`${t}:${i}`, it[1]);
  } else if (name === 'answer') {
    if (!quiz || quiz.pick >= 0) return;
    quiz.pick = Number(v); asked++;
    if (quiz.opts[quiz.pick] === quiz.target) {
      score++;
      ok.s = 0.5;
      tween(ok, { s: 1 }, 420, ease.outBack);
      press('q' + quiz.pick, quiz.target[1]);
    } else {
      animate(450, p => { shake.x = Math.sin(p * Math.PI * 6) * 7 * (1 - p); }, ease.linear);
    }
  } else if (name === 'next') {
    transition('slide-left');
    newQuestion();
  }
}

function listView() {
  const items = CATS[tab].items.map((it, i) => ({ it, i })).filter(x => match(x.it));
  const chips = FILTERS.map(([f, label]) => `<span class="fc ${filter === f ? 'on' : ''}" data-action="filter" data-value="${f}">${filter === f ? '✓ ' : ''}${label}</span>`).join('');
  const rows = items.length ? items.map(({ it, i }, r) => `<div class="r" data-action="press" data-value="${tab}:${i}"><span class="grow">${esc(it[0])}</span><span class="keys">${it[1].map((k, j) => cap(k, Math.max(dn(`${tab}:${i}:${j}`).d, waveD(r, j)))).join('')}</span></div>`).join('')
    : `<div class="r" style="justify-content: center">Nothing with ${esc(FILTERS.find(f => f[0] === filter)[1])} in ${CATS[tab].name}</div>`;
  const status = last ? `↳ <b style="font-size: ${(12 * clamp(ok.s, 0.5, 1.4)).toFixed(1)}px">${last[1].map(esc).join(' ')}</b> · ${esc(last[0])} <span style="float: right">${pressed}×</span>` : 'Tap a shortcut to press its keys';
  return `<div class="chips">${chips}</div>${rows}<div class="last">${status}</div>`;
}

function quizView() {
  const q = quiz, done = q.pick >= 0, right = done && q.opts[q.pick] === q.target;
  const opts = q.opts.map((o, i) => {
    const isT = o === q.target;
    let style = '';
    if (done && isT) style = 'background-color: rgba(52,199,89,0.35); ';
    else if (done && i === q.pick) style = `background-color: rgba(255,59,48,0.35); margin-left: ${(shake.x - 6).toFixed(1)}px; margin-right: ${(-shake.x - 6).toFixed(1)}px; `;
    return `<div class="r"${done ? '' : ` data-action="answer" data-value="${i}"`} style="${style}"><span class="keys">${o[1].map((k, j) => cap(k, dn(`q${i}:${j}`).d)).join('')}</span><span class="grow"></span>${done && isT ? '✓' : done && i === q.pick ? '✗' : ''}</div>`;
  }).join('');
  const verdict = !done ? 'Pick the right keys' : right ? `<b style="font-size: ${(13 * clamp(ok.s, 0.5, 1.4)).toFixed(1)}px">🎉 Correct!</b>` : `<b>Not quite</b> · it's ${q.target[1].map(esc).join(' ')}`;
  return `<div style="margin: 2px 0 4px 0">Which keys <b>${esc(q.target[0].toLowerCase())}</b>?</div>${opts}
    <div class="row" style="margin-top: 8px"><span class="grow">${verdict}</span><span style="margin-right: 8px">${score}/${asked}</span>${done ? '<span class="nx" data-action="next">Next →</span>' : ''}</div>`;
}

function render() {
  const tabs = [...CATS.map((c, i) => {
    const n = c.items.filter(match).length;
    return `<span class="${i === tab ? 'on' : ''}" data-action="tab" data-value="${i}">${c.name}${filter ? ` ${n}` : ''}</span>`;
  }), `<span class="${tab === QUIZ ? 'on' : ''}" data-action="tab" data-value="${QUIZ}">🎯 Quiz</span>`].join('');
  return `<div class="sc"><div>Cheat sheet for the team ⌨️</div><div class="seg">${tabs}</div>${tab === QUIZ ? quizView() : listView()}</div>`;
}
</script>
