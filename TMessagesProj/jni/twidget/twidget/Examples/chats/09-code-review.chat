E.push({ live: p => `Writing objects: ${String(Math.round(p * 100)).padStart(3)}% (${Math.round(p * 19)}/19)${p >= 1 ? ', 14.21 KiB | 14.21 MiB/s, done.' : ''}`, ms: 700, d: 60 });
out('remote: Create a pull request for \'feature/html-bubbles\':', 220);
