</div>
<script>
const BASE = 0x1029e0000;
const FR = [
  ['LiteChat', '0x0000000102a4c1f0', 'litehtml::render_item::render_positioned(render_type) + 212', 'render_item.cpp:742', 'auto* ctr = el->get_document()->container(); // dangling'],
  ['LiteChat', '0x0000000102a4b9c4', 'litehtml::render_item::render_positioned(render_type) + 96', 'render_item.cpp:705', 'for(auto& el : m_positioned) el->render_positioned(rt);'],
  ['LiteChat', '0x0000000102a31e08', 'litehtml::document::render(pixel_t, render_type) + 388', 'document.cpp:1018', 'm_root_render->render_positioned(rt);'],
  ['LiteChat', '0x00000001029f72d4', '-[LHDocument layoutWithMaxWidth:] + 284', 'LHDocument.mm:48', 'lh::pixel_t natural = _doc->render(width);'],
  ['LiteChat', '0x00000001029f9c10', '-[HTMLBubbleView sizeForMaxWidth:] + 120', 'HTMLBubbleView.mm:131', 'CGSize size = [_document layoutWithMaxWidth:maxWidth];'],
  ['LiteChat', '0x00000001029fbe44', '-[TranscriptView relayout] + 1104', 'TranscriptView.mm:402', 'row.height = [bubble sizeForMaxWidth:width].height;'],
  ['LiteChat', '0x00000001029fc5a8', '-[TranscriptView clipViewFrameChanged:] + 28', 'TranscriptView.mm:377', '[self relayout];'],
  ['CoreFoundation', '0x000000018a2b3c84', '__CFNOTIFICATIONCENTER_IS_CALLING_OUT_TO_AN_OBSERVER__ + 148'],
