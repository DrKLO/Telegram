  .df td.d { background-color: rgba(255,59,48,0.12); } .df td.d.ln { background-color: rgba(255,59,48,0.2); } .df td.d.sg { color: #d70015; }
  .lc-dark .df td.a.sg { color: #5fd47b; } .lc-dark .df td.d.sg { color: #ff6961; }
