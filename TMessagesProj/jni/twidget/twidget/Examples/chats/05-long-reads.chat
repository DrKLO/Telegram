  .rn .toggle:hover { background-color: rgba(255,107,53,0.08); }
</style>
<div class="card rn">
  <div class="pad"><div class="row"><b class="grow" style="font-size: 17px">LiteChat 0.2 release notes</b><span class="badge green">STABLE</span></div>
    <h4>✨ New</h4><ul><li>Interactive messages: <code>chat:toggle</code> and <code>chat:select</code> links</li><li>Dark-mode aware CSS kit</li><li>Six new demo conversations</li></ul></div>
</div>
<script>
const VERSIONS = [
  { v: '0.3', badge: ['orange', 'BETA'], date: 'October 2026', groups: [
    ['✨ New', [
      ['Scripted messages: <code>&lt;script&gt;</code> with <code>render()</code> and <code>onAction()</code>', 'Every message gets its own JavaScriptCore sandbox. A click on a <code>data-action</code> element calls <code>onAction</code>, and <code>render()</code> returns the new HTML for the same bubble — nothing is posted to the chat.'],
      ['Bubble transitions: fade, slide and pop', '<code>transition(\'slide-left\')</code> snapshots the old content and animates the new one in while the bubble height follows. This card uses it for the version tabs.'],
      ['<code>animate()</code>, <code>tween()</code> and 14 easing curves', 'Up to 60 frames per second. Frames and timers pause while a bubble is off screen and catch up when it comes back.'],
      ['Script Log… in the message context menu'],
      ['Restart link for scripts stopped by the sandbox'],
      ['<code>esc()</code>, <code>mix()</code>, <code>alpha()</code>, <code>lerp()</code> and <code>clamp()</code> helpers'],
    ]],
    ['🐛 Fixes', [['Timers keep their order after a bubble scrolls back on screen'], ['A script error no longer wipes the last good HTML'], ['Hover state survives a re-render']]],
    ['⚡ Performance', [['Unchanged <code>render()</code> output skips layout entirely'], ['Frames are coalesced when several animations run at once']]],
    ['⚠️ Breaking', [['<code>chat:toggle</code> demo cards were rewritten as scripts'], ['Scripts get 50 ms per call and 200 ms of CPU per second']]],
  ] },
  { v: '0.2', badge: ['green', 'STABLE'], date: 'September 2026', groups: [
    ['✨ New', [
      ['Interactive messages: <code>chat:toggle</code> and <code>chat:select</code> links', 'A link toggles a class on the bubble\'s <code>&lt;body&gt;</code> and re-renders it: tabs, accordions and checklists without a single line of script.'],
      ['Dark-mode aware CSS kit: <code>.card</code>, <code>.btn</code>, <code>.badge</code>, <code>.panel</code>, <code>kbd</code>', 'Colours come from the current theme, so one message looks right in light and dark mode without any media queries.'],
      ['Six new demo conversations with long, complex messages', 'Including this one: an article, a digest, release notes, an FAQ, legal text and a poem.'],
      ['Theme classes <code>lc-dark</code> / <code>lc-light</code> / <code>lc-in</code> / <code>lc-out</code> on every bubble'],
      ['<code>on=</code> attribute in .chat files to pre-select tabs'],
      ['<code>lhrender --hover x,y</code> renders a hover state'],
      ['<code>lhrender --click x,y</code> reports which link was hit'],
      ['Typing indicator for scripted replies'],
      ['Open any .html file as a message (⌘O)'],
      ['Snippets menu in the composer'],
      ['Hover tooltip with parse and layout timings'],
      ['View HTML Source from the context menu'],
    ]],
    ['🐛 Fixes', [
      ['Hard colour stops in conic gradients (<code>red 0% 25%, blue 25% 50%</code>)'], ['Gradient stops that go backwards are clamped like browsers do'],
      ['Bubble tail corner on the last message of a group'], ['Composer corners clipped in dark mode'], ['Funnel labels clipped inside narrow bars'],
      ['Link preview image narrower than its card'], ['Body margin doubled the bubble padding'], ['Italic synthesised for families without an italic face'],
      ['Icons tinted with the requested colour'], ['Monotonic baseline: ascent + descent equals line height'], ['Image drawing upside-down in flipped contexts'],
      ['Text matrix reset before every CoreText draw'], ['Double border with rounded corners'], ['Dotted borders drawn as round dots'], ['Groove / ridge / inset / outset shading'],
    ]],
    ['⚡ Performance', [
      ['Per-font text-width cache (up to 8,192 entries)'], ['Layout cached per bubble width — scrolling never re-lays out'],
      ['Shrink-to-fit costs one extra layout only when the content is narrower'], ['Images decoded once into a process-wide cache'],
      ['Fonts resolved through NSFontManager once per document'], ['Background tiles skipped outside the clip rectangle'],
    ]],
    ['⚠️ Breaking', [
      ['Messages that contain their own <code>&lt;body&gt;</code> tag do not receive theme classes'],
      ['<code>chat:select</code> groups are prefixes: <code>tab-1</code>, <code>tab-2</code> belong to <code>tab</code>'], ['Minimum macOS is now 14 (conic gradients)'],
    ]],
  ] },
  { v: '0.1', badge: ['', 'ARCHIVED'], date: 'August 2026', groups: [
    ['✨ New', [
      ['Every message rendered by litehtml + gumbo', 'HTML and CSS are laid out by a compact C++ engine and drawn by the app. No web views, no web process per message.'],
      ['CoreText container with automatic font fallback', 'Emoji, Cyrillic, Japanese and Arabic render even when the CSS only asks for the system font.'],
      ['Icons through <code>icon:</code> URLs', 'Size, colour and weight are query parameters: <code>icon:heart-fill?size=24&amp;color=ff2d55</code>.'],
      ['Demo pictures as <code>data:</code> SVG'],
      ['<code>.chat</code> files describe demo conversations'],
    ]],
    ['🧭 Known issues', [['Remote images are not loaded yet'], ['No bidirectional text reordering'], ['Long unbreakable words overflow the bubble']]],
  ] },
];

let ver = 1, expanded = false, openKey = null;
const fx = { reveal: 3, intro: 0 };
const flat = V => V.groups.flatMap((g, gi) => g[1].map((it, ii) => ({ gi, key: `${V.v}/${gi}/${ii}`, html: it[0], more: it[1] })));

setTimeout(() => tween(fx, { intro: 1 }, 900, ease.outCubic), 250);

function onAction(name, value) {
  const N = flat(VERSIONS[ver]).length;
  if (name === 'ver') {
    const next = Number(value);
    if (next === ver) return;
    transition(next > ver ? 'slide-left' : 'slide-right');
    ver = next; openKey = null;
    fx.reveal = expanded ? flat(VERSIONS[ver]).length : 3;
  } else if (name === 'more') {
    transition(expanded ? 'slide-up' : 'slide-down');
    expanded = !expanded;
    if (!expanded) openKey = null;
    fx.reveal = expanded ? N : 3;
  } else if (name === 'item') {
    transition(openKey === value ? 'slide-up' : 'slide-down');
    openKey = openKey === value ? null : value;
  }
}

function render() {
  const V = VERSIONS[ver], items = flat(V), N = items.length;
  const shown = Math.min(N, fx.reveal);
  let body = '', group = -1;
  items.forEach((it, i) => {
    const frac = clamp(shown - i, 0, 1);
    if (frac <= 0) return;
    if (it.gi !== group) { body += `${group >= 0 ? '</ul>' : ''}<h4>${V.groups[it.gi][0]}</h4><ul>`; group = it.gi; }
    const enter = i < 3 ? 1 - ease.outCubic(clamp(fx.intro * 1.6 - i * 0.22, 0, 1)) : 0;
    const left = (1 - frac) * 22 + enter * 26;
    const isOpen = openKey === it.key;
    body += it.more
      ? `<li class="x ${isOpen ? 'open' : ''}" style="left: ${left.toFixed(1)}px" data-action="item" data-value="${it.key}">${it.html} <span class="chev">${isOpen ? '▾' : '▸'}</span>${isOpen ? `<div class="det muted">${it.more}</div>` : ''}</li>`
      : `<li style="left: ${left.toFixed(1)}px">${it.html}</li>`;
  });
  if (group >= 0) body += '</ul>';
  const counts = V.groups.map(g => `<span class="badge">${g[0].split(' ')[0]} ${Math.round(g[1].length * fx.intro)}</span>`).join('');
  const tabs = VERSIONS.map((x, i) => `<span class="${i === ver ? 'on' : ''}" data-action="ver" data-value="${i}">v${x.v}</span>`).join('');
  const rest = N - 3;
  return `<div class="card rn">
    <div class="pad" style="padding-bottom: 6px">
      <div class="row"><b class="grow" style="font-size: 17px">LiteChat ${V.v} release notes</b><span class="badge ${V.badge[0]}">${V.badge[1]}</span></div>
      <div class="tiny muted">${V.date} · ${Math.round(N * fx.intro)} changes · tap ▸ for details</div>
      <div class="seg">${tabs}</div>
      <div class="cnt" data-pin="top">${counts}</div>
      ${body}
      ${!expanded && shown <= 3.01 ? `<div class="small muted" style="margin: 2px 0 6px 0">…and ${rest} more changes.</div>` : ''}
    </div>
    <div class="toggle" data-pin="bottom" data-action="more">${expanded ? 'Show less ▴' : `Show all ${N} changes ▾`}</div>
  </div>`;
}
</script>

