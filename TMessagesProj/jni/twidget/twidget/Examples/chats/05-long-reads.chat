</style>
<div class="pm">
  <div class="k">Sunday poem</div>
  <div class="t">Ode to the Box Model</div>
  <p><i>Content</i> sits within its <i>padding</i> fair,<br>the <i>border</i> draws a line to keep it there;<br>the <i>margin</i>, quiet, asks for nothing more<br>than distance from the paragraph before.</p>
</div>
<script>
const POEM = [
  [['<i>Content</i> sits within its <i>padding</i> ', 'fair', ','], ['the <i>border</i> draws a line to keep it ', 'there', ';'],
   ['the <i>margin</i>, quiet, asks for nothing ', 'more', ''], ['than distance from the paragraph ', 'before', '.']],
  [['And when two margins meet, as margins ', 'do', ','], ['they do not add — the larger one wins ', 'through', ';'],
   ['so every block, however small or ', 'wide', ','], ['collapses gracefully on either ', 'side', '.']],
  [['The float drifts left; the text flows round its ', 'shore', ';'], ['the inline wraps, then wraps a little ', 'more', ' —'],
   ['and in this bubble, set in serif ', 'type', ','], ['a C++ engine draws it, pipe by ', 'pipe', '.']],
];
const CSS = [
  ['.box { padding: 12px; }', '.box { border: 1px solid; }', '.box { margin: 0 0 8px; }', '/* space from the sibling above */'],
  ['h2 { margin-bottom: 24px; }', 'p { margin-top: 16px; } /* gap: 24px */', '.block, .wide { display: block; }', '/* vertical margins collapse */'],
  ['img { float: left; }', 'span { display: inline; }', 'body { font-family: serif; }', '/* rendered by litehtml */'],
];
const RHYME = ['255,204,0', '52,199,89', '0,122,255', '175,82,222', '255,45,85', '48,176,199'];

const alphaOf = POEM.map(st => st.map(() => 0));
const orn = [0, 0];
let stanza = 0, run = 0, css = false, rhymes = false, liked = false, likes = 128;
const fx = { rh: 0, pop: 1 };

function reveal(s, quick) {
  const me = ++run, LINE_MS = quick ? 130 : 420, FADE_MS = quick ? 380 : 650, ORN_MS = quick ? 300 : 500;
  for (let i = 0; i < s; i++) { alphaOf[i] = alphaOf[i].map(() => 1); if (i < orn.length) orn[i] = 1; }
  stanza = s + 1;
  const lines = POEM[s].length, total = (lines - 1) * LINE_MS + FADE_MS + (s < orn.length ? ORN_MS * 0.4 : 0);
  animate(total, (_, t) => {
    if (me !== run) return;
    const ms = t * total;
    for (let j = 0; j < lines; j++) alphaOf[s][j] = ease.inOutSine(clamp((ms - j * LINE_MS) / FADE_MS, 0, 1));
    if (s < orn.length) orn[s] = clamp((ms - (lines - 1) * LINE_MS - FADE_MS + ORN_MS * 0.6) / ORN_MS, 0, 1);
  }, ease.linear);
}

function replay() {
  for (const st of alphaOf) st.fill(0);
  orn.fill(0);
  reveal(0, true);
}

setTimeout(() => reveal(0, true), 250);

function onAction(name) {
  if (name === 'next') { if (stanza < POEM.length) reveal(stanza); else replay(); }
  else if (name === 'css') { transition('fade'); css = !css; }
  else if (name === 'rhymes') { rhymes = !rhymes; tween(fx, { rh: rhymes ? 1 : 0 }, 450, ease.outCubic); }
  else if (name === 'like') {
    liked = !liked; likes += liked ? 1 : -1;
    fx.pop = liked ? 1.9 : 0.6; tween(fx, { pop: 1 }, 520, ease.outElastic);
  }
}

const shade = a => a >= 0.999 ? '' : `a${Math.min(9, Math.floor(a * 10))}`;

function render() {
  let rhyme = 0;
  const stanzas = POEM.map((st, si) => {
    const lines = st.map(([head, word, tail], li) => {
      const a = alphaOf[si][li];
      const rise = ((1 - a) * 8).toFixed(1);
      if (css) return `<div class="ln code ${shade(a)}" style="top: ${rise}px">${esc(CSS[si][li])}</div>`;
      const color = RHYME[rhyme + (li >> 1)];
      const mark = fx.rh > 0.01 ? ` style="background-color: rgba(${color},${(0.32 * fx.rh * a).toFixed(3)})"` : '';
      return `<div class="ln ${shade(a)}" style="top: ${rise}px">${head}<span class="rh"${mark}>${word}</span>${tail}</div>`;
    }).join('');
    rhyme += 2;
    const o = si < orn.length ? `<div class="orn" style="color: rgba(255,107,53,${orn[si].toFixed(3)})">❦</div>` : '';
    return `<div class="st">${lines}</div>${o}`;
  }).join('');
  const done = stanza >= POEM.length && alphaOf[POEM.length - 1][3] >= 1;
  const heart = `<span style="font-size: ${Math.max(6, Math.round(14 * fx.pop))}px; color: ${liked ? '#ff2d55' : '#8e8e93'}">${liked ? '♥' : '♡'}</span>`;
  return `<div class="pm">
    <div class="k">Sunday poem${css ? ' · in CSS' : ''}</div>
    <div class="t">Ode to the Box Model</div>
    ${stanzas}
    <div class="ctl">
      <span class="b go" data-action="next">${stanza < POEM.length ? `Stanza ${stanza + 1} ›` : done ? '↻ Replay' : '↻ Again'}</span>
      ${css ? '' : `<span class="b ${rhymes ? 'on' : ''}" data-action="rhymes">Rhymes</span>`}
      <span class="b ${css ? 'on' : ''}" data-action="css">${css ? 'English' : 'In CSS'}</span>
      <span class="b" data-action="like">${heart} ${likes}</span>
    </div>
    <div class="foot">— centred serif text, line breaks, ornaments</div>
  </div>`;
}
</script>
