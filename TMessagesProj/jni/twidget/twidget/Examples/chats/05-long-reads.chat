<style>
  .rn { width: 420px; max-width: 100%; }
  .rn .seg { display: flex; margin: 8px 0 2px 0; padding: 2px; border-radius: 9px; background-color: rgba(127,127,127,0.12); }
  .rn .seg span { flex-grow: 1; text-align: center; padding: 3px 0; border-radius: 7px; font-size: 12px; font-weight: 600; }
  .rn .seg span:hover { background-color: rgba(127,127,127,0.16); }
  .rn .seg span.on { background-color: #ff6b35; color: #ffffff; }
  .rn h4 { margin: 10px 0 3px 0; font-size: 13px; }
  .rn ul { margin: 0 0 4px 0; padding-left: 20px; font-size: 13px; }
  .rn li { position: relative; margin: 1px 0; padding: 1px 4px; border-radius: 6px; }
  .rn li.x:hover { background-color: rgba(255,107,53,0.09); }
  .rn li.x.open { background-color: rgba(255,107,53,0.12); }
  .rn .chev { color: #ff6b35; font-size: 11px; font-weight: 700; }
  .rn .det { margin: 3px 0 4px 0; font-size: 12px; line-height: 1.45; }
  .rn .cnt { display: flex; margin-top: 6px; }
  .rn .cnt span { margin-right: 6px; }
