<style>
  .faq { width: 420px; max-width: 100%; }
  .faq .chips { display: flex; flex-wrap: wrap; margin-top: 8px; }
  .faq .ch { padding: 2px 10px; margin: 0 6px 4px 0; border-radius: 12px; font-size: 12px; font-weight: 600; border: 1px solid rgba(127,127,127,0.30); }
  .faq .ch:hover { background-color: rgba(255,107,53,0.10); }
  .faq .ch.on { background-color: #ff6b35; border-color: #ff6b35; color: #ffffff; }
  .faq .q { display: flex; align-items: center; padding: 10px 14px; border-top: 1px solid rgba(127,127,127,0.22); font-weight: 600; }
  .faq .q:hover { background-color: rgba(127,127,127,0.08); }
  .faq .q.open { background-color: rgba(255,107,53,0.07); }
  .faq .sign { width: 18px; text-align: center; font-weight: 800; color: #ff6b35; }
  .faq .tag { font-size: 10px; font-weight: 700; text-transform: uppercase; color: #8e8e93; margin-right: 8px; }
  .faq .a { padding: 0 14px 10px 14px; font-size: 14px; line-height: 1.45; background-color: rgba(255,107,53,0.07); }
  .faq .help { display: flex; align-items: center; margin-top: 8px; font-size: 12px; }
  .faq .v { padding: 2px 9px; margin-left: 6px; line-height: 20px; border-radius: 10px; background-color: rgba(127,127,127,0.14); }
  .faq .v:hover { background-color: rgba(127,127,127,0.26); }
  .faq .v.up { background-color: rgba(52,199,89,0.22); }
  .faq .v.down { background-color: rgba(255,59,48,0.18); }
  .faq .empty { padding: 14px; border-top: 1px solid rgba(127,127,127,0.22); text-align: center; }
</style>
<div class="card faq">
  <div class="pad"><div style="font-size: 17px; font-weight: 800">Frequently asked questions</div><div class="tiny muted">Click a question to open its answer.</div></div>
  <div class="pad sep"><b>Can a message run JavaScript?</b><div class="small muted">Yes, in a sandbox: a message's script returns HTML from <code>render()</code>.</div></div>
</div>
<script>
const CATS = ['All', 'Scripts', 'Rendering', 'Authoring'];
const QA = [
  { cat: 'Scripts', q: 'Can a message run JavaScript?', up: 41, down: 2,
    a: 'Yes, in a sandbox. litehtml itself never runs scripts; a message\'s <code>&lt;script&gt;</code> runs in its own JavaScriptCore context with no network and no DOM. All it can do is return HTML from <code>render()</code> and react to clicks in <code>onAction</code>.' },
  { cat: 'Scripts', q: 'How does this accordion work?', up: 28, down: 1,
    a: 'Every question has <code>data-action="open"</code>. A click calls <code>onAction(\'open\', id)</code>; the script keeps a single <code>openId</code>, so opening one answer closes the other, calls <code>transition(\'slide-down\')</code>, and <code>render()</code> returns the new HTML for this same bubble.' },
  { cat: 'Rendering', q: 'Do styles from one message leak into another?', up: 19, down: 0,
    a: 'Never. Each bubble is a separate litehtml document with its own stylesheet list, so a <code>&lt;style&gt;p { color: red }&lt;/style&gt;</code> only affects its own bubble.' },
  { cat: 'Rendering', q: 'How long can a message be?', up: 12, down: 3,
    a: 'There is no hard limit. The article above carries around 20&nbsp;KB of HTML; the leaderboard in “Analytics” has fifty table rows. Layout cost grows roughly linearly with the number of words and boxes, and a script may return up to 256&nbsp;KB per render.' },
  { cat: 'Authoring', q: 'Can I write my own messages like these?', up: 33, down: 1,
    a: 'Yes — paste HTML into the composer, with <code>&lt;style&gt;</code> and <code>&lt;script&gt;</code> if you like, or edit the <code>.chat</code> files in <code>Resources/chats</code>. Anything you send shows fullsize; wrap it in <code>&lt;div class="widget"&gt;</code> to show it inside a bubble.' },
  { cat: 'Scripts', q: 'What stops a script from freezing the app?', up: 25, down: 0,
    a: 'Every call into a script is capped at 50&nbsp;ms, and a message gets at most 200&nbsp;ms of CPU per second. Break either rule and the script is stopped; the card keeps its last HTML and offers a Restart link.' },
  { cat: 'Rendering', q: 'Which CSS can\'t litehtml draw?', up: 17, down: 2,
    a: 'No transitions, transforms, <code>opacity</code>, <code>box-shadow</code> or grid. Scripts animate with what is left — <code>rgba()</code> colours, margins, sizes and absolute positions — re-rendering up to 60 times a second.' },
  { cat: 'Scripts', q: 'Do animations run while I scroll away?', up: 14, down: 1,
    a: 'No. Timers and frames pause while a bubble is off screen and catch up when it comes back, so a long chat full of live cards costs nothing.' },
];

let cat = 0, openId = null;
const votes = {};
const fx = { intro: 0, bar: 0, pop: 1 };
let popKey = '';

setTimeout(() => tween(fx, { intro: 1 }, 900, ease.outCubic), 250);

function onAction(name, value) {
  if (name === 'cat') {
    const next = Number(value);
    if (next === cat) return;
    transition('fade');
    cat = next;
    if (openId !== null && cat && QA[openId].cat !== CATS[cat]) openId = null;
    fx.intro = 0.35; tween(fx, { intro: 1 }, 600, ease.outCubic);
  } else if (name === 'open') {
    const id = Number(value);
    transition(openId === id ? 'slide-up' : 'slide-down');
    openId = openId === id ? null : id;
    fx.bar = 0;
    if (openId !== null) tween(fx, { bar: 1 }, 420, ease.outBack);
  } else if (name === 'vote') {
    const [id, kind] = value.split(':');
    votes[id] = votes[id] === kind ? undefined : kind;
    popKey = value; fx.pop = 1.7; tween(fx, { pop: 1 }, 420, ease.outBack);
  }
}

function render() {
  const list = QA.map((x, id) => ({ x, id })).filter(({ x }) => !cat || x.cat === CATS[cat]);
  const chips = CATS.map((c, i) => {
    const n = i ? QA.filter(x => x.cat === c).length : QA.length;
    return `<span class="ch ${i === cat ? 'on' : ''}" data-action="cat" data-value="${i}">${c} ${n}</span>`;
  }).join('');
  const rated = Object.values(votes).filter(Boolean).length;
  const rows = list.map(({ x, id }, k) => {
    const isOpen = openId === id;
    const off = (1 - ease.outCubic(clamp(fx.intro * 1.8 - k * 0.1, 0, 1))) * 28;
    const vote = votes[id];
    const btn = kind => {
      const n = (kind === 'up' ? x.up : x.down) + (vote === kind ? 1 : 0);
      const size = popKey === `${id}:${kind}` ? Math.round(13 * fx.pop) : 13;
      return `<span class="v ${vote === kind ? kind : ''}" data-action="vote" data-value="${id}:${kind}"><span style="font-size: ${size}px">${kind === 'up' ? '👍' : '👎'}</span> ${n}</span>`;
    };
    const answer = isOpen ? `<div class="a">${x.a}
      <div class="help"><span class="muted grow">${vote ? 'Thanks for the feedback!' : 'Was this helpful?'}</span>${btn('up')}${btn('down')}</div></div>` : '';
    const bar = isOpen ? clamp(4 * fx.bar, 0, 5) : 0;
    return `<div class="q ${isOpen ? 'open' : ''}" ${bar ? `style="border-left: ${bar.toFixed(1)}px solid #ff6b35; padding-left: ${(14 - bar).toFixed(1)}px"` : ''} data-action="open" data-value="${id}">
      <span class="grow" style="position: relative; left: ${off.toFixed(1)}px">${x.q}</span>
      ${cat ? '' : `<span class="tag">${x.cat}</span>`}<span class="sign">${isOpen ? '−' : '+'}</span></div>${answer}`;
  }).join('');
  return `<div class="card faq">
    <div class="pad" style="padding-bottom: 8px">
      <div class="row between"><span style="font-size: 17px; font-weight: 800">Frequently asked questions</span><span class="tiny muted">${rated ? `you rated ${rated}` : ''}</span></div>
      <div class="tiny muted">Showing ${list.length} of ${QA.length} · one answer open at a time</div>
      <div class="chips">${chips}</div>
    </div>
    ${rows || '<div class="empty muted">Nothing here yet.</div>'}
  </div>`;
}
</script>

