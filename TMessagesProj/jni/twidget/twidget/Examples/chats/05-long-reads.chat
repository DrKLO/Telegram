  .lc-dark .pm .a3 { color: rgba(255,255,255,0.3); } .lc-dark .pm .a4 { color: rgba(255,255,255,0.4); } .lc-dark .pm .a5 { color: rgba(255,255,255,0.5); }
  .lc-dark .pm .a6 { color: rgba(255,255,255,0.6); } .lc-dark .pm .a7 { color: rgba(255,255,255,0.7); } .lc-dark .pm .a8 { color: rgba(255,255,255,0.8); }
