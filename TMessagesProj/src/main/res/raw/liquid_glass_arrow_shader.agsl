// liquid_glass_shader.agsl with an arrow out of a side (a hint): only for such a shape, the plain one stays cheaper
uniform shader img;

uniform float2 center;
uniform float2 size;
uniform float4 radius;
uniform float thickness;
uniform float refract_index;
uniform float refract_intensity;
uniform float4 foreground_color_premultiplied;
// the arrow: its height, the radius of its tip, of the fillets at the edge, the half width of the stripe it changes
uniform float4 arrow;
// xy: the point of the edge on its axis, from the center; zw: the direction out of the body
uniform float4 arrow_axis;

half sdfRect(half2 p, half2 sz, half4 r) {
  r.xy = (p.x > 0.0) ? r.xy : r.zw;
  r.x  = (p.y > 0.0) ? r.x  : r.y;
  half2 q = abs(p) - sz + r.x;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r.x;
}

// the edge with the arrow, u along it (folded), v out of the body: the tip arc, the side at 45°, the fillet, the edge
float sdArrowEdge(float u, float v) {
  const float SQ2 = 1.41421356;
  const float S = 0.70710678;
  float h = arrow.x, rt = arrow.y, rf = arrow.z;
  float2 ct = float2(0.0, h - rt);
  float2 cf = float2(h + (rt + rf) * (SQ2 - 1.0), rf);
  float2 a = ct + rt * float2(S, S);
  float2 b = cf - rf * float2(S, S);
  float2 p = float2(u, v);

  float2 ab = b - a;
  float t = clamp(dot(p - a, ab) / dot(ab, ab), 0.0, 1.0);
  float d = length(p - a - ab * t);
  float2 qt = p - ct;
  if (qt.y >= qt.x) {
    d = min(d, abs(length(qt) - rt));
  }
  float2 qf = p - cf;
  if (qf.x <= 0.0 && qf.y <= qf.x) {
    d = min(d, abs(length(qf) - rf));
  }
  d = min(d, length(float2(max(cf.x - u, 0.0), v)));

  float f = u <= a.x ? ct.y + sqrt(max(rt * rt - u * u, 0.0))
          : u <= b.x ? a.y - (u - a.x)
          : u <= cf.x ? rf - sqrt(max(rf * rf - (u - cf.x) * (u - cf.x), 0.0))
          : 0.0;
  return v < f ? -d : d;
}

half sdShape(float2 p) {
  float2 q = p - arrow_axis.xy;
  float2 dir = arrow_axis.zw;
  float u = abs(q.x * dir.y - q.y * dir.x);
  if (u < arrow.w) {
    // within the stripe: the body without its edge there, cut by the edge with the arrow
    float e = (arrow.x + thickness + 2.0) * 0.5;
    float body = sdfRect(p - dir * e, size + abs(dir) * e, radius);
    return half(max(body, sdArrowEdge(u, dot(q, dir))));
  }
  return sdfRect(p, size, radius);
}

half4 srcOver(half4 src, half4 dst) {
    half3 outRGB = (src.rgb + dst.rgb * (1.0 - src.a));
    float outA = src.a + (1.0 - src.a) * dst.a;
    return half4(outRGB, outA);
}

half4 main(in float2 fragCoord) {
  float2 p = fragCoord - center;
  half sdRaw = sdShape(p);
  float2 uv = fragCoord;
  // past the edge the lens goes on as at the edge: the outline clips it, but a downsampled glass is upscaled over it
  half sd = min(sdRaw, 0.0);
  half sdX = sdShape(p + float2(1.0, 0.0));
  half sdY = sdShape(p + float2(0.0, 1.0));

  half n_cos = max(thickness + sd, 0.0) / thickness;
  half n_cos2 = n_cos * n_cos;
  half n_sin = sqrt(1.0 - n_cos2);
  half3 normal = normalize(half3((sdX - sdRaw) * n_cos, (sdY - sdRaw) * n_cos, n_sin));

  half3 refract_vec = refract(half3(0.0, 0.0, -1.0), normal, 1.0 / refract_index);
  half h = sd < -thickness ? thickness : sqrt(sd * (-2.0 * thickness - sd));
  half refract_length = (h + 8.0 * thickness) / -refract_vec.z;

  uv += refract_vec.xy * refract_length * refract_intensity;
  // on a small shape the edge samples past the far side: stay within the shape, whatever the grid of a downsampled node
  // and the arrow
  float2 tip = arrow_axis.zw * arrow.x;
  uv = clamp(uv, center - size + 0.5 + min(tip, 0.0), center + size - 0.5 + max(tip, 0.0));

  return srcOver(half4(foreground_color_premultiplied), img.eval(uv));
}
